test "TestReversed.test_pickle" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\n\ndef check_pickle(itorg, seq):\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        d = pickle.dumps(itorg, proto)\n        it = pickle.loads(d)\n        assert type(itorg) == type(it), ('assertEqual', type(itorg), type(it))\n        assert list(it) == seq, ('assertEqual', list(it), seq)\n        it = pickle.loads(d)\n        try:\n            next(it)\n        except StopIteration:\n            assert not seq[1:], ('assertFalse', seq[1:])\n            continue\n        d = pickle.dumps(it, proto)\n        it = pickle.loads(d)\n        assert list(it) == seq[1:], ('assertEqual', list(it), seq[1:])\n\ndef _t():\n    for data in ('abc', range(5), tuple(enumerate('abc')), range(1, 17, 5)):\n        check_pickle(reversed(data), list(data)[::-1])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
