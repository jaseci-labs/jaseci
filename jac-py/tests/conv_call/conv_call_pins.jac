test "FastCallTests.test_fastcall_clearing_dict" {
    (ok, detail) = p2_libtest_run_snippet("import gc\n\ndef pyfunc(arg1, arg2):\n    return [arg1, arg2]\n\ndef pyfunc_noarg():\n    return 'noarg'\n\nclass PythonClass:\n\n    def method(self, arg1, arg2):\n        return [arg1, arg2]\n\n    def method_noarg(self):\n        return 'noarg'\n\n    @classmethod\n    def class_method(cls):\n        return 'classmethod'\n\n    @staticmethod\n    def static_method():\n        return 'staticmethod'\nPYTHON_INSTANCE = PythonClass()\n\ndef testfunction(self):\n    \"\"\"some doc\"\"\"\n    return self\n\ndef testfunction_kw(self, *, kw):\n    \"\"\"some doc\"\"\"\n    return self\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.CALLS_KWARGS = [(pyfunc, (1,), {'arg2': 2}, [1, 2]), (pyfunc, (), {'arg1': 1, 'arg2': 2}, [1, 2]), (PYTHON_INSTANCE.method, (1,), {'arg2': 2}, [1, 2]), (PYTHON_INSTANCE.method, (), {'arg1': 1, 'arg2': 2}, [1, 2])]\n    self.CALLS_POSARGS = [(pyfunc, (1, 2), [1, 2]), (pyfunc_noarg, (), 'noarg'), (PythonClass.class_method, (), 'classmethod'), (PythonClass.static_method, (), 'staticmethod'), (PYTHON_INSTANCE.method, (1, 2), [1, 2]), (PYTHON_INSTANCE.method_noarg, (), 'noarg'), (PYTHON_INSTANCE.class_method, (), 'classmethod'), (PYTHON_INSTANCE.static_method, (), 'staticmethod')]\n\n    class IntWithDict:\n        __slots__ = ['kwargs']\n\n        def __init__(self, **kwargs):\n            self.kwargs = kwargs\n\n        def __index__(self):\n            self.kwargs.clear()\n            gc.collect()\n            return 0\n    x = IntWithDict(optimize=IntWithDict())\n    compile('pass', '', 'exec', x, **x.kwargs)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestRecursion.test_recursion_with_kwargs" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    def recurse_kw(a=0):\n        recurse_kw(a=0)\n    try:\n        recurse_kw()\n    except RecursionError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestFunctionWithManyArgs.test_function_with_many_args" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    for N in (10, 500, 1000):\n        args = ','.join([f'a{i}' for i in range(N)])\n        src = f'def f({args}) : return a{N // 2}'\n        l = {}\n        exec(src, {}, l)\n        assert l['f'](*range(N)) == N // 2, ('assertEqual', l['f'](*range(N)), N // 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
