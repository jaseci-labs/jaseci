test "TestWeirdBugs.test_iter_and_mutate" {
    (ok, detail) = p2_libtest_run_snippet("def R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n    s = set(range(100))\n    s.clear()\n    s.update(range(100))\n    si = iter(s)\n    s.clear()\n    a = list(range(100))\n    s.update(range(100))\n    list(si)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestWeirdBugs.test_merge_and_mutate" {
    (ok, detail) = p2_libtest_run_snippet("def R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n\n    class X:\n\n        def __hash__(self):\n            return hash(0)\n\n        def __eq__(self, o):\n            other.clear()\n            return False\n    other = set()\n    other = {X() for i in range(10)}\n    s = {0}\n    s.update(other)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestWeirdBugs.test_hash_collision_concurrent_add" {
    (ok, detail) = p2_libtest_run_snippet("def R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class X:\n\n        def __hash__(self):\n            return 0\n\n    class Y:\n        flag = False\n\n        def __hash__(self):\n            return 0\n\n        def __eq__(self, other):\n            if not self.flag:\n                self.flag = True\n                s.add(X())\n            return self is other\n    a = X()\n    s = set()\n    s.add(a)\n    s.add(X())\n    s.remove(a)\n    s.add(Y())\n    repr(s)\n    list(s)\n    set() | s\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestGraphs.test_cube" {
    (ok, detail) = p2_libtest_run_snippet("def R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n    g = cube(3)\n    vertices1 = set(g)\n    assert len(vertices1) == 8, ('assertEqual', len(vertices1), 8)\n    for edge in g.values():\n        assert len(edge) == 3, ('assertEqual', len(edge), 3)\n    vertices2 = set((v for edges in g.values() for v in edges))\n    assert vertices1 == vertices2, ('assertEqual', vertices1, vertices2)\n    cubefaces = faces(g)\n    assert len(cubefaces) == 6, ('assertEqual', len(cubefaces), 6)\n    for face in cubefaces:\n        assert len(face) == 4, ('assertEqual', len(face), 4)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestGraphs.test_cuboctahedron" {
    (ok, detail) = p2_libtest_run_snippet("import collections.abc\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\ndef powerset(U):\n    \"\"\"Generates all subsets of a set or sequence U.\"\"\"\n    U = iter(U)\n    try:\n        x = frozenset([next(U)])\n        for S in powerset(U):\n            yield S\n            yield (S | x)\n    except StopIteration:\n        yield frozenset()\n\ndef cube(n):\n    \"\"\"Graph of n-dimensional hypercube.\"\"\"\n    singletons = [frozenset([x]) for x in range(n)]\n    return dict([(x, frozenset([x ^ s for s in singletons])) for x in powerset(range(n))])\n\ndef linegraph(G):\n    \"\"\"Graph, the vertices of which are edges of G,\n    with two vertices being adjacent iff the corresponding\n    edges share a vertex.\"\"\"\n    L = {}\n    for x in G:\n        for y in G[x]:\n            nx = [frozenset([x, z]) for z in G[x] if z != y]\n            ny = [frozenset([y, z]) for z in G[y] if z != x]\n            L[frozenset([x, y])] = frozenset(nx + ny)\n    return L\n\ndef faces(G):\n    \"\"\"Return a set of faces in G.  Where a face is a set of vertices on that face\"\"\"\n    f = set()\n    for v1, edges in G.items():\n        for v2 in edges:\n            for v3 in G[v2]:\n                if v1 == v3:\n                    continue\n                if v1 in G[v3]:\n                    f.add(frozenset([v1, v2, v3]))\n                else:\n                    for v4 in G[v3]:\n                        if v4 == v2:\n                            continue\n                        if v1 in G[v4]:\n                            f.add(frozenset([v1, v2, v3, v4]))\n                        else:\n                            for v5 in G[v4]:\n                                if v5 == v3 or v5 == v2:\n                                    continue\n                                if v1 in G[v5]:\n                                    f.add(frozenset([v1, v2, v3, v4, v5]))\n    return f\n\ndef _t():\n    g = cube(3)\n    cuboctahedron = linegraph(g)\n    assert len(cuboctahedron) == 12, ('assertEqual', len(cuboctahedron), 12)\n    vertices = set(cuboctahedron)\n    for edges in cuboctahedron.values():\n        assert len(edges) == 4, ('assertEqual', len(edges), 4)\n    othervertices = set((edge for edges in cuboctahedron.values() for edge in edges))\n    assert vertices == othervertices, ('assertEqual', vertices, othervertices)\n    cubofaces = faces(cuboctahedron)\n    facesizes = collections.defaultdict(int)\n    for face in cubofaces:\n        facesizes[len(face)] += 1\n    assert facesizes[3] == 8, ('assertEqual', facesizes[3], 8)\n    assert facesizes[4] == 6, ('assertEqual', facesizes[4], 6)\n    for vertex in cuboctahedron:\n        edge = vertex\n        assert len(edge) == 2, ('assertEqual', len(edge), 2)\n        for cubevert in edge:\n            assert cubevert in g, ('assertIn', cubevert, g)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
