test "TestIdentities.test_binopsVsSubsets" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b = (self.a, self.b)\n    assert a - b < a, ('assertTrue', a - b < a)\n    assert b - a < b, ('assertTrue', b - a < b)\n    assert a & b < a, ('assertTrue', a & b < a)\n    assert a & b < b, ('assertTrue', a & b < b)\n    assert a | b > a, ('assertTrue', a | b > a)\n    assert a | b > b, ('assertTrue', a | b > b)\n    assert a ^ b < a | b, ('assertTrue', a ^ b < a | b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIdentities.test_commutativity" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b = (self.a, self.b)\n    assert a & b == b & a, ('assertEqual', a & b, b & a)\n    assert a | b == b | a, ('assertEqual', a | b, b | a)\n    assert a ^ b == b ^ a, ('assertEqual', a ^ b, b ^ a)\n    if a != b:\n        assert a - b != b - a, ('assertNotEqual', a - b, b - a)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIdentities.test_summations" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b = (self.a, self.b)\n    assert a - b | a & b | b - a == a | b, ('assertEqual', a - b | a & b | b - a, a | b)\n    assert a & b | a ^ b == a | b, ('assertEqual', a & b | a ^ b, a | b)\n    assert a | b - a == a | b, ('assertEqual', a | b - a, a | b)\n    assert a - b | b == a | b, ('assertEqual', a - b | b, a | b)\n    assert a - b | a & b == a, ('assertEqual', a - b | a & b, a)\n    assert b - a | a & b == b, ('assertEqual', b - a | a & b, b)\n    assert a - b | b - a == a ^ b, ('assertEqual', a - b | b - a, a ^ b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestIdentities.test_exclusion" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.a = set('abracadabra')\n    self.b = set('alacazam')\n    a, b, zero = (self.a, self.b, set())\n    assert a - b & b == zero, ('assertEqual', a - b & b, zero)\n    assert b - a & a == zero, ('assertEqual', b - a & a, zero)\n    assert a & b & (a ^ b) == zero, ('assertEqual', a & b & (a ^ b), zero)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
