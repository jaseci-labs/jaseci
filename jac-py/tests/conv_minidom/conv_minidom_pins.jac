test "MinidomTest.testChangeAttr" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\n\ndef _t():\n    dom = parseString('<abc/>')\n    el = dom.documentElement\n    el.setAttribute('spam', 'jam')\n    assert len(el.attributes) == 1, ('assertEqual', len(el.attributes), 1)\n    el.setAttribute('spam', 'bam')\n    el.setIdAttribute('spam')\n    assert len(el.attributes) == 1, ('assertEqual', len(el.attributes), 1)\n    assert el.attributes['spam'].value == 'bam', ('assertEqual', el.attributes['spam'].value, 'bam')\n    assert el.attributes['spam'].nodeValue == 'bam', ('assertEqual', el.attributes['spam'].nodeValue, 'bam')\n    assert el.getAttribute('spam') == 'bam', ('assertEqual', el.getAttribute('spam'), 'bam')\n    assert el.getAttributeNode('spam').isId, ('assertTrue', el.getAttributeNode('spam').isId)\n    el.attributes['spam'] = 'ham'\n    assert len(el.attributes) == 1, ('assertEqual', len(el.attributes), 1)\n    assert el.attributes['spam'].value == 'ham', ('assertEqual', el.attributes['spam'].value, 'ham')\n    assert el.attributes['spam'].nodeValue == 'ham', ('assertEqual', el.attributes['spam'].nodeValue, 'ham')\n    assert el.getAttribute('spam') == 'ham', ('assertEqual', el.getAttribute('spam'), 'ham')\n    assert el.attributes['spam'].isId, ('assertTrue', el.attributes['spam'].isId)\n    el.setAttribute('spam2', 'bam')\n    assert len(el.attributes) == 2, ('assertEqual', len(el.attributes), 2)\n    assert el.attributes['spam'].value == 'ham', ('assertEqual', el.attributes['spam'].value, 'ham')\n    assert el.attributes['spam'].nodeValue == 'ham', ('assertEqual', el.attributes['spam'].nodeValue, 'ham')\n    assert el.getAttribute('spam') == 'ham', ('assertEqual', el.getAttribute('spam'), 'ham')\n    assert el.attributes['spam2'].value == 'bam', ('assertEqual', el.attributes['spam2'].value, 'bam')\n    assert el.attributes['spam2'].nodeValue == 'bam', ('assertEqual', el.attributes['spam2'].nodeValue, 'bam')\n    assert el.getAttribute('spam2') == 'bam', ('assertEqual', el.getAttribute('spam2'), 'bam')\n    el.attributes['spam2'] = 'bam2'\n    assert len(el.attributes) == 2, ('assertEqual', len(el.attributes), 2)\n    assert el.attributes['spam'].value == 'ham', ('assertEqual', el.attributes['spam'].value, 'ham')\n    assert el.attributes['spam'].nodeValue == 'ham', ('assertEqual', el.attributes['spam'].nodeValue, 'ham')\n    assert el.getAttribute('spam') == 'ham', ('assertEqual', el.getAttribute('spam'), 'ham')\n    assert el.attributes['spam2'].value == 'bam2', ('assertEqual', el.attributes['spam2'].value, 'bam2')\n    assert el.attributes['spam2'].nodeValue == 'bam2', ('assertEqual', el.attributes['spam2'].nodeValue, 'bam2')\n    assert el.getAttribute('spam2') == 'bam2', ('assertEqual', el.getAttribute('spam2'), 'bam2')\n    dom.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

