test "MinidomTest.testEncodings" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\nfrom xml.parsers.expat import ExpatError\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef _t():\n    doc = parseString('<foo>&#x20ac;</foo>')\n    assert doc.toxml() == '<?xml version=\"1.0\" ?><foo>\u20ac</foo>', ('assertEqual', doc.toxml(), '<?xml version=\"1.0\" ?><foo>\u20ac</foo>')\n    assert doc.toxml('utf-8') == b'<?xml version=\"1.0\" encoding=\"utf-8\"?><foo>\\xe2\\x82\\xac</foo>', ('assertEqual', doc.toxml('utf-8'), b'<?xml version=\"1.0\" encoding=\"utf-8\"?><foo>\\xe2\\x82\\xac</foo>')\n    assert doc.toxml('iso-8859-15') == b'<?xml version=\"1.0\" encoding=\"iso-8859-15\"?><foo>\\xa4</foo>', ('assertEqual', doc.toxml('iso-8859-15'), b'<?xml version=\"1.0\" encoding=\"iso-8859-15\"?><foo>\\xa4</foo>')\n    assert doc.toxml('us-ascii') == b'<?xml version=\"1.0\" encoding=\"us-ascii\"?><foo>&#8364;</foo>', ('assertEqual', doc.toxml('us-ascii'), b'<?xml version=\"1.0\" encoding=\"us-ascii\"?><foo>&#8364;</foo>')\n    assert doc.toxml('utf-16') == '<?xml version=\"1.0\" encoding=\"utf-16\"?><foo>\u20ac</foo>'.encode('utf-16'), ('assertEqual', doc.toxml('utf-16'), '<?xml version=\"1.0\" encoding=\"utf-16\"?><foo>\u20ac</foo>'.encode('utf-16'))\n    try:\n        parseString(b'<fran\\xe7ais>Comment \\xe7a va ? Tr\\xe8s bien ?</fran\\xe7ais>')\n    except (UnicodeDecodeError, ExpatError) as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    doc.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testStandalone" {
