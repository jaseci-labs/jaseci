test "MinidomTest.testInsertBefore" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\n\ndef _t():\n    dom = parseString('<doc><foo/></doc>')\n    root = dom.documentElement\n    elem = root.childNodes[0]\n    nelem = dom.createElement('element')\n    root.insertBefore(nelem, elem)\n    assert len(root.childNodes) == 2, ('assertEqual', len(root.childNodes), 2)\n    assert root.childNodes.length == 2, ('assertEqual', root.childNodes.length, 2)\n    assert root.childNodes[0] is nelem, ('assertIs', root.childNodes[0], nelem)\n    assert root.childNodes.item(0) is nelem, ('assertIs', root.childNodes.item(0), nelem)\n    assert root.childNodes[1] is elem, ('assertIs', root.childNodes[1], elem)\n    assert root.childNodes.item(1) is elem, ('assertIs', root.childNodes.item(1), elem)\n    assert root.firstChild is nelem, ('assertIs', root.firstChild, nelem)\n    assert root.lastChild is elem, ('assertIs', root.lastChild, elem)\n    assert root.toxml() == '<doc><element/><foo/></doc>', ('assertEqual', root.toxml(), '<doc><element/><foo/></doc>')\n    nelem = dom.createElement('element')\n    root.insertBefore(nelem, None)\n    assert len(root.childNodes) == 3, ('assertEqual', len(root.childNodes), 3)\n    assert root.childNodes.length == 3, ('assertEqual', root.childNodes.length, 3)\n    assert root.childNodes[1] is elem, ('assertIs', root.childNodes[1], elem)\n    assert root.childNodes.item(1) is elem, ('assertIs', root.childNodes.item(1), elem)\n    assert root.childNodes[2] is nelem, ('assertIs', root.childNodes[2], nelem)\n    assert root.childNodes.item(2) is nelem, ('assertIs', root.childNodes.item(2), nelem)\n    assert root.lastChild is nelem, ('assertIs', root.lastChild, nelem)\n    assert nelem.previousSibling is elem, ('assertIs', nelem.previousSibling, elem)\n    assert root.toxml() == '<doc><element/><foo/><element/></doc>', ('assertEqual', root.toxml(), '<doc><element/><foo/><element/></doc>')\n    nelem2 = dom.createElement('bar')\n    root.insertBefore(nelem2, nelem)\n    assert len(root.childNodes) == 4, ('assertEqual', len(root.childNodes), 4)\n    assert root.childNodes.length == 4, ('assertEqual', root.childNodes.length, 4)\n    assert root.childNodes[2] is nelem2, ('assertIs', root.childNodes[2], nelem2)\n    assert root.childNodes.item(2) is nelem2, ('assertIs', root.childNodes.item(2), nelem2)\n    assert root.childNodes[3] is nelem, ('assertIs', root.childNodes[3], nelem)\n    assert root.childNodes.item(3) is nelem, ('assertIs', root.childNodes.item(3), nelem)\n    assert nelem2.nextSibling is nelem, ('assertIs', nelem2.nextSibling, nelem)\n    assert nelem.previousSibling is nelem2, ('assertIs', nelem.previousSibling, nelem2)\n    assert root.toxml() == '<doc><element/><foo/><bar/><element/></doc>', ('assertEqual', root.toxml(), '<doc><element/><foo/><bar/><element/></doc>')\n    dom.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

