    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef confirm(test, testname='Test'):\n    assert test, ('assertTrue', test)\n\ndef check_clone_pi(deep, testName):\n    doc = parseString('<?target data?><doc/>')\n    pi = doc.firstChild\n    assert pi.nodeType == Node.PROCESSING_INSTRUCTION_NODE, ('assertEqual', pi.nodeType, Node.PROCESSING_INSTRUCTION_NODE)\n    clone = pi.cloneNode(deep)\n    confirm(clone.target == pi.target and clone.data == pi.data)\n\ndef _t():\n    check_clone_pi(1, 'testClonePIDeep')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testCloneNodeEntity" {
    (ok, detail) = p2_libtest_run_snippet("from test import support\nimport xml.dom.minidom\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef check_clone_node_entity(clone_document):\n    document = xml.dom.minidom.parseString('\\n            <?xml version=\"1.0\" ?>\\n            <!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.01//EN\"\\n                \"http://www.w3.org/TR/html4/strict.dtd\"\\n                [ <!ENTITY smile \"\u263a\"> ]\\n            >\\n            <doc>Don\\'t let entities make you frown &smile;</doc>\\n        '.strip())\n\n    class Handler:\n\n        def handle(self, operation, key, data, src, dst):\n            self.operation = operation\n            self.key = key\n            self.data = data\n            self.src = src\n            self.dst = dst\n    handler = Handler()\n    doctype = document.doctype\n    entity = doctype.entities['smile']\n    entity.setUserData('key', 'data', handler)\n    if clone_document:\n        clone = document.cloneNode(deep=True)\n        assert clone.documentElement.firstChild.wholeText == \"Don't let entities make you frown \u263a\", ('assertEqual', clone.documentElement.firstChild.wholeText, \"Don't let entities make you frown \u263a\")\n        operation = xml.dom.UserDataHandler.NODE_IMPORTED\n        dst = clone.doctype.entities['smile']\n    else:\n        with support.swap_attr(doctype, 'ownerDocument', None):\n            clone = doctype.cloneNode(deep=True)\n        operation = xml.dom.UserDataHandler.NODE_CLONED\n        dst = clone.entities['smile']\n    assert handler.operation == operation, ('assertEqual', handler.operation, operation)\n    assert handler.key == 'key', ('assertEqual', handler.key, 'key')\n    assert handler.data == 'data', ('assertEqual', handler.data, 'data')\n    assert handler.src is entity, ('assertIs', handler.src, entity)\n    assert handler.dst is dst, ('assertIs', handler.dst, dst)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    check_clone_node_entity(False)\n    check_clone_node_entity(True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testNormalize" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef confirm(test, testname='Test'):\n    assert test, ('assertTrue', test)\n\ndef _t():\n    doc = parseString('<doc/>')\n    root = doc.documentElement\n    root.appendChild(doc.createTextNode('first'))\n    root.appendChild(doc.createTextNode('second'))\n    confirm(len(root.childNodes) == 2 and root.childNodes.length == 2, 'testNormalize -- preparation')\n    doc.normalize()\n    confirm(len(root.childNodes) == 1 and root.childNodes.length == 1 and (root.firstChild is root.lastChild) and (root.firstChild.data == 'firstsecond'), 'testNormalize -- result')\n    doc.unlink()\n    doc = parseString('<doc/>')\n    root = doc.documentElement\n    root.appendChild(doc.createTextNode(''))\n    doc.normalize()\n    confirm(len(root.childNodes) == 0 and root.childNodes.length == 0, 'testNormalize -- single empty node removed')\n    doc.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

