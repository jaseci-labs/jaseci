test "MinidomTest.testCloneDocumentDeep" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef _t():\n    doc = parseString(\"<?xml version='1.0'?>\\n<!-- comment --><!DOCTYPE doc [\\n<!NOTATION notation SYSTEM 'http://xml.python.org/'>\\n]>\\n<doc attr='value'/>\")\n    doc2 = doc.cloneNode(1)\n    assert not (doc.isSameNode(doc2) or doc2.isSameNode(doc)), ('assertFalse', (doc.isSameNode(doc2) or doc2.isSameNode(doc)))\n    assert len(doc.childNodes) == len(doc2.childNodes), ('assertEqual', len(doc.childNodes), len(doc2.childNodes))\n    assert doc2.documentElement.nodeType == Node.ELEMENT_NODE, ('assertEqual', doc2.documentElement.nodeType, Node.ELEMENT_NODE)\n    assert doc2.documentElement.ownerDocument.isSameNode(doc2), ('assertTrue', doc2.documentElement.ownerDocument.isSameNode(doc2))\n    assert not doc.documentElement.isSameNode(doc2.documentElement), ('assertFalse', doc.documentElement.isSameNode(doc2.documentElement))\n    if doc.doctype is not None:\n        assert doc2.doctype.nodeType == Node.DOCUMENT_TYPE_NODE, ('assertEqual', doc2.doctype.nodeType, Node.DOCUMENT_TYPE_NODE)\n        assert doc2.doctype.ownerDocument.isSameNode(doc2), ('assertTrue', doc2.doctype.ownerDocument.isSameNode(doc2))\n        assert not doc.doctype.isSameNode(doc2.doctype), ('assertFalse', doc.doctype.isSameNode(doc2.doctype))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testCloneDocumentTypeDeepOk" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef confirm(test, testname='Test'):\n    assert test, ('assertTrue', test)\n\ndef _t():\n    doctype = create_nonempty_doctype()\n    clone = doctype.cloneNode(1)\n    confirm(clone is not None and clone.nodeName == doctype.nodeName and (clone.name == doctype.name) and (clone.publicId == doctype.publicId) and (clone.systemId == doctype.systemId) and (len(clone.entities) == len(doctype.entities)) and (clone.entities.item(len(clone.entities)) is None) and (len(clone.notations) == len(doctype.notations)) and (clone.notations.item(len(clone.notations)) is None) and (len(clone.childNodes) == 0))\n    for i in range(len(doctype.entities)):\n        se = doctype.entities.item(i)\n        ce = clone.entities.item(i)\n        confirm(not se.isSameNode(ce) and (not ce.isSameNode(se)) and (ce.nodeName == se.nodeName) and (ce.notationName == se.notationName) and (ce.publicId == se.publicId) and (ce.systemId == se.systemId) and (ce.encoding == se.encoding) and (ce.actualEncoding == se.actualEncoding) and (ce.version == se.version))\n    for i in range(len(doctype.notations)):\n        sn = doctype.notations.item(i)\n        cn = clone.notations.item(i)\n        confirm(not sn.isSameNode(cn) and (not cn.isSameNode(sn)) and (cn.nodeName == sn.nodeName) and (cn.publicId == sn.publicId) and (cn.systemId == sn.systemId))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

