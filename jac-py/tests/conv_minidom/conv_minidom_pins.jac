test "MinidomTest.testProcessingInstruction" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\n\ndef _t():\n    dom = parseString('<e><?mypi \\t\\n data \\t\\n ?></e>')\n    pi = dom.documentElement.firstChild\n    assert pi.target == 'mypi', ('assertEqual', pi.target, 'mypi')\n    assert pi.data == 'data \\t\\n ', ('assertEqual', pi.data, 'data \\t\\n ')\n    assert pi.nodeName == 'mypi', ('assertEqual', pi.nodeName, 'mypi')\n    assert pi.nodeType == Node.PROCESSING_INSTRUCTION_NODE, ('assertEqual', pi.nodeType, Node.PROCESSING_INSTRUCTION_NODE)\n    assert pi.attributes is None, ('assertIsNone', pi.attributes)\n    assert not pi.hasChildNodes(), ('assertFalse', pi.hasChildNodes())\n    assert len(pi.childNodes) == 0, ('assertEqual', len(pi.childNodes), 0)\n    assert pi.firstChild is None, ('assertIsNone', pi.firstChild)\n    assert pi.lastChild is None, ('assertIsNone', pi.lastChild)\n    assert pi.localName is None, ('assertIsNone', pi.localName)\n    assert pi.namespaceURI == xml.dom.EMPTY_NAMESPACE, ('assertEqual', pi.namespaceURI, xml.dom.EMPTY_NAMESPACE)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
