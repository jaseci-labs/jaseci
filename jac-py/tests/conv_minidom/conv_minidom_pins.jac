test "MinidomTest.testHasChildNodes" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef _t():\n    dom = parseString('<doc><foo/></doc>')\n    doc = dom.documentElement\n    assert doc.hasChildNodes(), ('assertTrue', doc.hasChildNodes())\n    dom2 = parseString('<doc/>')\n    doc2 = dom2.documentElement\n    assert not doc2.hasChildNodes(), ('assertFalse', doc2.hasChildNodes())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testCloneElementShallow" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\n\ndef _testCloneElementCopiesAttributes(e1, e2, test):\n    attrs1 = e1.attributes\n    attrs2 = e2.attributes\n    keys1 = list(attrs1.keys())\n    keys2 = list(attrs2.keys())\n    keys1.sort()\n    keys2.sort()\n    assert keys1 == keys2, ('assertEqual', keys1, keys2)\n    for i in range(len(keys1)):\n        a1 = attrs1.item(i)\n        a2 = attrs2.item(i)\n        assert a1 is not a2, ('assertIsNot', a1, a2)\n        assert a1.value == a2.value, ('assertEqual', a1.value, a2.value)\n        assert a1.nodeValue == a2.nodeValue, ('assertEqual', a1.nodeValue, a2.nodeValue)\n        assert a1.namespaceURI == a2.namespaceURI, ('assertEqual', a1.namespaceURI, a2.namespaceURI)\n        assert a1.localName == a2.localName, ('assertEqual', a1.localName, a2.localName)\n        assert a2.ownerElement is e2, ('assertIs', a2.ownerElement, e2)\n\ndef _setupCloneElement(deep):\n    dom = parseString(\"<doc attr='value'><foo/></doc>\")\n    root = dom.documentElement\n    clone = root.cloneNode(deep)\n    _testCloneElementCopiesAttributes(root, clone, 'testCloneElement' + (deep and 'Deep' or 'Shallow'))\n    root.tagName = root.nodeName = 'MODIFIED'\n    root.setAttribute('attr', 'NEW VALUE')\n    root.setAttribute('added', 'VALUE')\n    return (dom, clone)\n\ndef _t():\n    dom, clone = _setupCloneElement(0)\n    assert len(clone.childNodes) == 0, ('assertEqual', len(clone.childNodes), 0)\n    assert clone.childNodes.length == 0, ('assertEqual', clone.childNodes.length, 0)\n    assert clone.parentNode is None, ('assertIsNone', clone.parentNode)\n    assert clone.toxml() == '<doc attr=\"value\"/>', ('assertEqual', clone.toxml(), '<doc attr=\"value\"/>')\n    dom.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testCloneElementDeep" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\n\ndef _testCloneElementCopiesAttributes(e1, e2, test):\n    attrs1 = e1.attributes\n    attrs2 = e2.attributes\n    keys1 = list(attrs1.keys())\n    keys2 = list(attrs2.keys())\n    keys1.sort()\n    keys2.sort()\n    assert keys1 == keys2, ('assertEqual', keys1, keys2)\n    for i in range(len(keys1)):\n        a1 = attrs1.item(i)\n        a2 = attrs2.item(i)\n        assert a1 is not a2, ('assertIsNot', a1, a2)\n        assert a1.value == a2.value, ('assertEqual', a1.value, a2.value)\n        assert a1.nodeValue == a2.nodeValue, ('assertEqual', a1.nodeValue, a2.nodeValue)\n        assert a1.namespaceURI == a2.namespaceURI, ('assertEqual', a1.namespaceURI, a2.namespaceURI)\n        assert a1.localName == a2.localName, ('assertEqual', a1.localName, a2.localName)\n        assert a2.ownerElement is e2, ('assertIs', a2.ownerElement, e2)\n\ndef _setupCloneElement(deep):\n    dom = parseString(\"<doc attr='value'><foo/></doc>\")\n    root = dom.documentElement\n    clone = root.cloneNode(deep)\n    _testCloneElementCopiesAttributes(root, clone, 'testCloneElement' + (deep and 'Deep' or 'Shallow'))\n    root.tagName = root.nodeName = 'MODIFIED'\n    root.setAttribute('attr', 'NEW VALUE')\n    root.setAttribute('added', 'VALUE')\n    return (dom, clone)\n\ndef _t():\n    dom, clone = _setupCloneElement(1)\n    assert len(clone.childNodes) == 1, ('assertEqual', len(clone.childNodes), 1)\n    assert clone.childNodes.length == 1, ('assertEqual', clone.childNodes.length, 1)\n    assert clone.parentNode is None, ('assertIsNone', clone.parentNode)\n    assert clone.toxml(), ('assertTrue', clone.toxml())\n    dom.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
