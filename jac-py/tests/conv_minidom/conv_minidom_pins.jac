test "MinidomTest.testPickledDocument" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\nimport xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\nsample = \"<?xml version='1.0' encoding='us-ascii'?>\\n<!DOCTYPE doc PUBLIC 'http://xml.python.org/public' 'http://xml.python.org/system' [\\n  <!ELEMENT e EMPTY>\\n  <!ENTITY ent SYSTEM 'http://xml.python.org/entity'>\\n]><doc attr='value'> text\\n<?pi sample?> <!-- comment --> <e/> </doc>\"\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef assert_recursive_equal(doc, doc2):\n    stack = [(doc, doc2)]\n    while stack:\n        n1, n2 = stack.pop()\n        assert n1.nodeType == n2.nodeType, ('assertEqual', n1.nodeType, n2.nodeType)\n        assert len(n1.childNodes) == len(n2.childNodes), ('assertEqual', len(n1.childNodes), len(n2.childNodes))\n        assert n1.nodeName == n2.nodeName, ('assertEqual', n1.nodeName, n2.nodeName)\n        assert not n1.isSameNode(n2), ('assertFalse', n1.isSameNode(n2))\n        assert not n2.isSameNode(n1), ('assertFalse', n2.isSameNode(n1))\n        if n1.nodeType == Node.DOCUMENT_TYPE_NODE:\n            len(n1.entities)\n            len(n2.entities)\n            len(n1.notations)\n            len(n2.notations)\n            assert len(n1.entities) == len(n2.entities), ('assertEqual', len(n1.entities), len(n2.entities))\n            assert len(n1.notations) == len(n2.notations), ('assertEqual', len(n1.notations), len(n2.notations))\n            for i in range(len(n1.notations)):\n                no1 = n1.notations.item(i)\n                no2 = n1.notations.item(i)\n                assert no1.name == no2.name, ('assertEqual', no1.name, no2.name)\n                assert no1.publicId == no2.publicId, ('assertEqual', no1.publicId, no2.publicId)\n                assert no1.systemId == no2.systemId, ('assertEqual', no1.systemId, no2.systemId)\n                stack.append((no1, no2))\n            for i in range(len(n1.entities)):\n                e1 = n1.entities.item(i)\n                e2 = n2.entities.item(i)\n                assert e1.notationName == e2.notationName, ('assertEqual', e1.notationName, e2.notationName)\n                assert e1.publicId == e2.publicId, ('assertEqual', e1.publicId, e2.publicId)\n                assert e1.systemId == e2.systemId, ('assertEqual', e1.systemId, e2.systemId)\n                stack.append((e1, e2))\n        if n1.nodeType != Node.DOCUMENT_NODE:\n            assert n1.ownerDocument.isSameNode(doc), ('assertTrue', n1.ownerDocument.isSameNode(doc))\n            assert n2.ownerDocument.isSameNode(doc2), ('assertTrue', n2.ownerDocument.isSameNode(doc2))\n        for i in range(len(n1.childNodes)):\n            stack.append((n1.childNodes[i], n2.childNodes[i]))\n\ndef _t():\n    doc = parseString(sample)\n    for proto in range(2, pickle.HIGHEST_PROTOCOL + 1):\n        s = pickle.dumps(doc, proto)\n        doc2 = pickle.loads(s)\n        assert_recursive_equal(doc, doc2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testDeepcopiedDocument" {
    (ok, detail) = p2_libtest_run_snippet("import copy\nimport xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\nsample = \"<?xml version='1.0' encoding='us-ascii'?>\\n<!DOCTYPE doc PUBLIC 'http://xml.python.org/public' 'http://xml.python.org/system' [\\n  <!ELEMENT e EMPTY>\\n  <!ENTITY ent SYSTEM 'http://xml.python.org/entity'>\\n]><doc attr='value'> text\\n<?pi sample?> <!-- comment --> <e/> </doc>\"\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef assert_recursive_equal(doc, doc2):\n    stack = [(doc, doc2)]\n    while stack:\n        n1, n2 = stack.pop()\n        assert n1.nodeType == n2.nodeType, ('assertEqual', n1.nodeType, n2.nodeType)\n        assert len(n1.childNodes) == len(n2.childNodes), ('assertEqual', len(n1.childNodes), len(n2.childNodes))\n        assert n1.nodeName == n2.nodeName, ('assertEqual', n1.nodeName, n2.nodeName)\n        assert not n1.isSameNode(n2), ('assertFalse', n1.isSameNode(n2))\n        assert not n2.isSameNode(n1), ('assertFalse', n2.isSameNode(n1))\n        if n1.nodeType == Node.DOCUMENT_TYPE_NODE:\n            len(n1.entities)\n            len(n2.entities)\n            len(n1.notations)\n            len(n2.notations)\n            assert len(n1.entities) == len(n2.entities), ('assertEqual', len(n1.entities), len(n2.entities))\n            assert len(n1.notations) == len(n2.notations), ('assertEqual', len(n1.notations), len(n2.notations))\n            for i in range(len(n1.notations)):\n                no1 = n1.notations.item(i)\n                no2 = n1.notations.item(i)\n                assert no1.name == no2.name, ('assertEqual', no1.name, no2.name)\n                assert no1.publicId == no2.publicId, ('assertEqual', no1.publicId, no2.publicId)\n                assert no1.systemId == no2.systemId, ('assertEqual', no1.systemId, no2.systemId)\n                stack.append((no1, no2))\n            for i in range(len(n1.entities)):\n                e1 = n1.entities.item(i)\n                e2 = n2.entities.item(i)\n                assert e1.notationName == e2.notationName, ('assertEqual', e1.notationName, e2.notationName)\n                assert e1.publicId == e2.publicId, ('assertEqual', e1.publicId, e2.publicId)\n                assert e1.systemId == e2.systemId, ('assertEqual', e1.systemId, e2.systemId)\n                stack.append((e1, e2))\n        if n1.nodeType != Node.DOCUMENT_NODE:\n            assert n1.ownerDocument.isSameNode(doc), ('assertTrue', n1.ownerDocument.isSameNode(doc))\n            assert n2.ownerDocument.isSameNode(doc2), ('assertTrue', n2.ownerDocument.isSameNode(doc2))\n        for i in range(len(n1.childNodes)):\n            stack.append((n1.childNodes[i], n2.childNodes[i]))\n\ndef _t():\n    doc = parseString(sample)\n    doc2 = copy.deepcopy(doc)\n    assert_recursive_equal(doc, doc2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testSerializeCommentNodeWithDoubleHyphen" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef _t():\n    doc = create_doc_without_doctype()\n    doc.appendChild(doc.createComment('foo--bar'))\n    try:\n        doc.toxml()\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MinidomTest.testEmptyXMLNSValue" {
    (ok, detail) = p2_libtest_run_snippet("import xml.dom.minidom\nfrom xml.dom.minidom import parse, Attr, Node, Document, Element, parseString\nfrom xml.dom.minidom import getDOMImplementation\n\ndef create_doc_without_doctype(doctype=None):\n    return getDOMImplementation().createDocument(None, 'doc', doctype)\n\ndef create_nonempty_doctype():\n    doctype = getDOMImplementation().createDocumentType('doc', None, None)\n    doctype.entities._seq = []\n    doctype.notations._seq = []\n    notation = xml.dom.minidom.Notation('my-notation', None, 'http://xml.python.org/notations/my')\n    doctype.notations._seq.append(notation)\n    entity = xml.dom.minidom.Entity('my-entity', None, 'http://xml.python.org/entities/my', 'my-notation')\n    entity.version = '1.0'\n    entity.encoding = 'utf-8'\n    entity.actualEncoding = 'us-ascii'\n    doctype.entities._seq.append(entity)\n    return doctype\n\ndef create_doc_with_doctype():\n    doctype = create_nonempty_doctype()\n    doc = create_doc_without_doctype(doctype)\n    doctype.entities.item(0).ownerDocument = doc\n    doctype.notations.item(0).ownerDocument = doc\n    return doc\n\ndef _t():\n    doc = parseString(\"<element xmlns=''>\\n<foo/>\\n</element>\")\n    doc2 = parseString(doc.toxml())\n    assert doc2.namespaceURI == xml.dom.EMPTY_NAMESPACE, ('assertEqual', doc2.namespaceURI, xml.dom.EMPTY_NAMESPACE)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

