ElementById('w')), ('assertTrue', e.isSameNode(doc.getElementById('w')))\n    assert not a1.isId, ('assertFalse', a1.isId)\n    assert a2.isId, ('assertTrue', a2.isId)\n    assert not a3.isId, ('assertFalse', a3.isId)\n    assert doc.getElementById('v') is None, ('assertIsNone', doc.getElementById('v'))\n    doc.renameNode(a2, xml.dom.EMPTY_NAMESPACE, 'an')\n    confirm(e.isSameNode(doc.getElementById('w')) and a2.isId)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
