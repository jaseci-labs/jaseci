sion=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?><foo>\\xe2\\x82\\xac</foo>', ('assertEqual', doc.toxml('utf-8', True), b'<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?><foo>\\xe2\\x82\\xac</foo>')\n    doc.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
