}

test "TestParseNumber.test_parse_num_ok" {
    (ok, detail) = p2_libtest_run_snippet("from optparse import make_option, Option, TitledHelpFormatter, OptionParser, OptionGroup, SUPPRESS_USAGE, OptionError, OptionConflictError, BadOptionError, OptionValueError, Values\nfrom optparse import _parse_num\n\nclass InterceptingOptionParser(OptionParser):\n\n    def exit(self, status=0, msg=None):\n        raise InterceptedError(exit_status=status, exit_message=msg)\n\n    def error(self, msg):\n        raise InterceptedError(error_message=msg)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.parser = InterceptingOptionParser()\n    self.parser.add_option('-n', type=int)\n    self.parser.add_option('-l', type=int)\n    assert _parse_num('0', int) == 0, ('assertEqual', _parse_num('0', int), 0)\n    assert _parse_num('0x10', int) == 16, ('assertEqual', _parse_num('0x10', int), 16)\n    assert _parse_num('0XA', int) == 10, ('assertEqual', _parse_num('0XA', int), 10)\n    assert _parse_num('010', int) == 8, ('assertEqual', _parse_num('010', int), 8)\n    assert _parse_num('0b11', int) == 3, ('assertEqual', _parse_num('0b11', int), 3)\n    assert _parse_num('0b', int) == 0, ('assertEqual', _parse_num('0b', int), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "MiscTestCase.test_lazy_import" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import ensure_lazy_imports\n\ndef _t():\n    ensure_lazy_imports('optparse', {'textwrap'})\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
