test "DisTests.test_string_without_quotes" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport io\nimport pickletools\n\ndef check_dis_error(data, expected, expected_error, **kwargs):\n    out = io.StringIO()\n    try:\n        pickletools.dis(data, out=out, **kwargs)\n    except ValueError as _exc:\n        assert _re.search(expected_error, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert out.getvalue() == expected, ('assertEqual', out.getvalue(), expected)\n\ndef _t():\n    check_dis_error(b\"Sabc'\\n.\", '', 'no string quotes around b\"abc\\'\"')\n    check_dis_error(b'Sabc\"\\n.', '', 'no string quotes around b\\'abc\"\\'')\n    check_dis_error(b\"S'abc\\n.\", '', 'string quote b\"\\'\" not found at both ends of b\"\\'abc\"')\n    check_dis_error(b'S\"abc\\n.', '', 'string quote b\\'\"\\' not found at both ends of b\\'\"abc\\'')\n    check_dis_error(b'S\\'abc\"\\n.', '', 'string quote b\"\\'\" not found at both ends of b\\'\\\\\\\\\\'abc\"\\'')\n    check_dis_error(b'S\"abc\\'\\n.', '', 'string quote b\\'\"\\' not found at both ends of b\\'\"abc\\\\\\\\\\'\\'')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

