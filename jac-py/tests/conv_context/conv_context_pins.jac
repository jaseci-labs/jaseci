    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ContextTest.test_token_contextmanager_without_default" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport contextvars\nimport functools\n\ndef isolated_context(func):\n    \"\"\"Needed to make reftracking test mode work.\"\"\"\n\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        ctx = contextvars.Context()\n        return ctx.run(func, *args, **kwargs)\n    return wrapper\n\ndef _t():\n    ctx = contextvars.Context()\n    c = contextvars.ContextVar('c')\n\n    def fun():\n        with c.set(36):\n            assert c.get() == 36, ('assertEqual', c.get(), 36)\n        try:\n            c.get()\n        except LookupError as _exc:\n            assert _re.search(\"<ContextVar name='c'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n    ctx.run(fun)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ContextTest.test_token_contextmanager_on_exception" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport contextvars\nimport functools\n\ndef isolated_context(func):\n    \"\"\"Needed to make reftracking test mode work.\"\"\"\n\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        ctx = contextvars.Context()\n        return ctx.run(func, *args, **kwargs)\n    return wrapper\n\ndef _t():\n    ctx = contextvars.Context()\n    c = contextvars.ContextVar('c', default=42)\n\n    def fun():\n        with c.set(36):\n            assert c.get() == 36, ('assertEqual', c.get(), 36)\n            raise ValueError('custom exception')\n        assert c.get() == 42, ('assertEqual', c.get(), 42)\n    try:\n        ctx.run(fun)\n    except ValueError as _exc:\n        assert _re.search('custom exception', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ContextTest.test_token_contextmanager_multiple_c_set" {
    (ok, detail) = p2_libtest_run_snippet("import contextvars\nimport functools\n\ndef isolated_context(func):\n    \"\"\"Needed to make reftracking test mode work.\"\"\"\n\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        ctx = contextvars.Context()\n        return ctx.run(func, *args, **kwargs)\n    return wrapper\n\ndef _t():\n    ctx = contextvars.Context()\n    c = contextvars.ContextVar('c', default=42)\n\n    def fun():\n        with c.set(36):\n            assert c.get() == 36, ('assertEqual', c.get(), 36)\n            c.set(24)\n            assert c.get() == 24, ('assertEqual', c.get(), 24)\n            c.set(12)\n            assert c.get() == 12, ('assertEqual', c.get(), 12)\n        assert c.get() == 42, ('assertEqual', c.get(), 42)\n    ctx.run(fun)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ContextTest.test_token_contextmanager_with_explicit_reset_another_token" {
    (ok, detail) = p2_libtest_run_snippet("import contextvars\nimport functools\n\ndef isolated_context(func):\n    \"\"\"Needed to make reftracking test mode work.\"\"\"\n\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        ctx = contextvars.Context()\n        return ctx.run(func, *args, **kwargs)\n    return wrapper\n\ndef _t():\n    ctx = contextvars.Context()\n    c = contextvars.ContextVar('c', default=42)\n\n    def fun():\n        with c.set(36):\n            assert c.get() == 36, ('assertEqual', c.get(), 36)\n            token = c.set(24)\n            assert c.get() == 24, ('assertEqual', c.get(), 24)\n            c.reset(token)\n            assert c.get() == 36, ('assertEqual', c.get(), 36)\n        assert c.get() == 42, ('assertEqual', c.get(), 42)\n    ctx.run(fun)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ContextTest.test_context_eq_reentrant_contextvar_set" {
    (ok, detail) = p2_libtest_run_snippet("import contextvars\n\ndef _t():\n    var = contextvars.ContextVar('v')\n    ctx1 = contextvars.Context()\n    ctx2 = contextvars.Context()\n\n    class ReentrantEq:\n\n        def __eq__(self, other):\n            ctx1.run(lambda: var.set(object()))\n            return True\n    ctx1.run(var.set, ReentrantEq())\n    ctx2.run(var.set, object())\n    ctx1 == ctx2\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ContextTest.test_context_eq_reentrant_contextvar_set_in_hash" {
    (ok, detail) = p2_libtest_run_snippet("import contextvars\n\ndef _t():\n    var = contextvars.ContextVar('v')\n    ctx1 = contextvars.Context()\n    ctx2 = contextvars.Context()\n\n    class ReentrantHash:\n\n        def __hash__(self):\n            ctx1.run(lambda: var.set(object()))\n            return 0\n\n        def __eq__(self, other):\n            return isinstance(other, ReentrantHash)\n    ctx1.run(var.set, ReentrantHash())\n    ctx2.run(var.set, ReentrantHash())\n    ctx1 == ctx2\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
