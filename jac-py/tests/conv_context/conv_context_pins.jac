test "ContextTest.test_context_run_2" {
    (ok, detail) = p2_libtest_run_snippet("import contextvars\nimport functools\n\ndef isolated_context(func):\n    \"\"\"Needed to make reftracking test mode work.\"\"\"\n\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        ctx = contextvars.Context()\n        return ctx.run(func, *args, **kwargs)\n    return wrapper\n\ndef _t():\n    ctx = contextvars.Context()\n\n    def func(*args, **kwargs):\n        kwargs['spam'] = 'foo'\n        args += ('bar',)\n        return (args, kwargs)\n    for f in (func, functools.partial(func)):\n        assert ctx.run(f) == (('bar',), {'spam': 'foo'}), ('assertEqual', ctx.run(f), (('bar',), {'spam': 'foo'}))\n        assert ctx.run(f, 1) == ((1, 'bar'), {'spam': 'foo'}), ('assertEqual', ctx.run(f, 1), ((1, 'bar'), {'spam': 'foo'}))\n        assert ctx.run(f, a=2) == (('bar',), {'a': 2, 'spam': 'foo'}), ('assertEqual', ctx.run(f, a=2), (('bar',), {'a': 2, 'spam': 'foo'}))\n        assert ctx.run(f, 11, a=2) == ((11, 'bar'), {'a': 2, 'spam': 'foo'}), ('assertEqual', ctx.run(f, 11, a=2), ((11, 'bar'), {'a': 2, 'spam': 'foo'}))\n        a = {}\n        assert ctx.run(f, 11, **a) == ((11, 'bar'), {'spam': 'foo'}), ('assertEqual', ctx.run(f, 11, **a), ((11, 'bar'), {'spam': 'foo'}))\n        assert a == {}, ('assertEqual', a, {})\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

