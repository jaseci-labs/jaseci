test "ContextTest.test_context_copy_1" {
    (ok, detail) = p2_libtest_run_snippet("import contextvars\n\ndef _t():\n    ctx1 = contextvars.Context()\n    c = contextvars.ContextVar('c', default=42)\n\n    def ctx1_fun():\n        c.set(10)\n        ctx2 = ctx1.copy()\n        assert ctx2[c] == 10, ('assertEqual', ctx2[c], 10)\n        c.set(20)\n        assert ctx1[c] == 20, ('assertEqual', ctx1[c], 20)\n        assert ctx2[c] == 10, ('assertEqual', ctx2[c], 10)\n        ctx2.run(ctx2_fun)\n        assert ctx1[c] == 20, ('assertEqual', ctx1[c], 20)\n        assert ctx2[c] == 30, ('assertEqual', ctx2[c], 30)\n\n    def ctx2_fun():\n        assert c.get() == 10, ('assertEqual', c.get(), 10)\n        c.set(30)\n        assert c.get() == 30, ('assertEqual', c.get(), 30)\n    ctx1.run(ctx1_fun)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ContextTest.test_context_isinstance" {
    (ok, detail) = p2_libtest_run_snippet("import collections.abc\nimport contextvars\nimport functools\n\ndef isolated_context(func):\n    \"\"\"Needed to make reftracking test mode work.\"\"\"\n\n    @functools.wraps(func)\n    def wrapper(*args, **kwargs):\n        ctx = contextvars.Context()\n        return ctx.run(func, *args, **kwargs)\n    return wrapper\n\ndef _t():\n    ctx = contextvars.Context()\n    assert isinstance(ctx, collections.abc.Mapping), ('assertIsInstance', ctx, collections.abc.Mapping)\n    assert issubclass(contextvars.Context, collections.abc.Mapping), ('assertTrue', issubclass(contextvars.Context, collections.abc.Mapping))\n    mapping_methods = ('__contains__', '__eq__', '__getitem__', '__iter__', '__len__', '__ne__', 'get', 'items', 'keys', 'values')\n    for name in mapping_methods:\n        assert callable(getattr(ctx, name)), ('assertTrue', callable(getattr(ctx, name)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

