test "ContextTest.test_context_getset_1" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport contextvars\n\ndef _t():\n    c = contextvars.ContextVar('c')\n    try:\n        c.get()\n    except LookupError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert c.get(None) is None, ('assertIsNone', c.get(None))\n    t0 = c.set(42)\n    assert c.get() == 42, ('assertEqual', c.get(), 42)\n    assert c.get(None) == 42, ('assertEqual', c.get(None), 42)\n    assert t0.old_value is t0.MISSING, ('assertIs', t0.old_value, t0.MISSING)\n    assert t0.old_value is contextvars.Token.MISSING, ('assertIs', t0.old_value, contextvars.Token.MISSING)\n    assert t0.var is c, ('assertIs', t0.var, c)\n    t = c.set('spam')\n    assert c.get() == 'spam', ('assertEqual', c.get(), 'spam')\n    assert c.get(None) == 'spam', ('assertEqual', c.get(None), 'spam')\n    assert t.old_value == 42, ('assertEqual', t.old_value, 42)\n    c.reset(t)\n    assert c.get() == 42, ('assertEqual', c.get(), 42)\n    assert c.get(None) == 42, ('assertEqual', c.get(None), 42)\n    c.set('spam2')\n    try:\n        c.reset(t)\n    except RuntimeError as _exc:\n        assert _re.search('has already been used', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert c.get() == 'spam2', ('assertEqual', c.get(), 'spam2')\n    ctx1 = contextvars.copy_context()\n    assert c in ctx1, ('assertIn', c, ctx1)\n    c.reset(t0)\n    try:\n        c.reset(t0)\n    except RuntimeError as _exc:\n        assert _re.search('has already been used', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert c.get(None) is None, ('assertIsNone', c.get(None))\n    assert c in ctx1, ('assertIn', c, ctx1)\n    assert ctx1[c] == 'spam2', ('assertEqual', ctx1[c], 'spam2')\n    assert ctx1.get(c, 'aa') == 'spam2', ('assertEqual', ctx1.get(c, 'aa'), 'spam2')\n    assert len(ctx1) == 1, ('assertEqual', len(ctx1), 1)\n    assert list(ctx1.items()) == [(c, 'spam2')], ('assertEqual', list(ctx1.items()), [(c, 'spam2')])\n    assert list(ctx1.values()) == ['spam2'], ('assertEqual', list(ctx1.values()), ['spam2'])\n    assert list(ctx1.keys()) == [c], ('assertEqual', list(ctx1.keys()), [c])\n    assert list(ctx1) == [c], ('assertEqual', list(ctx1), [c])\n    ctx2 = contextvars.copy_context()\n    assert c not in ctx2, ('assertNotIn', c, ctx2)\n    try:\n        ctx2[c]\n    except KeyError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert ctx2.get(c, 'aa') == 'aa', ('assertEqual', ctx2.get(c, 'aa'), 'aa')\n    assert len(ctx2) == 0, ('assertEqual', len(ctx2), 0)\n    assert list(ctx2) == [], ('assertEqual', list(ctx2), [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

