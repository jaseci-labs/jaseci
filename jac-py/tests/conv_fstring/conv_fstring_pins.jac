test "TestCase.test_syntax_error_for_starred_expressions" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n    try:\n        compile(\"f'{*a}'\", '?', 'exec')\n    except SyntaxError as _exc:\n        assert _re.search(\"can't use starred expression here\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        compile(\"f'{**a}'\", '?', 'exec')\n    except SyntaxError as _exc:\n        assert _re.search(\"f-string: expecting a valid expression after '{'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_debug_in_file" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.os_helper import temp_cwd\nfrom test.support.script_helper import assert_python_failure, assert_python_ok\n\ndef _t():\n    with temp_cwd():\n        script = 'script.py'\n        with open('script.py', 'w') as f:\n            f.write(f\"print(f'''{{\\n3\\n=}}''')\")\n        _, stdout, _ = assert_python_ok(script)\n    assert stdout.decode('utf-8').strip().replace('\\r\\n', '\\n').replace('\\r', '\\n') == '3\\n=3', ('assertEqual', stdout.decode('utf-8').strip().replace('\\r\\n', '\\n').replace('\\r', '\\n'), '3\\n=3')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_syntax_warning_infinite_recursion_in_file" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.os_helper import temp_cwd\nfrom test.support.script_helper import assert_python_failure, assert_python_ok\n\ndef _t():\n    with temp_cwd():\n        script = 'script.py'\n        with open(script, 'w') as f:\n            f.write(\"print(f'\\\\{1}')\")\n        _, stdout, stderr = assert_python_ok(script)\n        assert b'\\\\1' in stdout, ('assertIn', b'\\\\1', stdout)\n        assert len(stderr.strip().splitlines()) == 2, ('assertEqual', len(stderr.strip().splitlines()), 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_fstring_without_formatting_bytecode" {
    (ok, detail) = p2_libtest_run_snippet("import dis\n\ndef _t():\n\n    def get_code(s):\n        return [(i.opname, i.oparg) for i in dis.get_instructions(s)]\n    for s in ['', 'some string']:\n        assert get_code(f\"'{s}'\") == get_code(f\"f'{s}'\"), ('assertEqual', get_code(f\"'{s}'\"), get_code(f\"f'{s}'\"))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_gh129093" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    assert f'1==2={1 == 2!r}' == '1==2=False', ('assertEqual', f'1==2={1 == 2!r}', '1==2=False')\n    assert f'1 == 2={1 == 2!r}' == '1 == 2=False', ('assertEqual', f'1 == 2={1 == 2!r}', '1 == 2=False')\n    assert f'1!=2={1 != 2!r}' == '1!=2=True', ('assertEqual', f'1!=2={1 != 2!r}', '1!=2=True')\n    assert f'1 != 2={1 != 2!r}' == '1 != 2=True', ('assertEqual', f'1 != 2={1 != 2!r}', '1 != 2=True')\n    assert f'(1) != 2={1 != 2!r}' == '(1) != 2=True', ('assertEqual', f'(1) != 2={1 != 2!r}', '(1) != 2=True')\n    assert f'(1*2) != (3)={1 * 2 != 3!r}' == '(1*2) != (3)=True', ('assertEqual', f'(1*2) != (3)={1 * 2 != 3!r}', '(1*2) != (3)=True')\n    assert f'1 != 2 == 3 != 4={1 != 2 == 3 != 4!r}' == '1 != 2 == 3 != 4=False', ('assertEqual', f'1 != 2 == 3 != 4={1 != 2 == 3 != 4!r}', '1 != 2 == 3 != 4=False')\n    assert f'1 == 2 != 3 == 4={1 == 2 != 3 == 4!r}' == '1 == 2 != 3 == 4=False', ('assertEqual', f'1 == 2 != 3 == 4={1 == 2 != 3 == 4!r}', '1 == 2 != 3 == 4=False')\n    assert f\"f'{{1==2=}}'={f'1==2={1 == 2!r}'!r}\" == \"f'{1==2=}'='1==2=False'\", ('assertEqual', f\"f'{{1==2=}}'={f'1==2={1 == 2!r}'!r}\", \"f'{1==2=}'='1==2=False'\")\n    assert f\"f'{{1 == 2=}}'={f'1 == 2={1 == 2!r}'!r}\" == \"f'{1 == 2=}'='1 == 2=False'\", ('assertEqual', f\"f'{{1 == 2=}}'={f'1 == 2={1 == 2!r}'!r}\", \"f'{1 == 2=}'='1 == 2=False'\")\n    assert f\"f'{{1!=2=}}'={f'1!=2={1 != 2!r}'!r}\" == \"f'{1!=2=}'='1!=2=True'\", ('assertEqual', f\"f'{{1!=2=}}'={f'1!=2={1 != 2!r}'!r}\", \"f'{1!=2=}'='1!=2=True'\")\n    assert f\"f'{{1 != 2=}}'={f'1 != 2={1 != 2!r}'!r}\" == \"f'{1 != 2=}'='1 != 2=True'\", ('assertEqual', f\"f'{{1 != 2=}}'={f'1 != 2={1 != 2!r}'!r}\", \"f'{1 != 2=}'='1 != 2=True'\")\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_raw_fstring_format_spec" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class UnchangedFormat:\n        \"\"\"Test helper that returns the format spec unchanged.\"\"\"\n\n        def __format__(self, format):\n            return format\n    assert f'{UnchangedFormat():\u00ff}' == '\u00ff', ('assertEqual', f'{UnchangedFormat():\u00ff}', '\u00ff')\n    assert f'{UnchangedFormat():\\\\xFF}' == '\\\\xFF', ('assertEqual', f'{UnchangedFormat():\\\\xFF}', '\\\\xFF')\n    assert f\"{UnchangedFormat():{'\u00ff'}}\" == '\u00ff', ('assertEqual', f\"{UnchangedFormat():{'\u00ff'}}\", '\u00ff')\n    assert f\"{UnchangedFormat():{'\\\\xFF'}}\" == '\\\\xFF', ('assertEqual', f\"{UnchangedFormat():{'\\\\xFF'}}\", '\\\\xFF')\n    assert f\"{UnchangedFormat():{'\\\\xFF'}}\" == '\\\\xFF', ('assertEqual', f\"{UnchangedFormat():{'\\\\xFF'}}\", '\\\\xFF')\n    assert f\"{UnchangedFormat():{'ab'}}\" == 'ab', ('assertEqual', f\"{UnchangedFormat():{'ab'}}\", 'ab')\n    assert f\"{UnchangedFormat():{'ab'}}\" == 'ab', ('assertEqual', f\"{UnchangedFormat():{'ab'}}\", 'ab')\n    assert f'{UnchangedFormat():\\\\xFF} {UnchangedFormat():\\\\n}' == '\\\\xFF \\\\n', ('assertEqual', f'{UnchangedFormat():\\\\xFF} {UnchangedFormat():\\\\n}', '\\\\xFF \\\\n')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_gh139516" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.os_helper import temp_cwd\nfrom test.support.script_helper import assert_python_failure, assert_python_ok\n\ndef _t():\n    with temp_cwd():\n        script = 'script.py'\n        with open(script, 'wb') as f:\n            f.write('def f(a): pass\\nf\"{f(a=lambda: \\'\u00e0\\'\\n)}\"'.encode())\n        assert_python_ok(script)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
