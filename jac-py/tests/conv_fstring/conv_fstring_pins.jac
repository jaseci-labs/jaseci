    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    expr = \"\\na = 10\\nf'{a * x()} {a * x()} {a * x()}'\\n\"\n    t = ast.parse(expr)\n    assert type(t) == ast.Module, ('assertEqual', type(t), ast.Module)\n    assert len(t.body) == 2, ('assertEqual', len(t.body), 2)\n    assert type(t.body[0]) == ast.Assign, ('assertEqual', type(t.body[0]), ast.Assign)\n    assert t.body[0].lineno == 2, ('assertEqual', t.body[0].lineno, 2)\n    assert type(t.body[1]) == ast.Expr, ('assertEqual', type(t.body[1]), ast.Expr)\n    assert type(t.body[1].value) == ast.JoinedStr, ('assertEqual', type(t.body[1].value), ast.JoinedStr)\n    assert len(t.body[1].value.values) == 5, ('assertEqual', len(t.body[1].value.values), 5)\n    assert type(t.body[1].value.values[0]) == ast.FormattedValue, ('assertEqual', type(t.body[1].value.values[0]), ast.FormattedValue)\n    assert type(t.body[1].value.values[1]) == ast.Constant, ('assertEqual', type(t.body[1].value.values[1]), ast.Constant)\n    assert type(t.body[1].value.values[1].value) == str, ('assertEqual', type(t.body[1].value.values[1].value), str)\n    assert type(t.body[1].value.values[2]) == ast.FormattedValue, ('assertEqual', type(t.body[1].value.values[2]), ast.FormattedValue)\n    assert type(t.body[1].value.values[3]) == ast.Constant, ('assertEqual', type(t.body[1].value.values[3]), ast.Constant)\n    assert type(t.body[1].value.values[3].value) == str, ('assertEqual', type(t.body[1].value.values[3].value), str)\n    assert type(t.body[1].value.values[4]) == ast.FormattedValue, ('assertEqual', type(t.body[1].value.values[4]), ast.FormattedValue)\n    assert t.body[1].lineno == 3, ('assertEqual', t.body[1].lineno, 3)\n    assert t.body[1].value.lineno == 3, ('assertEqual', t.body[1].value.lineno, 3)\n    assert t.body[1].value.values[0].lineno == 3, ('assertEqual', t.body[1].value.values[0].lineno, 3)\n    assert t.body[1].value.values[1].lineno == 3, ('assertEqual', t.body[1].value.values[1].lineno, 3)\n    assert t.body[1].value.values[2].lineno == 3, ('assertEqual', t.body[1].value.values[2].lineno, 3)\n    assert t.body[1].value.values[3].lineno == 3, ('assertEqual', t.body[1].value.values[3].lineno, 3)\n    assert t.body[1].value.values[4].lineno == 3, ('assertEqual', t.body[1].value.values[4].lineno, 3)\n    binop = t.body[1].value.values[0].value\n    assert type(binop) == ast.BinOp, ('assertEqual', type(binop), ast.BinOp)\n    assert type(binop.left) == ast.Name, ('assertEqual', type(binop.left), ast.Name)\n    assert type(binop.op) == ast.Mult, ('assertEqual', type(binop.op), ast.Mult)\n    assert type(binop.right) == ast.Call, ('assertEqual', type(binop.right), ast.Call)\n    assert binop.lineno == 3, ('assertEqual', binop.lineno, 3)\n    assert binop.left.lineno == 3, ('assertEqual', binop.left.lineno, 3)\n    assert binop.right.lineno == 3, ('assertEqual', binop.right.lineno, 3)\n    assert binop.col_offset == 3, ('assertEqual', binop.col_offset, 3)\n    assert binop.left.col_offset == 3, ('assertEqual', binop.left.col_offset, 3)\n    assert binop.right.col_offset == 7, ('assertEqual', binop.right.col_offset, 7)\n    binop = t.body[1].value.values[2].value\n    assert type(binop) == ast.BinOp, ('assertEqual', type(binop), ast.BinOp)\n    assert type(binop.left) == ast.Name, ('assertEqual', type(binop.left), ast.Name)\n    assert type(binop.op) == ast.Mult, ('assertEqual', type(binop.op), ast.Mult)\n    assert type(binop.right) == ast.Call, ('assertEqual', type(binop.right), ast.Call)\n    assert binop.lineno == 3, ('assertEqual', binop.lineno, 3)\n    assert binop.left.lineno == 3, ('assertEqual', binop.left.lineno, 3)\n    assert binop.right.lineno == 3, ('assertEqual', binop.right.lineno, 3)\n    assert binop.col_offset == 13, ('assertEqual', binop.col_offset, 13)\n    assert binop.left.col_offset == 13, ('assertEqual', binop.left.col_offset, 13)\n    assert binop.right.col_offset == 17, ('assertEqual', binop.right.col_offset, 17)\n    binop = t.body[1].value.v