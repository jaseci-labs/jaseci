test "TestCase.test_debug_conversion" {
    (ok, detail) = p2_libtest_run_snippet("import datetime\n\ndef _t():\n    x = 'A string'\n    assert f'x={x!r}' == 'x=' + repr(x), ('assertEqual', f'x={x!r}', 'x=' + repr(x))\n    assert f'x ={x!r}' == 'x =' + repr(x), ('assertEqual', f'x ={x!r}', 'x =' + repr(x))\n    assert f'x={x!s}' == 'x=' + str(x), ('assertEqual', f'x={x!s}', 'x=' + str(x))\n    assert f'x={x!r}' == 'x=' + repr(x), ('assertEqual', f'x={x!r}', 'x=' + repr(x))\n    assert f'x={x!a}' == 'x=' + ascii(x), ('assertEqual', f'x={x!a}', 'x=' + ascii(x))\n    x = 2.71828\n    assert f'x={x:.2f}' == 'x=' + format(x, '.2f'), ('assertEqual', f'x={x:.2f}', 'x=' + format(x, '.2f'))\n    assert f'x={x:}' == 'x=' + format(x, ''), ('assertEqual', f'x={x:}', 'x=' + format(x, ''))\n    assert f'x={x!r:^20}' == 'x=' + format(repr(x), '^20'), ('assertEqual', f'x={x!r:^20}', 'x=' + format(repr(x), '^20'))\n    assert f'x={x!s:^20}' == 'x=' + format(str(x), '^20'), ('assertEqual', f'x={x!s:^20}', 'x=' + format(str(x), '^20'))\n    assert f'x={x!a:^20}' == 'x=' + format(ascii(x), '^20'), ('assertEqual', f'x={x!a:^20}', 'x=' + format(ascii(x), '^20'))\n    x = 9\n    assert f'3*x+15={3 * x + 15!r}' == '3*x+15=42', ('assertEqual', f'3*x+15={3 * x + 15!r}', '3*x+15=42')\n    ten\u03c0 = 31.4\n    assert f'ten\u03c0={ten\u03c0:.2f}' == 'ten\u03c0=31.40', ('assertEqual', f'ten\u03c0={ten\u03c0:.2f}', 'ten\u03c0=31.40')\n    assert f\"\"\"\"\u03a3\"={'\u03a3'!r}\"\"\" == '\"\u03a3\"=\\'\u03a3\\'', ('assertEqual', f\"\"\"\"\u03a3\"={'\u03a3'!r}\"\"\", '\"\u03a3\"=\\'\u03a3\\'')\n    assert f\"{f'3.1415={3.1415:.1f}':*^20}\" == '*****3.1415=3.1*****', ('assertEqual', f\"{f'3.1415={3.1415:.1f}':*^20}\", '*****3.1415=3.1*****')\n    pi = '\u03c0'\n    assert f'alpha \u03b1 pi={pi!r} \u03c9 omega' == \"alpha \u03b1 pi='\u03c0' \u03c9 omega\", ('assertEqual', f'alpha \u03b1 pi={pi!r} \u03c9 omega', \"alpha \u03b1 pi='\u03c0' \u03c9 omega\")\n    assert f'\\n3\\n={3!r}' == '\\n3\\n=3', ('assertEqual', f'\\n3\\n={3!r}', '\\n3\\n=3')\n    assert f'{0 == 1}' == 'False', ('assertEqual', f'{0 == 1}', 'False')\n    assert f'{0 != 1}' == 'True', ('assertEqual', f'{0 != 1}', 'True')\n    assert f'{0 <= 1}' == 'True', ('assertEqual', f'{0 <= 1}', 'True')\n    assert f'{0 >= 1}' == 'False', ('assertEqual', f'{0 >= 1}', 'False')\n    assert f\"{(x := '5')}\" == '5', ('assertEqual', f\"{(x := '5')}\", '5')\n    assert x == '5', ('assertEqual', x, '5')\n    assert f'{(x := 5)}' == '5', ('assertEqual', f'{(x := 5)}', '5')\n    assert x == 5, ('assertEqual', x, 5)\n    assert f\"{'='}\" == '=', ('assertEqual', f\"{'='}\", '=')\n    x = 20\n    assert f'{x:=10}' == '        20', ('assertEqual', f'{x:=10}', '        20')\n\n    def f(a):\n        nonlocal x\n        oldx = x\n        x = a\n        return oldx\n    x = 0\n    assert f\"{f(a='3=')}\" == '0', ('assertEqual', f\"{f(a='3=')}\", '0')\n    assert x == '3=', ('assertEqual', x, '3=')\n    assert f'{f(a=4)}' == '3=', ('assertEqual', f'{f(a=4)}', '3=')\n    assert x == 4, ('assertEqual', x, 4)\n    y = 20\n    assert f'{2:y={y!r}}' == 'yyyyyyyyyyyyyyyyyyy2', ('assertEqual', f'{2:y={y!r}}', 'yyyyyyyyyyyyyyyyyyy2')\n    assert f'{datetime.datetime.now():h1y={y!r}h2y={y!r}h3y={y!r}}' == 'h1y=20h2y=20h3y=20', ('assertEqual', f'{datetime.datetime.now():h1y={y!r}h2y={y!r}h3y={y!r}}', 'h1y=20h2y=20h3y=20')\n\n    class C:\n\n        def __format__(self, s):\n            return f'FORMAT-{s}'\n\n        def __repr__(self):\n            return 'REPR'\n    assert f'C()={C()!r}' == 'C()=REPR', ('assertEqual', f'C()={C()!r}', 'C()=REPR')\n    assert f'C()={C()!r}' == 'C()=REPR', ('assertEqual', f'C()={C()!r}', 'C()=REPR')\n    assert f'C()={C():}' == 'C()=FORMAT-', ('assertEqual', f'C()={C():}', 'C()=FORMAT-')\n    assert f'C()={C(): }' == 'C()=FORMAT- ', ('assertEqual', f'C()={C(): }', 'C()=FORMAT- ')\n    assert f'C()={C():x}' == 'C()=FORMAT-x', ('assertEqual', f'C()={C():x}', 'C()=FORMAT-x')\n    assert f'C()={C()!r:*^20}' == 'C()=********REPR********', ('assertEqual', f'C()={C()!r:*^20}', 'C()=********REPR********')\n    assert f'{C():20={20!r}}' == 'FORMAT-20=20', ('assertEqual', f'{C():20={20!r}}', 'FORMAT-20=20')\n    try:\n        eval(*(\"f'{C=]'\",))\n    except SyntaxError:\n        pass\n    x = 'foo'\n    assert f'Xx={x!r}Y' == 'Xx=' + repr(x) + 'Y', ('assertEqual', f'Xx={x!r}Y', 'Xx=' + repr(x) + 'Y')\n    assert f'Xx  ={x!r}Y' == 'Xx  =' + repr(x) + 'Y', ('assertEqual', f'Xx  ={x!r}Y', 'Xx  =' + repr(x) + 'Y')\n    assert f'Xx=  {x!r}Y' == 'Xx=  ' + repr(x) + 'Y', ('assertEqual', f'Xx=  {x!r}Y', 'Xx=  ' + repr(x) + 'Y')\n    assert f'Xx  =  {x!r}Y' == 'Xx  =  ' + repr(x) + 'Y', ('assertEqual', f'Xx  =  {x!r}Y', 'Xx  =  ' + repr(x) + 'Y')\n    assert f'sadsd 1 + 1 =  {1 + 1:{1 + 1:1d}f}' == 'sadsd 1 + 1 =  2.000000', ('assertEqual', f'sadsd 1 + 1 =  {1 + 1:{1 + 1:1d}f}', 'sadsd 1 + 1 =  2.000000')\n    assert f'1+2 = \\n  {1 + 2!r}' == '1+2 = \\n  3', ('assertEqual', f'1+2 = \\n  {1 + 2!r}', '1+2 = \\n  3')\n    assert f'''\"\"\" # booo\\n  \"\"\"={' # booo\\n  '!r}''' == '\"\"\" # booo\\n  \"\"\"=\\' # booo\\\\n  \\'', ('assertEqual', f'''\"\"\" # booo\\n  \"\"\"={' # booo\\n  '!r}''', '\"\"\" # booo\\n  \"\"\"=\\' # booo\\\\n  \\'')\n    assert f\"\"\"\" # nooo \"={' # nooo '!r}\"\"\" == '\" # nooo \"=\\' # nooo \\'', ('assertEqual', f\"\"\"\" # nooo \"={' # nooo '!r}\"\"\", '\" # nooo \"=\\' # nooo \\'')\n    assert f\"\"\"\" \\\\\" # nooo \\\\\" \"={' \" # nooo \" '!r}\"\"\" == '\" \\\\\" # nooo \\\\\" \"=\\' \" # nooo \" \\'', ('assertEqual', f\"\"\"\" \\\\\" # nooo \\\\\" \"={' \" # nooo \" '!r}\"\"\", '\" \\\\\" # nooo \\\\\" \"=\\' \" # nooo \" \\'')\n    assert f''' \\n  \"\"\"hello\"\"\"={'hello'!r}''' == ' \\n  \"\"\"hello\"\"\"=\\'hello\\'', ('assertEqual', f''' \\n  \"\"\"hello\"\"\"={'hello'!r}''', ' \\n  \"\"\"hello\"\"\"=\\'hello\\'')\n    assert f\"{'# this is not a comment\\n        a'}\" == '# this is not a comment\\n        a', ('assertEqual', f\"{'# this is not a comment\\n        a'}\", '# this is not a comment\\n        a')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_debug_expressions_are_raw_strings" {
    (ok, detail) = p2_libtest_run_snippet("import warnings\n\ndef _t():\n    with warnings.catch_warnings():\n        warnings.simplefilter('ignore', SyntaxWarning)\n        assert eval('f\\'{b\"\\\\N{OX}\"=}\\'') == 'b\"\\\\N{OX}\"=b\\'\\\\\\\\N{OX}\\'', ('assertEqual', eval('f\\'{b\"\\\\N{OX}\"=}\\''), 'b\"\\\\N{OX}\"=b\\'\\\\\\\\N{OX}\\'')\n    assert f\"\"\"r\"\\\\xff\"={'\\\\xff'!r}\"\"\" == 'r\"\\\\xff\"=\\'\\\\\\\\xff\\'', ('assertEqual', f\"\"\"r\"\\\\xff\"={'\\\\xff'!r}\"\"\", 'r\"\\\\xff\"=\\'\\\\\\\\xff\\'')\n    assert f\"\"\"r\"\\\\n\"={'\\\\n'!r}\"\"\" == 'r\"\\\\n\"=\\'\\\\\\\\n\\'', ('assertEqual', f\"\"\"r\"\\\\n\"={'\\\\n'!r}\"\"\", 'r\"\\\\n\"=\\'\\\\\\\\n\\'')\n    assert f\"\"\"'\\\\''={\"'\"!r}\"\"\" == '\\'\\\\\\'\\'=\"\\'\"', ('assertEqual', f\"\"\"'\\\\''={\"'\"!r}\"\"\", '\\'\\\\\\'\\'=\"\\'\"')\n    assert f\"'\\\\xc5'={'\u00c5'!r}\" == \"'\\\\xc5'='\u00c5'\", ('assertEqual', f\"'\\\\xc5'={'\u00c5'!r}\", \"'\\\\xc5'='\u00c5'\")\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_walrus" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    x = 20\n    assert f'{x:=10}' == '        20', ('assertEqual', f'{x:=10}', '        20')\n    assert f'{(x := 10)}' == '10', ('assertEqual', f'{(x := 10)}', '10')\n    assert x == 10, ('assertEqual', x, 10)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_invalid_syntax_error_message" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n    try:\n        compile(\"f'{a $ b}'\", '?', 'exec')\n    except SyntaxError as _exc:\n        assert _re.search(\"f-string: expecting '=', or '!', or ':', or '}'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_with_two_commas_in_format_specifier" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport re\n\ndef _t():\n    error_msg = re.escape(\"Cannot specify ',' with ','.\")\n    try:\n        f'{1:,,}'\n    except ValueError as _exc:\n        assert _re.search(error_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

