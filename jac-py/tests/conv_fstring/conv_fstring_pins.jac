    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_literal_eval" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport ast\n\ndef _t():\n    try:\n        ast.literal_eval(\"f'x'\")\n    except ValueError as _exc:\n        assert _re.search('malformed node or string', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_ast_compile_time_concat" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    x = ['']\n    expr = \"x[0] = 'foo' f'{3}'\"\n    t = ast.parse(expr)\n    c = compile(t, '', 'exec')\n    exec(c)\n    assert x[0] == 'foo3', ('assertEqual', x[0], 'foo3')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

