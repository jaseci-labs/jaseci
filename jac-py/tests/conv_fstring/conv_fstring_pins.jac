test "TestCase.test_ast_numbers_fstring_with_formatting" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    t = ast.parse('f\"Here is that pesky {xxx:.3f} again\"')\n    assert len(t.body) == 1, ('assertEqual', len(t.body), 1)\n    assert t.body[0].lineno == 1, ('assertEqual', t.body[0].lineno, 1)\n    assert type(t.body[0]) == ast.Expr, ('assertEqual', type(t.body[0]), ast.Expr)\n    assert type(t.body[0].value) == ast.JoinedStr, ('assertEqual', type(t.body[0].value), ast.JoinedStr)\n    assert len(t.body[0].value.values) == 3, ('assertEqual', len(t.body[0].value.values), 3)\n    assert type(t.body[0].value.values[0]) == ast.Constant, ('assertEqual', type(t.body[0].value.values[0]), ast.Constant)\n    assert type(t.body[0].value.values[1]) == ast.FormattedValue, ('assertEqual', type(t.body[0].value.values[1]), ast.FormattedValue)\n    assert type(t.body[0].value.values[2]) == ast.Constant, ('assertEqual', type(t.body[0].value.values[2]), ast.Constant)\n    _, expr, _ = t.body[0].value.values\n    name = expr.value\n    assert type(name) == ast.Name, ('assertEqual', type(name), ast.Name)\n    assert name.lineno == 1, ('assertEqual', name.lineno, 1)\n    assert name.end_lineno == 1, ('assertEqual', name.end_lineno, 1)\n    assert name.col_offset == 22, ('assertEqual', name.col_offset, 22)\n    assert name.end_col_offset == 25, ('assertEqual', name.end_col_offset, 25)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_ast_line_numbers_multiline_fstring" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    expr = \"\\na = 10\\nf'''\\n  {a\\n     *\\n       x()}\\nnon-important content\\n'''\\n\"\n    t = ast.parse(expr)\n    assert type(t) == ast.Module, ('assertEqual', type(t), ast.Module)\n    assert len(t.body) == 2, ('assertEqual', len(t.body), 2)\n    assert type(t.body[0]) == ast.Assign, ('assertEqual', type(t.body[0]), ast.Assign)\n    assert t.body[0].lineno == 2, ('assertEqual', t.body[0].lineno, 2)\n    assert type(t.body[1]) == ast.Expr, ('assertEqual', type(t.body[1]), ast.Expr)\n    assert type(t.body[1].value) == ast.JoinedStr, ('assertEqual', type(t.body[1].value), ast.JoinedStr)\n    assert len(t.body[1].value.values) == 3, ('assertEqual', len(t.body[1].value.values), 3)\n    assert type(t.body[1].value.values[0]) == ast.Constant, ('assertEqual', type(t.body[1].value.values[0]), ast.Constant)\n    assert type(t.body[1].value.values[0].value) == str, ('assertEqual', type(t.body[1].value.values[0].value), str)\n    assert type(t.body[1].value.values[1]) == ast.FormattedValue, ('assertEqual', type(t.body[1].value.values[1]), ast.FormattedValue)\n    assert type(t.body[1].value.values[2]) == ast.Constant, ('assertEqual', type(t.body[1].value.values[2]), ast.Constant)\n    assert type(t.body[1].value.values[2].value) == str, ('assertEqual', type(t.body[1].value.values[2].value), str)\n    assert t.body[1].lineno == 3, ('assertEqual', t.body[1].lineno, 3)\n    assert t.body[1].value.lineno == 3, ('assertEqual', t.body[1].value.lineno, 3)\n    assert t.body[1].value.values[0].lineno == 3, ('assertEqual', t.body[1].value.values[0].lineno, 3)\n    assert t.body[1].value.values[1].lineno == 4, ('assertEqual', t.body[1].value.values[1].lineno, 4)\n    assert t.body[1].value.values[2].lineno == 6, ('assertEqual', t.body[1].value.values[2].lineno, 6)\n    assert t.body[1].col_offset == 0, ('assertEqual', t.body[1].col_offset, 0)\n    assert t.body[1].value.col_offset == 0, ('assertEqual', t.body[1].value.col_offset, 0)\n    assert t.body[1].value.values[0].col_offset == 4, ('assertEqual', t.body[1].value.values[0].col_offset, 4)\n    assert t.body[1].value.values[1].col_offset == 2, ('assertEqual', t.body[1].value.values[1].col_offset, 2)\n    assert t.body[1].value.values[2].col_offset == 11, ('assertEqual', t.body[1].value.values[2].col_offset, 11)\n    binop = t.body[1].value.values[1].value\n    assert type(binop) == ast.BinOp, ('assertEqual', type(binop), ast.BinOp)\n    assert type(binop.left) == ast.Name, ('assertEqual', type(binop.left), ast.Name)\n    assert type(binop.op) == ast.Mult, ('assertEqual', type(binop.op), ast.Mult)\n    assert type(binop.right) == ast.Call, ('assertEqual', type(binop.right), ast.Call)\n    assert binop.lineno == 4, ('assertEqual', binop.lineno, 4)\n    assert binop.left.lineno == 4, ('assertEqual', binop.left.lineno, 4)\n    assert binop.right.lineno == 6, ('assertEqual', binop.right.lineno, 6)\n    assert binop.col_offset == 3, ('assertEqual', binop.col_offset, 3)\n    assert binop.left.col_offset == 3, ('assertEqual', binop.left.col_offset, 3)\n    assert binop.right.col_offset == 7, ('assertEqual', binop.right.col_offset, 7)\n    expr = \"\\na = f'''\\n          {blech}\\n    '''\\n\"\n    t = ast.parse(expr)\n    assert type(t) == ast.Module, ('assertEqual', type(t), ast.Module)\n    assert len(t.body) == 1, ('assertEqual', len(t.body), 1)\n    assert type(t.body[0]) == ast.Assign, ('assertEqual', type(t.body[0]), ast.Assign)\n    assert type(t.body[0].value) == ast.JoinedStr, ('assertEqual', type(t.body[0].value), ast.JoinedStr)\n    assert len(t.body[0].value.values) == 3, ('assertEqual', len(t.body[0].value.values), 3)\n    assert type(t.body[0].value.values[1]) == ast.FormattedValue, ('assertEqual', type(t.body[0].value.values[1]), ast.FormattedValue)\n    assert t.body[0].lineno == 2, ('assertEqual', t.body[0].lineno, 2)\n    assert t.body[0].value.lineno == 2, ('assertEqual', t.body[0].value.lineno, 2)\n    assert t.body[0].value.values[0].lineno == 2, ('assertEqual', t.body[0].value.values[0].lineno, 2)\n    assert t.body[0].value.values[1].lineno == 3, ('assertEqual', t.body[0].value.values[1].lineno, 3)\n    assert t.body[0].value.values[2].lineno == 3, ('assertEqual', t.body[0].value.values[2].lineno, 3)\n    assert t.body[0].col_offset == 0, ('assertEqual', t.body[0].col_offset, 0)\n    assert t.body[0].value.col_offset == 4, ('assertEqual', t.body[0].value.col_offset, 4)\n    assert t.body[0].value.values[0].col_offset == 8, ('assertEqual', t.body[0].value.values[0].col_offset, 8)\n    assert t.body[0].value.values[1].col_offset == 10, ('assertEqual', t.body[0].value.values[1].col_offset, 10)\n    assert t.body[0].value.values[2].col_offset == 17, ('assertEqual', t.body[0].value.values[2].col_offset, 17)\n    assert t.body[0].value.values[1].value.lineno == 3, ('assertEqual', t.body[0].value.values[1].value.lineno, 3)\n    assert t.body[0].value.values[1].value.end_lineno == 3, ('assertEqual', t.body[0].value.values[1].value.end_lineno, 3)\n    assert t.body[0].value.values[1].value.col_offset == 11, ('assertEqual', t.body[0].value.values[1].value.col_offset, 11)\n    assert t.body[0].value.values[1].value.end_col_offset == 16, ('assertEqual', t.body[0].value.values[1].value.end_col_offset, 16)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_ast_line_numbers_with_parentheses" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    expr = '\\nx = (\\n    f\" {test(t)}\"\\n)'\n    t = ast.parse(expr)\n    assert type(t) == ast.Module, ('assertEqual', type(t), ast.Module)\n    assert len(t.body) == 1, ('assertEqual', len(t.body), 1)\n    joinedstr = t.body[0].value\n    assert type(joinedstr) == ast.JoinedStr, ('assertEqual', type(joinedstr), ast.JoinedStr)\n    assert joinedstr.lineno == 3, ('assertEqual', joinedstr.lineno, 3)\n    assert joinedstr.end_lineno == 3, ('assertEqual', joinedstr.end_lineno, 3)\n    assert joinedstr.col_offset == 4, ('assertEqual', joinedstr.col_offset, 4)\n    assert joinedstr.end_col_offset == 17, ('assertEqual', joinedstr.end_col_offset, 17)\n    fv = t.body[0].value.values[1]\n    assert type(fv) == ast.FormattedValue, ('assertEqual', type(fv), ast.FormattedValue)\n    assert fv.lineno == 3, ('assertEqual', fv.lineno, 3)\n    assert fv.end_lineno == 3, ('assertEqual', fv.end_lineno, 3)\n    assert fv.col_offset == 7, ('assertEqual', fv.col_offset, 7)\n    assert fv.end_col_offset == 16, ('assertEqual', fv.end_col_offset, 16)\n    call = t.body[0].value.values[1].value\n    assert type(call) == ast.Call, ('assertEqual', type(call), ast.Call)\n    assert call.lineno == 3, ('assertEqual', call.lineno, 3)\n    assert call.end_lineno == 3, ('assertEqual', call.end_lineno, 3)\n    assert call.col_offset == 8, ('assertEqual', call.col_offset, 8)\n    assert call.end_col_offset == 15, ('assertEqual', call.end_col_offset, 15)\n    expr = '\\nx = (\\n    u\\'wat\\',\\n    u\"wat\",\\n    b\\'wat\\',\\n    b\"wat\",\\n    f\\'wat\\',\\n    f\"wat\",\\n)\\n\\ny = (\\n    u\\'\\'\\'wat\\'\\'\\',\\n    u\"\"\"wat\"\"\",\\n    b\\'\\'\\'wat\\'\\'\\',\\n    b\"\"\"wat\"\"\",\\n    f\\'\\'\\'wat\\'\\'\\',\\n    f\"\"\"wat\"\"\",\\n)\\n        '\n    t = ast.parse(expr)\n    assert type(t) == ast.Module, ('assertEqual', type(t), ast.Module)\n    assert len(t.body) == 2, ('assertEqual', len(t.body), 2)\n    x, y = t.body\n    offsets = [(elt.col_offset, elt.end_col_offset) for elt in x.value.elts]\n    assert all((offset == (4, 10) for offset in offsets)), ('assertTrue', all((offset == (4, 10) for offset in offsets)))\n    offsets = [(elt.col_offset, elt.end_col_offset) for elt in y.value.elts]\n    assert all((offset == (4, 14) for offset in offsets)), ('assertTrue', all((offset == (4, 14) for offset in offsets)))\n    expr = \"\\nx = (\\n        'PERL_MM_OPT', (\\n            f'wat'\\n            f'some_string={f(x)} '\\n            f'wat'\\n        ),\\n)\\n\"\n    t = ast.parse(expr)\n    assert type(t) == ast.Module, ('assertEqual', type(t), ast.Module)\n    assert len(t.body) == 1, ('assertEqual', len(t.body), 1)\n    fstring = t.body[0].value.elts[1]\n    assert type(fstring) == ast.JoinedStr, ('assertEqual', type(fstring), ast.JoinedStr)\n    assert len(fstring.values) == 3, ('assertEqual', len(fstring.values), 3)\n    wat1, middle, wat2 = fstring.values\n    assert type(wat1) == ast.Constant, ('assertEqual', type(wat1), ast.Constant)\n    assert wat1.lineno == 4, ('assertEqual', wat1.lineno, 4)\n    assert wat1.end_lineno == 5, ('assertEqual', wat1.end_lineno, 5)\n    assert wat1.col_offset == 14, ('assertEqual', wat1.col_offset, 14)\n    assert wat1.end_col_offset == 26, ('assertEqual', wat1.end_col_offset, 26)\n    call = middle.value\n    assert type(call) == ast.Call, ('assertEqual', type(call), ast.Call)\n    assert call.lineno == 5, ('assertEqual', call.lineno, 5)\n    assert call.end_lineno == 5, ('assertEqual', call.end_lineno, 5)\n    assert call.col_offset == 27, ('assertEqual', call.col_offset, 27)\n    assert call.end_col_offset == 31, ('assertEqual', call.end_col_offset, 31)\n    assert type(wat2) == ast.Constant, ('assertEqual', type(wat2), ast.Constant)\n    assert wat2.lineno == 5, ('assertEqual', wat2.lineno, 5)\n    assert wat2.end_lineno == 6, ('assertEqual', wat2.end_lineno, 6)\n    assert wat2.col_offset == 32, ('assertEqual', wat2.col_offset, 32)\n    assert wat2.end_col_offset == 17, ('assertEqual', wat2.end_col_offset, 17)\n    assert fstring.end_col_offset == 18, ('assertEqual', fstring.end_col_offset, 18)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_ast_fstring_empty_format_spec" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    expr = \"f'{expr:}'\"\n    mod = ast.parse(expr)\n    assert type(mod) == ast.Module, ('assertEqual', type(mod), ast.Module)\n    assert len(mod.body) == 1, ('assertEqual', len(mod.body), 1)\n    fstring = mod.body[0].value\n    assert type(fstring) == ast.JoinedStr, ('assertEqual', type(fstring), ast.JoinedStr)\n    assert len(fstring.values) == 1, ('assertEqual', len(fstring.values), 1)\n    fv = fstring.values[0]\n    assert type(fv) == ast.FormattedValue, ('assertEqual', type(fv), ast.FormattedValue)\n    format_spec = fv.format_spec\n    assert type(format_spec) == ast.JoinedStr, ('assertEqual', type(format_spec), ast.JoinedStr)\n    assert len(format_spec.values) == 0, ('assertEqual', len(format_spec.values), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_ast_fstring_format_spec" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    expr = \"f'{1:{name}}'\"\n    mod = ast.parse(expr)\n    assert type(mod) == ast.Module, ('assertEqual', type(mod), ast.Module)\n    assert len(mod.body) == 1, ('assertEqual', len(mod.body), 1)\n    fstring = mod.body[0].value\n    assert type(fstring) == ast.JoinedStr, ('assertEqual', type(fstring), ast.JoinedStr)\n    assert len(fstring.values) == 1, ('assertEqual', len(fstring.values), 1)\n    fv = fstring.values[0]\n    assert type(fv) == ast.FormattedValue, ('assertEqual', type(fv), ast.FormattedValue)\n    format_spec = fv.format_spec\n    assert type(format_spec) == ast.JoinedStr, ('assertEqual', type(format_spec), ast.JoinedStr)\n    assert len(format_spec.values) == 1, ('assertEqual', len(format_spec.values), 1)\n    format_spec_value = format_spec.values[0]\n    assert type(format_spec_value) == ast.FormattedValue, ('assertEqual', type(format_spec_value), ast.FormattedValue)\n    assert format_spec_value.value.id == 'name', ('assertEqual', format_spec_value.value.id, 'name')\n    expr = \"f'{1:{name1}{name2}}'\"\n    mod = ast.parse(expr)\n    assert type(mod) == ast.Module, ('assertEqual', type(mod), ast.Module)\n    assert len(mod.body) == 1, ('assertEqual', len(mod.body), 1)\n    fstring = mod.body[0].value\n    assert type(fstring) == ast.JoinedStr, ('assertEqual', type(fstring), ast.JoinedStr)\n    assert len(fstring.values) == 1, ('assertEqual', len(fstring.values), 1)\n    fv = fstring.values[0]\n    assert type(fv) == ast.FormattedValue, ('assertEqual', type(fv), ast.FormattedValue)\n    format_spec = fv.format_spec\n    assert type(format_spec) == ast.JoinedStr, ('assertEqual', type(format_spec), ast.JoinedStr)\n    assert len(format_spec.values) == 2, ('assertEqual', len(format_spec.values), 2)\n    format_spec_value = format_spec.values[0]\n    assert type(format_spec_value) == ast.FormattedValue, ('assertEqual', type(format_spec_value), ast.FormattedValue)\n    assert format_spec_value.value.id == 'name1', ('assertEqual', format_spec_value.value.id, 'name1')\n    format_spec_value = format_spec.values[1]\n    assert type(format_spec_value) == ast.FormattedValue, ('assertEqual', type(format_spec_value), ast.FormattedValue)\n    assert format_spec_value.value.id == 'name2', ('assertEqual', format_spec_value.value.id, 'name2')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_docstring" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    def f():\n        f'Not a docstring'\n    assert f.__doc__ is None, ('assertIsNone', f.__doc__)\n\n    def g():\n        f'Not a docstring'\n    assert g.__doc__ is None, ('assertIsNone', g.__doc__)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
