test "TestCase.test__format__lookup" {
    (ok, detail) = p2_libtest_run_snippet("import types\n\ndef _t():\n\n    class X:\n\n        def __format__(self, spec):\n            return 'class'\n    x = X()\n    y = X()\n    y.__format__ = types.MethodType(lambda self, spec: 'instance', y)\n    assert f'{y}' == format(y), ('assertEqual', f'{y}', format(y))\n    assert f'{y}' == 'class', ('assertEqual', f'{y}', 'class')\n    assert format(x) == format(y), ('assertEqual', format(x), format(y))\n    assert x.__format__('') == 'class', ('assertEqual', x.__format__(''), 'class')\n    assert y.__format__('') == 'instance', ('assertEqual', y.__format__(''), 'instance')\n    assert type(x).__format__(x, '') == 'class', ('assertEqual', type(x).__format__(x, ''), 'class')\n    assert type(y).__format__(y, '') == 'class', ('assertEqual', type(y).__format__(y, ''), 'class')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

