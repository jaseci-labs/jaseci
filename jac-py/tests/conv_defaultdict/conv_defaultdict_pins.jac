test "TestDefaultDict.test_union" {
    (ok, detail) = p2_libtest_run_snippet("from collections import defaultdict\n\ndef _t():\n    i = defaultdict(int, {1: 1, 2: 2})\n    s = defaultdict(str, {0: 'zero', 1: 'one'})\n    i_s = i | s\n    assert i_s.default_factory is int, ('assertIs', i_s.default_factory, int)\n    assert i_s == {1: 'one', 2: 2, 0: 'zero'}, ('assertDictEqual', i_s, {1: 'one', 2: 2, 0: 'zero'})\n    assert list(i_s) == [1, 2, 0], ('assertEqual', list(i_s), [1, 2, 0])\n    s_i = s | i\n    assert s_i.default_factory is str, ('assertIs', s_i.default_factory, str)\n    assert s_i == {0: 'zero', 1: 1, 2: 2}, ('assertDictEqual', s_i, {0: 'zero', 1: 1, 2: 2})\n    assert list(s_i) == [0, 1, 2], ('assertEqual', list(s_i), [0, 1, 2])\n    i_ds = i | dict(s)\n    assert i_ds.default_factory is int, ('assertIs', i_ds.default_factory, int)\n    assert i_ds == {1: 'one', 2: 2, 0: 'zero'}, ('assertDictEqual', i_ds, {1: 'one', 2: 2, 0: 'zero'})\n    assert list(i_ds) == [1, 2, 0], ('assertEqual', list(i_ds), [1, 2, 0])\n    ds_i = dict(s) | i\n    assert ds_i.default_factory is int, ('assertIs', ds_i.default_factory, int)\n    assert ds_i == {0: 'zero', 1: 1, 2: 2}, ('assertDictEqual', ds_i, {0: 'zero', 1: 1, 2: 2})\n    assert list(ds_i) == [0, 1, 2], ('assertEqual', list(ds_i), [0, 1, 2])\n    try:\n        i | list(s.items())\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        list(s.items()) | i\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    i |= list(s.items())\n    assert i.default_factory is int, ('assertIs', i.default_factory, int)\n    assert i == {1: 'one', 2: 2, 0: 'zero'}, ('assertDictEqual', i, {1: 'one', 2: 2, 0: 'zero'})\n    assert list(i) == [1, 2, 0], ('assertEqual', list(i), [1, 2, 0])\n    try:\n        i |= None\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestDefaultDict.test_factory_conflict_with_set_value" {
    (ok, detail) = p2_libtest_run_snippet("from collections import defaultdict\n\ndef _t():\n    key = 'conflict_test'\n    count = 0\n\n    def default_factory():\n        nonlocal count\n        count += 1\n        local_count = count\n        if count == 1:\n            test_dict[key]\n        return local_count\n    test_dict = defaultdict(default_factory)\n    assert count == 0, ('assertEqual', count, 0)\n    assert test_dict[key] == 2, ('assertEqual', test_dict[key], 2)\n    assert count == 2, ('assertEqual', count, 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

