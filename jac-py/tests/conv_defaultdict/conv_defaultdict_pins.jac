test "TestDefaultDict.test_basic" {
    (ok, detail) = p2_libtest_run_snippet("from collections import defaultdict\n\ndef _t():\n    d1 = defaultdict()\n    assert d1.default_factory == None, ('assertEqual', d1.default_factory, None)\n    d1.default_factory = list\n    d1[12].append(42)\n    assert d1 == {12: [42]}, ('assertEqual', d1, {12: [42]})\n    d1[12].append(24)\n    assert d1 == {12: [42, 24]}, ('assertEqual', d1, {12: [42, 24]})\n    d1[13]\n    d1[14]\n    assert d1 == {12: [42, 24], 13: [], 14: []}, ('assertEqual', d1, {12: [42, 24], 13: [], 14: []})\n    assert d1[12] is not d1[13] is not d1[14], ('assertTrue', d1[12] is not d1[13] is not d1[14])\n    d2 = defaultdict(list, foo=1, bar=2)\n    assert d2.default_factory == list, ('assertEqual', d2.default_factory, list)\n    assert d2 == {'foo': 1, 'bar': 2}, ('assertEqual', d2, {'foo': 1, 'bar': 2})\n    assert d2['foo'] == 1, ('assertEqual', d2['foo'], 1)\n    assert d2['bar'] == 2, ('assertEqual', d2['bar'], 2)\n    assert d2[42] == [], ('assertEqual', d2[42], [])\n    assert 'foo' in d2, ('assertIn', 'foo', d2)\n    assert 'foo' in d2.keys(), ('assertIn', 'foo', d2.keys())\n    assert 'bar' in d2, ('assertIn', 'bar', d2)\n    assert 'bar' in d2.keys(), ('assertIn', 'bar', d2.keys())\n    assert 42 in d2, ('assertIn', 42, d2)\n    assert 42 in d2.keys(), ('assertIn', 42, d2.keys())\n    assert 12 not in d2, ('assertNotIn', 12, d2)\n    assert 12 not in d2.keys(), ('assertNotIn', 12, d2.keys())\n    d2.default_factory = None\n    assert d2.default_factory == None, ('assertEqual', d2.default_factory, None)\n    try:\n        d2[15]\n    except KeyError as err:\n        assert err.args == (15,), ('assertEqual', err.args, (15,))\n    else:\n        raise AssertionError(\"d2[15] didn't raise KeyError\")\n    try:\n        defaultdict(*(1,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

