test "LineCacheTests.test_memoryerror" {
    (ok, detail) = p2_libtest_run_snippet("import linecache\nfrom test import support\nFILENAME = linecache.__file__\n\ndef _t():\n    lines = linecache.getlines(FILENAME)\n    assert lines, ('assertTrue', lines)\n\n    def raise_memoryerror(*args, **kwargs):\n        raise MemoryError\n    with support.swap_attr(linecache, 'updatecache', raise_memoryerror):\n        lines2 = linecache.getlines(FILENAME)\n    assert lines2 == lines, ('assertEqual', lines2, lines)\n    linecache.clearcache()\n    with support.swap_attr(linecache, 'updatecache', raise_memoryerror):\n        lines3 = linecache.getlines(FILENAME)\n    assert lines3 == [], ('assertEqual', lines3, [])\n    assert linecache.getlines(FILENAME) == lines, ('assertEqual', linecache.getlines(FILENAME), lines)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "LineCacheTests.test_loader" {
    (ok, detail) = p2_libtest_run_snippet("import linecache\nfrom importlib.machinery import ModuleSpec\n\nclass FakeLoader:\n\n    def get_source(self, fullname):\n        return f'source for {fullname}'\n\nclass NoSourceLoader:\n\n    def get_source(self, fullname):\n        return None\n\ndef _t():\n    filename = 'scheme://path'\n    for loader in (None, object(), NoSourceLoader()):\n        linecache.clearcache()\n        module_globals = {'__name__': 'a.b.c', '__loader__': loader}\n        assert linecache.getlines(filename, module_globals) == [], ('assertEqual', linecache.getlines(filename, module_globals), [])\n    linecache.clearcache()\n    module_globals = {'__name__': 'a.b.c', '__loader__': FakeLoader()}\n    assert linecache.getlines(filename, module_globals) == ['source for a.b.c\\n'], ('assertEqual', linecache.getlines(filename, module_globals), ['source for a.b.c\\n'])\n    for spec in (None, object(), ModuleSpec('', FakeLoader())):\n        linecache.clearcache()\n        module_globals = {'__name__': 'a.b.c', '__loader__': FakeLoader(), '__spec__': spec}\n        assert linecache.getlines(filename, module_globals) == ['source for a.b.c\\n'], ('assertEqual', linecache.getlines(filename, module_globals), ['source for a.b.c\\n'])\n    linecache.clearcache()\n    spec = ModuleSpec('x.y.z', FakeLoader())\n    module_globals = {'__name__': 'a.b.c', '__loader__': spec.loader, '__spec__': spec}\n    assert linecache.getlines(filename, module_globals) == ['source for x.y.z\\n'], ('assertEqual', linecache.getlines(filename, module_globals), ['source for x.y.z\\n'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

