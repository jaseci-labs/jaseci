test "LineCacheTests.test_getline" {
    (ok, detail) = p2_libtest_run_snippet("import linecache\nimport os.path\nFILENAME = linecache.__file__\nINVALID_NAME = '!@$)(!@#_1'\nEMPTY = ''\nMODULES = 'linecache abc'.split()\nMODULE_PATH = os.path.dirname(FILENAME)\n\ndef _t():\n    getline = linecache.getline\n    assert getline(FILENAME, 2 ** 15) == EMPTY, ('assertEqual', getline(FILENAME, 2 ** 15), EMPTY)\n    assert getline(FILENAME, -1) == EMPTY, ('assertEqual', getline(FILENAME, -1), EMPTY)\n    try:\n        getline(*(FILENAME, 1.1))\n    except TypeError:\n        pass\n    assert getline(EMPTY, 1) == EMPTY, ('assertEqual', getline(EMPTY, 1), EMPTY)\n    assert getline(INVALID_NAME, 1) == EMPTY, ('assertEqual', getline(INVALID_NAME, 1), EMPTY)\n    for entry in MODULES:\n        filename = os.path.join(MODULE_PATH, entry) + '.py'\n        with open(filename, encoding='utf-8') as file:\n            for index, line in enumerate(file):\n                assert line == getline(filename, index + 1), ('assertEqual', line, getline(filename, index + 1))\n    empty = linecache.getlines('a/b/c/__init__.py')\n    assert empty == [], ('assertEqual', empty, [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

