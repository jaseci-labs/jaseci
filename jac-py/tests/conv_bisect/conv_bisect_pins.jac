test "TestInsortPython.test_listDerived" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_bisect = import_helper.import_fresh_module('bisect', blocked=['_bisect'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.module = py_bisect\n\n    class List(list):\n        data = []\n\n        def insert(self, index, item):\n            self.data.insert(index, item)\n    lst = List()\n    self.module.insort_left(lst, 10)\n    self.module.insort_right(lst, 5)\n    assert [5, 10] == lst.data, ('assertEqual', [5, 10], lst.data)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

