test "TestDocExamplePython.test_colors" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_bisect = import_helper.import_fresh_module('bisect', blocked=['_bisect'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.module = py_bisect\n    data = [('red', 5), ('blue', 1), ('yellow', 8), ('black', 0)]\n    data.sort(key=lambda r: r[1])\n    keys = [r[1] for r in data]\n    bisect_left = self.module.bisect_left\n    assert data[bisect_left(keys, 0)] == ('black', 0), ('assertEqual', data[bisect_left(keys, 0)], ('black', 0))\n    assert data[bisect_left(keys, 1)] == ('blue', 1), ('assertEqual', data[bisect_left(keys, 1)], ('blue', 1))\n    assert data[bisect_left(keys, 5)] == ('red', 5), ('assertEqual', data[bisect_left(keys, 5)], ('red', 5))\n    assert data[bisect_left(keys, 8)] == ('yellow', 8), ('assertEqual', data[bisect_left(keys, 8)], ('yellow', 8))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

