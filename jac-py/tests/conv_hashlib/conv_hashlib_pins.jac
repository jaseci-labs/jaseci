test "HashLibTestCase.test_sha256_gil" {
    (ok, detail) = p2_libtest_run_snippet("import hashlib\nfrom test.support import hashlib_helper\n\ndef _t():\n    gil_minsize = hashlib_helper.find_gil_minsize(['_sha2', '_hashlib'])\n    m = hashlib.sha256()\n    m.update(b'1')\n    m.update(b'#' * gil_minsize)\n    m.update(b'1')\n    assert m.hexdigest() == '1cfceca95989f51f658e3f3ffe7f1cd43726c9e088c13ee10b46f57cef135b94', ('assertEqual', m.hexdigest(), '1cfceca95989f51f658e3f3ffe7f1cd43726c9e088c13ee10b46f57cef135b94')\n    m = hashlib.sha256(b'1' + b'#' * gil_minsize + b'1')\n    assert m.hexdigest() == '1cfceca95989f51f658e3f3ffe7f1cd43726c9e088c13ee10b46f57cef135b94', ('assertEqual', m.hexdigest(), '1cfceca95989f51f658e3f3ffe7f1cd43726c9e088c13ee10b46f57cef135b94')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

