test "HashLibTestCase.test_blake2b" {
    (ok, detail) = p2_libtest_run_snippet("import hashlib\n\ndef hexstr(s):\n    assert isinstance(s, bytes), repr(s)\n    h = '0123456789abcdef'\n    r = ''\n    for i in s:\n        r += h[i >> 4 & 15] + h[i & 15]\n    return r\n\ndef _t():\n\n    def check_blake2(constructor, salt_size, person_size, key_size, digest_size, max_offset):\n        assert constructor.SALT_SIZE == salt_size, ('assertEqual', constructor.SALT_SIZE, salt_size)\n        for i in range(salt_size + 1):\n            constructor(salt=b'a' * i)\n        salt = b'a' * (salt_size + 1)\n        try:\n            constructor(salt=salt)\n        except ValueError:\n            pass\n        assert constructor.PERSON_SIZE == person_size, ('assertEqual', constructor.PERSON_SIZE, person_size)\n        for i in range(person_size + 1):\n            constructor(person=b'a' * i)\n        person = b'a' * (person_size + 1)\n        try:\n            constructor(person=person)\n        except ValueError:\n            pass\n        assert constructor.MAX_DIGEST_SIZE == digest_size, ('assertEqual', constructor.MAX_DIGEST_SIZE, digest_size)\n        for i in range(1, digest_size + 1):\n            constructor(digest_size=i)\n        try:\n            constructor(digest_size=-1)\n        except ValueError:\n            pass\n        try:\n            constructor(digest_size=0)\n        except ValueError:\n            pass\n        try:\n            constructor(digest_size=digest_size + 1)\n        except ValueError:\n            pass\n        assert constructor.MAX_KEY_SIZE == key_size, ('assertEqual', constructor.MAX_KEY_SIZE, key_size)\n        for i in range(key_size + 1):\n            constructor(key=b'a' * i)\n        key = b'a' * (key_size + 1)\n        try:\n            constructor(key=key)\n        except ValueError:\n            pass\n        assert constructor().hexdigest() == constructor(key=b'').hexdigest(), ('assertEqual', constructor().hexdigest(), constructor(key=b'').hexdigest())\n        for i in range(0, 256):\n            constructor(fanout=i)\n        try:\n            constructor(fanout=-1)\n        except ValueError:\n            pass\n        try:\n            constructor(fanout=256)\n        except ValueError:\n            pass\n        for i in range(1, 256):\n            constructor(depth=i)\n        try:\n            constructor(depth=-1)\n        except ValueError:\n            pass\n        try:\n            constructor(depth=0)\n        except ValueError:\n            pass\n        try:\n            constructor(depth=256)\n        except ValueError:\n            pass\n        for i in range(0, 256):\n            constructor(node_depth=i)\n        try:\n            constructor(node_depth=-1)\n        except ValueError:\n            pass\n        try:\n            constructor(node_depth=256)\n        except ValueError:\n            pass\n        for i in range(0, digest_size + 1):\n            constructor(inner_size=i)\n        try:\n            constructor(inner_size=-1)\n        except ValueError:\n            pass\n        try:\n            constructor(inner_size=digest_size + 1)\n        except ValueError:\n            pass\n        constructor(leaf_size=0)\n        constructor(leaf_size=(1 << 32) - 1)\n        try:\n            constructor(leaf_size=-1)\n        except ValueError:\n            pass\n        try:\n            constructor(leaf_size=1 << 32)\n        except OverflowError:\n            pass\n        constructor(node_offset=0)\n        constructor(node_offset=max_offset)\n        try:\n            constructor(node_offset=-1)\n        except ValueError:\n            pass\n        try:\n            constructor(node_offset=max_offset + 1)\n        except OverflowError:\n            pass\n        try:\n            constructor(*('',))\n        except TypeError:\n            pass\n        constructor(b'', key=b'', salt=b'', person=b'', digest_size=17, fanout=1, depth=1, leaf_size=256, node_offset=512, node_depth=1, inner_size=7, last_node=True)\n\n    def blake2_rfc7693(constructor, md_len, in_len):\n\n        def selftest_seq(length, seed):\n            mask = (1 << 32) - 1\n            a = 3735899053 * seed & mask\n            b = 1\n            out = bytearray(length)\n            for i in range(length):\n                t = a + b & mask\n                a, b = (b, t)\n                out[i] = t >> 24 & 255\n            return out\n        outer = constructor(digest_size=32)\n        for outlen in md_len:\n            for inlen in in_len:\n                indata = selftest_seq(inlen, inlen)\n                key = selftest_seq(outlen, outlen)\n                unkeyed = constructor(indata, digest_size=outlen)\n                outer.update(unkeyed.digest())\n                keyed = constructor(indata, key=key, digest_size=outlen)\n                outer.update(keyed.digest())\n        return outer.hexdigest()\n    check_blake2(hashlib.blake2b, 16, 16, 64, 64, (1 << 64) - 1)\n    b2b_md_len = [20, 32, 48, 64]\n    b2b_in_len = [0, 3, 128, 129, 255, 1024]\n    assert blake2_rfc7693(hashlib.blake2b, b2b_md_len, b2b_in_len) == 'c23a7800d98123bd10f506c61e29da5603d763b8bbad2e737f5e765a7bccd475', ('assertEqual', blake2_rfc7693(hashlib.blake2b, b2b_md_len, b2b_in_len), 'c23a7800d98123bd10f506c61e29da5603d763b8bbad2e737f5e765a7bccd475')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

