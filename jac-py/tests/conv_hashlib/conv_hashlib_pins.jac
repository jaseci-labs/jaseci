test "KDFTests.test_file_digest" {
    (ok, detail) = p2_libtest_run_snippet("import hashlib\nimport tempfile\n\ndef _t():\n    data = b'a' * 65536\n    d1 = hashlib.sha256()\n    with tempfile.NamedTemporaryFile(delete_on_close=False) as fp:\n        for _ in range(10):\n            d1.update(data)\n            fp.write(data)\n        fp.close()\n        with open(fp.name, 'rb') as f:\n            d2 = hashlib.file_digest(f, hashlib.sha256)\n        assert d1.hexdigest() == d2.hexdigest(), ('assertEqual', d1.hexdigest(), d2.hexdigest())\n        assert d1.name == d2.name, ('assertEqual', d1.name, d2.name)\n        assert type(d1) is type(d2), ('assertIs', type(d1), type(d2))\n        try:\n            with open(fp.name, 'r') as f:\n                hashlib.file_digest(f, 'sha256')\n        except ValueError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            with open(fp.name, 'wb') as f:\n                hashlib.file_digest(f, 'sha256')\n        except ValueError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n    try:\n        hashlib.file_digest(None, 'sha256')\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    class NonBlocking:\n\n        def readinto(self, buf):\n            return None\n\n        def readable(self):\n            return True\n    try:\n        hashlib.file_digest(NonBlocking(), hashlib.sha256)\n    except BlockingIOError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
