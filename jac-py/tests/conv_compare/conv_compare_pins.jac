test "ComparisonFullTest.test_mappings" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef assert_equality_only(a, b, equal):\n    \"\"\"Assert equality result and that ordering is not implemented.\n\n        a, b: Instances to be tested (of same or different type).\n        equal: Boolean indicating the expected equality comparison results.\n        \"\"\"\n    assert (a == b) == equal, ('assertEqual', (a == b), equal)\n    assert (b == a) == equal, ('assertEqual', (b == a), equal)\n    assert (a != b) == (not equal), ('assertEqual', (a != b), (not equal))\n    assert (b != a) == (not equal), ('assertEqual', (b != a), (not equal))\n    try:\n        a < b\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        a <= b\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        a > b\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        a >= b\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        b < a\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        b <= a\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        b > a\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        b >= a\n    except TypeError as _exc:\n        assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\ndef _t():\n    \"\"\" Compare dict.\n        \"\"\"\n    d1 = {1: 'a', 2: 'b'}\n    d2 = {2: 'b', 3: 'c'}\n    d3 = {3: 'c', 2: 'b'}\n    assert_equality_only(d1, d1, True)\n    assert_equality_only(d1, d2, False)\n    assert_equality_only(d2, d3, True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
