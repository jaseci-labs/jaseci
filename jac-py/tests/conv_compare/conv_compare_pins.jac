    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef assert_eq_subtest(a, b, comp, a_meth, b_meth):\n    if a_meth is None or 'eq' in a_meth or 'eq' in b_meth:\n        assert (a == b) == (comp == 0), ('assertEqual', (a == b), (comp == 0))\n        assert (b == a) == (comp == 0), ('assertEqual', (b == a), (comp == 0))\n    else:\n        assert (a == b) == (a is b), ('assertEqual', (a == b), (a is b))\n        assert (b == a) == (a is b), ('assertEqual', (b == a), (a is b))\n\ndef assert_ne_subtest(a, b, comp, a_meth, b_meth):\n    if a_meth is None or not {'ne', 'eq'}.isdisjoint(a_meth + b_meth):\n        assert (a != b) == (comp != 0), ('assertEqual', (a != b), (comp != 0))\n        assert (b != a) == (comp != 0), ('assertEqual', (b != a), (comp != 0))\n    else:\n        assert (a != b) == (a is not b), ('assertEqual', (a != b), (a is not b))\n        assert (b != a) == (a is not b), ('assertEqual', (b != a), (a is not b))\n\ndef assert_lt_subtest(a, b, comp, a_meth, b_meth):\n    if a_meth is None or 'lt' in a_meth or 'gt' in b_meth:\n        assert (a < b) == (comp < 0), ('assertEqual', (a < b), (comp < 0))\n        assert (b > a) == (comp < 0), ('assertEqual', (b > a), (comp < 0))\n    else:\n        try:\n            a < b\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            b > a\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\ndef assert_le_subtest(a, b, comp, a_meth, b_meth):\n    if a_meth is None or 'le' in a_meth or 'ge' in b_meth:\n        assert (a <= b) == (comp <= 0), ('assertEqual', (a <= b), (comp <= 0))\n        assert (b >= a) == (comp <= 0), ('assertEqual', (b >= a), (comp <= 0))\n    else:\n        try:\n            a <= b\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            b >= a\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\ndef assert_gt_subtest(a, b, comp, a_meth, b_meth):\n    if a_meth is None or 'gt' in a_meth or 'lt' in b_meth:\n        assert (a > b) == (comp > 0), ('assertEqual', (a > b), (comp > 0))\n        assert (b < a) == (comp > 0), ('assertEqual', (b < a), (comp > 0))\n    else:\n        try:\n            a > b\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            b < a\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\ndef assert_ge_subtest(a, b, comp, a_meth, b_meth):\n    if a_meth is None or 'ge' in a_meth or 'le' in b_meth:\n        assert (a >= b) == (comp >= 0), ('assertEqual', (a >= b), (comp >= 0))\n        assert (b <= a) == (comp >= 0), ('assertEqual', (b <= a), (comp >= 0))\n    else:\n        try:\n            a >= b\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            b <= a\n        except TypeError as _exc:\n            assert _re.search('not supported', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n\ndef assert_total_order(a, b, comp, a_meth=None, b_meth=None):\n    \"\"\"Test total ordering comparison of two instances.\n\n        a, b: Instances to be tested (of same or different type).\n\n        comp: -1, 0, or 1 indicates that the expected order comparison\n           result for operations that are supported by the classes is\n           a <, ==, or > b.\n\n        a_meth, b_meth: Either None, indicating that all rich comparison\n           methods are available, aa for builtins, or the tuple (subset)\n           of \"eq\", \"ne\", \"lt\", \"le\", \"gt\", and \"ge\" that are available\n           for the corresponding instance (of a user-defined class).\n        \"\"\"\n    assert_eq_subtest(a, b, comp, a_meth, b_meth)\n    assert_ne_subtest(a, b, comp, a_meth, b_meth)\n    assert_lt_subtest(a, b, comp, a_meth, b_meth)\n    assert_le_subtest(a, b, comp, a_meth, b_meth)\n    assert_gt_subtest(a, b, comp, a_meth, b_meth)\n    assert_ge_subtest(a, b, comp, a_meth, b_meth)\n\ndef _t():\n    \"\"\"Compare instances of str and a subclass.\"\"\"\n\n    class StrSubclass(str):\n        pass\n    s1 = str('a')\n    s2 = str('b')\n    c1 = StrSubclass('a')\n    c2 = StrSubclass('b')\n    c3 = StrSubclass('b')\n    assert_total_order(s1, s1, 0)\n    assert_total_order(s1, s2, -1)\n    assert_total_order(c1, c1, 0)\n    assert_total_order(c1, c2, -1)\n    assert_total_order(c2, c3, 0)\n    assert_total_order(s1, c2, -1)\n    assert_total_order(s2, c3, 0)\n    assert_total_order(c1, s2, -1)\n    assert_total_order(c2, s2, 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
