test "CosmeticTestCase.test_simple_expressions_parens" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef get_source(code1, code2=None, **kwargs):\n    code2 = code2 or code1\n    code1 = ast.unparse(ast.parse(code1, **kwargs))\n    return (code1, code2)\n\ndef check_src_roundtrip(code1, code2=None, **kwargs):\n    code1, code2 = get_source(code1, code2, **kwargs)\n    assert code2 == code1, ('assertEqual', code2, code1)\n\ndef _t():\n    check_src_roundtrip('(a := b)')\n    check_src_roundtrip('await x')\n    check_src_roundtrip('x if x else y')\n    check_src_roundtrip('lambda x: x')\n    check_src_roundtrip('1 + 1')\n    check_src_roundtrip('1 + 2 / 3')\n    check_src_roundtrip('(1 + 2) / 3')\n    check_src_roundtrip('(1 + 2) * 3 + 4 * (5 + 2)')\n    check_src_roundtrip('(1 + 2) * 3 + 4 * (5 + 2) ** 2')\n    check_src_roundtrip('~x')\n    check_src_roundtrip('x and y')\n    check_src_roundtrip('x and y and z')\n    check_src_roundtrip('x and (y and x)')\n    check_src_roundtrip('(x and y) and z')\n    check_src_roundtrip('(x ** y) ** z ** q')\n    check_src_roundtrip('x >> y')\n    check_src_roundtrip('x << y')\n    check_src_roundtrip('x >> y and x >> z')\n    check_src_roundtrip('x + y - z * q ^ t ** k')\n    check_src_roundtrip('P * V if P and V else n * R * T')\n    check_src_roundtrip('lambda P, V, n: P * V == n * R * T')\n    check_src_roundtrip('flag & (other | foo)')\n    check_src_roundtrip('not x == y')\n    check_src_roundtrip('x == (not y)')\n    check_src_roundtrip('yield x')\n    check_src_roundtrip('yield from x')\n    check_src_roundtrip('call((yield x))')\n    check_src_roundtrip('return x + (yield x)')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

