test "CosmeticTestCase.test_lambda_parameters" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef get_source(code1, code2=None, **kwargs):\n    code2 = code2 or code1\n    code1 = ast.unparse(ast.parse(code1, **kwargs))\n    return (code1, code2)\n\ndef check_src_roundtrip(code1, code2=None, **kwargs):\n    code1, code2 = get_source(code1, code2, **kwargs)\n    assert code2 == code1, ('assertEqual', code2, code1)\n\ndef _t():\n    check_src_roundtrip('lambda: something')\n    check_src_roundtrip('four = lambda: 2 + 2')\n    check_src_roundtrip('lambda x: x * 2')\n    check_src_roundtrip('square = lambda n: n ** 2')\n    check_src_roundtrip('lambda x, y: x + y')\n    check_src_roundtrip('add = lambda x, y: x + y')\n    check_src_roundtrip('lambda x, y, /, z, q, *, u: None')\n    check_src_roundtrip('lambda x, *y, **z: None')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CosmeticTestCase.test_star_expr_assign_target" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef get_source(code1, code2=None, **kwargs):\n    code2 = code2 or code1\n    code1 = ast.unparse(ast.parse(code1, **kwargs))\n    return (code1, code2)\n\ndef check_src_roundtrip(code1, code2=None, **kwargs):\n    code1, code2 = get_source(code1, code2, **kwargs)\n    assert code2 == code1, ('assertEqual', code2, code1)\n\ndef _t():\n    for source_type, source in [('single assignment', '{target} = foo'), ('multiple assignment', '{target} = {target} = bar'), ('for loop', 'for {target} in foo:\\n    pass'), ('async for loop', 'async for {target} in foo:\\n    pass')]:\n        for target in ['a', 'a,', 'a, b', 'a, *b, c', 'a, (b, c), d', 'a, (b, c, d), *e', 'a, (b, *c, d), e', 'a, (b, *c, (d, e), f), g', '[a]', '[a, b]', '[a, *b, c]', '[a, [b, c], d]', '[a, [b, c, d], *e]', '[a, [b, *c, d], e]', '[a, [b, *c, [d, e], f], g]', 'a, [b, c], d', '[a, b, (c, d), (e, f)]', 'a, b, [*c], d, e']:\n            check_src_roundtrip(source.format(target=target))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "CosmeticTestCase.test_star_expr_assign_target_multiple" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef get_source(code1, code2=None, **kwargs):\n    code2 = code2 or code1\n    code1 = ast.unparse(ast.parse(code1, **kwargs))\n    return (code1, code2)\n\ndef check_src_roundtrip(code1, code2=None, **kwargs):\n    code1, code2 = get_source(code1, code2, **kwargs)\n    assert code2 == code1, ('assertEqual', code2, code1)\n\ndef _t():\n    check_src_roundtrip('() = []')\n    check_src_roundtrip('[] = ()')\n    check_src_roundtrip('() = [a] = c, = [d] = e, f = () = g = h')\n    check_src_roundtrip('a = b = c = d')\n    check_src_roundtrip('a, b = c, d = e, f = g')\n    check_src_roundtrip('[a, b] = [c, d] = [e, f] = g')\n    check_src_roundtrip('a, b = [c, d] = e, f = g')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

