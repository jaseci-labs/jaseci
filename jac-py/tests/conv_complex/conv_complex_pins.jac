test "ComplexTest.test_richcompare" {
    (ok, detail) = p2_libtest_run_snippet("import operator\n\ndef _t():\n    assert complex.__eq__(1 + 1j, 1 << 10000) is False, ('assertIs', complex.__eq__(1 + 1j, 1 << 10000), False)\n    assert complex.__lt__(1 + 1j, None) is NotImplemented, ('assertIs', complex.__lt__(1 + 1j, None), NotImplemented)\n    assert complex.__eq__(1 + 1j, None) is NotImplemented, ('assertIs', complex.__eq__(1 + 1j, None), NotImplemented)\n    assert complex.__eq__(1 + 1j, 1 + 1j) is True, ('assertIs', complex.__eq__(1 + 1j, 1 + 1j), True)\n    assert complex.__eq__(1 + 1j, 2 + 2j) is False, ('assertIs', complex.__eq__(1 + 1j, 2 + 2j), False)\n    assert complex.__ne__(1 + 1j, 1 + 1j) is False, ('assertIs', complex.__ne__(1 + 1j, 1 + 1j), False)\n    assert complex.__ne__(1 + 1j, 2 + 2j) is True, ('assertIs', complex.__ne__(1 + 1j, 2 + 2j), True)\n    for i in range(1, 100):\n        f = i / 100.0\n        assert complex.__eq__(f + 0j, f) is True, ('assertIs', complex.__eq__(f + 0j, f), True)\n        assert complex.__ne__(f + 0j, f) is False, ('assertIs', complex.__ne__(f + 0j, f), False)\n        assert complex.__eq__(complex(f, f), f) is False, ('assertIs', complex.__eq__(complex(f, f), f), False)\n        assert complex.__ne__(complex(f, f), f) is True, ('assertIs', complex.__ne__(complex(f, f), f), True)\n    assert complex.__lt__(1 + 1j, 2 + 2j) is NotImplemented, ('assertIs', complex.__lt__(1 + 1j, 2 + 2j), NotImplemented)\n    assert complex.__le__(1 + 1j, 2 + 2j) is NotImplemented, ('assertIs', complex.__le__(1 + 1j, 2 + 2j), NotImplemented)\n    assert complex.__gt__(1 + 1j, 2 + 2j) is NotImplemented, ('assertIs', complex.__gt__(1 + 1j, 2 + 2j), NotImplemented)\n    assert complex.__ge__(1 + 1j, 2 + 2j) is NotImplemented, ('assertIs', complex.__ge__(1 + 1j, 2 + 2j), NotImplemented)\n    try:\n        operator.lt(*(1 + 1j, 2 + 2j))\n    except TypeError:\n        pass\n    try:\n        operator.le(*(1 + 1j, 2 + 2j))\n    except TypeError:\n        pass\n    try:\n        operator.gt(*(1 + 1j, 2 + 2j))\n    except TypeError:\n        pass\n    try:\n        operator.ge(*(1 + 1j, 2 + 2j))\n    except TypeError:\n        pass\n    assert operator.eq(1 + 1j, 1 + 1j) is True, ('assertIs', operator.eq(1 + 1j, 1 + 1j), True)\n    assert operator.eq(1 + 1j, 2 + 2j) is False, ('assertIs', operator.eq(1 + 1j, 2 + 2j), False)\n    assert operator.ne(1 + 1j, 1 + 1j) is False, ('assertIs', operator.ne(1 + 1j, 1 + 1j), False)\n    assert operator.ne(1 + 1j, 2 + 2j) is True, ('assertIs', operator.ne(1 + 1j, 2 + 2j), True)\n    assert operator.eq(1 + 1j, 2.0) is False, ('assertIs', operator.eq(1 + 1j, 2.0), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ComplexTest.test_richcompare_boundaries" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    def check(n, deltas, is_equal, imag=0.0):\n        for delta in deltas:\n            i = n + delta\n            z = complex(i, imag)\n            assert complex.__eq__(z, i) is is_equal(delta), ('assertIs', complex.__eq__(z, i), is_equal(delta))\n            assert complex.__ne__(z, i) is (not is_equal(delta)), ('assertIs', complex.__ne__(z, i), (not is_equal(delta)))\n    for i in range(1, 10):\n        pow = 52 + i\n        mult = 2 ** i\n        check(2 ** pow, range(1, 101), lambda delta: delta % mult == 0)\n        check(2 ** pow, range(1, 101), lambda delta: False, float(i))\n    check(2 ** 53, range(-100, 0), lambda delta: True)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

