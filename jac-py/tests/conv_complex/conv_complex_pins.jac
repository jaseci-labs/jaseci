test "ComplexTest.test_underscores" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.numbers import VALID_UNDERSCORE_LITERALS, INVALID_UNDERSCORE_LITERALS\n\ndef _t():\n    for lit in VALID_UNDERSCORE_LITERALS:\n        if not any((ch in lit for ch in 'xXoObB')):\n            assert complex(lit) == eval(lit), ('assertEqual', complex(lit), eval(lit))\n            assert complex(lit) == complex(lit.replace('_', '')), ('assertEqual', complex(lit), complex(lit.replace('_', '')))\n    for lit in INVALID_UNDERSCORE_LITERALS:\n        if lit in ('0_7', '09_99'):\n            continue\n        if not any((ch in lit for ch in 'xXoObB')):\n            try:\n                complex(*(lit,))\n            except ValueError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

