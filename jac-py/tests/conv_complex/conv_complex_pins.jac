test "ComplexTest.test_format" {
    (ok, detail) = p2_libtest_run_snippet("INF = float('inf')\nNAN = float('nan')\n\ndef _t():\n    assert format(1 + 3j, '') == str(1 + 3j), ('assertEqual', format(1 + 3j, ''), str(1 + 3j))\n    assert format(1.5 + 3.5j, '') == str(1.5 + 3.5j), ('assertEqual', format(1.5 + 3.5j, ''), str(1.5 + 3.5j))\n    assert format(3j, '') == str(3j), ('assertEqual', format(3j, ''), str(3j))\n    assert format(3.2j, '') == str(3.2j), ('assertEqual', format(3.2j, ''), str(3.2j))\n    assert format(3 + 0j, '') == str(3 + 0j), ('assertEqual', format(3 + 0j, ''), str(3 + 0j))\n    assert format(3.2 + 0j, '') == str(3.2 + 0j), ('assertEqual', format(3.2 + 0j, ''), str(3.2 + 0j))\n    assert format(3.2 + 0j, '-') == str(3.2 + 0j), ('assertEqual', format(3.2 + 0j, '-'), str(3.2 + 0j))\n    assert format(3.2 + 0j, '<') == str(3.2 + 0j), ('assertEqual', format(3.2 + 0j, '<'), str(3.2 + 0j))\n    z = 4 / 7.0 - 100j / 7.0\n    assert format(z, '') == str(z), ('assertEqual', format(z, ''), str(z))\n    assert format(z, '-') == str(z), ('assertEqual', format(z, '-'), str(z))\n    assert format(z, '<') == str(z), ('assertEqual', format(z, '<'), str(z))\n    assert format(z, '10') == str(z), ('assertEqual', format(z, '10'), str(z))\n    z = complex(0.0, 3.0)\n    assert format(z, '') == str(z), ('assertEqual', format(z, ''), str(z))\n    assert format(z, '-') == str(z), ('assertEqual', format(z, '-'), str(z))\n    assert format(z, '<') == str(z), ('assertEqual', format(z, '<'), str(z))\n    assert format(z, '2') == str(z), ('assertEqual', format(z, '2'), str(z))\n    z = complex(-0.0, 2.0)\n    assert format(z, '') == str(z), ('assertEqual', format(z, ''), str(z))\n    assert format(z, '-') == str(z), ('assertEqual', format(z, '-'), str(z))\n    assert format(z, '<') == str(z), ('assertEqual', format(z, '<'), str(z))\n    assert format(z, '3') == str(z), ('assertEqual', format(z, '3'), str(z))\n    assert format(1 + 3j, 'g') == '1+3j', ('assertEqual', format(1 + 3j, 'g'), '1+3j')\n    assert format(3j, 'g') == '0+3j', ('assertEqual', format(3j, 'g'), '0+3j')\n    assert format(1.5 + 3.5j, 'g') == '1.5+3.5j', ('assertEqual', format(1.5 + 3.5j, 'g'), '1.5+3.5j')\n    assert format(1.5 + 3.5j, '+g') == '+1.5+3.5j', ('assertEqual', format(1.5 + 3.5j, '+g'), '+1.5+3.5j')\n    assert format(1.5 - 3.5j, '+g') == '+1.5-3.5j', ('assertEqual', format(1.5 - 3.5j, '+g'), '+1.5-3.5j')\n    assert format(1.5 - 3.5j, '-g') == '1.5-3.5j', ('assertEqual', format(1.5 - 3.5j, '-g'), '1.5-3.5j')\n    assert format(1.5 + 3.5j, ' g') == ' 1.5+3.5j', ('assertEqual', format(1.5 + 3.5j, ' g'), ' 1.5+3.5j')\n    assert format(1.5 - 3.5j, ' g') == ' 1.5-3.5j', ('assertEqual', format(1.5 - 3.5j, ' g'), ' 1.5-3.5j')\n    assert format(-1.5 + 3.5j, ' g') == '-1.5+3.5j', ('assertEqual', format(-1.5 + 3.5j, ' g'), '-1.5+3.5j')\n    assert format(-1.5 - 3.5j, ' g') == '-1.5-3.5j', ('assertEqual', format(-1.5 - 3.5j, ' g'), '-1.5-3.5j')\n    assert format(-1.5 - 3.5e-20j, 'g') == '-1.5-3.5e-20j', ('assertEqual', format(-1.5 - 3.5e-20j, 'g'), '-1.5-3.5e-20j')\n    assert format(-1.5 - 3.5j, 'f') == '-1.500000-3.500000j', ('assertEqual', format(-1.5 - 3.5j, 'f'), '-1.500000-3.500000j')\n    assert format(-1.5 - 3.5j, 'F') == '-1.500000-3.500000j', ('assertEqual', format(-1.5 - 3.5j, 'F'), '-1.500000-3.500000j')\n    assert format(-1.5 - 3.5j, 'e') == '-1.500000e+00-3.500000e+00j', ('assertEqual', format(-1.5 - 3.5j, 'e'), '-1.500000e+00-3.500000e+00j')\n    assert format(-1.5 - 3.5j, '.2e') == '-1.50e+00-3.50e+00j', ('assertEqual', format(-1.5 - 3.5j, '.2e'), '-1.50e+00-3.50e+00j')\n    assert format(-1.5 - 3.5j, '.2E') == '-1.50E+00-3.50E+00j', ('assertEqual', format(-1.5 - 3.5j, '.2E'), '-1.50E+00-3.50E+00j')\n    assert format(-15000000000.0 - 350000j, '.2G') == '-1.5E+10-3.5E+05j', ('assertEqual', format(-15000000000.0 - 350000j, '.2G'), '-1.5E+10-3.5E+05j')\n    assert format(1.5 + 3j, '<20g') == '1.5+3j              ', ('assertEqual', format(1.5 + 3j, '<20g'), '1.5+3j              ')\n    assert format(1.5 + 3j, '*<20g') == '1.5+3j**************', ('assertEqual', format(1.5 + 3j, '*<20g'), '1.5+3j**************')\n    assert format(1.5 + 3j, '>20g') == '              1.5+3j', ('assertEqual', format(1.5 + 3j, '>20g'), '              1.5+3j')\n    assert format(1.5 + 3j, '^20g') == '       1.5+3j       ', ('assertEqual', format(1.5 + 3j, '^20g'), '       1.5+3j       ')\n    assert format(1.5 + 3j, '<20') == '(1.5+3j)            ', ('assertEqual', format(1.5 + 3j, '<20'), '(1.5+3j)            ')\n    assert format(1.5 + 3j, '>20') == '            (1.5+3j)', ('assertEqual', format(1.5 + 3j, '>20'), '            (1.5+3j)')\n    assert format(1.5 + 3j, '^20') == '      (1.5+3j)      ', ('assertEqual', format(1.5 + 3j, '^20'), '      (1.5+3j)      ')\n    assert format(1.123 - 3.123j, '^20.2') == '     (1.1-3.1j)     ', ('assertEqual', format(1.123 - 3.123j, '^20.2'), '     (1.1-3.1j)     ')\n    assert format(1.5 + 3j, '20.2f') == '          1.50+3.00j', ('assertEqual', format(1.5 + 3j, '20.2f'), '          1.50+3.00j')\n    assert format(1.5 + 3j, '>20.2f') == '          1.50+3.00j', ('assertEqual', format(1.5 + 3j, '>20.2f'), '          1.50+3.00j')\n    assert format(1.5 + 3j, '<20.2f') == '1.50+3.00j          ', ('assertEqual', format(1.5 + 3j, '<20.2f'), '1.50+3.00j          ')\n    assert format(1.5e+20 + 3j, '<20.2f') == '150000000000000000000.00+3.00j', ('assertEqual', format(1.5e+20 + 3j, '<20.2f'), '150000000000000000000.00+3.00j')\n    assert format(1.5e+20 + 3j, '>40.2f') == '          150000000000000000000.00+3.00j', ('assertEqual', format(1.5e+20 + 3j, '>40.2f'), '          150000000000000000000.00+3.00j')\n    assert format(1.5e+20 + 3j, '^40,.2f') == '  150,000,000,000,000,000,000.00+3.00j  ', ('assertEqual', format(1.5e+20 + 3j, '^40,.2f'), '  150,000,000,000,000,000,000.00+3.00j  ')\n    assert format(1.5e+21 + 3j, '^40,.2f') == ' 1,500,000,000,000,000,000,000.00+3.00j ', ('assertEqual', format(1.5e+21 + 3j, '^40,.2f'), ' 1,500,000,000,000,000,000,000.00+3.00j ')\n    assert format(1.5e+21 + 3000j, ',.2f') == '1,500,000,000,000,000,000,000.00+3,000.00j', ('assertEqual', format(1.5e+21 + 3000j, ',.2f'), '1,500,000,000,000,000,000,000.00+3,000.00j')\n    assert format(1 + 1j, '.0e') == '1e+00+1e+00j', ('assertEqual', format(1 + 1j, '.0e'), '1e+00+1e+00j')\n    assert format(1 + 1j, '#.0e') == '1.e+00+1.e+00j', ('assertEqual', format(1 + 1j, '#.0e'), '1.e+00+1.e+00j')\n    assert format(1 + 1j, '.0f') == '1+1j', ('assertEqual', format(1 + 1j, '.0f'), '1+1j')\n    assert format(1 + 1j, '#.0f') == '1.+1.j', ('assertEqual', format(1 + 1j, '#.0f'), '1.+1.j')\n    assert format(1.1 + 1.1j, 'g') == '1.1+1.1j', ('assertEqual', format(1.1 + 1.1j, 'g'), '1.1+1.1j')\n    assert format(1.1 + 1.1j, '#g') == '1.10000+1.10000j', ('assertEqual', format(1.1 + 1.1j, '#g'), '1.10000+1.10000j')\n    assert format(1 + 1j, '.1e') == '1.0e+00+1.0e+00j', ('assertEqual', format(1 + 1j, '.1e'), '1.0e+00+1.0e+00j')\n    assert format(1 + 1j, '#.1e') == '1.0e+00+1.0e+00j', ('assertEqual', format(1 + 1j, '#.1e'), '1.0e+00+1.0e+00j')\n    assert format(1 + 1j, '.1f') == '1.0+1.0j', ('assertEqual', format(1 + 1j, '.1f'), '1.0+1.0j')\n    assert format(1 + 1j, '#.1f') == '1.0+1.0j', ('assertEqual', format(1 + 1j, '#.1f'), '1.0+1.0j')\n    assert format(-1.5 + 0.5j, '#f') == '-1.500000+0.500000j', ('assertEqual', format(-1.5 + 0.5j, '#f'), '-1.500000+0.500000j')\n    assert format(-1.5 + 0.5j, '#.0f') == '-2.+0.j', ('assertEqual', format(-1.5 + 0.5j, '#.0f'), '-2.+0.j')\n    assert format(-1.5 + 0.5j, '#e') == '-1.500000e+00+5.000000e-01j', ('assertEqual', format(-1.5 + 0.5j, '#e'), '-1.500000e+00+5.000000e-01j')\n    assert format(-1.5 + 0.5j, '#.0e') == '-2.e+00+5.e-01j', ('assertEqual', format(-1.5 + 0.5j, '#.0e'), '-2.e+00+5.e-01j')\n    assert format(-1.5 + 0.5j, '#g') == '-1.50000+0.500000j', ('assertEqual', format(-1.5 + 0.5j, '#g'), '-1.50000+0.500000j')\n    assert format(-1.5 + 0.5j, '.0g') == '-2+0.5j', ('assertEqual', format(-1.5 + 0.5j, '.0g'), '-2+0.5j')\n    assert format(-1.5 + 0.5j, '#.0g') == '-2.+0.5j', ('assertEqual', format(-1.5 + 0.5j, '#.0g'), '-2.+0.5j')\n    try:\n        (1.5 + 0.5j).__format__(*('010f',))\n    except ValueError:\n        pass\n    try:\n        (1.5 + 3j).__format__(*('=20',))\n    except ValueError:\n        pass\n    for t in 'bcdoxX':\n        try:\n            (1.5 + 0.5j).__format__(*(t,))\n        except ValueError:\n            pass\n    assert '*{0:.3f}*'.format(3.14159 + 2.71828j) == '*3.142+2.718j*', ('assertEqual', '*{0:.3f}*'.format(3.14159 + 2.71828j), '*3.142+2.718j*')\n    assert format(complex(NAN, NAN), 'f') == 'nan+nanj', ('assertEqual', format(complex(NAN, NAN), 'f'), 'nan+nanj')\n    assert format(complex(1, NAN), 'f') == '1.000000+nanj', ('assertEqual', format(complex(1, NAN), 'f'), '1.000000+nanj')\n    assert format(complex(NAN, 1), 'f') == 'nan+1.000000j', ('assertEqual', format(complex(NAN, 1), 'f'), 'nan+1.000000j')\n    assert format(complex(NAN, -1), 'f') == 'nan-1.000000j', ('assertEqual', format(complex(NAN, -1), 'f'), 'nan-1.000000j')\n    assert format(complex(NAN, NAN), 'F') == 'NAN+NANj', ('assertEqual', format(complex(NAN, NAN), 'F'), 'NAN+NANj')\n    assert format(complex(1, NAN), 'F') == '1.000000+NANj', ('assertEqual', format(complex(1, NAN), 'F'), '1.000000+NANj')\n    assert format(complex(NAN, 1), 'F') == 'NAN+1.000000j', ('assertEqual', format(complex(NAN, 1), 'F'), 'NAN+1.000000j')\n    assert format(complex(NAN, -1), 'F') == 'NAN-1.000000j', ('assertEqual', format(complex(NAN, -1), 'F'), 'NAN-1.000000j')\n    assert format(complex(INF, INF), 'f') == 'inf+infj', ('assertEqual', format(complex(INF, INF), 'f'), 'inf+infj')\n    assert format(complex(1, INF), 'f') == '1.000000+infj', ('assertEqual', format(complex(1, INF), 'f'), '1.000000+infj')\n    assert format(complex(INF, 1), 'f') == 'inf+1.000000j', ('assertEqual', format(complex(INF, 1), 'f'), 'inf+1.000000j')\n    assert format(complex(INF, -1), 'f') == 'inf-1.000000j', ('assertEqual', format(complex(INF, -1), 'f'), 'inf-1.000000j')\n    assert format(complex(INF, INF), 'F') == 'INF+INFj', ('assertEqual', format(complex(INF, INF), 'F'), 'INF+INFj')\n    assert format(complex(1, INF), 'F') == '1.000000+INFj', ('assertEqual', format(complex(1, INF), 'F'), '1.000000+INFj')\n    assert format(complex(INF, 1), 'F') == 'INF+1.000000j', ('assertEqual', format(complex(INF, 1), 'F'), 'INF+1.000000j')\n    assert format(complex(INF, -1), 'F') == 'INF-1.000000j', ('assertEqual', format(complex(INF, -1), 'F'), 'INF-1.000000j')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
