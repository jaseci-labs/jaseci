test "PullDOMTestCase.test_parse_semantics" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom import pulldom\nSMALL_SAMPLE = '<?xml version=\"1.0\"?>\\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:xdc=\"http://www.xml.com/books\">\\n<!-- A comment -->\\n<title>Introduction to XSL</title>\\n<hr/>\\n<p><xdc:author xdc:attrib=\"prefixed attribute\" attrib=\"other attrib\">A. Namespace</xdc:author></p>\\n</html>'\n\ndef _t():\n    \"\"\"Test DOMEventStream parsing semantics.\"\"\"\n    items = pulldom.parseString(SMALL_SAMPLE)\n    evt, node = next(items)\n    assert hasattr(node, 'createElement'), ('assertHasAttr', node, 'createElement')\n    assert pulldom.START_DOCUMENT == evt, ('assertEqual', pulldom.START_DOCUMENT, evt)\n    evt, node = next(items)\n    assert pulldom.START_ELEMENT == evt, ('assertEqual', pulldom.START_ELEMENT, evt)\n    assert 'html' == node.tagName, ('assertEqual', 'html', node.tagName)\n    assert 2 == len(node.attributes), ('assertEqual', 2, len(node.attributes))\n    assert node.attributes.getNamedItem('xmlns:xdc').value == 'http://www.xml.com/books', ('assertEqual', node.attributes.getNamedItem('xmlns:xdc').value, 'http://www.xml.com/books')\n    evt, node = next(items)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    evt, node = next(items)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    evt, node = next(items)\n    assert 'title' == node.tagName, ('assertEqual', 'title', node.tagName)\n    title_node = node\n    evt, node = next(items)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    assert 'Introduction to XSL' == node.data, ('assertEqual', 'Introduction to XSL', node.data)\n    evt, node = next(items)\n    assert pulldom.END_ELEMENT == evt, ('assertEqual', pulldom.END_ELEMENT, evt)\n    assert 'title' == node.tagName, ('assertEqual', 'title', node.tagName)\n    assert title_node is node, ('assertTrue', title_node is node)\n    evt, node = next(items)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    evt, node = next(items)\n    assert pulldom.START_ELEMENT == evt, ('assertEqual', pulldom.START_ELEMENT, evt)\n    assert 'hr' == node.tagName, ('assertEqual', 'hr', node.tagName)\n    evt, node = next(items)\n    assert pulldom.END_ELEMENT == evt, ('assertEqual', pulldom.END_ELEMENT, evt)\n    assert 'hr' == node.tagName, ('assertEqual', 'hr', node.tagName)\n    evt, node = next(items)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    evt, node = next(items)\n    assert pulldom.START_ELEMENT == evt, ('assertEqual', pulldom.START_ELEMENT, evt)\n    assert 'p' == node.tagName, ('assertEqual', 'p', node.tagName)\n    evt, node = next(items)\n    assert pulldom.START_ELEMENT == evt, ('assertEqual', pulldom.START_ELEMENT, evt)\n    assert 'xdc:author' == node.tagName, ('assertEqual', 'xdc:author', node.tagName)\n    evt, node = next(items)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    evt, node = next(items)\n    assert pulldom.END_ELEMENT == evt, ('assertEqual', pulldom.END_ELEMENT, evt)\n    assert 'xdc:author' == node.tagName, ('assertEqual', 'xdc:author', node.tagName)\n    evt, node = next(items)\n    assert pulldom.END_ELEMENT == evt, ('assertEqual', pulldom.END_ELEMENT, evt)\n    evt, node = next(items)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    evt, node = next(items)\n    assert pulldom.END_ELEMENT == evt, ('assertEqual', pulldom.END_ELEMENT, evt)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PullDOMTestCase.test_expandItem" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom import pulldom\nSMALL_SAMPLE = '<?xml version=\"1.0\"?>\\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:xdc=\"http://www.xml.com/books\">\\n<!-- A comment -->\\n<title>Introduction to XSL</title>\\n<hr/>\\n<p><xdc:author xdc:attrib=\"prefixed attribute\" attrib=\"other attrib\">A. Namespace</xdc:author></p>\\n</html>'\n\ndef _t():\n    \"\"\"Ensure expandItem works as expected.\"\"\"\n    items = pulldom.parseString(SMALL_SAMPLE)\n    for evt, item in items:\n        if evt == pulldom.START_ELEMENT and item.tagName == 'title':\n            items.expandNode(item)\n            assert 1 == len(item.childNodes), ('assertEqual', 1, len(item.childNodes))\n            break\n    else:\n        raise AssertionError('No \"title\" element detected in SMALL_SAMPLE!')\n    for evt, node in items:\n        if evt == pulldom.START_ELEMENT:\n            break\n    assert 'hr' == node.tagName, ('assertEqual', 'hr', node.tagName)\n    items.expandNode(node)\n    assert next(items)[0] == pulldom.CHARACTERS, ('assertEqual', next(items)[0], pulldom.CHARACTERS)\n    evt, node = next(items)\n    assert node.tagName == 'p', ('assertEqual', node.tagName, 'p')\n    items.expandNode(node)\n    next(items)\n    evt, node = next(items)\n    assert node.tagName == 'html', ('assertEqual', node.tagName, 'html')\n    try:\n        next(items)\n    except StopIteration as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    items.clear()\n    assert items.parser is None, ('assertIsNone', items.parser)\n    assert items.stream is None, ('assertIsNone', items.stream)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PullDOMTestCase.test_external_ges_default" {
    (ok, detail) = p2_libtest_run_snippet("from xml.sax.handler import feature_external_ges\nfrom xml.dom import pulldom\nSMALL_SAMPLE = '<?xml version=\"1.0\"?>\\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:xdc=\"http://www.xml.com/books\">\\n<!-- A comment -->\\n<title>Introduction to XSL</title>\\n<hr/>\\n<p><xdc:author xdc:attrib=\"prefixed attribute\" attrib=\"other attrib\">A. Namespace</xdc:author></p>\\n</html>'\n\ndef _t():\n    parser = pulldom.parseString(SMALL_SAMPLE)\n    saxparser = parser.parser\n    ges = saxparser.getFeature(feature_external_ges)\n    assert ges == False, ('assertEqual', ges, False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

