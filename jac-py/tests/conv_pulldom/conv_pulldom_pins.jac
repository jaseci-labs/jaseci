test "PullDOMTestCase.test_expandItem" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom import pulldom\nSMALL_SAMPLE = '<?xml version=\"1.0\"?>\\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:xdc=\"http://www.xml.com/books\">\\n<!-- A comment -->\\n<title>Introduction to XSL</title>\\n<hr/>\\n<p><xdc:author xdc:attrib=\"prefixed attribute\" attrib=\"other attrib\">A. Namespace</xdc:author></p>\\n</html>'\n\ndef _t():\n    \"\"\"Ensure expandItem works as expected.\"\"\"\n    items = pulldom.parseString(SMALL_SAMPLE)\n    for evt, item in items:\n        if evt == pulldom.START_ELEMENT and item.tagName == 'title':\n            items.expandNode(item)\n            assert 1 == len(item.childNodes), ('assertEqual', 1, len(item.childNodes))\n            break\n    else:\n        raise AssertionError('No \"title\" element detected in SMALL_SAMPLE!')\n    for evt, node in items:\n        if evt == pulldom.START_ELEMENT:\n            break\n    assert 'hr' == node.tagName, ('assertEqual', 'hr', node.tagName)\n    items.expandNode(node)\n    assert next(items)[0] == pulldom.CHARACTERS, ('assertEqual', next(items)[0], pulldom.CHARACTERS)\n    evt, node = next(items)\n    assert node.tagName == 'p', ('assertEqual', node.tagName, 'p')\n    items.expandNode(node)\n    next(items)\n    evt, node = next(items)\n    assert node.tagName == 'html', ('assertEqual', node.tagName, 'html')\n    try:\n        next(items)\n    except StopIteration as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    items.clear()\n    assert items.parser is None, ('assertIsNone', items.parser)\n    assert items.stream is None, ('assertIsNone', items.stream)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PullDOMTestCase.test_external_ges_default" {
    (ok, detail) = p2_libtest_run_snippet("from xml.sax.handler import feature_external_ges\nfrom xml.dom import pulldom\nSMALL_SAMPLE = '<?xml version=\"1.0\"?>\\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:xdc=\"http://www.xml.com/books\">\\n<!-- A comment -->\\n<title>Introduction to XSL</title>\\n<hr/>\\n<p><xdc:author xdc:attrib=\"prefixed attribute\" attrib=\"other attrib\">A. Namespace</xdc:author></p>\\n</html>'\n\ndef _t():\n    parser = pulldom.parseString(SMALL_SAMPLE)\n    saxparser = parser.parser\n    ges = saxparser.getFeature(feature_external_ges)\n    assert ges == False, ('assertEqual', ges, False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SAX2DOMTestCase.testSAX2DOM" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom import pulldom\n\ndef _t():\n    \"\"\"Ensure SAX2DOM expands nodes as expected.\"\"\"\n    sax2dom = pulldom.SAX2DOM()\n    sax2dom.startDocument()\n    sax2dom.startElement('doc', {})\n    sax2dom.characters('text')\n    sax2dom.startElement('subelm', {})\n    sax2dom.characters('text')\n    sax2dom.endElement('subelm')\n    sax2dom.characters('text')\n    sax2dom.endElement('doc')\n    sax2dom.endDocument()\n    doc = sax2dom.document\n    root = doc.documentElement\n    text1, elm1, text2 = root.childNodes\n    text3 = elm1.childNodes[0]\n    assert text1.previousSibling is None, ('assertIsNone', text1.previousSibling)\n    assert text1.nextSibling is elm1, ('assertIs', text1.nextSibling, elm1)\n    assert elm1.previousSibling is text1, ('assertIs', elm1.previousSibling, text1)\n    assert elm1.nextSibling is text2, ('assertIs', elm1.nextSibling, text2)\n    assert text2.previousSibling is elm1, ('assertIs', text2.previousSibling, elm1)\n    assert text2.nextSibling is None, ('assertIsNone', text2.nextSibling)\n    assert text3.previousSibling is None, ('assertIsNone', text3.previousSibling)\n    assert text3.nextSibling is None, ('assertIsNone', text3.nextSibling)\n    assert root.parentNode is doc, ('assertIs', root.parentNode, doc)\n    assert text1.parentNode is root, ('assertIs', text1.parentNode, root)\n    assert elm1.parentNode is root, ('assertIs', elm1.parentNode, root)\n    assert text2.parentNode is root, ('assertIs', text2.parentNode, root)\n    assert text3.parentNode is elm1, ('assertIs', text3.parentNode, elm1)\n    doc.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
