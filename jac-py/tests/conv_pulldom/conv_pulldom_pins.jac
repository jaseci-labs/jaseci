test "ThoroughTestCase.test_thorough_sax2dom" {
    (ok, detail) = p2_libtest_run_snippet("import xml.sax\nfrom xml.sax.xmlreader import AttributesImpl\nfrom xml.dom import pulldom\n\nclass SAXExerciser(object):\n    \"\"\"A fake sax parser that calls some of the harder-to-reach sax methods to\n    ensure it emits the correct events\"\"\"\n\n    def setContentHandler(self, handler):\n        self._handler = handler\n\n    def parse(self, _):\n        h = self._handler\n        h.startDocument()\n        h.comment('a comment')\n        h.processingInstruction('target', 'data')\n        h.startElement('html', AttributesImpl({}))\n        h.comment('a comment')\n        h.processingInstruction('target', 'data')\n        h.startElement('p', AttributesImpl({'class': 'paraclass'}))\n        h.characters('text')\n        h.endElement('p')\n        h.endElement('html')\n        h.endDocument()\n\n    def stub(self, *args, **kwargs):\n        \"\"\"Stub method. Does nothing.\"\"\"\n        pass\n    setProperty = stub\n    setFeature = stub\n\nclass SAX2DOMExerciser(SAXExerciser):\n    \"\"\"The same as SAXExerciser, but without the processing instruction and\n    comment before the root element, because S2D can\"t handle it\"\"\"\n\n    def parse(self, _):\n        h = self._handler\n        h.startDocument()\n        h.startElement('html', AttributesImpl({}))\n        h.comment('a comment')\n        h.processingInstruction('target', 'data')\n        h.startElement('p', AttributesImpl({'class': 'paraclass'}))\n        h.characters('text')\n        h.endElement('p')\n        h.endElement('html')\n        h.endDocument()\n\nclass SAX2DOMTestHelper(pulldom.DOMEventStream):\n    \"\"\"Allows us to drive SAX2DOM from a DOMEventStream.\"\"\"\n\n    def reset(self):\n        self.pulldom = pulldom.SAX2DOM()\n        self.parser.setFeature(xml.sax.handler.feature_namespaces, 1)\n        self.parser.setContentHandler(self.pulldom)\n\ndef _test_thorough(pd, before_root=True):\n    \"\"\"Test some of the hard-to-reach parts of the parser, using a mock\n        parser.\"\"\"\n    evt, node = next(pd)\n    assert pulldom.START_DOCUMENT == evt, ('assertEqual', pulldom.START_DOCUMENT, evt)\n    assert hasattr(node, 'createElement'), ('assertHasAttr', node, 'createElement')\n    if before_root:\n        evt, node = next(pd)\n        assert pulldom.COMMENT == evt, ('assertEqual', pulldom.COMMENT, evt)\n        assert 'a comment' == node.data, ('assertEqual', 'a comment', node.data)\n        evt, node = next(pd)\n        assert pulldom.PROCESSING_INSTRUCTION == evt, ('assertEqual', pulldom.PROCESSING_INSTRUCTION, evt)\n        assert 'target' == node.target, ('assertEqual', 'target', node.target)\n        assert 'data' == node.data, ('assertEqual', 'data', node.data)\n    evt, node = next(pd)\n    assert pulldom.START_ELEMENT == evt, ('assertEqual', pulldom.START_ELEMENT, evt)\n    assert 'html' == node.tagName, ('assertEqual', 'html', node.tagName)\n    evt, node = next(pd)\n    assert pulldom.COMMENT == evt, ('assertEqual', pulldom.COMMENT, evt)\n    assert 'a comment' == node.data, ('assertEqual', 'a comment', node.data)\n    evt, node = next(pd)\n    assert pulldom.PROCESSING_INSTRUCTION == evt, ('assertEqual', pulldom.PROCESSING_INSTRUCTION, evt)\n    assert 'target' == node.target, ('assertEqual', 'target', node.target)\n    assert 'data' == node.data, ('assertEqual', 'data', node.data)\n    evt, node = next(pd)\n    assert pulldom.START_ELEMENT == evt, ('assertEqual', pulldom.START_ELEMENT, evt)\n    assert 'p' == node.tagName, ('assertEqual', 'p', node.tagName)\n    evt, node = next(pd)\n    assert pulldom.CHARACTERS == evt, ('assertEqual', pulldom.CHARACTERS, evt)\n    assert 'text' == node.data, ('assertEqual', 'text', node.data)\n    evt, node = next(pd)\n    assert pulldom.END_ELEMENT == evt, ('assertEqual', pulldom.END_ELEMENT, evt)\n    assert 'p' == node.tagName, ('assertEqual', 'p', node.tagName)\n    evt, node = next(pd)\n    assert pulldom.END_ELEMENT == evt, ('assertEqual', pulldom.END_ELEMENT, evt)\n    assert 'html' == node.tagName, ('assertEqual', 'html', node.tagName)\n    evt, node = next(pd)\n    assert pulldom.END_DOCUMENT == evt, ('assertEqual', pulldom.END_DOCUMENT, evt)\n\ndef _t():\n    \"\"\"Test some of the hard-to-reach parts of SAX2DOM.\"\"\"\n    pd = SAX2DOMTestHelper(None, SAX2DOMExerciser(), 12)\n    _test_thorough(pd, False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SAX2DOMTestCase.test_basic" {
    (ok, detail) = p2_libtest_run_snippet("import io\nimport xml.sax\nfrom xml.dom import pulldom\nSMALL_SAMPLE = '<?xml version=\"1.0\"?>\\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:xdc=\"http://www.xml.com/books\">\\n<!-- A comment -->\\n<title>Introduction to XSL</title>\\n<hr/>\\n<p><xdc:author xdc:attrib=\"prefixed attribute\" attrib=\"other attrib\">A. Namespace</xdc:author></p>\\n</html>'\n\nclass SAX2DOMTestHelper(pulldom.DOMEventStream):\n    \"\"\"Allows us to drive SAX2DOM from a DOMEventStream.\"\"\"\n\n    def reset(self):\n        self.pulldom = pulldom.SAX2DOM()\n        self.parser.setFeature(xml.sax.handler.feature_namespaces, 1)\n        self.parser.setContentHandler(self.pulldom)\n\ndef _t():\n    \"\"\"Ensure SAX2DOM can parse from a stream.\"\"\"\n    with io.StringIO(SMALL_SAMPLE) as fin:\n        sd = SAX2DOMTestHelper(fin, xml.sax.make_parser(), len(SMALL_SAMPLE))\n        for evt, node in sd:\n            if evt == pulldom.START_ELEMENT and node.tagName == 'html':\n                break\n        assert len(node.childNodes) > 0, ('assertGreater', len(node.childNodes), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SAX2DOMTestCase.testSAX2DOM" {
    (ok, detail) = p2_libtest_run_snippet("from xml.dom import pulldom\n\ndef _t():\n    \"\"\"Ensure SAX2DOM expands nodes as expected.\"\"\"\n    sax2dom = pulldom.SAX2DOM()\n    sax2dom.startDocument()\n    sax2dom.startElement('doc', {})\n    sax2dom.characters('text')\n    sax2dom.startElement('subelm', {})\n    sax2dom.characters('text')\n    sax2dom.endElement('subelm')\n    sax2dom.characters('text')\n    sax2dom.endElement('doc')\n    sax2dom.endDocument()\n    doc = sax2dom.document\n    root = doc.documentElement\n    text1, elm1, text2 = root.childNodes\n    text3 = elm1.childNodes[0]\n    assert text1.previousSibling is None, ('assertIsNone', text1.previousSibling)\n    assert text1.nextSibling is elm1, ('assertIs', text1.nextSibling, elm1)\n    assert elm1.previousSibling is text1, ('assertIs', elm1.previousSibling, text1)\n    assert elm1.nextSibling is text2, ('assertIs', elm1.nextSibling, text2)\n    assert text2.previousSibling is elm1, ('assertIs', text2.previousSibling, elm1)\n    assert text2.nextSibling is None, ('assertIsNone', text2.nextSibling)\n    assert text3.previousSibling is None, ('assertIsNone', text3.previousSibling)\n    assert text3.nextSibling is None, ('assertIsNone', text3.nextSibling)\n    assert root.parentNode is doc, ('assertIs', root.parentNode, doc)\n    assert text1.parentNode is root, ('assertIs', text1.parentNode, root)\n    assert elm1.parentNode is root, ('assertIs', elm1.parentNode, root)\n    assert text2.parentNode is root, ('assertIs', text2.parentNode, root)\n    assert text3.parentNode is elm1, ('assertIs', text3.parentNode, elm1)\n    doc.unlink()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
