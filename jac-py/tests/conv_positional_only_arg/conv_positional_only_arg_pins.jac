}

test "PositionalOnlyTestCase.test_too_many_arguments" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    fundef = 'def f(%s, /):\\n  pass\\n' % ', '.join(('i%d' % i for i in range(300)))\n    compile(fundef, '<test>', 'single')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PositionalOnlyTestCase.test_serialization" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport pickle\n\ndef global_pos_only_f(a, b, /):\n    return (a, b)\n\ndef global_pos_only_and_normal(a, /, b):\n    return (a, b)\n\ndef global_pos_only_defaults(a=1, /, b=2):\n    return (a, b)\n\ndef _t():\n    pickled_posonly = pickle.dumps(global_pos_only_f)\n    pickled_optional = pickle.dumps(global_pos_only_and_normal)\n    pickled_defaults = pickle.dumps(global_pos_only_defaults)\n    unpickled_posonly = pickle.loads(pickled_posonly)\n    unpickled_optional = pickle.loads(pickled_optional)\n    unpickled_defaults = pickle.loads(pickled_defaults)\n    assert unpickled_posonly(1, 2) == (1, 2), ('assertEqual', unpickled_posonly(1, 2), (1, 2))\n    expected = \"global_pos_only_f\\\\(\\\\) got some positional-only arguments passed as keyword arguments: 'a, b'\"\n    try:\n        unpickled_posonly(a=1, b=2)\n    except TypeError as _exc:\n        assert _re.search(expected, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert unpickled_optional(1, 2) == (1, 2), ('assertEqual', unpickled_optional(1, 2), (1, 2))\n    expected = \"global_pos_only_and_normal\\\\(\\\\) got some positional-only arguments passed as keyword arguments: 'a'\"\n    try:\n        unpickled_optional(a=1, b=2)\n    except TypeError as _exc:\n        assert _re.search(expected, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert unpickled_defaults() == (1, 2), ('assertEqual', unpickled_defaults(), (1, 2))\n    expected = \"global_pos_only_defaults\\\\(\\\\) got some positional-only arguments passed as keyword arguments: 'a'\"\n    try:\n        unpickled_defaults(a=1, b=2)\n    except TypeError as _exc:\n        assert _re.search(expected, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PositionalOnlyTestCase.test_async" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef global_pos_only_f(a, b, /):\n    return (a, b)\n\ndef global_pos_only_and_normal(a, /, b):\n    return (a, b)\n\ndef global_pos_only_defaults(a=1, /, b=2):\n    return (a, b)\n\ndef _t():\n\n    async def f(a=1, /, b=2):\n        return (a, b)\n    try:\n        f(a=1, b=2)\n    except TypeError as _exc:\n        assert _re.search(\"f\\\\(\\\\) got some positional-only arguments passed as keyword arguments: 'a'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    def _check_call(*args, **kwargs):\n        try:\n            coro = f(*args, **kwargs)\n            coro.send(None)\n        except StopIteration as e:\n            result = e.value\n        assert result == (1, 2), ('assertEqual', result, (1, 2))\n    _check_call(1, 2)\n    _check_call(1, b=2)\n    _check_call(1)\n    _check_call()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PositionalOnlyTestCase.test_generator" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef global_pos_only_f(a, b, /):\n    return (a, b)\n\ndef global_pos_only_and_normal(a, /, b):\n    return (a, b)\n\ndef global_pos_only_defaults(a=1, /, b=2):\n    return (a, b)\n\ndef _t():\n\n    def f(a=1, /, b=2):\n        yield (a, b)\n    try:\n        f(a=1, b=2)\n    except TypeError as _exc:\n        assert _re.search(\"f\\\\(\\\\) got some positional-only arguments passed as keyword arguments: 'a'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    gen = f(1, 2)\n    assert next(gen) == (1, 2), ('assertEqual', next(gen), (1, 2))\n    gen = f(1, b=2)\n    assert next(gen) == (1, 2), ('assertEqual', next(gen), (1, 2))\n    gen = f(1)\n    assert next(gen) == (1, 2), ('assertEqual', next(gen), (1, 2))\n    gen = f()\n    assert next(gen) == (1, 2), ('assertEqual', next(gen), (1, 2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PositionalOnlyTestCase.test_super" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    sentinel = object()\n\n    class A:\n\n        def method(self):\n            return sentinel\n\n    class C(A):\n\n        def method(self, /):\n            return super().method()\n    assert C().method() == sentinel, ('assertEqual', C().method(), sentinel)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PositionalOnlyTestCase.test_annotations_constant_fold" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport types\n\ndef _t():\n\n    def g():\n\n        def f(x: not int is int, /):\n            ...\n    code_obj = next((const for const in g.__code__.co_consts if isinstance(const, types.CodeType) and const.co_name == '__annotate__'))\n    codes = [(i.opname, i.argval) for i in dis.get_instructions(code_obj)]\n    assert ('UNARY_NOT', None) not in codes, ('assertNotIn', ('UNARY_NOT', None), codes)\n    assert ('IS_OP', 1) in codes, ('assertIn', ('IS_OP', 1), codes)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
