test "PositionalOnlyTestCase.test_closures" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n\n    def f(x, y):\n\n        def g(x2, /, y2):\n            return x + y + x2 + y2\n        return g\n    assert f(1, 2)(3, 4) == 10, ('assertEqual', f(1, 2)(3, 4), 10)\n    try:\n        f(1, 2)(3)\n    except TypeError as _exc:\n        assert _re.search(\"g\\\\(\\\\) missing 1 required positional argument: 'y2'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        f(1, 2)(3, 4, 5)\n    except TypeError as _exc:\n        assert _re.search('g\\\\(\\\\) takes 2 positional arguments but 3 were given', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    def f(x, /, y):\n\n        def g(x2, y2):\n            return x + y + x2 + y2\n        return g\n    assert f(1, 2)(3, 4) == 10, ('assertEqual', f(1, 2)(3, 4), 10)\n\n    def f(x, /, y):\n\n        def g(x2, /, y2):\n            return x + y + x2 + y2\n        return g\n    assert f(1, 2)(3, 4) == 10, ('assertEqual', f(1, 2)(3, 4), 10)\n    try:\n        f(1, 2)(3)\n    except TypeError as _exc:\n        assert _re.search(\"g\\\\(\\\\) missing 1 required positional argument: 'y2'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        f(1, 2)(3, 4, 5)\n    except TypeError as _exc:\n        assert _re.search('g\\\\(\\\\) takes 2 positional arguments but 3 were given', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

