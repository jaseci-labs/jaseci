test "LongWordTestCase.test_break_long" {
    (ok, detail) = p2_libtest_run_snippet("from textwrap import TextWrapper, wrap, fill, dedent, indent, shorten\n\ndef show(textin):\n    if isinstance(textin, list):\n        result = []\n        for i in range(len(textin)):\n            result.append('  %d: %r' % (i, textin[i]))\n        result = '\\n'.join(result) if result else '  no lines'\n    elif isinstance(textin, str):\n        result = '  %s\\n' % repr(textin)\n    return result\n\ndef check(result, expect):\n    assert result == expect, ('assertEqual', result, expect)\n\ndef check_wrap(text, width, expect, **kwargs):\n    result = wrap(text, width, **kwargs)\n    check(result, expect)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.wrapper = TextWrapper()\n    self.text = 'Did you say \"supercalifragilisticexpialidocious?\"\\nHow *do* you spell that odd word, anyways?\\n'\n    check_wrap(self.text, 30, ['Did you say \"supercalifragilis', 'ticexpialidocious?\" How *do*', 'you spell that odd word,', 'anyways?'])\n    check_wrap(self.text, 50, ['Did you say \"supercalifragilisticexpialidocious?\"', 'How *do* you spell that odd word, anyways?'])\n    check_wrap('-' * 10 + 'hello', 10, ['----------', '               h', '               e', '               l', '               l', '               o'], subsequent_indent=' ' * 15)\n    check_wrap(self.text, 12, ['Did you say', '\"supercalifr', 'agilisticexp', 'ialidocious?', '\" How *do*', 'you spell', 'that odd', 'word,', 'anyways?'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

