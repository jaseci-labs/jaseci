}

test "IndentTestCases.test_subsequent_indent" {
    (ok, detail) = p2_libtest_run_snippet("from textwrap import TextWrapper, wrap, fill, dedent, indent, shorten\n\ndef show(textin):\n    if isinstance(textin, list):\n        result = []\n        for i in range(len(textin)):\n            result.append('  %d: %r' % (i, textin[i]))\n        result = '\\n'.join(result) if result else '  no lines'\n    elif isinstance(textin, str):\n        result = '  %s\\n' % repr(textin)\n    return result\n\ndef check(result, expect):\n    assert result == expect, ('assertEqual', result, expect)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.text = 'This paragraph will be filled, first without any indentation,\\nand then with some (including a hanging indent).'\n    expect = '  * This paragraph will be filled, first\\n    without any indentation, and then\\n    with some (including a hanging\\n    indent).'\n    result = fill(self.text, 40, initial_indent='  * ', subsequent_indent='    ')\n    check(result, expect)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "DedentTestCase.test_type_error" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom textwrap import TextWrapper, wrap, fill, dedent, indent, shorten\n\ndef _t():\n    try:\n        dedent(0)\n    except TypeError as _exc:\n        assert _re.search('expected str object, not', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        dedent(b'')\n    except TypeError as _exc:\n        assert _re.search('expected str object, not', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "DedentTestCase.test_dedent_whitespace" {
    (ok, detail) = p2_libtest_run_snippet("from textwrap import TextWrapper, wrap, fill, dedent, indent, shorten\n\ndef assertUnchanged(text):\n    \"\"\"assert that dedent() has no effect on 'text'\"\"\"\n    assert text == dedent(text), ('assertEqual', text, dedent(text))\n\ndef _t():\n    text = ''\n    assertUnchanged(text)\n    text = '    '\n    expect = ''\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = '\\t\\t\\t\\t'\n    expect = ''\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = ' \\t  \\t\\t  \\t '\n    expect = ''\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = '\\x0c\\n\\r\\t\\x0b '\n    expect = '\\n'\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = '\\n'\n    expect = '\\n'\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = '\\r\\n' * 5\n    expect = '\\n' * 5\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = '    \\n\\t\\n  \\n\\t\\t\\n\\n\\n       '\n    expect = '\\n\\n\\n\\n\\n\\n'\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = 'a\\n \\n\\t\\n'\n    expect = 'a\\n\\n\\n'\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\n    text = 'a\\r\\n\\r\\n\\r\\n'\n    expect = 'a\\r\\n\\n\\n'\n    assert expect == dedent(text), ('assertEqual', expect, dedent(text))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

