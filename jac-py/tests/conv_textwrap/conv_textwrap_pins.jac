test "WrapTestCase.test_simple" {
    (ok, detail) = p2_libtest_run_snippet("from textwrap import TextWrapper, wrap, fill, dedent, indent, shorten\n\ndef show(textin):\n    if isinstance(textin, list):\n        result = []\n        for i in range(len(textin)):\n            result.append('  %d: %r' % (i, textin[i]))\n        result = '\\n'.join(result) if result else '  no lines'\n    elif isinstance(textin, str):\n        result = '  %s\\n' % repr(textin)\n    return result\n\ndef check(result, expect):\n    assert result == expect, ('assertEqual', result, expect)\n\ndef check_wrap(text, width, expect, **kwargs):\n    result = wrap(text, width, **kwargs)\n    check(result, expect)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.wrapper = TextWrapper(width=45)\n    text = \"Hello there, how are you this fine day?  I'm glad to hear it!\"\n    check_wrap(text, 12, ['Hello there,', 'how are you', 'this fine', \"day?  I'm\", 'glad to hear', 'it!'])\n    check_wrap(text, 42, ['Hello there, how are you this fine day?', \"I'm glad to hear it!\"])\n    check_wrap(text, 80, [text])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

