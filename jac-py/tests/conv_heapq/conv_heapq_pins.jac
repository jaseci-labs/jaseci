test "TestHeapPython.test_heapsort" {
    (ok, detail) = p2_libtest_run_snippet("import random\nimport doctest\nfrom test.support import import_helper\npy_heapq = import_helper.import_fresh_module('heapq', blocked=['_heapq'])\n\ndef load_tests(loader, tests, ignore):\n\n    class HeapqMergeDocTestFinder:\n\n        def find(self, *args, **kwargs):\n            dtf = doctest.DocTestFinder()\n            return dtf.find(py_heapq.merge)\n    tests.addTests(doctest.DocTestSuite(py_heapq, test_finder=HeapqMergeDocTestFinder()))\n    return tests\n\nclass _SelfNS:\n    pass\nself = _SelfNS()\nself.module = py_heapq\n\ndef _t():\n    for trial in range(100):\n        size = random.randrange(50)\n        data = [random.randrange(25) for i in range(size)]\n        if trial & 1:\n            heap = data[:]\n            self.module.heapify(heap)\n        else:\n            heap = []\n            for item in data:\n                self.module.heappush(heap, item)\n        heap_sorted = [self.module.heappop(heap) for i in range(size)]\n        assert heap_sorted == sorted(data), ('assertEqual', heap_sorted, sorted(data))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

