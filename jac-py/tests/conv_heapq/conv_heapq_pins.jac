    (ok, detail) = p2_libtest_run_snippet("import random\nimport doctest\nfrom test.support import import_helper\npy_heapq = import_helper.import_fresh_module('heapq', blocked=['_heapq'])\n\ndef load_tests(loader, tests, ignore):\n\n    class HeapqMergeDocTestFinder:\n\n        def find(self, *args, **kwargs):\n            dtf = doctest.DocTestFinder()\n            return dtf.find(py_heapq.merge)\n    tests.addTests(doctest.DocTestSuite(py_heapq, test_finder=HeapqMergeDocTestFinder()))\n    return tests\n\nclass _SelfNS:\n    pass\nself = _SelfNS()\nself.module = py_heapq\n\ndef heapiter_max(heap):\n    try:\n        while 1:\n            yield self.module.heappop_max(heap)\n    except IndexError:\n        pass\n\ndef _t():\n    data = [random.randrange(2000) for i in range(1000)]\n    heap = data[:10]\n    self.module.heapify_max(heap)\n    for item in data[10:]:\n        self.module.heappushpop_max(heap, item)\n    expected = sorted(data, reverse=True)[-10:]\n    assert list(heapiter_max(heap)) == expected, ('assertEqual', list(heapiter_max(heap)), expected)\n    assert self.module.heappushpop_max([], 'x') == 'x', ('assertEqual', self.module.heappushpop_max([], 'x'), 'x')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestHeapPython.test_heappushpop" {
    (ok, detail) = p2_libtest_run_snippet("import doctest\nfrom test.support import import_helper\npy_heapq = import_helper.import_fresh_module('heapq', blocked=['_heapq'])\n\ndef load_tests(loader, tests, ignore):\n\n    class HeapqMergeDocTestFinder:\n\n        def find(self, *args, **kwargs):\n            dtf = doctest.DocTestFinder()\n            return dtf.find(py_heapq.merge)\n    tests.addTests(doctest.DocTestSuite(py_heapq, test_finder=HeapqMergeDocTestFinder()))\n    return tests\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\nclass _SelfNS:\n    pass\nself = _SelfNS()\nself.module = py_heapq\n\ndef _t():\n    h = []\n    x = self.module.heappushpop(h, 10)\n    assert (h, x) == ([], 10), ('assertEqual', (h, x), ([], 10))\n    h = [10]\n    x = self.module.heappushpop(h, 10.0)\n    assert (h, x) == ([10], 10.0), ('assertEqual', (h, x), ([10], 10.0))\n    assert type(h[0]) == int, ('assertEqual', type(h[0]), int)\n    assert type(x) == float, ('assertEqual', type(x), float)\n    h = [10]\n    x = self.module.heappushpop(h, 9)\n    assert (h, x) == ([10], 9), ('assertEqual', (h, x), ([10], 9))\n    h = [10]\n    x = self.module.heappushpop(h, 11)\n    assert (h, x) == ([11], 10), ('assertEqual', (h, x), ([11], 10))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

