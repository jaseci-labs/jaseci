test "TestHeapPython.test_merge" {
    (ok, detail) = p2_libtest_run_snippet("import random\nimport doctest\nfrom test.support import import_helper\nfrom operator import itemgetter\npy_heapq = import_helper.import_fresh_module('heapq', blocked=['_heapq'])\n\ndef load_tests(loader, tests, ignore):\n\n    class HeapqMergeDocTestFinder:\n\n        def find(self, *args, **kwargs):\n            dtf = doctest.DocTestFinder()\n            return dtf.find(py_heapq.merge)\n    tests.addTests(doctest.DocTestSuite(py_heapq, test_finder=HeapqMergeDocTestFinder()))\n    return tests\nfrom itertools import chain\n\nclass _SelfNS:\n    pass\nself = _SelfNS()\nself.module = py_heapq\n\ndef _t():\n    inputs = []\n    for i in range(random.randrange(25)):\n        row = []\n        for j in range(random.randrange(100)):\n            tup = (random.choice('ABC'), random.randrange(-500, 500))\n            row.append(tup)\n        inputs.append(row)\n    for key in [None, itemgetter(0), itemgetter(1), itemgetter(1, 0)]:\n        for reverse in [False, True]:\n            seqs = []\n            for seq in inputs:\n                seqs.append(sorted(seq, key=key, reverse=reverse))\n            assert sorted(chain(*inputs), key=key, reverse=reverse) == list(self.module.merge(*seqs, key=key, reverse=reverse)), ('assertEqual', sorted(chain(*inputs), key=key, reverse=reverse), list(self.module.merge(*seqs, key=key, reverse=reverse)))\n            assert list(self.module.merge()) == [], ('assertEqual', list(self.module.merge()), [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

