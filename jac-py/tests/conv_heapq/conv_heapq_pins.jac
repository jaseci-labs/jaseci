test "TestErrorHandlingPython.test_comparison_operator_modifying_heap_two_heaps" {
    (ok, detail) = p2_libtest_run_snippet("import doctest\nfrom test.support import import_helper\npy_heapq = import_helper.import_fresh_module('heapq', blocked=['_heapq'])\n\ndef load_tests(loader, tests, ignore):\n\n    class HeapqMergeDocTestFinder:\n\n        def find(self, *args, **kwargs):\n            dtf = doctest.DocTestFinder()\n            return dtf.find(py_heapq.merge)\n    tests.addTests(doctest.DocTestSuite(py_heapq, test_finder=HeapqMergeDocTestFinder()))\n    return tests\n\nclass _SelfNS:\n    pass\nself = _SelfNS()\nself.module = py_heapq\n\ndef _t():\n\n    class h(int):\n\n        def __lt__(self, o):\n            list2.clear()\n            return NotImplemented\n\n    class g(int):\n\n        def __lt__(self, o):\n            list1.clear()\n            return NotImplemented\n    list1, list2 = ([], [])\n    self.module.heappush(list1, h(0))\n    self.module.heappush(list2, g(0))\n    try:\n        self.module.heappush(*(list1, g(1)))\n    except (IndexError, RuntimeError):\n        pass\n    try:\n        self.module.heappush(*(list2, h(1)))\n    except (IndexError, RuntimeError):\n        pass\n    list1, list2 = ([], [])\n    self.module.heappush_max(list1, h(0))\n    self.module.heappush_max(list2, g(0))\n    self.module.heappush_max(list1, g(1))\n    self.module.heappush_max(list2, h(1))\n    try:\n        self.module.heappush_max(*(list1, g(1)))\n    except (IndexError, RuntimeError):\n        pass\n    try:\n        self.module.heappush_max(*(list2, h(1)))\n    except (IndexError, RuntimeError):\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

