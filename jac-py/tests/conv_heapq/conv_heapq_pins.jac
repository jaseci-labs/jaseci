test "TestHeapPython.test_comparison_operator" {
    (ok, detail) = p2_libtest_run_snippet("import random\nimport doctest\nfrom test.support import import_helper\npy_heapq = import_helper.import_fresh_module('heapq', blocked=['_heapq'])\n\ndef load_tests(loader, tests, ignore):\n\n    class HeapqMergeDocTestFinder:\n\n        def find(self, *args, **kwargs):\n            dtf = doctest.DocTestFinder()\n            return dtf.find(py_heapq.merge)\n    tests.addTests(doctest.DocTestSuite(py_heapq, test_finder=HeapqMergeDocTestFinder()))\n    return tests\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\nclass _SelfNS:\n    pass\nself = _SelfNS()\nself.module = py_heapq\n\ndef _t():\n\n    def hsort(data, comp):\n        data = [comp(x) for x in data]\n        self.module.heapify(data)\n        return [self.module.heappop(data).x for i in range(len(data))]\n\n    class LT:\n\n        def __init__(self, x):\n            self.x = x\n\n        def __lt__(self, other):\n            return self.x > other.x\n\n    class LE:\n\n        def __init__(self, x):\n            self.x = x\n\n        def __le__(self, other):\n            return self.x >= other.x\n    data = [random.random() for i in range(100)]\n    target = sorted(data, reverse=True)\n    assert hsort(data, LT) == target, ('assertEqual', hsort(data, LT), target)\n    try:\n        data(*(LE,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestHeapC.test_comparison_operator" {
    (ok, detail) = p2_libtest_run_snippet("import random\nimport doctest\nfrom test.support import import_helper\npy_heapq = import_helper.import_fresh_module('heapq', blocked=['_heapq'])\nc_heapq = import_helper.import_fresh_module('heapq', fresh=['_heapq'])\n\ndef load_tests(loader, tests, ignore):\n\n    class HeapqMergeDocTestFinder:\n\n        def find(self, *args, **kwargs):\n            dtf = doctest.DocTestFinder()\n            return dtf.find(py_heapq.merge)\n    tests.addTests(doctest.DocTestSuite(py_heapq, test_finder=HeapqMergeDocTestFinder()))\n    return tests\n\ndef R(seqn):\n    \"\"\"Regular generator\"\"\"\n    for i in seqn:\n        yield i\n\nclass G:\n    \"\"\"Sequence using __getitem__\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n\n    def __getitem__(self, i):\n        return self.seqn[i]\n\nclass Ig:\n    \"\"\"Sequence using iterator protocol defined with a generator\"\"\"\n\n    def __init__(self, seqn):\n        self.seqn = seqn\n        self.i = 0\n\n    def __iter__(self):\n        for val in self.seqn:\n            yield val\nfrom itertools import chain\n\ndef L(seqn):\n    \"\"\"Test multiple tiers of iterators\"\"\"\n    return chain(map(lambda x: x, R(Ig(G(seqn)))))\n\nclass _SelfNS:\n    pass\nself = _SelfNS()\nself.module = c_heapq\n\ndef _t():\n\n    def hsort(data, comp):\n        data = [comp(x) for x in data]\n        self.module.heapify(data)\n        return [self.module.heappop(data).x for i in range(len(data))]\n\n    class LT:\n\n        def __init__(self, x):\n            self.x = x\n\n        def __lt__(self, other):\n            return self.x > other.x\n\n    class LE:\n\n        def __init__(self, x):\n            self.x = x\n\n        def __le__(self, other):\n            return self.x >= other.x\n    data = [random.random() for i in range(100)]\n    target = sorted(data, reverse=True)\n    assert hsort(data, LT) == target, ('assertEqual', hsort(data, LT), target)\n    try:\n        data(*(LE,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

