    (ok, detail) = p2_libtest_run_snippet("import csv\n\ndef _t():\n    try:\n        csv.list_dialects(*(None,))\n    except TypeError:\n        pass\n    try:\n        csv.get_dialect()\n    except TypeError:\n        pass\n    try:\n        csv.get_dialect(*(None,))\n    except csv.Error:\n        pass\n    try:\n        csv.get_dialect(*('nonesuch',))\n    except csv.Error:\n        pass\n    try:\n        csv.unregister_dialect()\n    except TypeError:\n        pass\n    try:\n        csv.unregister_dialect(*(None,))\n    except csv.Error:\n        pass\n    try:\n        csv.unregister_dialect(*('nonesuch',))\n    except csv.Error:\n        pass\n    try:\n        csv.register_dialect(*(None,))\n    except TypeError:\n        pass\n    try:\n        csv.register_dialect(*(None, None))\n    except TypeError:\n        pass\n    try:\n        csv.register_dialect(*('nonesuch', 0, 0))\n    except TypeError:\n        pass\n    try:\n        csv.register_dialect(*('nonesuch',), badargument=None)\n    except TypeError:\n        pass\n    try:\n        csv.register_dialect(*('nonesuch',), quoting=None)\n    except TypeError:\n        pass\n    try:\n        csv.register_dialect(*([],))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

