test "TestDictFields.test_write_multiple_dict_rows" {
    (ok, detail) = p2_libtest_run_snippet("from io import StringIO\nimport csv\n\ndef _t():\n    fileobj = StringIO()\n    writer = csv.DictWriter(fileobj, fieldnames=['f1', 'f2', 'f3'])\n    writer.writeheader()\n    assert fileobj.getvalue() == 'f1,f2,f3\\r\\n', ('assertEqual', fileobj.getvalue(), 'f1,f2,f3\\r\\n')\n    writer.writerows([{'f1': 1, 'f2': 'abc', 'f3': 'f'}, {'f1': 2, 'f2': 5, 'f3': 'xyz'}])\n    assert fileobj.getvalue() == 'f1,f2,f3\\r\\n1,abc,f\\r\\n2,5,xyz\\r\\n', ('assertEqual', fileobj.getvalue(), 'f1,f2,f3\\r\\n1,abc,f\\r\\n2,5,xyz\\r\\n')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

