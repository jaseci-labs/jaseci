test "TestWeakSet.test_symmetric_difference" {
    (ok, detail) = p2_libtest_run_snippet("from weakref import WeakSet\nimport string\nfrom collections import UserString as ustr\nimport gc\n\ndef setUp():\n    self.items = [ustr(c) for c in ('a', 'b', 'c')]\n    self.items2 = [ustr(c) for c in ('x', 'y', 'z')]\n    self.ab_items = [ustr(c) for c in 'ab']\n    self.abcde_items = [ustr(c) for c in 'abcde']\n    self.def_items = [ustr(c) for c in 'def']\n    self.ab_weakset = WeakSet(self.ab_items)\n    self.abcde_weakset = WeakSet(self.abcde_items)\n    self.def_weakset = WeakSet(self.def_items)\n    self.letters = [ustr(c) for c in string.ascii_letters]\n    self.s = WeakSet(self.items)\n    self.d = dict.fromkeys(self.items)\n    self.obj = ustr('F')\n    self.fs = WeakSet([self.obj])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.items = [ustr(c) for c in ('a', 'b', 'c')]\n    self.items2 = [ustr(c) for c in ('x', 'y', 'z')]\n    self.ab_items = [ustr(c) for c in 'ab']\n    self.abcde_items = [ustr(c) for c in 'abcde']\n    self.def_items = [ustr(c) for c in 'def']\n    self.ab_weakset = WeakSet(self.ab_items)\n    self.abcde_weakset = WeakSet(self.abcde_items)\n    self.def_weakset = WeakSet(self.def_items)\n    self.letters = [ustr(c) for c in string.ascii_letters]\n    self.s = WeakSet(self.items)\n    self.d = dict.fromkeys(self.items)\n    self.obj = ustr('F')\n    self.fs = WeakSet([self.obj])\n    i = self.s.symmetric_difference(self.items2)\n    for c in self.letters:\n        assert (c in i) == (c in self.d) ^ (c in self.items2), ('assertEqual', (c in i), (c in self.d) ^ (c in self.items2))\n    assert self.s == WeakSet(self.items), ('assertEqual', self.s, WeakSet(self.items))\n    assert type(i) == WeakSet, ('assertEqual', type(i), WeakSet)\n    try:\n        self.s.symmetric_difference(*([[]],))\n    except TypeError:\n        pass\n    assert len(i) == len(self.items) + len(self.items2), ('assertEqual', len(i), len(self.items) + len(self.items2))\n    self.items2.pop()\n    gc.collect()\n    assert len(i) == len(self.items) + len(self.items2), ('assertEqual', len(i), len(self.items) + len(self.items2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

