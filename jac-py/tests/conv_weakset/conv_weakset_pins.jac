test "TestWeakSet.test_weak_destroy_while_iterating" {
    (ok, detail) = p2_libtest_run_snippet("from weakref import WeakSet\nimport string\nfrom collections import UserString as ustr\nimport gc\n\ndef setUp():\n    self.items = [ustr(c) for c in ('a', 'b', 'c')]\n    self.items2 = [ustr(c) for c in ('x', 'y', 'z')]\n    self.ab_items = [ustr(c) for c in 'ab']\n    self.abcde_items = [ustr(c) for c in 'abcde']\n    self.def_items = [ustr(c) for c in 'def']\n    self.ab_weakset = WeakSet(self.ab_items)\n    self.abcde_weakset = WeakSet(self.abcde_items)\n    self.def_weakset = WeakSet(self.def_items)\n    self.letters = [ustr(c) for c in string.ascii_letters]\n    self.s = WeakSet(self.items)\n    self.d = dict.fromkeys(self.items)\n    self.obj = ustr('F')\n    self.fs = WeakSet([self.obj])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.items = [ustr(c) for c in ('a', 'b', 'c')]\n    self.items2 = [ustr(c) for c in ('x', 'y', 'z')]\n    self.ab_items = [ustr(c) for c in 'ab']\n    self.abcde_items = [ustr(c) for c in 'abcde']\n    self.def_items = [ustr(c) for c in 'def']\n    self.ab_weakset = WeakSet(self.ab_items)\n    self.abcde_weakset = WeakSet(self.abcde_items)\n    self.def_weakset = WeakSet(self.def_items)\n    self.letters = [ustr(c) for c in string.ascii_letters]\n    self.s = WeakSet(self.items)\n    self.d = dict.fromkeys(self.items)\n    self.obj = ustr('F')\n    self.fs = WeakSet([self.obj])\n    items = [ustr(c) for c in ('a', 'b', 'c')]\n    s = WeakSet(items)\n    it = iter(s)\n    next(it)\n    del items[-1]\n    gc.collect()\n    assert len(list(it)) in [len(items), len(items) - 1], ('assertIn', len(list(it)), [len(items), len(items) - 1])\n    del it\n    assert len(s) == len(items), ('assertEqual', len(s), len(items))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestWeakSet.test_weak_destroy_and_mutate_while_iterating" {
    (ok, detail) = p2_libtest_run_snippet("from weakref import WeakSet\nimport string\nfrom collections import UserString as ustr\nimport gc\nimport contextlib\n\ndef setUp():\n    self.items = [ustr(c) for c in ('a', 'b', 'c')]\n    self.items2 = [ustr(c) for c in ('x', 'y', 'z')]\n    self.ab_items = [ustr(c) for c in 'ab']\n    self.abcde_items = [ustr(c) for c in 'abcde']\n    self.def_items = [ustr(c) for c in 'def']\n    self.ab_weakset = WeakSet(self.ab_items)\n    self.abcde_weakset = WeakSet(self.abcde_items)\n    self.def_weakset = WeakSet(self.def_items)\n    self.letters = [ustr(c) for c in string.ascii_letters]\n    self.s = WeakSet(self.items)\n    self.d = dict.fromkeys(self.items)\n    self.obj = ustr('F')\n    self.fs = WeakSet([self.obj])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.items = [ustr(c) for c in ('a', 'b', 'c')]\n    self.items2 = [ustr(c) for c in ('x', 'y', 'z')]\n    self.ab_items = [ustr(c) for c in 'ab']\n    self.abcde_items = [ustr(c) for c in 'abcde']\n    self.def_items = [ustr(c) for c in 'def']\n    self.ab_weakset = WeakSet(self.ab_items)\n    self.abcde_weakset = WeakSet(self.abcde_items)\n    self.def_weakset = WeakSet(self.def_items)\n    self.letters = [ustr(c) for c in string.ascii_letters]\n    self.s = WeakSet(self.items)\n    self.d = dict.fromkeys(self.items)\n    self.obj = ustr('F')\n    self.fs = WeakSet([self.obj])\n    items = [ustr(c) for c in string.ascii_letters]\n    s = WeakSet(items)\n\n    @contextlib.contextmanager\n    def testcontext():\n        try:\n            it = iter(s)\n            yielded = ustr(str(next(it)))\n            u = ustr(str(items.pop()))\n            if yielded == u:\n                next(it)\n            gc.collect()\n            yield u\n        finally:\n            it = None\n    with testcontext() as u:\n        assert u not in s, ('assertNotIn', u, s)\n    with testcontext() as u:\n        try:\n            s.remove(*(u,))\n        except KeyError:\n            pass\n    assert u not in s, ('assertNotIn', u, s)\n    with testcontext() as u:\n        s.add(u)\n    assert u in s, ('assertIn', u, s)\n    t = s.copy()\n    with testcontext() as u:\n        s.update(t)\n    assert len(s) == len(t), ('assertEqual', len(s), len(t))\n    with testcontext() as u:\n        s.clear()\n    assert len(s) == 0, ('assertEqual', len(s), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

