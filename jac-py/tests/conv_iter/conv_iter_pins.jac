}

test "TestCase.test_extending_list_with_iterator_does_not_segfault" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    def gen():\n        for i in range(500):\n            yield i\n    lst = [0] * 500\n    for i in range(240):\n        lst.pop(0)\n    lst.extend(gen())\n    assert len(lst) == 760, ('assertEqual', len(lst), 760)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
