test "TestCase.test_iter_file" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.os_helper import TESTFN, unlink\nimport pickle\nimport collections.abc\n\ndef check_pickle(itorg, seq):\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        d = pickle.dumps(itorg, proto)\n        it = pickle.loads(d)\n        assert isinstance(it, collections.abc.Iterator), ('assertTrue', isinstance(it, collections.abc.Iterator))\n        assert list(it) == seq, ('assertEqual', list(it), seq)\n        it = pickle.loads(d)\n        try:\n            next(it)\n        except StopIteration:\n            continue\n        d = pickle.dumps(it, proto)\n        it = pickle.loads(d)\n        assert list(it) == seq[1:], ('assertEqual', list(it), seq[1:])\n\ndef check_for_loop(expr, seq, pickle=True):\n    if pickle:\n        check_pickle(iter(expr), seq)\n    res = []\n    for val in expr:\n        res.append(val)\n    assert res == seq, ('assertEqual', res, seq)\n\ndef _t():\n    f = open(TESTFN, 'w', encoding='utf-8')\n    try:\n        for i in range(5):\n            f.write('%d\\n' % i)\n    finally:\n        f.close()\n    f = open(TESTFN, 'r', encoding='utf-8')\n    try:\n        check_for_loop(f, ['0\\n', '1\\n', '2\\n', '3\\n', '4\\n'], pickle=False)\n        check_for_loop(f, [], pickle=False)\n    finally:\n        f.close()\n        try:\n            unlink(TESTFN)\n        except OSError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_unicode_join_endcase" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.os_helper import TESTFN, unlink\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class OhPhooey:\n\n        def __init__(self, seq):\n            self.it = iter(seq)\n            self.i = 0\n\n        def __iter__(self):\n            return self\n\n        def __next__(self):\n            i = self.i\n            self.i = i + 1\n            if i == 2:\n                return 'fooled you!'\n            return next(self.it)\n    f = open(TESTFN, 'w', encoding='utf-8')\n    try:\n        f.write('a\\n' + 'b\\n' + 'c\\n')\n    finally:\n        f.close()\n    f = open(TESTFN, 'r', encoding='utf-8')\n    try:\n        got = ' - '.join(OhPhooey(f))\n        assert got == 'a\\n - b\\n - fooled you! - c\\n', ('assertEqual', got, 'a\\n - b\\n - fooled you! - c\\n')\n    finally:\n        f.close()\n        try:\n            unlink(TESTFN)\n        except OSError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_countOf" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.os_helper import TESTFN, unlink\n\ndef _t():\n    from operator import countOf\n    assert countOf([1, 2, 2, 3, 2, 5], 2) == 3, ('assertEqual', countOf([1, 2, 2, 3, 2, 5], 2), 3)\n    assert countOf((1, 2, 2, 3, 2, 5), 2) == 3, ('assertEqual', countOf((1, 2, 2, 3, 2, 5), 2), 3)\n    assert countOf('122325', '2') == 3, ('assertEqual', countOf('122325', '2'), 3)\n    assert countOf('122325', '6') == 0, ('assertEqual', countOf('122325', '6'), 0)\n    try:\n        countOf(*(42, 1))\n    except TypeError:\n        pass\n    try:\n        countOf(*(countOf, countOf))\n    except TypeError:\n        pass\n    d = {'one': 3, 'two': 3, 'three': 3, 1j: 2j}\n    for k in d:\n        assert countOf(d, k) == 1, ('assertEqual', countOf(d, k), 1)\n    assert countOf(d.values(), 3) == 3, ('assertEqual', countOf(d.values(), 3), 3)\n    assert countOf(d.values(), 2j) == 1, ('assertEqual', countOf(d.values(), 2j), 1)\n    assert countOf(d.values(), 1j) == 0, ('assertEqual', countOf(d.values(), 1j), 0)\n    f = open(TESTFN, 'w', encoding='utf-8')\n    try:\n        f.write('a\\nb\\nc\\nb\\n')\n    finally:\n        f.close()\n    f = open(TESTFN, 'r', encoding='utf-8')\n    try:\n        for letter, count in (('a', 1), ('b', 2), ('c', 1), ('d', 0)):\n            f.seek(0, 0)\n            assert countOf(f, letter + '\\n') == count, ('assertEqual', countOf(f, letter + '\\n'), count)\n    finally:\n        f.close()\n        try:\n            unlink(TESTFN)\n        except OSError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_writelines" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.os_helper import TESTFN, unlink\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    f = open(TESTFN, 'w', encoding='utf-8')\n    try:\n        try:\n            f.writelines(*(None,))\n        except TypeError:\n            pass\n        try:\n            f.writelines(*(42,))\n        except TypeError:\n            pass\n        f.writelines(['1\\n', '2\\n'])\n        f.writelines(('3\\n', '4\\n'))\n        f.writelines({'5\\n': None})\n        f.writelines({})\n\n        class Iterator:\n\n            def __init__(self, start, finish):\n                self.start = start\n                self.finish = finish\n                self.i = self.start\n\n            def __next__(self):\n                if self.i >= self.finish:\n                    raise StopIteration\n                result = str(self.i) + '\\n'\n                self.i += 1\n                return result\n\n            def __iter__(self):\n                return self\n\n        class Whatever:\n\n            def __init__(self, start, finish):\n                self.start = start\n                self.finish = finish\n\n            def __iter__(self):\n                return Iterator(self.start, self.finish)\n        f.writelines(Whatever(6, 6 + 2000))\n        f.close()\n        f = open(TESTFN, encoding='utf-8')\n        expected = [str(i) + '\\n' for i in range(1, 2006)]\n        assert list(f) == expected, ('assertEqual', list(f), expected)\n    finally:\n        f.close()\n        try:\n            unlink(TESTFN)\n        except OSError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCase.test_ref_counting_behavior" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class C(object):\n        count = 0\n\n        def __new__(cls):\n            cls.count += 1\n            return object.__new__(cls)\n\n        def __del__(self):\n            cls = self.__class__\n            assert cls.count > 0\n            cls.count -= 1\n    x = C()\n    assert C.count == 1, ('assertEqual', C.count, 1)\n    del x\n    assert C.count == 0, ('assertEqual', C.count, 0)\n    l = [C(), C(), C()]\n    assert C.count == 3, ('assertEqual', C.count, 3)\n    try:\n        a, b = iter(l)\n    except ValueError:\n        pass\n    del l\n    assert C.count == 0, ('assertEqual', C.count, 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

