    (ok, detail) = p2_libtest_run_snippet("def _t():\n    HAS_MORE = 1\n    NO_MORE = 2\n\n    def exhaust(iterator):\n        \"\"\"Exhaust an iterator without raising StopIteration.\"\"\"\n        list(iterator)\n\n    def spam():\n        if spam.is_recursive_call:\n            return NO_MORE\n        spam.is_recursive_call = True\n        exhaust(spam.iterator)\n        return HAS_MORE\n    spam.is_recursive_call = False\n    spam.iterator = iter(spam, NO_MORE)\n    try:\n        next(spam.iterator)\n    except StopIteration as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

