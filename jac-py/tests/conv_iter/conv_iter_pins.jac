test "TestCase.test_3720" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class BadIterator(object):\n\n        def __iter__(self):\n            return self\n\n        def __next__(self):\n            del BadIterator.__next__\n            return 1\n    try:\n        for i in BadIterator():\n            pass\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
