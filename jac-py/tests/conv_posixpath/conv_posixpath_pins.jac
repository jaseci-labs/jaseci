test "PosixPathTest.test_expanduser_home_envvar" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support import os_helper\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    with os_helper.EnvironmentVarGuard() as env:\n        env['HOME'] = '/home/victor'\n        assert posixpath.expanduser('~') == '/home/victor', ('assertEqual', posixpath.expanduser('~'), '/home/victor')\n        env['HOME'] = '/home/victor/'\n        assert posixpath.expanduser('~') == '/home/victor', ('assertEqual', posixpath.expanduser('~'), '/home/victor')\n        for home in ('/', '', '//', '///'):\n            env['HOME'] = home\n            assert posixpath.expanduser('~') == '/', ('assertEqual', posixpath.expanduser('~'), '/')\n            assert posixpath.expanduser('~/') == '/', ('assertEqual', posixpath.expanduser('~/'), '/')\n            assert posixpath.expanduser('~/foo') == '/foo', ('assertEqual', posixpath.expanduser('~/foo'), '/foo')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

