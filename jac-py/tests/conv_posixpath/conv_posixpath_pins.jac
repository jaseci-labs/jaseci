test "PosixPathTest.test_islink_invalid_paths" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    assert posixpath.islink(TESTFN + '\\udfff') is False, ('assertIs', posixpath.islink(TESTFN + '\\udfff'), False)\n    assert posixpath.islink(os.fsencode(TESTFN) + b'\\xff') is False, ('assertIs', posixpath.islink(os.fsencode(TESTFN) + b'\\xff'), False)\n    assert posixpath.islink(TESTFN + '\\x00') is False, ('assertIs', posixpath.islink(TESTFN + '\\x00'), False)\n    assert posixpath.islink(os.fsencode(TESTFN) + b'\\x00') is False, ('assertIs', posixpath.islink(os.fsencode(TESTFN) + b'\\x00'), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

