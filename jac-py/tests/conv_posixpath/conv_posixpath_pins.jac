test "PosixPathTest.test_join" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    fn = posixpath.join\n    assert fn('/foo', 'bar', '/bar', 'baz') == '/bar/baz', ('assertEqual', fn('/foo', 'bar', '/bar', 'baz'), '/bar/baz')\n    assert fn('/foo', 'bar', 'baz') == '/foo/bar/baz', ('assertEqual', fn('/foo', 'bar', 'baz'), '/foo/bar/baz')\n    assert fn('/foo/', 'bar/', 'baz/') == '/foo/bar/baz/', ('assertEqual', fn('/foo/', 'bar/', 'baz/'), '/foo/bar/baz/')\n    assert fn(b'/foo', b'bar', b'/bar', b'baz') == b'/bar/baz', ('assertEqual', fn(b'/foo', b'bar', b'/bar', b'baz'), b'/bar/baz')\n    assert fn(b'/foo', b'bar', b'baz') == b'/foo/bar/baz', ('assertEqual', fn(b'/foo', b'bar', b'baz'), b'/foo/bar/baz')\n    assert fn(b'/foo/', b'bar/', b'baz/') == b'/foo/bar/baz/', ('assertEqual', fn(b'/foo/', b'bar/', b'baz/'), b'/foo/bar/baz/')\n    assert fn('a', '') == 'a/', ('assertEqual', fn('a', ''), 'a/')\n    assert fn('a', '', '') == 'a/', ('assertEqual', fn('a', '', ''), 'a/')\n    assert fn('a', 'b') == 'a/b', ('assertEqual', fn('a', 'b'), 'a/b')\n    assert fn('a', 'b/') == 'a/b/', ('assertEqual', fn('a', 'b/'), 'a/b/')\n    assert fn('a/', 'b') == 'a/b', ('assertEqual', fn('a/', 'b'), 'a/b')\n    assert fn('a/', 'b/') == 'a/b/', ('assertEqual', fn('a/', 'b/'), 'a/b/')\n    assert fn('a', 'b/c', 'd') == 'a/b/c/d', ('assertEqual', fn('a', 'b/c', 'd'), 'a/b/c/d')\n    assert fn('a', 'b//c', 'd') == 'a/b//c/d', ('assertEqual', fn('a', 'b//c', 'd'), 'a/b//c/d')\n    assert fn('a', 'b/c/', 'd') == 'a/b/c/d', ('assertEqual', fn('a', 'b/c/', 'd'), 'a/b/c/d')\n    assert fn('/a', 'b') == '/a/b', ('assertEqual', fn('/a', 'b'), '/a/b')\n    assert fn('/a/', 'b') == '/a/b', ('assertEqual', fn('/a/', 'b'), '/a/b')\n    assert fn('a', '/b', 'c') == '/b/c', ('assertEqual', fn('a', '/b', 'c'), '/b/c')\n    assert fn('a', '/b', '/c') == '/c', ('assertEqual', fn('a', '/b', '/c'), '/c')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_split" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    assert posixpath.split('/foo/bar') == ('/foo', 'bar'), ('assertEqual', posixpath.split('/foo/bar'), ('/foo', 'bar'))\n    assert posixpath.split('/') == ('/', ''), ('assertEqual', posixpath.split('/'), ('/', ''))\n    assert posixpath.split('foo') == ('', 'foo'), ('assertEqual', posixpath.split('foo'), ('', 'foo'))\n    assert posixpath.split('////foo') == ('////', 'foo'), ('assertEqual', posixpath.split('////foo'), ('////', 'foo'))\n    assert posixpath.split('//foo//bar') == ('//foo', 'bar'), ('assertEqual', posixpath.split('//foo//bar'), ('//foo', 'bar'))\n    assert posixpath.split(b'/foo/bar') == (b'/foo', b'bar'), ('assertEqual', posixpath.split(b'/foo/bar'), (b'/foo', b'bar'))\n    assert posixpath.split(b'/') == (b'/', b''), ('assertEqual', posixpath.split(b'/'), (b'/', b''))\n    assert posixpath.split(b'foo') == (b'', b'foo'), ('assertEqual', posixpath.split(b'foo'), (b'', b'foo'))\n    assert posixpath.split(b'////foo') == (b'////', b'foo'), ('assertEqual', posixpath.split(b'////foo'), (b'////', b'foo'))\n    assert posixpath.split(b'//foo//bar') == (b'//foo', b'bar'), ('assertEqual', posixpath.split(b'//foo//bar'), (b'//foo', b'bar'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_splitext" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef splitextTest(path, filename, ext):\n    assert posixpath.splitext(path) == (filename, ext), ('assertEqual', posixpath.splitext(path), (filename, ext))\n    assert posixpath.splitext('/' + path) == ('/' + filename, ext), ('assertEqual', posixpath.splitext('/' + path), ('/' + filename, ext))\n    assert posixpath.splitext('abc/' + path) == ('abc/' + filename, ext), ('assertEqual', posixpath.splitext('abc/' + path), ('abc/' + filename, ext))\n    assert posixpath.splitext('abc.def/' + path) == ('abc.def/' + filename, ext), ('assertEqual', posixpath.splitext('abc.def/' + path), ('abc.def/' + filename, ext))\n    assert posixpath.splitext('/abc.def/' + path) == ('/abc.def/' + filename, ext), ('assertEqual', posixpath.splitext('/abc.def/' + path), ('/abc.def/' + filename, ext))\n    assert posixpath.splitext(path + '/') == (filename + ext + '/', ''), ('assertEqual', posixpath.splitext(path + '/'), (filename + ext + '/', ''))\n    path = bytes(path, 'ASCII')\n    filename = bytes(filename, 'ASCII')\n    ext = bytes(ext, 'ASCII')\n    assert posixpath.splitext(path) == (filename, ext), ('assertEqual', posixpath.splitext(path), (filename, ext))\n    assert posixpath.splitext(b'/' + path) == (b'/' + filename, ext), ('assertEqual', posixpath.splitext(b'/' + path), (b'/' + filename, ext))\n    assert posixpath.splitext(b'abc/' + path) == (b'abc/' + filename, ext), ('assertEqual', posixpath.splitext(b'abc/' + path), (b'abc/' + filename, ext))\n    assert posixpath.splitext(b'abc.def/' + path) == (b'abc.def/' + filename, ext), ('assertEqual', posixpath.splitext(b'abc.def/' + path), (b'abc.def/' + filename, ext))\n    assert posixpath.splitext(b'/abc.def/' + path) == (b'/abc.def/' + filename, ext), ('assertEqual', posixpath.splitext(b'/abc.def/' + path), (b'/abc.def/' + filename, ext))\n    assert posixpath.splitext(path + b'/') == (filename + ext + b'/', b''), ('assertEqual', posixpath.splitext(path + b'/'), (filename + ext + b'/', b''))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    splitextTest('foo.bar', 'foo', '.bar')\n    splitextTest('foo.boo.bar', 'foo.boo', '.bar')\n    splitextTest('foo.boo.biff.bar', 'foo.boo.biff', '.bar')\n    splitextTest('.csh.rc', '.csh', '.rc')\n    splitextTest('nodots', 'nodots', '')\n    splitextTest('.cshrc', '.cshrc', '')\n    splitextTest('...manydots', '...manydots', '')\n    splitextTest('...manydots.ext', '...manydots', '.ext')\n    splitextTest('.', '.', '')\n    splitextTest('..', '..', '')\n    splitextTest('........', '........', '')\n    splitextTest('', '', '')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_splitroot" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    f = posixpath.splitroot\n    assert f('') == ('', '', ''), ('assertEqual', f(''), ('', '', ''))\n    assert f('a') == ('', '', 'a'), ('assertEqual', f('a'), ('', '', 'a'))\n    assert f('a/b') == ('', '', 'a/b'), ('assertEqual', f('a/b'), ('', '', 'a/b'))\n    assert f('a/b/') == ('', '', 'a/b/'), ('assertEqual', f('a/b/'), ('', '', 'a/b/'))\n    assert f('/a') == ('', '/', 'a'), ('assertEqual', f('/a'), ('', '/', 'a'))\n    assert f('/a/b') == ('', '/', 'a/b'), ('assertEqual', f('/a/b'), ('', '/', 'a/b'))\n    assert f('/a/b/') == ('', '/', 'a/b/'), ('assertEqual', f('/a/b/'), ('', '/', 'a/b/'))\n    assert f('//a') == ('', '//', 'a'), ('assertEqual', f('//a'), ('', '//', 'a'))\n    assert f('///a') == ('', '/', '//a'), ('assertEqual', f('///a'), ('', '/', '//a'))\n    assert f('///a/b') == ('', '/', '//a/b'), ('assertEqual', f('///a/b'), ('', '/', '//a/b'))\n    assert f('c:/a/b') == ('', '', 'c:/a/b'), ('assertEqual', f('c:/a/b'), ('', '', 'c:/a/b'))\n    assert f('\\\\/a/b') == ('', '', '\\\\/a/b'), ('assertEqual', f('\\\\/a/b'), ('', '', '\\\\/a/b'))\n    assert f('\\\\a\\\\b') == ('', '', '\\\\a\\\\b'), ('assertEqual', f('\\\\a\\\\b'), ('', '', '\\\\a\\\\b'))\n    assert f(b'') == (b'', b'', b''), ('assertEqual', f(b''), (b'', b'', b''))\n    assert f(b'a') == (b'', b'', b'a'), ('assertEqual', f(b'a'), (b'', b'', b'a'))\n    assert f(b'/a') == (b'', b'/', b'a'), ('assertEqual', f(b'/a'), (b'', b'/', b'a'))\n    assert f(b'//a') == (b'', b'//', b'a'), ('assertEqual', f(b'//a'), (b'', b'//', b'a'))\n    assert f(b'///a') == (b'', b'/', b'//a'), ('assertEqual', f(b'///a'), (b'', b'/', b'//a'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_isabs" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    assert posixpath.isabs('') is False, ('assertIs', posixpath.isabs(''), False)\n    assert posixpath.isabs('/') is True, ('assertIs', posixpath.isabs('/'), True)\n    assert posixpath.isabs('/foo') is True, ('assertIs', posixpath.isabs('/foo'), True)\n    assert posixpath.isabs('/foo/bar') is True, ('assertIs', posixpath.isabs('/foo/bar'), True)\n    assert posixpath.isabs('foo/bar') is False, ('assertIs', posixpath.isabs('foo/bar'), False)\n    assert posixpath.isabs(b'') is False, ('assertIs', posixpath.isabs(b''), False)\n    assert posixpath.isabs(b'/') is True, ('assertIs', posixpath.isabs(b'/'), True)\n    assert posixpath.isabs(b'/foo') is True, ('assertIs', posixpath.isabs(b'/foo'), True)\n    assert posixpath.isabs(b'/foo/bar') is True, ('assertIs', posixpath.isabs(b'/foo/bar'), True)\n    assert posixpath.isabs(b'foo/bar') is False, ('assertIs', posixpath.isabs(b'foo/bar'), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

