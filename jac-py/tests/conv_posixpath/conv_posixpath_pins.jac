}

test "PosixPathTest.test_realpath_invalid_paths" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nimport sys\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test import support\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    path = '/\\x00'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = b'/\\x00'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = '/nonexistent/x\\x00'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except FileNotFoundError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = b'/nonexistent/x\\x00'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except FileNotFoundError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = '/\\x00/..'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = b'/\\x00/..'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = '/nonexistent/x\\x00/..'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except FileNotFoundError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = b'/nonexistent/x\\x00/..'\n    try:\n        realpath(*(path,), strict=False)\n    except ValueError:\n        pass\n    try:\n        realpath(*(path,), strict=True)\n    except FileNotFoundError:\n        pass\n    try:\n        realpath(*(path,), strict=ALLOW_MISSING)\n    except ValueError:\n        pass\n    path = '/\\udfff'\n    if sys.platform == 'win32':\n        assert realpath(path, strict=False) == path, ('assertEqual', realpath(path, strict=False), path)\n        try:\n            realpath(*(path,), strict=True)\n        except FileNotFoundError:\n            pass\n        assert realpath(path, strict=ALLOW_MISSING) == path, ('assertEqual', realpath(path, strict=ALLOW_MISSING), path)\n    else:\n        try:\n            realpath(*(path,), strict=False)\n        except UnicodeEncodeError:\n            pass\n        try:\n            realpath(*(path,), strict=True)\n        except UnicodeEncodeError:\n            pass\n        try:\n            realpath(*(path,), strict=ALLOW_MISSING)\n        except UnicodeEncodeError:\n            pass\n    path = '/nonexistent/\\udfff'\n    if sys.platform == 'win32':\n        assert realpath(path, strict=False) == path, ('assertEqual', realpath(path, strict=False), path)\n        assert realpath(path, strict=ALLOW_MISSING) == path, ('assertEqual', realpath(path, strict=ALLOW_MISSING), path)\n    else:\n        try:\n            realpath(*(path,), strict=False)\n        except UnicodeEncodeError:\n            pass\n        try:\n            realpath(*(path,), strict=ALLOW_MISSING)\n        except UnicodeEncodeError:\n            pass\n    try:\n        realpath(*(path,), strict=True)\n    except FileNotFoundError:\n        pass\n    path = '/\\udfff/..'\n    if sys.platform == 'win32':\n        assert realpath(path, strict=False) == '/', ('assertEqual', realpath(path, strict=False), '/')\n        try:\n            realpath(*(path,), strict=True)\n        except FileNotFoundError:\n            pass\n        assert realpath(path, strict=ALLOW_MISSING) == '/', ('assertEqual', realpath(path, strict=ALLOW_MISSING), '/')\n    else:\n        try:\n            realpath(*(path,), strict=False)\n        except UnicodeEncodeError:\n            pass\n        try:\n            realpath(*(path,), strict=True)\n        except UnicodeEncodeError:\n            pass\n        try:\n            realpath(*(path,), strict=ALLOW_MISSING)\n        except UnicodeEncodeError:\n            pass\n    path = '/nonexistent/\\udfff/..'\n    if sys.platform == 'win32':\n        assert realpath(path, strict=False) == '/nonexistent', ('assertEqual', realpath(path, strict=False), '/nonexistent')\n        assert realpath(path, strict=ALLOW_MISSING) == '/nonexistent', ('assertEqual', realpath(path, strict=ALLOW_MISSING), '/nonexistent')\n    else:\n        try:\n            realpath(*(path,), strict=False)\n        except UnicodeEncodeError:\n            pass\n        try:\n            realpath(*(path,), strict=ALLOW_MISSING)\n        except UnicodeEncodeError:\n            pass\n    try:\n        realpath(*(path,), strict=True)\n    except FileNotFoundError:\n        pass\n    path = b'/\\xff'\n    if sys.platform == 'win32':\n        try:\n            realpath(*(path,), strict=False)\n        except UnicodeDecodeError:\n            pass\n        try:\n            realpath(*(path,), strict=True)\n        except UnicodeDecodeError:\n            pass\n        try:\n            realpath(*(path,), strict=ALLOW_MISSING)\n        except UnicodeDecodeError:\n            pass\n    else:\n        assert realpath(path, strict=False) == path, ('assertEqual', realpath(path, strict=False), path)\n        if support.is_wasi:\n            try:\n                realpath(*(path,), strict=True)\n            except OSError:\n                pass\n            try:\n                realpath(*(path,), strict=ALLOW_MISSING)\n            except OSError:\n                pass\n        else:\n            try:\n                realpath(*(path,), strict=True)\n            except FileNotFoundError:\n                pass\n            assert realpath(path, strict=ALLOW_MISSING) == path, ('assertEqual', realpath(path, strict=ALLOW_MISSING), path)\n    path = b'/nonexistent/\\xff'\n    if sys.platform == 'win32':\n        try:\n            realpath(*(path,), strict=False)\n        except UnicodeDecodeError:\n            pass\n        try:\n            realpath(*(path,), strict=ALLOW_MISSING)\n        except UnicodeDecodeError:\n            pass\n    else:\n        assert realpath(path, strict=False) == path, ('assertEqual', realpath(path, strict=False), path)\n    if support.is_wasi:\n        try:\n            realpath(*(path,), strict=True)\n        except OSError:\n            pass\n        try:\n            realpath(*(path,), strict=ALLOW_MISSING)\n        except OSError:\n            pass\n    else:\n        try:\n            realpath(*(path,), strict=True)\n        except FileNotFoundError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_realpath_symlink_loops" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support import os_helper\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    try:\n        os.symlink(ABSTFN, ABSTFN)\n        assert realpath(ABSTFN) == ABSTFN, ('assertEqual', realpath(ABSTFN), ABSTFN)\n        os.symlink(ABSTFN + '1', ABSTFN + '2')\n        os.symlink(ABSTFN + '2', ABSTFN + '1')\n        assert realpath(ABSTFN + '1') == ABSTFN + '1', ('assertEqual', realpath(ABSTFN + '1'), ABSTFN + '1')\n        assert realpath(ABSTFN + '2') == ABSTFN + '2', ('assertEqual', realpath(ABSTFN + '2'), ABSTFN + '2')\n        assert realpath(ABSTFN + '1/x') == ABSTFN + '1/x', ('assertEqual', realpath(ABSTFN + '1/x'), ABSTFN + '1/x')\n        assert realpath(ABSTFN + '1/..') == dirname(ABSTFN), ('assertEqual', realpath(ABSTFN + '1/..'), dirname(ABSTFN))\n        assert realpath(ABSTFN + '1/../x') == dirname(ABSTFN) + '/x', ('assertEqual', realpath(ABSTFN + '1/../x'), dirname(ABSTFN) + '/x')\n        os.symlink(ABSTFN + 'x', ABSTFN + 'y')\n        assert realpath(ABSTFN + '1/../' + basename(ABSTFN) + 'y') == ABSTFN + 'x', ('assertEqual', realpath(ABSTFN + '1/../' + basename(ABSTFN) + 'y'), ABSTFN + 'x')\n        assert realpath(ABSTFN + '1/../' + basename(ABSTFN) + '1') == ABSTFN + '1', ('assertEqual', realpath(ABSTFN + '1/../' + basename(ABSTFN) + '1'), ABSTFN + '1')\n        os.symlink(basename(ABSTFN) + 'a/b', ABSTFN + 'a')\n        assert realpath(ABSTFN + 'a') == ABSTFN + 'a/b', ('assertEqual', realpath(ABSTFN + 'a'), ABSTFN + 'a/b')\n        os.symlink('../' + basename(dirname(ABSTFN)) + '/' + basename(ABSTFN) + 'c', ABSTFN + 'c')\n        assert realpath(ABSTFN + 'c') == ABSTFN + 'c', ('assertEqual', realpath(ABSTFN + 'c'), ABSTFN + 'c')\n        with os_helper.change_cwd(dirname(ABSTFN)):\n            assert realpath(basename(ABSTFN)) == ABSTFN, ('assertEqual', realpath(basename(ABSTFN)), ABSTFN)\n    finally:\n        os_helper.unlink(ABSTFN)\n        os_helper.unlink(ABSTFN + '1')\n        os_helper.unlink(ABSTFN + '2')\n        os_helper.unlink(ABSTFN + 'y')\n        os_helper.unlink(ABSTFN + 'c')\n        os_helper.unlink(ABSTFN + 'a')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_realpath_nonterminal_file" {
    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support import os_helper\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    try:\n        with open(ABSTFN, 'w') as f:\n            f.write('test_posixpath wuz ere')\n        assert realpath(ABSTFN, strict=False) == ABSTFN, ('assertEqual', realpath(ABSTFN, strict=False), ABSTFN)\n        assert realpath(ABSTFN, strict=True) == ABSTFN, ('assertEqual', realpath(ABSTFN, strict=True), ABSTFN)\n        assert realpath(ABSTFN, strict=ALLOW_MISSING) == ABSTFN, ('assertEqual', realpath(ABSTFN, strict=ALLOW_MISSING), ABSTFN)\n        assert realpath(ABSTFN + '/', strict=False) == ABSTFN, ('assertEqual', realpath(ABSTFN + '/', strict=False), ABSTFN)\n        try:\n            realpath(*(ABSTFN + '/',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/.', strict=False) == ABSTFN, ('assertEqual', realpath(ABSTFN + '/.', strict=False), ABSTFN)\n        try:\n            realpath(*(ABSTFN + '/.',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/.',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/..', strict=False) == dirname(ABSTFN), ('assertEqual', realpath(ABSTFN + '/..', strict=False), dirname(ABSTFN))\n        try:\n            realpath(*(ABSTFN + '/..',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/..',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/subdir', strict=False) == ABSTFN + '/subdir', ('assertEqual', realpath(ABSTFN + '/subdir', strict=False), ABSTFN + '/subdir')\n        try:\n            realpath(*(ABSTFN + '/subdir',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/subdir',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n    finally:\n        os_helper.unlink(ABSTFN)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_realpath_nonterminal_symlink_to_file" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support import os_helper\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    try:\n        with open(ABSTFN + '1', 'w') as f:\n            f.write('test_posixpath wuz ere')\n        os.symlink(ABSTFN + '1', ABSTFN)\n        assert realpath(ABSTFN, strict=False) == ABSTFN + '1', ('assertEqual', realpath(ABSTFN, strict=False), ABSTFN + '1')\n        assert realpath(ABSTFN, strict=True) == ABSTFN + '1', ('assertEqual', realpath(ABSTFN, strict=True), ABSTFN + '1')\n        assert realpath(ABSTFN, strict=ALLOW_MISSING) == ABSTFN + '1', ('assertEqual', realpath(ABSTFN, strict=ALLOW_MISSING), ABSTFN + '1')\n        assert realpath(ABSTFN + '/', strict=False) == ABSTFN + '1', ('assertEqual', realpath(ABSTFN + '/', strict=False), ABSTFN + '1')\n        try:\n            realpath(*(ABSTFN + '/',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/.', strict=False) == ABSTFN + '1', ('assertEqual', realpath(ABSTFN + '/.', strict=False), ABSTFN + '1')\n        try:\n            realpath(*(ABSTFN + '/.',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/.',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/..', strict=False) == dirname(ABSTFN), ('assertEqual', realpath(ABSTFN + '/..', strict=False), dirname(ABSTFN))\n        try:\n            realpath(*(ABSTFN + '/..',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/..',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/subdir', strict=False) == ABSTFN + '1/subdir', ('assertEqual', realpath(ABSTFN + '/subdir', strict=False), ABSTFN + '1/subdir')\n        try:\n            realpath(*(ABSTFN + '/subdir',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/subdir',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n    finally:\n        os_helper.unlink(ABSTFN)\n        os_helper.unlink(ABSTFN + '1')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_realpath_nonterminal_symlink_to_symlinks_to_file" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support import os_helper\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    try:\n        with open(ABSTFN + '2', 'w') as f:\n            f.write('test_posixpath wuz ere')\n        os.symlink(ABSTFN + '2', ABSTFN + '1')\n        os.symlink(ABSTFN + '1', ABSTFN)\n        assert realpath(ABSTFN, strict=False) == ABSTFN + '2', ('assertEqual', realpath(ABSTFN, strict=False), ABSTFN + '2')\n        assert realpath(ABSTFN, strict=True) == ABSTFN + '2', ('assertEqual', realpath(ABSTFN, strict=True), ABSTFN + '2')\n        assert realpath(ABSTFN, strict=True) == ABSTFN + '2', ('assertEqual', realpath(ABSTFN, strict=True), ABSTFN + '2')\n        assert realpath(ABSTFN + '/', strict=False) == ABSTFN + '2', ('assertEqual', realpath(ABSTFN + '/', strict=False), ABSTFN + '2')\n        try:\n            realpath(*(ABSTFN + '/',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/.', strict=False) == ABSTFN + '2', ('assertEqual', realpath(ABSTFN + '/.', strict=False), ABSTFN + '2')\n        try:\n            realpath(*(ABSTFN + '/.',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/.',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/..', strict=False) == dirname(ABSTFN), ('assertEqual', realpath(ABSTFN + '/..', strict=False), dirname(ABSTFN))\n        try:\n            realpath(*(ABSTFN + '/..',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/..',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n        assert realpath(ABSTFN + '/subdir', strict=False) == ABSTFN + '2/subdir', ('assertEqual', realpath(ABSTFN + '/subdir', strict=False), ABSTFN + '2/subdir')\n        try:\n            realpath(*(ABSTFN + '/subdir',), strict=True)\n        except NotADirectoryError:\n            pass\n        try:\n            realpath(*(ABSTFN + '/subdir',), strict=ALLOW_MISSING)\n        except NotADirectoryError:\n            pass\n    finally:\n        os_helper.unlink(ABSTFN)\n        os_helper.unlink(ABSTFN + '1')\n        os_helper.unlink(ABSTFN + '2')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_relpath" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    real_getcwd, os.getcwd = (os.getcwd, lambda: '/home/user/bar')\n    try:\n        curdir = os.path.split(os.getcwd())[-1]\n        try:\n            posixpath.relpath(*(None,))\n        except TypeError:\n            pass\n        try:\n            posixpath.relpath(*('',))\n        except ValueError:\n            pass\n        assert posixpath.relpath('a') == 'a', ('assertEqual', posixpath.relpath('a'), 'a')\n        assert posixpath.relpath(posixpath.abspath('a')) == 'a', ('assertEqual', posixpath.relpath(posixpath.abspath('a')), 'a')\n        assert posixpath.relpath('a/b') == 'a/b', ('assertEqual', posixpath.relpath('a/b'), 'a/b')\n        assert posixpath.relpath('../a/b') == '../a/b', ('assertEqual', posixpath.relpath('../a/b'), '../a/b')\n        assert posixpath.relpath('a', '../b') == '../' + curdir + '/a', ('assertEqual', posixpath.relpath('a', '../b'), '../' + curdir + '/a')\n        assert posixpath.relpath('a/b', '../c') == '../' + curdir + '/a/b', ('assertEqual', posixpath.relpath('a/b', '../c'), '../' + curdir + '/a/b')\n        assert posixpath.relpath('a', 'b/c') == '../../a', ('assertEqual', posixpath.relpath('a', 'b/c'), '../../a')\n        assert posixpath.relpath('a', 'a') == '.', ('assertEqual', posixpath.relpath('a', 'a'), '.')\n        assert posixpath.relpath('/foo/bar/bat', '/x/y/z') == '../../../foo/bar/bat', ('assertEqual', posixpath.relpath('/foo/bar/bat', '/x/y/z'), '../../../foo/bar/bat')\n        assert posixpath.relpath('/foo/bar/bat', '/foo/bar') == 'bat', ('assertEqual', posixpath.relpath('/foo/bar/bat', '/foo/bar'), 'bat')\n        assert posixpath.relpath('/foo/bar/bat', '/') == 'foo/bar/bat', ('assertEqual', posixpath.relpath('/foo/bar/bat', '/'), 'foo/bar/bat')\n        assert posixpath.relpath('/', '/foo/bar/bat') == '../../..', ('assertEqual', posixpath.relpath('/', '/foo/bar/bat'), '../../..')\n        assert posixpath.relpath('/foo/bar/bat', '/x') == '../foo/bar/bat', ('assertEqual', posixpath.relpath('/foo/bar/bat', '/x'), '../foo/bar/bat')\n        assert posixpath.relpath('/x', '/foo/bar/bat') == '../../../x', ('assertEqual', posixpath.relpath('/x', '/foo/bar/bat'), '../../../x')\n        assert posixpath.relpath('/', '/') == '.', ('assertEqual', posixpath.relpath('/', '/'), '.')\n        assert posixpath.relpath('/a', '/a') == '.', ('assertEqual', posixpath.relpath('/a', '/a'), '.')\n        assert posixpath.relpath('/a/b', '/a/b') == '.', ('assertEqual', posixpath.relpath('/a/b', '/a/b'), '.')\n    finally:\n        os.getcwd = real_getcwd\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_relpath_bytes" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    real_getcwdb, os.getcwdb = (os.getcwdb, lambda: b'/home/user/bar')\n    try:\n        curdir = os.path.split(os.getcwdb())[-1]\n        try:\n            posixpath.relpath(*(b'',))\n        except ValueError:\n            pass\n        assert posixpath.relpath(b'a') == b'a', ('assertEqual', posixpath.relpath(b'a'), b'a')\n        assert posixpath.relpath(posixpath.abspath(b'a')) == b'a', ('assertEqual', posixpath.relpath(posixpath.abspath(b'a')), b'a')\n        assert posixpath.relpath(b'a/b') == b'a/b', ('assertEqual', posixpath.relpath(b'a/b'), b'a/b')\n        assert posixpath.relpath(b'../a/b') == b'../a/b', ('assertEqual', posixpath.relpath(b'../a/b'), b'../a/b')\n        assert posixpath.relpath(b'a', b'../b') == b'../' + curdir + b'/a', ('assertEqual', posixpath.relpath(b'a', b'../b'), b'../' + curdir + b'/a')\n        assert posixpath.relpath(b'a/b', b'../c') == b'../' + curdir + b'/a/b', ('assertEqual', posixpath.relpath(b'a/b', b'../c'), b'../' + curdir + b'/a/b')\n        assert posixpath.relpath(b'a', b'b/c') == b'../../a', ('assertEqual', posixpath.relpath(b'a', b'b/c'), b'../../a')\n        assert posixpath.relpath(b'a', b'a') == b'.', ('assertEqual', posixpath.relpath(b'a', b'a'), b'.')\n        assert posixpath.relpath(b'/foo/bar/bat', b'/x/y/z') == b'../../../foo/bar/bat', ('assertEqual', posixpath.relpath(b'/foo/bar/bat', b'/x/y/z'), b'../../../foo/bar/bat')\n        assert posixpath.relpath(b'/foo/bar/bat', b'/foo/bar') == b'bat', ('assertEqual', posixpath.relpath(b'/foo/bar/bat', b'/foo/bar'), b'bat')\n        assert posixpath.relpath(b'/foo/bar/bat', b'/') == b'foo/bar/bat', ('assertEqual', posixpath.relpath(b'/foo/bar/bat', b'/'), b'foo/bar/bat')\n        assert posixpath.relpath(b'/', b'/foo/bar/bat') == b'../../..', ('assertEqual', posixpath.relpath(b'/', b'/foo/bar/bat'), b'../../..')\n        assert posixpath.relpath(b'/foo/bar/bat', b'/x') == b'../foo/bar/bat', ('assertEqual', posixpath.relpath(b'/foo/bar/bat', b'/x'), b'../foo/bar/bat')\n        assert posixpath.relpath(b'/x', b'/foo/bar/bat') == b'../../../x', ('assertEqual', posixpath.relpath(b'/x', b'/foo/bar/bat'), b'../../../x')\n        assert posixpath.relpath(b'/', b'/') == b'.', ('assertEqual', posixpath.relpath(b'/', b'/'), b'.')\n        assert posixpath.relpath(b'/a', b'/a') == b'.', ('assertEqual', posixpath.relpath(b'/a', b'/a'), b'.')\n        assert posixpath.relpath(b'/a/b', b'/a/b') == b'.', ('assertEqual', posixpath.relpath(b'/a/b', b'/a/b'), b'.')\n        try:\n            posixpath.relpath(*(b'bytes', 'str'))\n        except TypeError:\n            pass\n        try:\n            posixpath.relpath(*('str', b'bytes'))\n        except TypeError:\n            pass\n    finally:\n        os.getcwdb = real_getcwdb\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "PosixPathTest.test_commonpath" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\n    def check(paths, expected):\n        assert posixpath.commonpath(paths) == expected, ('assertEqual', posixpath.commonpath(paths), expected)\n        assert posixpath.commonpath([os.fsencode(p) for p in paths]) == os.fsencode(expected), ('assertEqual', posixpath.commonpath([os.fsencode(p) for p in paths]), os.fsencode(expected))\n\n    def check_error(exc, paths):\n        try:\n            posixpath.commonpath(*(paths,))\n        except exc:\n            pass\n        try:\n            posixpath.commonpath(*([os.fsencode(p) for p in paths],))\n        except exc:\n            pass\n    try:\n        posixpath.commonpath(*(None,))\n    except TypeError:\n        pass\n    try:\n        posixpath.commonpath(*([],))\n    except ValueError:\n        pass\n    try:\n        posixpath.commonpath(*(iter([]),))\n    except ValueError:\n        pass\n    check_error(ValueError, ['/usr', 'usr'])\n    check_error(ValueError, ['usr', '/usr'])\n    check(['/usr/local'], '/usr/local')\n    check(['/usr/local', '/usr/local'], '/usr/local')\n    check(['/usr/local/', '/usr/local'], '/usr/local')\n    check(['/usr/local/', '/usr/local/'], '/usr/local')\n    check(['/usr//local', '//usr/local'], '/usr/local')\n    check(['/usr/./local', '/./usr/local'], '/usr/local')\n    check(['/', '/dev'], '/')\n    check(['/usr', '/dev'], '/')\n    check(['/usr/lib/', '/usr/lib/python3'], '/usr/lib')\n    check(['/usr/lib/', '/usr/lib64/'], '/usr')\n    check(['/usr/lib', '/usr/lib64'], '/usr')\n    check(['/usr/lib/', '/usr/lib64'], '/usr')\n    check(['spam'], 'spam')\n    check(['spam', 'spam'], 'spam')\n    check(['spam', 'alot'], '')\n    check(['and/jam', 'and/spam'], 'and')\n    check(['and//jam', 'and/spam//'], 'and')\n    check(['and/./jam', './and/spam'], 'and')\n    check(['and/jam', 'and/spam', 'alot'], '')\n    check(['and/jam', 'and/spam', 'and'], 'and')\n    check([''], '')\n    check(['', 'spam/alot'], '')\n    check_error(ValueError, ['', '/spam/alot'])\n    try:\n        posixpath.commonpath(*([b'/usr/lib/', '/usr/lib/python3'],))\n    except TypeError:\n        pass\n    try:\n        posixpath.commonpath(*([b'/usr/lib/', 'usr/lib/python3'],))\n    except TypeError:\n        pass\n    try:\n        posixpath.commonpath(*([b'usr/lib/', '/usr/lib/python3'],))\n    except TypeError:\n        pass\n    try:\n        posixpath.commonpath(*(['/usr/lib/', b'/usr/lib/python3'],))\n    except TypeError:\n        pass\n    try:\n        posixpath.commonpath(*(['/usr/lib/', b'usr/lib/python3'],))\n    except TypeError:\n        pass\n    try:\n        posixpath.commonpath(*(['usr/lib/', b'/usr/lib/python3'],))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
