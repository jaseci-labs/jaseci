    (ok, detail) = p2_libtest_run_snippet("import posixpath\nfrom posixpath import realpath, abspath, dirname, basename, ALLOW_MISSING\nfrom test.support.os_helper import FakePath, TESTFN\nABSTFN = abspath(TESTFN)\n\ndef setUp():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n\ndef _t():\n    for suffix in ['', '1', '2']:\n        assert not posixpath.lexists(ABSTFN + suffix), ('assertFalse', posixpath.lexists(ABSTFN + suffix))\n    assert posixpath.basename('/foo/bar') == 'bar', ('assertEqual', posixpath.basename('/foo/bar'), 'bar')\n    assert posixpath.basename('/') == '', ('assertEqual', posixpath.basename('/'), '')\n    assert posixpath.basename('foo') == 'foo', ('assertEqual', posixpath.basename('foo'), 'foo')\n    assert posixpath.basename('////foo') == 'foo', ('assertEqual', posixpath.basename('////foo'), 'foo')\n    assert posixpath.basename('//foo//bar') == 'bar', ('assertEqual', posixpath.basename('//foo//bar'), 'bar')\n    assert posixpath.basename(b'/foo/bar') == b'bar', ('assertEqual', posixpath.basename(b'/foo/bar'), b'bar')\n    assert posixpath.basename(b'/') == b'', ('assertEqual', posixpath.basename(b'/'), b'')\n    assert posixpath.basename(b'foo') == b'foo', ('assertEqual', posixpath.basename(b'foo'), b'foo')\n    assert posixpath.basename(b'////foo') == b'foo', ('assertEqual', posixpath.basename(b'////foo'), b'foo')\n    assert posixpath.basename(b'//foo//bar') == b'bar', ('assertEqual', posixpath.basename(b'//foo//bar'), b'bar')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
