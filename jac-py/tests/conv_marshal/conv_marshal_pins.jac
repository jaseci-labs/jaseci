test "BugsTestCase.test_recursion_limit" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import is_apple_mobile, os_helper, requires_debug_ranges, is_emscripten\nimport marshal\nimport sys\nimport os\n\ndef omit_last_byte(data):\n    \"\"\"return data[:-1]\"\"\"\n    return data[slice(0, -1)]\n\ndef _t():\n    head = last = []\n    if os.name == 'nt':\n        MAX_MARSHAL_STACK_DEPTH = 1000\n    elif sys.platform == 'wasi' or is_emscripten or is_apple_mobile:\n        MAX_MARSHAL_STACK_DEPTH = 1500\n    else:\n        MAX_MARSHAL_STACK_DEPTH = 2000\n    for i in range(MAX_MARSHAL_STACK_DEPTH - 2):\n        last.append([0])\n        last = last[-1]\n    data = marshal.dumps(head)\n    new_head = marshal.loads(data)\n    assert len(new_head) == len(head), ('assertEqual', len(new_head), len(head))\n    assert len(new_head[0]) == len(head[0]), ('assertEqual', len(new_head[0]), len(head[0]))\n    assert len(new_head[-1]) == len(head[-1]), ('assertEqual', len(new_head[-1]), len(head[-1]))\n    last.append([0])\n    try:\n        marshal.dumps(*(head,))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "BugsTestCase.test_reference_loop_list" {
    (ok, detail) = p2_libtest_run_snippet("import marshal\n\ndef CollectObjectIDs(ids, obj):\n    \"\"\"Collect object ids seen in a structure\"\"\"\n    if id(obj) in ids:\n        return\n    ids.add(id(obj))\n    if isinstance(obj, (list, tuple, set, frozenset)):\n        for e in obj:\n            CollectObjectIDs(ids, e)\n    elif isinstance(obj, dict):\n        for k, v in obj.items():\n            CollectObjectIDs(ids, k)\n            CollectObjectIDs(ids, v)\n    return len(ids)\n\ndef _t():\n    a = []\n    a.append(a)\n    for v in range(3):\n        try:\n            marshal.dumps(*(a, v))\n        except ValueError:\n            pass\n    for v in range(3, marshal.version + 1):\n        d = marshal.dumps(a, v)\n        b = marshal.loads(d)\n        assert isinstance(b, list), ('assertIsInstance', b, list)\n        assert b[0] is b, ('assertIs', b[0], b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

