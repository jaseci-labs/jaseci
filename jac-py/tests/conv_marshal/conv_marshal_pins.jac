test "BugsTestCase.test_multiple_dumps_and_loads" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import is_apple_mobile, os_helper, requires_debug_ranges, is_emscripten\nimport marshal\n\ndef omit_last_byte(data):\n    \"\"\"return data[:-1]\"\"\"\n    return data[slice(0, -1)]\n\ndef _t():\n    data = (1, 'abc', b'def', 1.0, (2, 'a', ['b', b'c']))\n    for interleaved in (b'', b'0123'):\n        ilen = len(interleaved)\n        positions = []\n        try:\n            with open(os_helper.TESTFN, 'wb') as f:\n                for d in data:\n                    marshal.dump(d, f)\n                    if ilen:\n                        f.write(interleaved)\n                    positions.append(f.tell())\n            with open(os_helper.TESTFN, 'rb') as f:\n                for i, d in enumerate(data):\n                    assert d == marshal.load(f), ('assertEqual', d, marshal.load(f))\n                    if ilen:\n                        f.read(ilen)\n                    assert positions[i] == f.tell(), ('assertEqual', positions[i], f.tell())\n        finally:\n            os_helper.unlink(os_helper.TESTFN)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

