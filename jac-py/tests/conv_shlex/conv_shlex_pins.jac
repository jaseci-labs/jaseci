\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef splitTest(data, comments):\n    for i in range(len(data)):\n        l = shlex.split(data[i][0], comments=comments)\n        assert l == data[i][1:], ('assertEqual', l, data[i][1:])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n