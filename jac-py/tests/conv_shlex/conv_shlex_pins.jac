    (ok, detail) = p2_libtest_run_snippet("import itertools\nimport shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test handling of syntax splitting of ()'\n    src = ['( echo hi )', '(echo hi)']\n    ref = ['(', 'echo', 'hi', ')']\n    for ss, ws in itertools.product(src, (False, True)):\n        s = shlex.shlex(ss, punctuation_chars=True)\n        s.whitespace_split = ws\n        result = list(s)\n        assert ref == result, ('assertEqual', ref, result)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testSyntaxSplitCustom" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test handling of syntax splitting with custom chars'\n    ss = '~/a&&b-c --color=auto||d *.py?'\n    ref = ['~/a', '&', '&', 'b-c', '--color=auto', '||', 'd', '*.py?']\n    s = shlex.shlex(ss, punctuation_chars='|')\n    result = list(s)\n    assert ref == result, ('assertEqual', ref, result)\n    ref = ['~/a&&b-c', '--color=auto', '||', 'd', '*.py?']\n    s = shlex.shlex(ss, punctuation_chars='|')\n    s.whitespace_split = True\n    result = list(s)\n    assert ref == result, ('assertEqual', ref, result)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testTokenTypes" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test that tokens are split with types as expected.'\n    for source, expected in (('a && b || c', [('a', 'a'), ('&&', 'c'), ('b', 'a'), ('||', 'c'), ('c', 'a')]),):\n        s = shlex.shlex(source, punctuation_chars=True)\n        observed = []\n        while True:\n            t = s.get_token()\n            if t == s.eof:\n                break\n            if t[0] in s.punctuation_chars:\n                tt = 'c'\n            else:\n                tt = 'a'\n            observed.append((t, tt))\n        assert observed == expected, ('assertEqual', observed, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testPunctuationInWordChars" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test that any punctuation chars are removed from wordchars'\n    s = shlex.shlex('a_b__c', punctuation_chars='_')\n    assert '_' not in s.wordchars, ('assertNotIn', '_', s.wordchars)\n    assert list(s) == ['a', '_', 'b', '__', 'c'], ('assertEqual', list(s), ['a', '_', 'b', '__', 'c'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testPunctuationWithWhitespaceSplit" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test that with whitespace_split, behaviour is as expected'\n    s = shlex.shlex('a  && b  ||  c', punctuation_chars='&')\n    assert list(s) == ['a', '&&', 'b', '|', '|', 'c'], ('assertEqual', list(s), ['a', '&&', 'b', '|', '|', 'c'])\n    s = shlex.shlex('a  && b  ||  c', punctuation_chars='&')\n    s.whitespace_split = True\n    assert list(s) == ['a', '&&', 'b', '||', 'c'], ('assertEqual', list(s), ['a', '&&', 'b', '||', 'c'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testPunctuationWithPosix" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test that punctuation_chars and posix behave correctly together.'\n    s = shlex.shlex('f >\"abc\"', posix=True, punctuation_chars=True)\n    assert list(s) == ['f', '>', 'abc'], ('assertEqual', list(s), ['f', '>', 'abc'])\n    s = shlex.shlex('f >\\\\\"abc\\\\\"', posix=True, punctuation_chars=True)\n    assert list(s) == ['f', '>', '\"abc\"'], ('assertEqual', list(s), ['f', '>', '\"abc\"'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testEmptyStringHandling" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test that parsing of empty strings is correctly handled.'\n    expected = ['', ')', 'abc']\n    for punct in (False, True):\n        s = shlex.shlex(\"'')abc\", posix=True, punctuation_chars=punct)\n        slist = list(s)\n        assert slist == expected, ('assertEqual', slist, expected)\n    expected = [\"''\", ')', 'abc']\n    s = shlex.shlex(\"'')abc\", punctuation_chars=True)\n    assert list(s) == expected, ('assertEqual', list(s), expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testUnicodeHandling" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test punctuation_chars and whitespace_split handle unicode.'\n    ss = '\u2119\u01b4\u2602\u210c\u00f8\u1f24'\n    ref = ['\u2119\u01b4\u2602\u210c\u00f8\u1f24']\n    s = shlex.shlex(ss, punctuation_chars=True)\n    s.whitespace_split = True\n    assert list(s) == ref, ('assertEqual', list(s), ref)\n    ref = ['\u2119', '\u01b4', '\u2602', '\u210c', '\u00f8', '\u1f24']\n    s = shlex.shlex(ss, punctuation_chars=True)\n    assert list(s) == ref, ('assertEqual', list(s), ref)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testQuote" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\nimport string\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    safeunquoted = string.ascii_letters + string.digits + '@%_-+=:,./'\n    unicode_sample = '\u00e9\u00e0\u00df'\n    unsafe = '\"`$\\\\!' + unicode_sample\n    assert shlex.quote('') == \"''\", ('assertEqual', shlex.quote(''), \"''\")\n    assert shlex.quote(None) == \"''\", ('assertEqual', shlex.quote(None), \"''\")\n    assert shlex.quote(safeunquoted) == safeunquoted, ('assertEqual', shlex.quote(safeunquoted), safeunquoted)\n    assert shlex.quote('test file name') == \"'test file name'\", ('assertEqual', shlex.quote('test file name'), \"'test file name'\")\n    for u in unsafe:\n        assert shlex.quote('test%sname' % u) == \"'test%sname'\" % u, ('assertEqual', shlex.quote('test%sname' % u), \"'test%sname'\" % u)\n    for u in unsafe:\n        assert shlex.quote(\"test%s'name'\" % u) == '\\'test%s\\'\"\\'\"\\'name\\'\"\\'\"\\'\\'' % u, ('assertEqual', shlex.quote(\"test%s'name'\" % u), '\\'test%s\\'\"\\'\"\\'name\\'\"\\'\"\\'\\'' % u)\n    try:\n        shlex.quote(*(42,))\n    except TypeError:\n        pass\n    try:\n        shlex.quote(*(b'abc',))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testJoin" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for split_command, command in [(['a ', 'b'], \"'a ' b\"), (['a', ' b'], \"a ' b'\"), (['a', ' ', 'b'], \"a ' ' b\"), (['\"a', 'b\"'], '\\'\"a\\' \\'b\"\\'')]:\n        joined = shlex.join(split_command)\n        assert joined == command, ('assertEqual', joined, command)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testJoinRoundtrip" {
    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    all_data = self.data + self.posix_data\n    for command, *split_command in all_data:\n        joined = shlex.join(split_command)\n        resplit = shlex.split(joined)\n        assert split_command == resplit, ('assertEqual', split_command, resplit)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

