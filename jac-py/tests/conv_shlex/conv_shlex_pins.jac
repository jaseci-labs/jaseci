    (ok, detail) = p2_libtest_run_snippet("import io\nimport shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef oldSplit(s):\n    ret = []\n    lex = shlex.shlex(io.StringIO(s))\n    tok = lex.get_token()\n    while tok:\n        ret.append(tok)\n        tok = lex.get_token()\n    return ret\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test compatibility interface'\n    for i in range(len(self.data)):\n        l = oldSplit(self.data[i][0])\n        assert l == self.data[i][1:], ('assertEqual', l, self.data[i][1:])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testSyntaxSplitAmpersandAndPipe" {
    (ok, detail) = p2_libtest_run_snippet("import itertools\nimport shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test handling of syntax splitting of &, |'\n    for delimiter in ('&&', '&', '|&', ';&', ';;&', '||', '|', '&|', ';|', ';;|'):\n        src = ['echo hi %s echo bye' % delimiter, 'echo hi%secho bye' % delimiter]\n        ref = ['echo', 'hi', delimiter, 'echo', 'bye']\n        for ss, ws in itertools.product(src, (False, True)):\n            s = shlex.shlex(ss, punctuation_chars=True)\n            s.whitespace_split = ws\n            result = list(s)\n            assert ref == result, ('assertEqual', ref, result)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ShlexTest.testSyntaxSplitSemicolon" {
    (ok, detail) = p2_libtest_run_snippet("import itertools\nimport shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    'Test handling of syntax splitting of ;'\n    for delimiter in (';', ';;', ';&', ';;&'):\n        src = ['echo hi %s echo bye' % delimiter, 'echo hi%s echo bye' % delimiter, 'echo hi%secho bye' % delimiter]\n        ref = ['echo', 'hi', delimiter, 'echo', 'bye']\n        for ss, ws in itertools.product(src, (False, True)):\n            s = shlex.shlex(ss, punctuation_chars=True)\n            s.whitespace_split = ws\n            result = list(s)\n            assert ref == result, ('assertEqual', ref, result)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

