    (ok, detail) = p2_libtest_run_snippet("import shlex\ndata = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|\\\\|x|bar|\\n\\\\ x bar|\\\\|x|bar|\\n\\\\ bar|\\\\|bar|\\nfoo \\\\x bar|foo|\\\\|x|bar|\\nfoo \\\\ x bar|foo|\\\\|x|bar|\\nfoo \\\\ bar|foo|\\\\|bar|\\nfoo \"bar\" bla|foo|\"bar\"|bla|\\n\"foo\" \"bar\" \"bla\"|\"foo\"|\"bar\"|\"bla\"|\\n\"foo\" bar \"bla\"|\"foo\"|bar|\"bla\"|\\n\"foo\" bar bla|\"foo\"|bar|bla|\\nfoo \\'bar\\' bla|foo|\\'bar\\'|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|\\'foo\\'|\\'bar\\'|\\'bla\\'|\\n\\'foo\\' bar \\'bla\\'|\\'foo\\'|bar|\\'bla\\'|\\n\\'foo\\' bar bla|\\'foo\\'|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foo\"bar\"bar\"fasel\"|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foo\\'bar\\'bar\\'fasel\\'|baz|\\n\"\"|\"\"|\\n\\'\\'|\\'\\'|\\nfoo \"\" bar|foo|\"\"|bar|\\nfoo \\'\\' bar|foo|\\'\\'|bar|\\nfoo \"\" \"\" \"\" bar|foo|\"\"|\"\"|\"\"|bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo|\\'\\'|\\'\\'|\\'\\'|bar|\\n\\\\\"\"|\\\\|\"\"|\\n\"\\\\\"|\"\\\\\"|\\n\"foo\\\\ bar\"|\"foo\\\\ bar\"|\\n\"foo\\\\\\\\ bar\"|\"foo\\\\\\\\ bar\"|\\n\"foo\\\\\\\\ bar\\\\\"|\"foo\\\\\\\\ bar\\\\\"|\\n\"foo\\\\\\\\\" bar\\\\\"\"|\"foo\\\\\\\\\"|bar|\\\\|\"\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\ bar\\\\\"|dfadf\"|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|\"foo\\\\\\\\\\\\x bar\\\\\"|dfadf\"|\\n\"foo\\\\x bar\\\\\" dfadf\"|\"foo\\\\x bar\\\\\"|dfadf\"|\\n\\\\\\'\\'|\\\\|\\'\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\\'|\"foo\\\\\\\\\\\\x bar\\\\\"|df\\'a|\\\\|\\'df\\'|\\n\\\\\"foo\"|\\\\|\"foo\"|\\n\\\\\"foo\"\\\\x|\\\\|\"foo\"|\\\\|x|\\n\"foo\\\\x\"|\"foo\\\\x\"|\\n\"foo\\\\ \"|\"foo\\\\ \"|\\nfoo\\\\ xx|foo|\\\\|xx|\\nfoo\\\\ x\\\\x|foo|\\\\|x|\\\\|x|\\nfoo\\\\ x\\\\x\\\\\"\"|foo|\\\\|x|\\\\|x|\\\\|\"\"|\\n\"foo\\\\ x\\\\x\"|\"foo\\\\ x\\\\x\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\\'\"foobar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\\'|\"foobar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|\"foo\\\\ x\\\\x\\\\\\\\\"|\\\\|\\'\"fo\\'|obar\"|\\'don\\'|\\\\|\\'\\'|t\\'|\\n\\'foo\\\\ bar\\'|\\'foo\\\\ bar\\'|\\n\\'foo\\\\\\\\ bar\\'|\\'foo\\\\\\\\ bar\\'|\\nfoo\\\\ bar|foo|\\\\|bar|\\nfoo#bar\\\\nbaz|foobaz|\\n:-) ;-)|:|-|)|;|-|)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1|\u00e9|\u00ed|\u00f3|\u00fa|\\n'\nposix_data = 'x|x|\\nfoo bar|foo|bar|\\n foo bar|foo|bar|\\n foo bar |foo|bar|\\nfoo   bar    bla     fasel|foo|bar|bla|fasel|\\nx y  z              xxxx|x|y|z|xxxx|\\n\\\\x bar|x|bar|\\n\\\\ x bar| x|bar|\\n\\\\ bar| bar|\\nfoo \\\\x bar|foo|x|bar|\\nfoo \\\\ x bar|foo| x|bar|\\nfoo \\\\ bar|foo| bar|\\nfoo \"bar\" bla|foo|bar|bla|\\n\"foo\" \"bar\" \"bla\"|foo|bar|bla|\\n\"foo\" bar \"bla\"|foo|bar|bla|\\n\"foo\" bar bla|foo|bar|bla|\\nfoo \\'bar\\' bla|foo|bar|bla|\\n\\'foo\\' \\'bar\\' \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar \\'bla\\'|foo|bar|bla|\\n\\'foo\\' bar bla|foo|bar|bla|\\nblurb foo\"bar\"bar\"fasel\" baz|blurb|foobarbarfasel|baz|\\nblurb foo\\'bar\\'bar\\'fasel\\' baz|blurb|foobarbarfasel|baz|\\n\"\"||\\n\\'\\'||\\nfoo \"\" bar|foo||bar|\\nfoo \\'\\' bar|foo||bar|\\nfoo \"\" \"\" \"\" bar|foo||||bar|\\nfoo \\'\\' \\'\\' \\'\\' bar|foo||||bar|\\n\\\\\"|\"|\\n\"\\\\\"\"|\"|\\n\"foo\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\"|foo\\\\ bar|\\n\"foo\\\\\\\\ bar\\\\\"\"|foo\\\\ bar\"|\\n\"foo\\\\\\\\\" bar\\\\\"|foo\\\\|bar\"|\\n\"foo\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\ bar\\\\\" dfadf\"|foo\\\\\\\\ bar\" dfadf|\\n\"foo\\\\\\\\\\\\x bar\\\\\" dfadf\"|foo\\\\\\\\x bar\" dfadf|\\n\"foo\\\\x bar\\\\\" dfadf\"|foo\\\\x bar\" dfadf|\\n\\\\\\'|\\'|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\n\"foo\\\\\\\\\\\\x bar\\\\\" df\\'a\\\\ \\'df\"|foo\\\\\\\\x bar\" df\\'a\\\\ \\'df|\\n\\\\\"foo|\"foo|\\n\\\\\"foo\\\\x|\"foox|\\n\"foo\\\\x\"|foo\\\\x|\\n\"foo\\\\ \"|foo\\\\ |\\nfoo\\\\ xx|foo xx|\\nfoo\\\\ x\\\\x|foo xx|\\nfoo\\\\ x\\\\x\\\\\"|foo xx\"|\\n\"foo\\\\ x\\\\x\"|foo\\\\ x\\\\x|\\n\"foo\\\\ x\\\\x\\\\\\\\\"|foo\\\\ x\\\\x\\\\|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\"foobar\"|foo\\\\ x\\\\x\\\\foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"foobar\"|foo\\\\ x\\\\x\\\\\\'foobar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\"|foo\\\\ x\\\\x\\\\\\'fo\\'obar|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\'|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\n\"foo\\\\ x\\\\x\\\\\\\\\"\\\\\\'\"fo\\'obar\" \\'don\\'\\\\\\'\\'t\\' \\\\\\\\|foo\\\\ x\\\\x\\\\\\'fo\\'obar|don\\'t|\\\\|\\n\\'foo\\\\ bar\\'|foo\\\\ bar|\\n\\'foo\\\\\\\\ bar\\'|foo\\\\\\\\ bar|\\nfoo\\\\ bar|foo bar|\\nfoo#bar\\\\nbaz|foo|baz|\\n:-) ;-)|:-)|;-)|\\n\u00e1\u00e9\u00ed\u00f3\u00fa|\u00e1\u00e9\u00ed\u00f3\u00fa|\\n'\n\ndef setUp():\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.data = [x.split('|')[:-1] for x in data.splitlines()]\n    self.posix_data = [x.split('|')[:-1] for x in posix_data.splitlines()]\n    for item in self.data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    for item in self.posix_data:\n        item[0] = item[0].replace('\\\\n', '\\n')\n    punctuation_chars = '/|$%^'\n    shlex_instance = shlex.shlex(punctuation_chars=punctuation_chars)\n    assert shlex_instance.punctuation_chars == punctuation_chars, ('assertEqual', shlex_instance.punctuation_chars, punctuation_chars)\n    try:\n        shlex_instance.punctuation_chars = False\n    except AttributeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

