    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test_Struct_reinitialization" {
    (ok, detail) = p2_libtest_run_snippet("import struct\n\ndef string_reverse(s):\n    return s[::-1]\n\ndef _t():\n    s = struct.Struct('>h')\n    s.__init__('>hh')\n    assert s.format == '>hh', ('assertEqual', s.format, '>hh')\n    packed = b'\\x00\\x01\\x00\\x02'\n    assert s.pack(1, 2) == packed, ('assertEqual', s.pack(1, 2), packed)\n    assert s.unpack(packed) == (1, 2), ('assertEqual', s.unpack(packed), (1, 2))\n    try:\n        s.__init__('\\udc00')\n    except UnicodeEncodeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert s.format == '>hh', ('assertEqual', s.format, '>hh')\n    assert s.pack(1, 2) == packed, ('assertEqual', s.pack(1, 2), packed)\n    assert s.unpack(packed) == (1, 2), ('assertEqual', s.unpack(packed), (1, 2))\n    try:\n        s.__init__('$')\n    except struct.error as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert s.format == '>hh', ('assertEqual', s.format, '>hh')\n    assert s.pack(1, 2) == packed, ('assertEqual', s.pack(1, 2), packed)\n    assert s.unpack(packed) == (1, 2), ('assertEqual', s.unpack(packed), (1, 2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test_boundary_error_message" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport struct\n\ndef _t():\n    regex1 = 'pack_into requires a buffer of at least 6 bytes for packing 1 bytes at offset 5 \\\\(actual buffer size is 1\\\\)'\n    try:\n        struct.pack_into('b', bytearray(1), 5, 1)\n    except struct.error as _exc:\n        assert _re.search(regex1, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    regex2 = 'unpack_from requires a buffer of at least 6 bytes for unpacking 1 bytes at offset 5 \\\\(actual buffer size is 1\\\\)'\n    try:\n        struct.unpack_from('b', bytearray(1), 5)\n    except struct.error as _exc:\n        assert _re.search(regex2, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test_boundary_error_message_with_negative_offset" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport struct\n\ndef _t():\n    byte_list = bytearray(10)\n    try:\n        struct.pack_into('<I', byte_list, -2, 123)\n    except struct.error as _exc:\n        assert _re.search('no space to pack 4 bytes at offset -2', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        struct.pack_into('<B', byte_list, -11, 123)\n    except struct.error as _exc:\n        assert _re.search('offset -11 out of range for 10-byte buffer', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        struct.unpack_from('<I', byte_list, -2)\n    except struct.error as _exc:\n        assert _re.search('not enough data to unpack 4 bytes at offset -2', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        struct.unpack_from('<B', byte_list, -11)\n    except struct.error as _exc:\n        assert _re.search('offset -11 out of range for 10-byte buffer', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

