test "StructTest.test_struct_cleans_up_at_runtime_shutdown" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.script_helper import assert_python_ok\ninteger_codes = ('b', 'B', 'h', 'H', 'i', 'I', 'l', 'L', 'q', 'Q', 'n', 'N')\nbyteorders = ('', '@', '=', '<', '>', '!')\n\ndef iter_integer_formats(byteorders=byteorders):\n    for code in integer_codes:\n        for byteorder in byteorders:\n            if byteorder not in ('', '@') and code in ('n', 'N'):\n                continue\n            yield (code, byteorder)\n\ndef _t():\n    code = \"if 1:\\n            import struct\\n\\n            class C:\\n                def __init__(self):\\n                    self.pack = struct.pack\\n                def __del__(self):\\n                    self.pack('I', -42)\\n\\n            struct.x = C()\\n            \"\n    rc, stdout, stderr = assert_python_ok('-c', code)\n    assert rc == 0, ('assertEqual', rc, 0)\n    assert stdout.rstrip() == b'', ('assertEqual', stdout.rstrip(), b'')\n    assert b'Exception ignored while calling deallocator' in stderr, ('assertIn', b'Exception ignored while calling deallocator', stderr)\n    assert b'C.__del__' in stderr, ('assertIn', b'C.__del__', stderr)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test__struct_reference_cycle_cleaned_up" {
    (ok, detail) = p2_libtest_run_snippet("import gc\nimport weakref\nfrom test.support import import_helper\n\ndef _t():\n    _struct_module = import_helper.import_fresh_module('_struct')\n    module_ref = weakref.ref(_struct_module)\n    _struct_module.calcsize('b')\n    del _struct_module\n    gc.collect()\n    assert module_ref() is None, ('assertIsNone', module_ref())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

