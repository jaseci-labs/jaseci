    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test_705836" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport struct\n\ndef string_reverse(s):\n    return s[::-1]\n\ndef _t():\n    for base in range(1, 33):\n        delta = 0.5\n        while base - delta / 2.0 != base:\n            delta /= 2.0\n        smaller = base - delta\n        packed = struct.pack('<f', smaller)\n        unpacked = struct.unpack('<f', packed)[0]\n        assert base == unpacked, ('assertEqual', base, unpacked)\n        bigpacked = struct.pack('>f', smaller)\n        assert bigpacked == string_reverse(packed), ('assertEqual', bigpacked, string_reverse(packed))\n        unpacked = struct.unpack('>f', bigpacked)[0]\n        assert base == unpacked, ('assertEqual', base, unpacked)\n    big = (1 << 24) - 1\n    big = math.ldexp(big, 127 - 23)\n    packed = struct.pack('>f', big)\n    unpacked = struct.unpack('>f', packed)[0]\n    assert big == unpacked, ('assertEqual', big, unpacked)\n    big = (1 << 25) - 1\n    big = math.ldexp(big, 127 - 24)\n    try:\n        struct.pack(*('>f', big))\n    except OverflowError:\n        pass\n    try:\n        struct.pack(*('<f', big))\n    except OverflowError:\n        pass\n    try:\n        struct.pack(*('f', big))\n    except OverflowError:\n        pass\n    big = (1 << 11) - 1\n    big = math.ldexp(big, 15 - 10)\n    packed = struct.pack('>e', big)\n    unpacked = struct.unpack('>e', packed)[0]\n    assert big == unpacked, ('assertEqual', big, unpacked)\n    big = (1 << 12) - 1\n    big = math.ldexp(big, 15 - 11)\n    try:\n        struct.pack(*('>e', big))\n    except OverflowError:\n        pass\n    try:\n        struct.pack(*('<e', big))\n    except OverflowError:\n        pass\n    try:\n        struct.pack(*('e', big))\n    except OverflowError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

