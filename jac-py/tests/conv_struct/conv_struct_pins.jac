test "StructTest.test_calcsize" {
    (ok, detail) = p2_libtest_run_snippet("import struct\ninteger_codes = ('b', 'B', 'h', 'H', 'i', 'I', 'l', 'L', 'q', 'Q', 'n', 'N')\nbyteorders = ('', '@', '=', '<', '>', '!')\n\ndef iter_integer_formats(byteorders=byteorders):\n    for code in integer_codes:\n        for byteorder in byteorders:\n            if byteorder not in ('', '@') and code in ('n', 'N'):\n                continue\n            yield (code, byteorder)\n\ndef _t():\n    expected_size = {'b': 1, 'B': 1, 'h': 2, 'H': 2, 'i': 4, 'I': 4, 'l': 4, 'L': 4, 'q': 8, 'Q': 8}\n    for code, byteorder in iter_integer_formats(('=', '<', '>', '!')):\n        format = byteorder + code\n        size = struct.calcsize(format)\n        assert size == expected_size[code], ('assertEqual', size, expected_size[code])\n    native_pairs = ('bB', 'hH', 'iI', 'lL', 'nN', 'qQ')\n    for format_pair in native_pairs:\n        for byteorder in ('', '@'):\n            signed_size = struct.calcsize(byteorder + format_pair[0])\n            unsigned_size = struct.calcsize(byteorder + format_pair[1])\n            assert signed_size == unsigned_size, ('assertEqual', signed_size, unsigned_size)\n    assert struct.calcsize('b') == 1, ('assertEqual', struct.calcsize('b'), 1)\n    assert 2 <= struct.calcsize('h'), ('assertLessEqual', 2, struct.calcsize('h'))\n    assert 4 <= struct.calcsize('l'), ('assertLessEqual', 4, struct.calcsize('l'))\n    assert struct.calcsize('h') <= struct.calcsize('i'), ('assertLessEqual', struct.calcsize('h'), struct.calcsize('i'))\n    assert struct.calcsize('i') <= struct.calcsize('l'), ('assertLessEqual', struct.calcsize('i'), struct.calcsize('l'))\n    assert 8 <= struct.calcsize('q'), ('assertLessEqual', 8, struct.calcsize('q'))\n    assert struct.calcsize('l') <= struct.calcsize('q'), ('assertLessEqual', struct.calcsize('l'), struct.calcsize('q'))\n    assert struct.calcsize('n') >= struct.calcsize('i'), ('assertGreaterEqual', struct.calcsize('n'), struct.calcsize('i'))\n    assert struct.calcsize('n') >= struct.calcsize('P'), ('assertGreaterEqual', struct.calcsize('n'), struct.calcsize('P'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test_p_code" {
