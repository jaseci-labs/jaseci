test "StructTest.test_unpack_from" {
    (ok, detail) = p2_libtest_run_snippet("import struct\n\ndef string_reverse(s):\n    return s[::-1]\n\ndef _t():\n    test_string = b'abcd01234'\n    fmt = '4s'\n    s = struct.Struct(fmt)\n    for cls in (bytes, bytearray):\n        data = cls(test_string)\n        assert s.unpack_from(data) == (b'abcd',), ('assertEqual', s.unpack_from(data), (b'abcd',))\n        assert s.unpack_from(data, 2) == (b'cd01',), ('assertEqual', s.unpack_from(data, 2), (b'cd01',))\n        assert s.unpack_from(data, 4) == (b'0123',), ('assertEqual', s.unpack_from(data, 4), (b'0123',))\n        for i in range(6):\n            assert s.unpack_from(data, i) == (data[i:i + 4],), ('assertEqual', s.unpack_from(data, i), (data[i:i + 4],))\n        for i in range(6, len(test_string) + 1):\n            try:\n                s.unpack_from(*(data, i))\n            except struct.error:\n                pass\n    for cls in (bytes, bytearray):\n        data = cls(test_string)\n        assert struct.unpack_from(fmt, data) == (b'abcd',), ('assertEqual', struct.unpack_from(fmt, data), (b'abcd',))\n        assert struct.unpack_from(fmt, data, 2) == (b'cd01',), ('assertEqual', struct.unpack_from(fmt, data, 2), (b'cd01',))\n        assert struct.unpack_from(fmt, data, 4) == (b'0123',), ('assertEqual', struct.unpack_from(fmt, data, 4), (b'0123',))\n        for i in range(6):\n            assert struct.unpack_from(fmt, data, i) == (data[i:i + 4],), ('assertEqual', struct.unpack_from(fmt, data, i), (data[i:i + 4],))\n        for i in range(6, len(test_string) + 1):\n            try:\n                struct.unpack_from(*(fmt, data, i))\n            except struct.error:\n                pass\n    assert s.unpack_from(buffer=test_string, offset=2) == (b'cd01',), ('assertEqual', s.unpack_from(buffer=test_string, offset=2), (b'cd01',))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test_unpack_with_buffer" {
    (ok, detail) = p2_libtest_run_snippet("import array\nimport struct\nimport sys\nISBIGENDIAN = sys.byteorder == 'big'\n\ndef string_reverse(s):\n    return s[::-1]\n\ndef bigendian_to_native(value):\n    if ISBIGENDIAN:\n        return value\n    else:\n        return string_reverse(value)\n\ndef _t():\n    data1 = array.array('B', b'\\x124Vx')\n    data2 = memoryview(b'\\x124Vx')\n    for data in [data1, data2]:\n        value, = struct.unpack('>I', data)\n        assert value == 305419896, ('assertEqual', value, 305419896)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "StructTest.test_bool" {
    (ok, detail) = p2_libtest_run_snippet("import struct\n\ndef _t():\n\n    class ExplodingBool(object):\n\n        def __bool__(self):\n            raise OSError\n    for prefix in tuple('<>!=') + ('',):\n        false = ((), [], [], '', 0)\n        true = ([1], 'test', 5, -1, 4294967295 + 1, 4294967295 / 2)\n        falseFormat = prefix + '?' * len(false)\n        packedFalse = struct.pack(falseFormat, *false)\n        unpackedFalse = struct.unpack(falseFormat, packedFalse)\n        trueFormat = prefix + '?' * len(true)\n        packedTrue = struct.pack(trueFormat, *true)\n        unpackedTrue = struct.unpack(trueFormat, packedTrue)\n        assert len(true) == len(unpackedTrue), ('assertEqual', len(true), len(unpackedTrue))\n        assert len(false) == len(unpackedFalse), ('assertEqual', len(false), len(unpackedFalse))\n        for t in unpackedFalse:\n            assert not t, ('assertFalse', t)\n        for t in unpackedTrue:\n            assert t, ('assertTrue', t)\n        packed = struct.pack(prefix + '?', 1)\n        assert len(packed) == struct.calcsize(prefix + '?'), ('assertEqual', len(packed), struct.calcsize(prefix + '?'))\n        if len(packed) != 1:\n            assert not prefix, ('assertFalse', prefix, 'encoded bool is not one byte: %r' % packed)\n        try:\n            struct.pack(prefix + '?', ExplodingBool())\n        except OSError:\n            pass\n        else:\n            raise AssertionError('Expected OSError: struct.pack(%r, ExplodingBool())' % (prefix + '?'))\n    for c in [b'\\x01', b'\\x7f', b'\\xff', b'\\x0f', b'\\xf0']:\n        assert struct.unpack('>?', c)[0], ('assertTrue', struct.unpack('>?', c)[0])\n        assert struct.unpack('<?', c)[0], ('assertTrue', struct.unpack('<?', c)[0])\n        assert struct.unpack('=?', c)[0], ('assertTrue', struct.unpack('=?', c)[0])\n        assert struct.unpack('@?', c)[0], ('assertTrue', struct.unpack('@?', c)[0])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

