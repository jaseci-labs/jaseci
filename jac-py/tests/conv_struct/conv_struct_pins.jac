test "UnpackIteratorTest.test_length_hint" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nimport struct\n\ndef string_reverse(s):\n    return s[::-1]\n\ndef _t():\n    lh = operator.length_hint\n    s = struct.Struct('>IB')\n    b = bytes(range(1, 16))\n    it = s.iter_unpack(b)\n    assert lh(it) == 3, ('assertEqual', lh(it), 3)\n    next(it)\n    assert lh(it) == 2, ('assertEqual', lh(it), 2)\n    next(it)\n    assert lh(it) == 1, ('assertEqual', lh(it), 1)\n    next(it)\n    assert lh(it) == 0, ('assertEqual', lh(it), 0)\n    try:\n        next(*(it,))\n    except StopIteration:\n        pass\n    assert lh(it) == 0, ('assertEqual', lh(it), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

