test "StructTest.test_operations_on_half_initialized_Struct" {
    (ok, detail) = p2_libtest_run_snippet("import array\nimport struct\n\ndef _t():\n    S = struct.Struct.__new__(struct.Struct)\n    spam = array.array('b', b' ')\n    try:\n        S.iter_unpack(*(spam,))\n    except RuntimeError:\n        pass\n    try:\n        S.pack(*(1,))\n    except RuntimeError:\n        pass\n    try:\n        S.pack_into(*(spam, 1))\n    except RuntimeError:\n        pass\n    try:\n        S.unpack(*(spam,))\n    except RuntimeError:\n        pass\n    try:\n        S.unpack_from(*(spam,))\n    except RuntimeError:\n        pass\n    try:\n        getattr(*(S, 'format'))\n    except RuntimeError:\n        pass\n    try:\n        S.__sizeof__()\n    except RuntimeError:\n        pass\n    try:\n        repr(*(S,))\n    except RuntimeError:\n        pass\n    assert S.size == -1, ('assertEqual', S.size, -1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "UnpackIteratorTest.test_construct" {
    (ok, detail) = p2_libtest_run_snippet("from collections import abc\nimport struct\n\ndef string_reverse(s):\n    return s[::-1]\n\ndef _t():\n\n    def _check_iterator(it):\n        assert isinstance(it, abc.Iterator), ('assertIsInstance', it, abc.Iterator)\n        assert isinstance(it, abc.Iterable), ('assertIsInstance', it, abc.Iterable)\n    s = struct.Struct('>ibcp')\n    it = s.iter_unpack(b'')\n    _check_iterator(it)\n    it = s.iter_unpack(b'1234567')\n    _check_iterator(it)\n    try:\n        s.iter_unpack(b'123456')\n    except struct.error as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        s.iter_unpack(b'12345678')\n    except struct.error as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    s = struct.Struct('>')\n    try:\n        s.iter_unpack(b'')\n    except struct.error as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        s.iter_unpack(b'12')\n    except struct.error as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

