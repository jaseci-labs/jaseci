test "ExtendPathTests.test_simple" {
    (ok, detail) = p2_libtest_run_snippet("import sys\nimport os\nimport os.path\nimport tempfile\nimport shutil\n\ndef create_init(pkgname):\n    dirname = tempfile.mkdtemp()\n    sys.path.insert(0, dirname)\n    pkgdir = os.path.join(dirname, pkgname)\n    os.mkdir(pkgdir)\n    with open(os.path.join(pkgdir, '__init__.py'), 'w') as fl:\n        fl.write('from pkgutil import extend_path\\n__path__ = extend_path(__path__, __name__)\\n')\n    return dirname\n\ndef create_submodule(dirname, pkgname, submodule_name, value):\n    module_name = os.path.join(dirname, pkgname, submodule_name + '.py')\n    with open(module_name, 'w') as fl:\n        print('value={}'.format(value), file=fl)\n\ndef _t():\n    pkgname = 'foo'\n    dirname_0 = create_init(pkgname)\n    dirname_1 = create_init(pkgname)\n    create_submodule(dirname_0, pkgname, 'bar', 0)\n    create_submodule(dirname_1, pkgname, 'baz', 1)\n    import foo.bar\n    import foo.baz\n    assert foo.bar.value == 0, ('assertEqual', foo.bar.value, 0)\n    assert foo.baz.value == 1, ('assertEqual', foo.baz.value, 1)\n    assert sorted(foo.__path__) == sorted([os.path.join(dirname_0, pkgname), os.path.join(dirname_1, pkgname)]), ('assertEqual', sorted(foo.__path__), sorted([os.path.join(dirname_0, pkgname), os.path.join(dirname_1, pkgname)]))\n    shutil.rmtree(dirname_0)\n    shutil.rmtree(dirname_1)\n    del sys.path[0]\n    del sys.path[0]\n    del sys.modules['foo']\n    del sys.modules['foo.bar']\n    del sys.modules['foo.baz']\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
