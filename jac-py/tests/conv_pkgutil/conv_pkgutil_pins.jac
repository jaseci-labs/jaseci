ortlib.machinery.SourceFileLoader)\n            assert finder.find_spec(pkgname) is None, ('assertIsNone', finder.find_spec(pkgname))\n        try:\n            list(iter_importers('invalid.module'))\n        except ImportError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            list(iter_importers('.spam'))\n        except ImportError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n    finally:\n        shutil.rmtree(dirname)\n        del sys.path[0]\n        try:\n            del sys.modules['spam']\n            del sys.modules['spam.eggs']\n        except KeyError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

