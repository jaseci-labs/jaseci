    (ok, detail) = p2_libtest_run_snippet("import sys\nimport pkgutil\nimport os\nimport os.path\nimport tempfile\nimport shutil\n\ndef create_init(pkgname):\n    dirname = tempfile.mkdtemp()\n    sys.path.insert(0, dirname)\n    pkgdir = os.path.join(dirname, pkgname)\n    os.mkdir(pkgdir)\n    with open(os.path.join(pkgdir, '__init__.py'), 'w') as fl:\n        fl.write('from pkgutil import extend_path\\n__path__ = extend_path(__path__, __name__)\\n')\n    return dirname\n\ndef _t():\n    pkgname = 'foo'\n    dirname_0 = create_init(pkgname)\n    with open(os.path.join(dirname_0, 'bar.pkg'), 'w') as pkg_file:\n        pkg_file.write('\\n'.join(['baz', '/foo/bar/baz', '', '#comment']))\n    extended_paths = pkgutil.extend_path(sys.path, 'bar')\n    assert extended_paths[:-2] == sys.path, ('assertEqual', extended_paths[:-2], sys.path)\n    assert extended_paths[-2] == 'baz', ('assertEqual', extended_paths[-2], 'baz')\n    assert extended_paths[-1] == '/foo/bar/baz', ('assertEqual', extended_paths[-1], '/foo/bar/baz')\n    shutil.rmtree(dirname_0)\n    del sys.path[0]\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
