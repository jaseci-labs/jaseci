test "FractionTest.testHash" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nimport sys\nF = fractions.Fraction\n\ndef _t():\n    hmod = sys.hash_info.modulus\n    hinf = sys.hash_info.inf\n    assert hash(2.5) == hash(F(5, 2)), ('assertEqual', hash(2.5), hash(F(5, 2)))\n    assert hash(10 ** 50) == hash(F(10 ** 50)), ('assertEqual', hash(10 ** 50), hash(F(10 ** 50)))\n    assert hash(float(10 ** 23)) != hash(F(10 ** 23)), ('assertNotEqual', hash(float(10 ** 23)), hash(F(10 ** 23)))\n    assert hinf == hash(F(1, hmod)), ('assertEqual', hinf, hash(F(1, hmod)))\n    assert hash(F(-1)) == F(-1).__hash__(), ('assertEqual', hash(F(-1)), F(-1).__hash__())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.testApproximatePi" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport fractions\nF = fractions.Fraction\n\ndef _t():\n    three = F(3)\n    lasts, t, s, n, na, d, da = (0, three, 3, 1, 0, 0, 24)\n    while abs(s - lasts) > F(1, 10 ** 9):\n        lasts = s\n        n, na = (n + na, na + 8)\n        d, da = (d + da, da + 32)\n        t = t * n / d\n        s += t\n    assert round(math.pi - s, 7) == 0, ('assertAlmostEqual', math.pi, s)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.testApproximateCos1" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport fractions\nF = fractions.Fraction\n\ndef _t():\n    x = F(1)\n    i, lasts, s, fact, num, sign = (0, 0, F(1), 1, 1, 1)\n    while abs(s - lasts) > F(1, 10 ** 9):\n        lasts = s\n        i += 2\n        fact *= i * (i - 1)\n        num *= x * x\n        sign *= -1\n        s += num / fact * sign\n    assert round(math.cos(1) - s, 7) == 0, ('assertAlmostEqual', math.cos(1), s)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.test_copy_deepcopy_pickle" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nfrom copy import copy, deepcopy\nimport pickle\nfrom pickle import dumps, loads\nF = fractions.Fraction\n\nclass DummyFraction(fractions.Fraction):\n    \"\"\"Dummy Fraction subclass for copy and deepcopy testing.\"\"\"\n\ndef _components(r):\n    return (r.numerator, r.denominator)\n\ndef assertTypedEquals(expected, actual):\n    \"\"\"Asserts that both the types and values are the same.\"\"\"\n    assert type(expected) == type(actual), ('assertEqual', type(expected), type(actual))\n    assert expected == actual, ('assertEqual', expected, actual)\n\ndef _t():\n    r = F(13, 7)\n    dr = DummyFraction(13, 7)\n    for proto in range(0, pickle.HIGHEST_PROTOCOL + 1):\n        assert r == loads(dumps(r, proto)), ('assertEqual', r, loads(dumps(r, proto)))\n    assert id(r) == id(copy(r)), ('assertEqual', id(r), id(copy(r)))\n    assert id(r) == id(deepcopy(r)), ('assertEqual', id(r), id(deepcopy(r)))\n    assert id(dr) != id(copy(dr)), ('assertNotEqual', id(dr), id(copy(dr)))\n    assert id(dr) != id(deepcopy(dr)), ('assertNotEqual', id(dr), id(deepcopy(dr)))\n    assertTypedEquals(dr, copy(dr))\n    assertTypedEquals(dr, deepcopy(dr))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

