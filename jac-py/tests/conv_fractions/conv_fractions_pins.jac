test "FractionTest.testArithmetic" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nimport fractions\nF = fractions.Fraction\n\ndef assertTypedEquals(expected, actual):\n    \"\"\"Asserts that both the types and values are the same.\"\"\"\n    assert type(expected) == type(actual), ('assertEqual', type(expected), type(actual))\n    assert expected == actual, ('assertEqual', expected, actual)\n\ndef _t():\n    assert F(1, 2) == F(1, 10) + F(2, 5), ('assertEqual', F(1, 2), F(1, 10) + F(2, 5))\n    assert F(-3, 10) == F(1, 10) - F(2, 5), ('assertEqual', F(-3, 10), F(1, 10) - F(2, 5))\n    assert F(1, 25) == F(1, 10) * F(2, 5), ('assertEqual', F(1, 25), F(1, 10) * F(2, 5))\n    assert F(5, 6) == F(2, 3) * F(5, 4), ('assertEqual', F(5, 6), F(2, 3) * F(5, 4))\n    assert F(1, 4) == F(1, 10) / F(2, 5), ('assertEqual', F(1, 4), F(1, 10) / F(2, 5))\n    assert F(-15, 8) == F(3, 4) / F(-2, 5), ('assertEqual', F(-15, 8), F(3, 4) / F(-2, 5))\n    try:\n        operator.truediv(*(F(1), F(0)))\n    except ZeroDivisionError:\n        pass\n    assertTypedEquals(2, F(9, 10) // F(2, 5))\n    assertTypedEquals(10 ** 23, F(10 ** 23, 1) // F(1))\n    assert F(5, 6) == F(7, 3) % F(3, 2), ('assertEqual', F(5, 6), F(7, 3) % F(3, 2))\n    assert F(2, 3) == F(-7, 3) % F(3, 2), ('assertEqual', F(2, 3), F(-7, 3) % F(3, 2))\n    assert (F(1), F(5, 6)) == divmod(F(7, 3), F(3, 2)), ('assertEqual', (F(1), F(5, 6)), divmod(F(7, 3), F(3, 2)))\n    assert (F(-2), F(2, 3)) == divmod(F(-7, 3), F(3, 2)), ('assertEqual', (F(-2), F(2, 3)), divmod(F(-7, 3), F(3, 2)))\n    assert F(8, 27) == F(2, 3) ** F(3), ('assertEqual', F(8, 27), F(2, 3) ** F(3))\n    assert F(27, 8) == F(2, 3) ** F(-3), ('assertEqual', F(27, 8), F(2, 3) ** F(-3))\n    assertTypedEquals(2.0, F(4) ** F(1, 2))\n    assert F(1, 1) == +F(1, 1), ('assertEqual', F(1, 1), +F(1, 1))\n    z = pow(F(-1), F(1, 2))\n    assert round(z.real - 0, 7) == 0, ('assertAlmostEqual', z.real, 0)\n    assert z.imag == 1, ('assertEqual', z.imag, 1)\n    p = F(-1, 2) ** 0\n    assert p == F(1, 1), ('assertEqual', p, F(1, 1))\n    assert p.numerator == 1, ('assertEqual', p.numerator, 1)\n    assert p.denominator == 1, ('assertEqual', p.denominator, 1)\n    p = F(-1, 2) ** (-1)\n    assert p == F(-2, 1), ('assertEqual', p, F(-2, 1))\n    assert p.numerator == -2, ('assertEqual', p.numerator, -2)\n    assert p.denominator == 1, ('assertEqual', p.denominator, 1)\n    p = F(-1, 2) ** (-2)\n    assert p == F(4, 1), ('assertEqual', p, F(4, 1))\n    assert p.numerator == 4, ('assertEqual', p.numerator, 4)\n    assert p.denominator == 1, ('assertEqual', p.denominator, 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.testLargeArithmetic" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef assertTypedEquals(expected, actual):\n    \"\"\"Asserts that both the types and values are the same.\"\"\"\n    assert type(expected) == type(actual), ('assertEqual', type(expected), type(actual))\n    assert expected == actual, ('assertEqual', expected, actual)\n\ndef assertTypedTupleEquals(expected, actual):\n    \"\"\"Asserts that both the types and values in the tuples are the same.\"\"\"\n    assert expected == actual, ('assertTupleEqual', expected, actual)\n    assert list(map(type, expected)) == list(map(type, actual)), ('assertListEqual', list(map(type, expected)), list(map(type, actual)))\n\ndef _t():\n    assertTypedEquals(F(10101010100808080808080808101010101010000000000000000, 1010101010101010101010101011111111101010101010101010101010101), F(10 ** 35 + 1, 10 ** 27 + 1) % F(10 ** 27 + 1, 10 ** 35 - 1))\n    assertTypedEquals(F(7, 1901475900342344102245054808064), F(-2 ** 100, 3) % F(5, 2 ** 100))\n    assertTypedTupleEquals((9999999999999999, F(10101010100808080808080808101010101010000000000000000, 1010101010101010101010101011111111101010101010101010101010101)), divmod(F(10 ** 35 + 1, 10 ** 27 + 1), F(10 ** 27 + 1, 10 ** 35 - 1)))\n    assertTypedEquals(-2 ** 200 // 15, F(-2 ** 100, 3) // F(5, 2 ** 100))\n    assertTypedEquals(1, F(5, 2 ** 100) // F(3, 2 ** 100))\n    assertTypedEquals((1, F(2, 2 ** 100)), divmod(F(5, 2 ** 100), F(3, 2 ** 100)))\n    assertTypedTupleEquals((-2 ** 200 // 15, F(7, 1901475900342344102245054808064)), divmod(F(-2 ** 100, 3), F(5, 2 ** 100)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

