test "FractionTest.test_int_subclass" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\n\ndef _t():\n\n    class myint(int):\n\n        def __mul__(self, other):\n            return type(self)(int(self) * int(other))\n\n        def __floordiv__(self, other):\n            return type(self)(int(self) // int(other))\n\n        def __mod__(self, other):\n            x = type(self)(int(self) % int(other))\n            return x\n\n        @property\n        def numerator(self):\n            return type(self)(int(self))\n\n        @property\n        def denominator(self):\n            return type(self)(1)\n    f = fractions.Fraction(myint(1 * 3), myint(2 * 3))\n    assert f.numerator == 1, ('assertEqual', f.numerator, 1)\n    assert f.denominator == 2, ('assertEqual', f.denominator, 2)\n    assert type(f.numerator) == myint, ('assertEqual', type(f.numerator), myint)\n    assert type(f.denominator) == myint, ('assertEqual', type(f.denominator), myint)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

