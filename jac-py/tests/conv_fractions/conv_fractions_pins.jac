    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef _components(r):\n    return (r.numerator, r.denominator)\n\ndef _t():\n    r = F(7, 3)\n    r.__init__(2, 15)\n    assert (7, 3) == _components(r), ('assertEqual', (7, 3), _components(r))\n    try:\n        setattr(*(r, 'numerator', 12))\n    except AttributeError:\n        pass\n    try:\n        setattr(*(r, 'denominator', 6))\n    except AttributeError:\n        pass\n    assert (7, 3) == _components(r), ('assertEqual', (7, 3), _components(r))\n    r._numerator = 4\n    r._denominator = 2\n    assert (4, 2) == _components(r), ('assertEqual', (4, 2), _components(r))\n    assert F(4, 2) != r, ('assertNotEqual', F(4, 2), r)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.testFromFloat" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef _components(r):\n    return (r.numerator, r.denominator)\n\ndef assertRaisesMessage(exc_type, message, callable, *args, **kwargs):\n    \"\"\"Asserts that callable(*args, **kwargs) raises exc_type(message).\"\"\"\n    try:\n        callable(*args, **kwargs)\n    except exc_type as e:\n        assert message == str(e), ('assertEqual', message, str(e))\n    else:\n        raise AssertionError('%s not raised' % exc_type.__name__)\n\ndef _t():\n    try:\n        F.from_float(*(3 + 4j,))\n    except TypeError:\n        pass\n    assert (10, 1) == _components(F.from_float(10)), ('assertEqual', (10, 1), _components(F.from_float(10)))\n    bigint = 1234567890123456789\n    assert (bigint, 1) == _components(F.from_float(bigint)), ('assertEqual', (bigint, 1), _components(F.from_float(bigint)))\n    assert (0, 1) == _components(F.from_float(-0.0)), ('assertEqual', (0, 1), _components(F.from_float(-0.0)))\n    assert (10, 1) == _components(F.from_float(10.0)), ('assertEqual', (10, 1), _components(F.from_float(10.0)))\n    assert (-5, 2) == _components(F.from_float(-2.5)), ('assertEqual', (-5, 2), _components(F.from_float(-2.5)))\n    assert (99999999999999991611392, 1) == _components(F.from_float(1e+23)), ('assertEqual', (99999999999999991611392, 1), _components(F.from_float(1e+23)))\n    assert float(10 ** 23) == float(F.from_float(1e+23)), ('assertEqual', float(10 ** 23), float(F.from_float(1e+23)))\n    assert (3602879701896397, 1125899906842624) == _components(F.from_float(3.2)), ('assertEqual', (3602879701896397, 1125899906842624), _components(F.from_float(3.2)))\n    assert 3.2 == float(F.from_float(3.2)), ('assertEqual', 3.2, float(F.from_float(3.2)))\n    inf = 1e309\n    nan = inf - inf\n    assertRaisesMessage(OverflowError, 'cannot convert Infinity to integer ratio', F.from_float, inf)\n    assertRaisesMessage(OverflowError, 'cannot convert Infinity to integer ratio', F.from_float, -inf)\n    assertRaisesMessage(ValueError, 'cannot convert NaN to integer ratio', F.from_float, nan)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.testFromDecimal" {
    (ok, detail) = p2_libtest_run_snippet("from decimal import Decimal\nimport fractions\nF = fractions.Fraction\n\ndef assertRaisesMessage(exc_type, message, callable, *args, **kwargs):\n    \"\"\"Asserts that callable(*args, **kwargs) raises exc_type(message).\"\"\"\n    try:\n        callable(*args, **kwargs)\n    except exc_type as e:\n        assert message == str(e), ('assertEqual', message, str(e))\n    else:\n        raise AssertionError('%s not raised' % exc_type.__name__)\n\ndef _t():\n    try:\n        F.from_decimal(*(3 + 4j,))\n    except TypeError:\n        pass\n    assert F(10, 1) == F.from_decimal(10), ('assertEqual', F(10, 1), F.from_decimal(10))\n    assert F(0) == F.from_decimal(Decimal('-0')), ('assertEqual', F(0), F.from_decimal(Decimal('-0')))\n    assert F(5, 10) == F.from_decimal(Decimal('0.5')), ('assertEqual', F(5, 10), F.from_decimal(Decimal('0.5')))\n    assert F(5, 1000) == F.from_decimal(Decimal('5e-3')), ('assertEqual', F(5, 1000), F.from_decimal(Decimal('5e-3')))\n    assert F(5000) == F.from_decimal(Decimal('5e3')), ('assertEqual', F(5000), F.from_decimal(Decimal('5e3')))\n    assert 1 - F(1, 10 ** 30) == F.from_decimal(Decimal('0.' + '9' * 30)), ('assertEqual', 1 - F(1, 10 ** 30), F.from_decimal(Decimal('0.' + '9' * 30)))\n    assertRaisesMessage(OverflowError, 'cannot convert Infinity to integer ratio', F.from_decimal, Decimal('inf'))\n    assertRaisesMessage(OverflowError, 'cannot convert Infinity to integer ratio', F.from_decimal, Decimal('-inf'))\n    assertRaisesMessage(ValueError, 'cannot convert NaN to integer ratio', F.from_decimal, Decimal('nan'))\n    assertRaisesMessage(ValueError, 'cannot convert NaN to integer ratio', F.from_decimal, Decimal('snan'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
