test "FractionTest.testMixedLessEqual" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef _t():\n    assert 0.5 <= F(1, 2), ('assertTrue', 0.5 <= F(1, 2))\n    assert not 0.6 <= F(1, 2), ('assertFalse', 0.6 <= F(1, 2))\n    assert F(1, 2) <= 0.5, ('assertTrue', F(1, 2) <= 0.5)\n    assert not F(1, 2) <= 0.4, ('assertFalse', F(1, 2) <= 0.4)\n    assert 2 <= F(4, 2), ('assertTrue', 2 <= F(4, 2))\n    assert not 2 <= F(3, 2), ('assertFalse', 2 <= F(3, 2))\n    assert F(4, 2) <= 2, ('assertTrue', F(4, 2) <= 2)\n    assert not F(5, 2) <= 2, ('assertFalse', F(5, 2) <= 2)\n    assert not float('inf') <= F(1, 2), ('assertFalse', float('inf') <= F(1, 2))\n    assert float('-inf') <= F(0, 10), ('assertTrue', float('-inf') <= F(0, 10))\n    assert not float('nan') <= F(-3, 7), ('assertFalse', float('nan') <= F(-3, 7))\n    assert F(1, 2) <= float('inf'), ('assertTrue', F(1, 2) <= float('inf'))\n    assert not F(17, 12) <= float('-inf'), ('assertFalse', F(17, 12) <= float('-inf'))\n    assert not F(144, -89) <= float('nan'), ('assertFalse', F(144, -89) <= float('nan'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
