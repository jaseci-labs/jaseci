, 3), '^4.2f', '0.67'), (F(2, 3), '^5.2f', '0.67 '), (F(2, 3), '^6.2f', ' 0.67 '), (F(2, 3), '^7.2f', ' 0.67  '), (F(2, 3), '^8.2f', '  0.67  '), (F(-2, 3), '=+8.2f', '-   0.67'), (F(2, 3), '=+8.2f', '+   0.67'), (F(-2, 3), 'X>3.2f', '-0.67'), (F(-2, 3), 'X>7.2f', 'XX-0.67'), (F(-2, 3), 'X<7.2f', '-0.67XX'), (F(-2, 3), 'X^7.2f', 'X-0.67X'), (F(-2, 3), 'X=7.2f', '-XX0.67'), (F(-2, 3), ' >7.2f', '  -0.67'), (F(-2, 3), '\\x00>7.2f', '\\x00\\x00-0.67'), (F(-2, 3), '\\n>7.2f', '\\n\\n-0.67'), (F(-2, 3), '\\t>7.2f', '\\t\\t-0.67'), (F(-2, 3), '>>7.2f', '>>-0.67'), (F(-2, 3), '<>7.2f', '<<-0.67'), (F(-2, 3), '\u2192>7.2f', '\u2192\u2192-0.67'), (F(-2, 3), '07.2f', '-000.67'), (F(-2, 3), '-07.2f', '-000.67'), (F(2, 3), '+07.2f', '+000.67'), (F(2, 3), ' 07.2f', ' 000.67'), (F(2, 3), '0.2f', '0.67'), (F(2, 3), '>0.2f', '0.67'), (F(2, 3), '<0.2f', '0.67'), (F(2, 3), '^0.2f', '0.67'), (F(2, 3), '=0.2f', '0.67'), (F(2, 3), '00.2f', '0.67'), (F(2, 3), ',.2f', '0.67'), (F(2, 3), ',.7f', '0.6666667'), (F('123456.789'), ',.2f', '123,456.79'), (F('1234567'), ',.2f', '1,234,567.00'), (F('12345678'), ',.2f', '12,345,678.00'), (F('12345678'), ',f', '12,345,678.000000'), (F('123456.789123123'), '._f', '123456.789_123'), (F('123456.789123123'), '.7_f', '123456.789_123_1'), (F('123456.789123123'), '.9_f', '123456.789_123_123'), (F('123456.789123123'), '.,f', '123456.789,123'), (F('123456.789123123'), '_.,f', '123_456.789,123'), (F(2, 3), '_.2f', '0.67'), (F(2, 3), '_.7f', '0.6666667'), (F('123456.789'), '_.2f', '123_456.79'), (F('1234567'), '_.2f', '1_234_567.00'), (F('12345678'), '_.2f', '12_345_678.00'), (F('1234.5678'), '07,.2f', '1,234.57'), (F('1234.5678'), '08,.2f', '1,234.57'), (F('1234.5678'), '09,.2f', '01,234.57'), (F('1234.5678'), '010,.2f', '001,234.57'), (F('1234.5678'), '011,.2f', '0,001,234.57'), (F('1234.5678'), '012,.2f', '0,001,234.57'), (F('1234.5678'), '013,.2f', '00,001,234.57'), (F('1234.5678'), '014,.2f', '000,001,234.57'), (F('1234.5678'), '015,.2f', '0,000,001,234.57'), (F('1234.5678'), '016,.2f', '0,000,001,234.57'), (F('-1234.5678'), '07,.2f', '-1,234.57'), (F('-1234.5678'), '08,.2f', '-1,234.57'), (F('-1234.5678'), '09,.2f', '-1,234.57'), (F('-1234.5678'), '010,.2f', '-01,234.57'), (F('-1234.5678'), '011,.2f', '-001,234.57'), (F('-1234.5678'), '012,.2f', '-0,001,234.57'), (F('-1234.5678'), '013,.2f', '-0,001,234.57'), (F('-1234.5678'), '014,.2f', '-00,001,234.57'), (F('-1234.5678'), '015,.2f', '-000,001,234.57'), (F('-1234.5678'), '016,.2f', '-0,000,001,234.57'), (F('-1234.5678'), '06,.0f', '-1,235'), (F('-1234.5678'), '07,.0f', '-01,235'), (F('-1234.5678'), '08,.0f', '-001,235'), (F('-1234.5678'), '09,.0f', '-0,001,235'), (F('1234.5678'), '0=12,.2f', '0,001,234.57'), (F('12.34'), '0.2f', '12.34'), (F('12.34'), 'X>0.2f', '12.34'), (F(22, 7), '.5F', '3.14286'), (F(22, 7), '.2%', '314.29%'), (F(1, 7), '.2%', '14.29%'), (F(1, 70), '.2%', '1.43%'), (F(1, 700), '.2%', '0.14%'), (F(1, 7000), '.2%', '0.01%'), (F(1, 70000), '.2%', '0.00%'), (F(1, 7), '.0%', '14%'), (F(1, 7), '#.0%', '14.%'), (F(100, 7), ',.2%', '1,428.57%'), (F(22, 7), '7.2%', '314.29%'), (F(22, 7), '8.2%', ' 314.29%'), (F(22, 7), '08.2%', '0314.29%'), (F(1, 3), '.2f', '0.33'), (F(1, 8), '.2f', '0.12'), (F(3, 8), '.2f', '0.38'), (F(2545, 1000), '.2f', '2.54'), (F(2549, 1000), '.2f', '2.55'), (F(2635, 1000), '.2f', '2.64'), (F(1, 100), '.1f', '0.0'), (F(49, 1000), '.1f', '0.0'), (F(51, 1000), '.1f', '0.1'), (F(149, 1000), '.1f', '0.1'), (F(151, 1000), '.1f', '0.2'), (F(22, 7), '.02f', '3.14'), (F(22, 7), '005.02f', '03.14')]\n    for fraction, spec, expected in testcases:\n        assert format(fraction, spec) == expected, ('assertEqual', format(fraction, spec), expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.test_format_g_presentation_type" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef _t():\n    testcases = [(F('0.000012345678'), '.6g', '1.23457e-05'), (F('0.00012345678'), '.6g', '0.000123457'), (F('0.0012345678'), '.6g', '0.00123457'), (F('0.012345678'), '.6g', '0.0123457'), (F('0.12345678'), '.6g', '0.123457'), (F('1.2345678'), '.6g', '1.23457'), (F('12.345678'), '.6g', '12.3457'), (F('123.45678'), '.6g', '123.457'), (F('1234.5678'), '.6g', '1234.57'), (F('12345.678'), '.6g', '12345.7'), (F('123456.78'), '.6g', '123457'), (F('1234567.8'), '.6g', '1.23457e+06'), (F('9.99999e+2'), '.4g', '1000'), (F('9.99999e-8'), '.4g', '1e-07'), (F('9.99999e+8'), '.4g', '1e+09'), (F('-0.115'), '.2g', '-0.12'), (F('-0.125'), '.2g', '-0.12'), (F('-0.135'), '.2g', '-0.14'), (F('-0.145'), '.2g', '-0.14'), (F('0.115'), '.2g', '0.12'), (F('0.125'), '.2g', '0.12'), (F('0.135'), '.2g', '0.14'), (F('0.145'), '.2g', '0.14'), (F(0), '.6g', '0'), (F('123.400'), '.6g', '123.4'), (F('123.000'), '.6g', '123'), (F('120.000'), '.6g', '120'), (F('12000000'), '.6g', '1.2e+07'), (F(0), '#.6g', '0.00000'), (F('123.400'), '#.6g', '123.400'), (F('123.000'), '#.6g', '123.000'), (F('120.000'), '#.6g', '120.000'), (F('12000000'), '#.6g', '1.20000e+07'), (F('123.45678'), '.6G', '123.457'), (F('1234567.8'), '.6G', '1.23457E+06'), (F('3.1415926535'), 'g', '3.14159'), (F('0.000031415'), '.0g', '3e-05'), (F('0.00031415'), '.0g', '0.0003'), (F('0.31415'), '.0g', '0.3'), (F('3.1415'), '.0g', '3'), (F('3.1415'), '#.0g', '3.'), (F('31.415'), '.0g', '3e+01'), (F('31.415'), '#.0g', '3.e+01'), (F('0.000031415'), '.1g', '3e-05'), (F('0.00031415'), '.1g', '0.0003'), (F('0.31415'), '.1g', '0.3'), (F('3.1415'), '.1g', '3'), (F('3.1415'), '#.1g', '3.'), (F('31.415'), '.1g', '3e+01'), (F(2 ** 64), '_.25g', '18_446_744_073_709_551_616'), (F(-1, 7 ** 100), 'zg', '-3.09169e-85')]\n    for fraction, spec, expected in testcases:\n        assert format(fraction, spec) == expected, ('assertEqual', format(fraction, spec), expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.test_invalid_formats" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef _t():\n    fraction = F(2, 3)\n    try:\n        format(fraction, None)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    invalid_specs = ['Q6f', 'X>010f', 'X<010f', 'X^010f', 'X=010f', '0>010f', '0<010f', '0^010f', '0=010f', '>010f', '<010f', '^010f', '=010e', '=010f', '=010g', '=010%', '>00.2f', '>00f', '.e', '.f', '.g', '.%', '._6e', '._6f', '._6g', '._6%', 'Z.2fz', '05']\n    for spec in invalid_specs:\n        try:\n            format(fraction, spec)\n        except ValueError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.test_complex_handling" {
    (ok, detail) = p2_libtest_run_snippet("import math\nimport operator\nimport fractions\nF = fractions.Fraction\n\ndef typed_approx_eq(a, b):\n    return type(a) == type(b) and (a == b or math.isclose(a, b))\n\ndef assertRaisesMessage(exc_type, message, callable, *args, **kwargs):\n    \"\"\"Asserts that callable(*args, **kwargs) raises exc_type(message).\"\"\"\n    try:\n        callable(*args, **kwargs)\n    except exc_type as e:\n        assert message == str(e), ('assertEqual', message, str(e))\n    else:\n        raise AssertionError('%s not raised' % exc_type.__name__)\n\ndef _t():\n    a = F(1, 2)\n    b = 1j\n    message = \"unsupported operand type(s) for %s: '%s' and '%s'\"\n    assertRaisesMessage(TypeError, message % ('%', 'Fraction', 'complex'), operator.mod, a, b)\n    assertRaisesMessage(TypeError, message % ('//', 'Fraction', 'complex'), operator.floordiv, a, b)\n    assertRaisesMessage(TypeError, message % ('divmod()', 'Fraction', 'complex'), divmod, a, b)\n    assertRaisesMessage(TypeError, message % ('%', 'complex', 'Fraction'), operator.mod, b, a)\n    assertRaisesMessage(TypeError, message % ('//', 'complex', 'Fraction'), operator.floordiv, b, a)\n    assertRaisesMessage(TypeError, message % ('divmod()', 'complex', 'Fraction'), divmod, b, a)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.test_three_argument_pow" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef assertRaisesMessage(exc_type, message, callable, *args, **kwargs):\n    \"\"\"Asserts that callable(*args, **kwargs) raises exc_type(message).\"\"\"\n    try:\n        callable(*args, **kwargs)\n    except exc_type as e:\n        assert message == str(e), ('assertEqual', message, str(e))\n    else:\n        raise AssertionError('%s not raised' % exc_type.__name__)\n\ndef _t():\n    message = \"unsupported operand type(s) for ** or pow(): '%s', '%s', '%s'\"\n    assertRaisesMessage(TypeError, message % ('Fraction', 'int', 'int'), pow, F(3), 4, 5)\n    assertRaisesMessage(TypeError, message % ('int', 'Fraction', 'int'), pow, 3, F(4), 5)\n    assertRaisesMessage(TypeError, message % ('int', 'int', 'Fraction'), pow, 3, 4, F(5))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
