}

test "FractionTest.testBoolGuarateesBoolReturn" {
    (ok, detail) = p2_libtest_run_snippet("import numbers\nimport fractions\nimport functools\nF = fractions.Fraction\n\ndef _components(r):\n    return (r.numerator, r.denominator)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    @functools.total_ordering\n    class CustomValue:\n        denominator = 1\n\n        def __init__(self, value):\n            self.value = value\n\n        def __bool__(self):\n            return bool(self.value)\n\n        @property\n        def numerator(self):\n            return self\n\n        def __eq__(self, other):\n            raise AssertionError('Avoid comparisons in Fraction.__bool__')\n        __lt__ = __eq__\n    numbers.Rational.register(CustomValue)\n    numerator = CustomValue(1)\n    r = F(numerator)\n    assert r.numerator is numerator, ('assertIs', r.numerator, numerator)\n    assert bool(r) is True, ('assertIs', bool(r), True)\n    numerator = CustomValue(0)\n    r = F(numerator)\n    assert bool(r) is False, ('assertIs', bool(r), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

