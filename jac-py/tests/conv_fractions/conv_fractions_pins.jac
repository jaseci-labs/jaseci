test "FractionTest.testFromString" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef _components(r):\n    return (r.numerator, r.denominator)\n\ndef assertRaisesMessage(exc_type, message, callable, *args, **kwargs):\n    \"\"\"Asserts that callable(*args, **kwargs) raises exc_type(message).\"\"\"\n    try:\n        callable(*args, **kwargs)\n    except exc_type as e:\n        assert message == str(e), ('assertEqual', message, str(e))\n    else:\n        raise AssertionError('%s not raised' % exc_type.__name__)\n\ndef _t():\n    assert (5, 1) == _components(F('5')), ('assertEqual', (5, 1), _components(F('5')))\n    assert (5, 1) == _components(F('005')), ('assertEqual', (5, 1), _components(F('005')))\n    assert (3, 2) == _components(F('3/2')), ('assertEqual', (3, 2), _components(F('3/2')))\n    assert (3, 2) == _components(F('3 / 2')), ('assertEqual', (3, 2), _components(F('3 / 2')))\n    assert (3, 2) == _components(F(' \\n  +3/2')), ('assertEqual', (3, 2), _components(F(' \\n  +3/2')))\n    assert (-3, 2) == _components(F('-3/2  ')), ('assertEqual', (-3, 2), _components(F('-3/2  ')))\n    assert (13, 2) == _components(F('    0013/002 \\n  ')), ('assertEqual', (13, 2), _components(F('    0013/002 \\n  ')))\n    assert (16, 5) == _components(F(' 3.2 ')), ('assertEqual', (16, 5), _components(F(' 3.2 ')))\n    assert (16, 5) == _components(F('003.2')), ('assertEqual', (16, 5), _components(F('003.2')))\n    assert (-16, 5) == _components(F(' -3.2 ')), ('assertEqual', (-16, 5), _components(F(' -3.2 ')))\n    assert (-3, 1) == _components(F(' -3. ')), ('assertEqual', (-3, 1), _components(F(' -3. ')))\n    assert (3, 5) == _components(F(' .6 ')), ('assertEqual', (3, 5), _components(F(' .6 ')))\n    assert (1, 3125) == _components(F('32.e-5')), ('assertEqual', (1, 3125), _components(F('32.e-5')))\n    assert (1000000, 1) == _components(F('1E+06')), ('assertEqual', (1000000, 1), _components(F('1E+06')))\n    assert (-12300, 1) == _components(F('-1.23e4')), ('assertEqual', (-12300, 1), _components(F('-1.23e4')))\n    assert (0, 1) == _components(F(' .0e+0\\t')), ('assertEqual', (0, 1), _components(F(' .0e+0\\t')))\n    assert (0, 1) == _components(F('-0.000e0')), ('assertEqual', (0, 1), _components(F('-0.000e0')))\n    assert (123, 1) == _components(F('1_2_3')), ('assertEqual', (123, 1), _components(F('1_2_3')))\n    assert (41, 107) == _components(F('1_2_3/3_2_1')), ('assertEqual', (41, 107), _components(F('1_2_3/3_2_1')))\n    assert (6283, 2000) == _components(F('3.14_15')), ('assertEqual', (6283, 2000), _components(F('3.14_15')))\n    assert (6283, 2 * 10 ** 13) == _components(F('3.14_15e-1_0')), ('assertEqual', (6283, 2 * 10 ** 13), _components(F('3.14_15e-1_0')))\n    assert (101, 100) == _components(F('1.01')), ('assertEqual', (101, 100), _components(F('1.01')))\n    assert (101, 100) == _components(F('1.0_1')), ('assertEqual', (101, 100), _components(F('1.0_1')))\n    assertRaisesMessage(ZeroDivisionError, 'Fraction(3, 0)', F, '3/0')\n\n    def check_invalid(s):\n        msg = 'Invalid literal for Fraction: ' + repr(s)\n        assertRaisesMessage(ValueError, msg, F, s)\n    check_invalid('3/')\n    check_invalid('/2')\n    check_invalid('3/+2')\n    check_invalid('3/-2')\n    check_invalid('+ 3/2')\n    check_invalid('- 3/2')\n    check_invalid('3a2')\n    check_invalid('3/7.2')\n    check_invalid('3.2/7')\n    check_invalid('3 .2')\n    check_invalid('3. 2')\n    check_invalid('3.2 e1')\n    check_invalid('3.2e 1')\n    check_invalid('3.+2')\n    check_invalid('3.-2')\n    check_invalid('0x10')\n    check_invalid('0x10/1')\n    check_invalid('1/0x10')\n    check_invalid('0x10.')\n    check_invalid('0x10.1')\n    check_invalid('1.0x10')\n    check_invalid('1.0e0x10')\n    check_invalid('\u00b3')\n    check_invalid('\u00b3/2')\n    check_invalid('3/\u00b2')\n    check_invalid('\u00b3.2')\n    check_invalid('3.\u00b2')\n    check_invalid('3.2e\u00b2')\n    check_invalid('\u00bc')\n    check_invalid('.')\n    check_invalid('_')\n    check_invalid('_1')\n    check_invalid('1__2')\n    check_invalid('/_')\n    check_invalid('1_/')\n    check_invalid('_1/')\n    check_invalid('1__2/')\n    check_invalid('1/_')\n    check_invalid('1/_1')\n    check_invalid('1/1__2')\n    check_invalid('1._111')\n    check_invalid('1.1__1')\n    check_invalid('1.1e+_1')\n    check_invalid('1.1e+1__1')\n    check_invalid('123.dd')\n    check_invalid('123.5_dd')\n    check_invalid('dd.5')\n    check_invalid('7_dd')\n    check_invalid('1/dd')\n    check_invalid('1/123_dd')\n    check_invalid('789edd')\n    check_invalid('789e2_dd')\n    val = '9' * 50 + '_'\n    check_invalid(val)\n    check_invalid('1/' + val)\n    check_invalid('1.' + val)\n    check_invalid('.' + val)\n    check_invalid('1.1+e' + val)\n    check_invalid('1.1e' + val)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FractionTest.test_limit_int" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import requires_IEEE_754, adjust_int_max_str_digits\nimport fractions\nF = fractions.Fraction\n\ndef _components(r):\n    return (r.numerator, r.denominator)\n\ndef _t():\n    maxdigits = 5000\n    with adjust_int_max_str_digits(maxdigits):\n        msg = 'Exceeds the limit'\n        val = '1' * maxdigits\n        num = (10 ** maxdigits - 1) // 9\n        assert (num, 1) == _components(F(val)), ('assertEqual', (num, 1), _components(F(val)))\n        try:\n            F(*(val + '1',))\n        except ValueError:\n            pass\n        assert (num, 2) == _components(F(val + '/2')), ('assertEqual', (num, 2), _components(F(val + '/2')))\n        try:\n            F(*(val + '1/2',))\n        except ValueError:\n            pass\n        assert (1, num) == _components(F('1/' + val)), ('assertEqual', (1, num), _components(F('1/' + val)))\n        try:\n            F(*('1/1' + val,))\n        except ValueError:\n            pass\n        assert ((10 ** (maxdigits + 1) - 1) // 9, 10 ** maxdigits) == _components(F('1.' + val)), ('assertEqual', ((10 ** (maxdigits + 1) - 1) // 9, 10 ** maxdigits), _components(F('1.' + val)))\n        try:\n            F(*('1.1' + val,))\n        except ValueError:\n            pass\n        assert (num, 10 ** maxdigits) == _components(F('.' + val)), ('assertEqual', (num, 10 ** maxdigits), _components(F('.' + val)))\n        try:\n            F(*('.1' + val,))\n        except ValueError:\n            pass\n        try:\n            F(*('1.1e1' + val,))\n        except ValueError:\n            pass\n        assert (11, 10) == _components(F('1.1e' + '0' * maxdigits)), ('assertEqual', (11, 10), _components(F('1.1e' + '0' * maxdigits)))\n        try:\n            F(*('1.1e' + '0' * (maxdigits + 1),))\n        except ValueError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

