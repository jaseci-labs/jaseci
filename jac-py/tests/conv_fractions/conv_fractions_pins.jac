test "FractionTest.testLimitDenominator" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nF = fractions.Fraction\n\ndef assertRaisesMessage(exc_type, message, callable, *args, **kwargs):\n    \"\"\"Asserts that callable(*args, **kwargs) raises exc_type(message).\"\"\"\n    try:\n        callable(*args, **kwargs)\n    except exc_type as e:\n        assert message == str(e), ('assertEqual', message, str(e))\n    else:\n        raise AssertionError('%s not raised' % exc_type.__name__)\n\ndef _t():\n    rpi = F('3.1415926535897932')\n    assert rpi.limit_denominator(10000) == F(355, 113), ('assertEqual', rpi.limit_denominator(10000), F(355, 113))\n    assert -rpi.limit_denominator(10000) == F(-355, 113), ('assertEqual', -rpi.limit_denominator(10000), F(-355, 113))\n    assert rpi.limit_denominator(113) == F(355, 113), ('assertEqual', rpi.limit_denominator(113), F(355, 113))\n    assert rpi.limit_denominator(112) == F(333, 106), ('assertEqual', rpi.limit_denominator(112), F(333, 106))\n    assert F(201, 200).limit_denominator(100) == F(1), ('assertEqual', F(201, 200).limit_denominator(100), F(1))\n    assert F(201, 200).limit_denominator(101) == F(102, 101), ('assertEqual', F(201, 200).limit_denominator(101), F(102, 101))\n    assert F(0).limit_denominator(10000) == F(0), ('assertEqual', F(0).limit_denominator(10000), F(0))\n    for i in (0, -1):\n        assertRaisesMessage(ValueError, 'max_denominator should be at least 1', F(1).limit_denominator, i)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

