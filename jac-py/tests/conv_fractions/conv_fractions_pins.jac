test "FractionTest.testBigComplexComparisons" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nimport fractions\nF = fractions.Fraction\n\ndef _t():\n    assert not F(10 ** 23) == complex(10 ** 23), ('assertFalse', F(10 ** 23) == complex(10 ** 23))\n    try:\n        operator.gt(*(F(10 ** 23), complex(10 ** 23)))\n    except TypeError:\n        pass\n    try:\n        operator.le(*(F(10 ** 23), complex(10 ** 23)))\n    except TypeError:\n        pass\n    x = F(3, 8)\n    z = complex(0.375, 0.0)\n    w = complex(0.375, 0.2)\n    assert x == z, ('assertTrue', x == z)\n    assert not x != z, ('assertFalse', x != z)\n    assert not x == w, ('assertFalse', x == w)\n    assert x != w, ('assertTrue', x != w)\n    for op in (operator.lt, operator.le, operator.gt, operator.ge):\n        try:\n            op(*(x, z))\n        except TypeError:\n            pass\n        try:\n            op(*(z, x))\n        except TypeError:\n            pass\n        try:\n            op(*(x, w))\n        except TypeError:\n            pass\n        try:\n            op(*(w, x))\n        except TypeError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

