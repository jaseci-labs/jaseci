test "RatTestCase.test_gcd" {
    (ok, detail) = p2_libtest_run_snippet("def gcd(a, b):\n    \"\"\"Greatest common divisor using Euclid's algorithm.\"\"\"\n    while a:\n        a, b = (b % a, a)\n    return b\n\ndef _t():\n    assert gcd(10, 12) == 2, ('assertEqual', gcd(10, 12), 2)\n    assert gcd(10, 15) == 5, ('assertEqual', gcd(10, 15), 5)\n    assert gcd(10, 11) == 1, ('assertEqual', gcd(10, 11), 1)\n    assert gcd(100, 15) == 5, ('assertEqual', gcd(100, 15), 5)\n    assert gcd(-10, 2) == -2, ('assertEqual', gcd(-10, 2), -2)\n    assert gcd(10, -2) == 2, ('assertEqual', gcd(10, -2), 2)\n    assert gcd(-10, -2) == -2, ('assertEqual', gcd(-10, -2), -2)\n    for i in range(1, 20):\n        for j in range(1, 20):\n            assert gcd(i, j) > 0, ('assertTrue', gcd(i, j) > 0)\n            assert gcd(-i, j) < 0, ('assertTrue', gcd(-i, j) < 0)\n            assert gcd(i, -j) > 0, ('assertTrue', gcd(i, -j) > 0)\n            assert gcd(-i, -j) < 0, ('assertTrue', gcd(-i, -j) < 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

