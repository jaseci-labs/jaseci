:\n        \"\"\"Take one Rat modulo another (reversed args).\"\"\"\n        return divmod(other, self)[1]\n\n    def __eq__(self, other):\n        \"\"\"Compare two Rats for equality.\"\"\"\n        if isint(other):\n            return self.__den == 1 and self.__num == other\n        if isRat(other):\n            return self.__num == other.__num and self.__den == other.__den\n        if isnum(other):\n            return float(self) == other\n        return NotImplemented\n\ndef _t():\n    a = Rat(10, 15)\n    assert a.num == 2, ('assertEqual', a.num, 2)\n    assert a.den == 3, ('assertEqual', a.den, 3)\n    a = Rat(10, -15)\n    assert a.num == -2, ('assertEqual', a.num, -2)\n    assert a.den == 3, ('assertEqual', a.den, 3)\n    a = Rat(-10, 15)\n    assert a.num == -2, ('assertEqual', a.num, -2)\n    assert a.den == 3, ('assertEqual', a.den, 3)\n    a = Rat(-10, -15)\n    assert a.num == 2, ('assertEqual', a.num, 2)\n    assert a.den == 3, ('assertEqual', a.den, 3)\n    a = Rat(7)\n    assert a.num == 7, ('assertEqual', a.num, 7)\n    assert a.den == 1, ('assertEqual', a.den, 1)\n    try:\n        a = Rat(1, 0)\n    except ZeroDivisionError:\n        pass\n    else:\n        raise AssertionError(\"Rat(1, 0) didn't raise ZeroDivisionError\")\n    for bad in ('0', 0.0, 0j, (), [], {}, None, Rat, unittest):\n        try:\n            a = Rat(bad)\n        except TypeError:\n            pass\n        else:\n            raise AssertionError(\"Rat(%r) didn't raise TypeError\" % bad)\n        try:\n            a = Rat(1, bad)\n        except TypeError:\n            pass\n        else:\n            raise AssertionError(\"Rat(1, %r) didn't raise TypeError\" % bad)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
