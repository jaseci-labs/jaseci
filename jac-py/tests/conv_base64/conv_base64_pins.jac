test "BaseXYTestCase.test_RFC4648_test_cases" {
    (ok, detail) = p2_libtest_run_snippet("import base64\n\ndef _t():\n    b64encode = base64.b64encode\n    b32hexencode = base64.b32hexencode\n    b32encode = base64.b32encode\n    b16encode = base64.b16encode\n    assert b64encode(b'') == b'', ('assertEqual', b64encode(b''), b'')\n    assert b64encode(b'f') == b'Zg==', ('assertEqual', b64encode(b'f'), b'Zg==')\n    assert b64encode(b'fo') == b'Zm8=', ('assertEqual', b64encode(b'fo'), b'Zm8=')\n    assert b64encode(b'foo') == b'Zm9v', ('assertEqual', b64encode(b'foo'), b'Zm9v')\n    assert b64encode(b'foob') == b'Zm9vYg==', ('assertEqual', b64encode(b'foob'), b'Zm9vYg==')\n    assert b64encode(b'fooba') == b'Zm9vYmE=', ('assertEqual', b64encode(b'fooba'), b'Zm9vYmE=')\n    assert b64encode(b'foobar') == b'Zm9vYmFy', ('assertEqual', b64encode(b'foobar'), b'Zm9vYmFy')\n    assert b32encode(b'') == b'', ('assertEqual', b32encode(b''), b'')\n    assert b32encode(b'f') == b'MY======', ('assertEqual', b32encode(b'f'), b'MY======')\n    assert b32encode(b'fo') == b'MZXQ====', ('assertEqual', b32encode(b'fo'), b'MZXQ====')\n    assert b32encode(b'foo') == b'MZXW6===', ('assertEqual', b32encode(b'foo'), b'MZXW6===')\n    assert b32encode(b'foob') == b'MZXW6YQ=', ('assertEqual', b32encode(b'foob'), b'MZXW6YQ=')\n    assert b32encode(b'fooba') == b'MZXW6YTB', ('assertEqual', b32encode(b'fooba'), b'MZXW6YTB')\n    assert b32encode(b'foobar') == b'MZXW6YTBOI======', ('assertEqual', b32encode(b'foobar'), b'MZXW6YTBOI======')\n    assert b32hexencode(b'') == b'', ('assertEqual', b32hexencode(b''), b'')\n    assert b32hexencode(b'f') == b'CO======', ('assertEqual', b32hexencode(b'f'), b'CO======')\n    assert b32hexencode(b'fo') == b'CPNG====', ('assertEqual', b32hexencode(b'fo'), b'CPNG====')\n    assert b32hexencode(b'foo') == b'CPNMU===', ('assertEqual', b32hexencode(b'foo'), b'CPNMU===')\n    assert b32hexencode(b'foob') == b'CPNMUOG=', ('assertEqual', b32hexencode(b'foob'), b'CPNMUOG=')\n    assert b32hexencode(b'fooba') == b'CPNMUOJ1', ('assertEqual', b32hexencode(b'fooba'), b'CPNMUOJ1')\n    assert b32hexencode(b'foobar') == b'CPNMUOJ1E8======', ('assertEqual', b32hexencode(b'foobar'), b'CPNMUOJ1E8======')\n    assert b16encode(b'') == b'', ('assertEqual', b16encode(b''), b'')\n    assert b16encode(b'f') == b'66', ('assertEqual', b16encode(b'f'), b'66')\n    assert b16encode(b'fo') == b'666F', ('assertEqual', b16encode(b'fo'), b'666F')\n    assert b16encode(b'foo') == b'666F6F', ('assertEqual', b16encode(b'foo'), b'666F6F')\n    assert b16encode(b'foob') == b'666F6F62', ('assertEqual', b16encode(b'foob'), b'666F6F62')\n    assert b16encode(b'fooba') == b'666F6F6261', ('assertEqual', b16encode(b'fooba'), b'666F6F6261')\n    assert b16encode(b'foobar') == b'666F6F626172', ('assertEqual', b16encode(b'foobar'), b'666F6F626172')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
