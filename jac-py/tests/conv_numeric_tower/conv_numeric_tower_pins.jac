test "ComparisonTest.test_complex" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nfrom decimal import Decimal as D\nfrom fractions import Fraction as F\n\ndef _t():\n    z = 1.0 + 0j\n    w = -3.14 + 2.7j\n    for v in (1, 1.0, F(1), D(1), complex(1)):\n        assert z == v, ('assertEqual', z, v)\n        assert v == z, ('assertEqual', v, z)\n    for v in (2, 2.0, F(2), D(2), complex(2)):\n        assert z != v, ('assertNotEqual', z, v)\n        assert v != z, ('assertNotEqual', v, z)\n        assert w != v, ('assertNotEqual', w, v)\n        assert v != w, ('assertNotEqual', v, w)\n    for v in (1, 1.0, F(1), D(1), complex(1), 2, 2.0, F(2), D(2), complex(2), w):\n        for op in (operator.le, operator.lt, operator.ge, operator.gt):\n            try:\n                op(*(z, v))\n            except TypeError:\n                pass\n            try:\n                op(*(v, z))\n            except TypeError:\n                pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
