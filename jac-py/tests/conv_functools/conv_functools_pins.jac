test "TestCachedProperty.test_reuse_same_name" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\ndef _t():\n    \"\"\"Reusing a cached_property on different classes under the same name is OK.\"\"\"\n    counter = 0\n\n    @py_functools.cached_property\n    def _cp(_self):\n        nonlocal counter\n        counter += 1\n        return counter\n\n    class A:\n        cp = _cp\n\n    class B:\n        cp = _cp\n    a = A()\n    b = B()\n    assert a.cp == 1, ('assertEqual', a.cp, 1)\n    assert b.cp == 2, ('assertEqual', b.cp, 2)\n    assert a.cp == 1, ('assertEqual', a.cp, 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

