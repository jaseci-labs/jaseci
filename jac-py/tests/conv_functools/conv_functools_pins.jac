test "TestLRUPy.test_need_for_rlock" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\n@py_functools.lru_cache()\ndef py_cached_func(x, y):\n    return 3 * x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cached_func = (py_cached_func,)\n    _SelfNS.cached_func = (py_cached_func,)\n    self.module = py_functools\n    _SelfNS.module = py_functools\n\n    @self.module.lru_cache(maxsize=10)\n    def test_func(x):\n        \"\"\"Used to demonstrate a reentrant lru_cache call within a single thread\"\"\"\n        return x\n\n    class DoubleEq:\n        \"\"\"Demonstrate a reentrant lru_cache call within a single thread\"\"\"\n\n        def __init__(self, x):\n            self.x = x\n\n        def __hash__(self):\n            return self.x\n\n        def __eq__(self, other):\n            if self.x == 2:\n                test_func(DoubleEq(1))\n            return self.x == other.x\n    test_func(DoubleEq(1))\n    test_func(DoubleEq(2))\n    assert test_func(DoubleEq(2)) == DoubleEq(2), ('assertEqual', test_func(DoubleEq(2)), DoubleEq(2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLRUPy.test_lru_method" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\n@py_functools.lru_cache()\ndef py_cached_func(x, y):\n    return 3 * x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cached_func = (py_cached_func,)\n    _SelfNS.cached_func = (py_cached_func,)\n    self.module = py_functools\n    _SelfNS.module = py_functools\n\n    class X(int):\n        f_cnt = 0\n\n        @self.module.lru_cache(2)\n        def f(self, x):\n            self.f_cnt += 1\n            return x * 10 + self\n    a = X(5)\n    b = X(5)\n    c = X(7)\n    assert X.f.cache_info() == (0, 0, 2, 0), ('assertEqual', X.f.cache_info(), (0, 0, 2, 0))\n    for x in (1, 2, 2, 3, 1, 1, 1, 2, 3, 3):\n        assert a.f(x) == x * 10 + 5, ('assertEqual', a.f(x), x * 10 + 5)\n    assert (a.f_cnt, b.f_cnt, c.f_cnt) == (6, 0, 0), ('assertEqual', (a.f_cnt, b.f_cnt, c.f_cnt), (6, 0, 0))\n    assert X.f.cache_info() == (4, 6, 2, 2), ('assertEqual', X.f.cache_info(), (4, 6, 2, 2))\n    for x in (1, 2, 1, 1, 1, 1, 3, 2, 2, 2):\n        assert b.f(x) == x * 10 + 5, ('assertEqual', b.f(x), x * 10 + 5)\n    assert (a.f_cnt, b.f_cnt, c.f_cnt) == (6, 4, 0), ('assertEqual', (a.f_cnt, b.f_cnt, c.f_cnt), (6, 4, 0))\n    assert X.f.cache_info() == (10, 10, 2, 2), ('assertEqual', X.f.cache_info(), (10, 10, 2, 2))\n    for x in (2, 1, 1, 1, 1, 2, 1, 3, 2, 1):\n        assert c.f(x) == x * 10 + 7, ('assertEqual', c.f(x), x * 10 + 7)\n    assert (a.f_cnt, b.f_cnt, c.f_cnt) == (6, 4, 5), ('assertEqual', (a.f_cnt, b.f_cnt, c.f_cnt), (6, 4, 5))\n    assert X.f.cache_info() == (15, 15, 2, 2), ('assertEqual', X.f.cache_info(), (15, 15, 2, 2))\n    assert a.f.cache_info() == X.f.cache_info(), ('assertEqual', a.f.cache_info(), X.f.cache_info())\n    assert b.f.cache_info() == X.f.cache_info(), ('assertEqual', b.f.cache_info(), X.f.cache_info())\n    assert c.f.cache_info() == X.f.cache_info(), ('assertEqual', c.f.cache_info(), X.f.cache_info())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

