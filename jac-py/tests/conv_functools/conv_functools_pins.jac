test "TestSingleDispatch.test_compose_mro" {
    (ok, detail) = p2_libtest_run_snippet("import collections\nimport collections.abc\nfrom itertools import permutations\nimport functools\n\ndef _t():\n    c = collections.abc\n    mro = functools._compose_mro\n    bases = [c.Sequence, c.MutableMapping, c.Mapping, c.Set]\n    for haystack in permutations(bases):\n        m = mro(dict, haystack)\n        assert m == [dict, c.MutableMapping, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object], ('assertEqual', m, [dict, c.MutableMapping, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object])\n    bases = [c.Container, c.Mapping, c.MutableMapping, collections.OrderedDict]\n    for haystack in permutations(bases):\n        m = mro(collections.ChainMap, haystack)\n        assert m == [collections.ChainMap, c.MutableMapping, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object], ('assertEqual', m, [collections.ChainMap, c.MutableMapping, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object])\n    bases = [c.Container, c.Sized, str]\n    for haystack in permutations(bases):\n        m = mro(collections.defaultdict, [c.Sized, c.Container, str])\n        assert m == [collections.defaultdict, dict, c.Sized, c.Container, object], ('assertEqual', m, [collections.defaultdict, dict, c.Sized, c.Container, object])\n\n    class D(collections.defaultdict):\n        pass\n    c.MutableSequence.register(D)\n    bases = [c.MutableSequence, c.MutableMapping]\n    for haystack in permutations(bases):\n        m = mro(D, haystack)\n        assert m == [D, c.MutableSequence, c.Sequence, c.Reversible, collections.defaultdict, dict, c.MutableMapping, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object], ('assertEqual', m, [D, c.MutableSequence, c.Sequence, c.Reversible, collections.defaultdict, dict, c.MutableMapping, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object])\n\n    class C(collections.defaultdict):\n\n        def __call__(self):\n            pass\n    bases = [c.Sized, c.Callable, c.Container, c.Mapping]\n    for haystack in permutations(bases):\n        m = mro(C, haystack)\n        assert m == [C, c.Callable, collections.defaultdict, dict, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object], ('assertEqual', m, [C, c.Callable, collections.defaultdict, dict, c.Mapping, c.Collection, c.Sized, c.Iterable, c.Container, object])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_register_abc" {
    (ok, detail) = p2_libtest_run_snippet("import collections\nimport collections.abc\nimport functools\n\ndef _t():\n    c = collections.abc\n    d = {'a': 'b'}\n    l = [1, 2, 3]\n    s = {object(), None}\n    f = frozenset(s)\n    t = (1, 2, 3)\n\n    @functools.singledispatch\n    def g(obj):\n        return 'base'\n    assert g(d) == 'base', ('assertEqual', g(d), 'base')\n    assert g(l) == 'base', ('assertEqual', g(l), 'base')\n    assert g(s) == 'base', ('assertEqual', g(s), 'base')\n    assert g(f) == 'base', ('assertEqual', g(f), 'base')\n    assert g(t) == 'base', ('assertEqual', g(t), 'base')\n    g.register(c.Sized, lambda obj: 'sized')\n    assert g(d) == 'sized', ('assertEqual', g(d), 'sized')\n    assert g(l) == 'sized', ('assertEqual', g(l), 'sized')\n    assert g(s) == 'sized', ('assertEqual', g(s), 'sized')\n    assert g(f) == 'sized', ('assertEqual', g(f), 'sized')\n    assert g(t) == 'sized', ('assertEqual', g(t), 'sized')\n    g.register(c.MutableMapping, lambda obj: 'mutablemapping')\n    assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n    assert g(l) == 'sized', ('assertEqual', g(l), 'sized')\n    assert g(s) == 'sized', ('assertEqual', g(s), 'sized')\n    assert g(f) == 'sized', ('assertEqual', g(f), 'sized')\n    assert g(t) == 'sized', ('assertEqual', g(t), 'sized')\n    g.register(collections.ChainMap, lambda obj: 'chainmap')\n    assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n    assert g(l) == 'sized', ('assertEqual', g(l), 'sized')\n    assert g(s) == 'sized', ('assertEqual', g(s), 'sized')\n    assert g(f) == 'sized', ('assertEqual', g(f), 'sized')\n    assert g(t) == 'sized', ('assertEqual', g(t), 'sized')\n    g.register(c.MutableSequence, lambda obj: 'mutablesequence')\n    assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n    assert g(l) == 'mutablesequence', ('assertEqual', g(l), 'mutablesequence')\n    assert g(s) == 'sized', ('assertEqual', g(s), 'sized')\n    assert g(f) == 'sized', ('assertEqual', g(f), 'sized')\n    assert g(t) == 'sized', ('assertEqual', g(t), 'sized')\n    g.register(c.MutableSet, lambda obj: 'mutableset')\n    assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n    assert g(l) == 'mutablesequence', ('assertEqual', g(l), 'mutablesequence')\n    assert g(s) == 'mutableset', ('assertEqual', g(s), 'mutableset')\n    assert g(f) == 'sized', ('assertEqual', g(f), 'sized')\n    assert g(t) == 'sized', ('assertEqual', g(t), 'sized')\n    g.register(c.Mapping, lambda obj: 'mapping')\n    assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n    assert g(l) == 'mutablesequence', ('assertEqual', g(l), 'mutablesequence')\n    assert g(s) == 'mutableset', ('assertEqual', g(s), 'mutableset')\n    assert g(f) == 'sized', ('assertEqual', g(f), 'sized')\n    assert g(t) == 'sized', ('assertEqual', g(t), 'sized')\n    g.register(c.Sequence, lambda obj: 'sequence')\n    assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n    assert g(l) == 'mutablesequence', ('assertEqual', g(l), 'mutablesequence')\n    assert g(s) == 'mutableset', ('assertEqual', g(s), 'mutableset')\n    assert g(f) == 'sized', ('assertEqual', g(f), 'sized')\n    assert g(t) == 'sequence', ('assertEqual', g(t), 'sequence')\n    g.register(c.Set, lambda obj: 'set')\n    assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n    assert g(l) == 'mutablesequence', ('assertEqual', g(l), 'mutablesequence')\n    assert g(s) == 'mutableset', ('assertEqual', g(s), 'mutableset')\n    assert g(f) == 'set', ('assertEqual', g(f), 'set')\n    assert g(t) == 'sequence', ('assertEqual', g(t), 'sequence')\n    g.register(dict, lambda obj: 'dict')\n    assert g(d) == 'dict', ('assertEqual', g(d), 'dict')\n    assert g(l) == 'mutablesequence', ('assertEqual', g(l), 'mutablesequence')\n    assert g(s) == 'mutableset', ('assertEqual', g(s), 'mutableset')\n    assert g(f) == 'set', ('assertEqual', g(f), 'set')\n    assert g(t) == 'sequence', ('assertEqual', g(t), 'sequence')\n    g.register(list, lambda obj: 'list')\n    assert g(d) == 'dict', ('assertEqual', g(d), 'dict')\n    assert g(l) == 'list', ('assertEqual', g(l), 'list')\n    assert g(s) == 'mutableset', ('assertEqual', g(s), 'mutableset')\n    assert g(f) == 'set', ('assertEqual', g(f), 'set')\n    assert g(t) == 'sequence', ('assertEqual', g(t), 'sequence')\n    g.register(set, lambda obj: 'concrete-set')\n    assert g(d) == 'dict', ('assertEqual', g(d), 'dict')\n    assert g(l) == 'list', ('assertEqual', g(l), 'list')\n    assert g(s) == 'concrete-set', ('assertEqual', g(s), 'concrete-set')\n    assert g(f) == 'set', ('assertEqual', g(f), 'set')\n    assert g(t) == 'sequence', ('assertEqual', g(t), 'sequence')\n    g.register(frozenset, lambda obj: 'frozen-set')\n    assert g(d) == 'dict', ('assertEqual', g(d), 'dict')\n    assert g(l) == 'list', ('assertEqual', g(l), 'list')\n    assert g(s) == 'concrete-set', ('assertEqual', g(s), 'concrete-set')\n    assert g(f) == 'frozen-set', ('assertEqual', g(f), 'frozen-set')\n    assert g(t) == 'sequence', ('assertEqual', g(t), 'sequence')\n    g.register(tuple, lambda obj: 'tuple')\n    assert g(d) == 'dict', ('assertEqual', g(d), 'dict')\n    assert g(l) == 'list', ('assertEqual', g(l), 'list')\n    assert g(s) == 'concrete-set', ('assertEqual', g(s), 'concrete-set')\n    assert g(f) == 'frozen-set', ('assertEqual', g(f), 'frozen-set')\n    assert g(t) == 'tuple', ('assertEqual', g(t), 'tuple')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_c3_abc" {
    (ok, detail) = p2_libtest_run_snippet("import collections\nimport collections.abc\nfrom itertools import permutations\nimport functools\n\ndef _t():\n    c = collections.abc\n    mro = functools._c3_mro\n\n    class A(object):\n        pass\n\n    class B(A):\n\n        def __len__(self):\n            return 0\n\n    @c.Container.register\n    class C(object):\n        pass\n\n    class D(object):\n        pass\n\n    class X(D, C, B):\n\n        def __call__(self):\n            pass\n    expected = [X, c.Callable, D, C, c.Container, B, c.Sized, A, object]\n    for abcs in permutations([c.Sized, c.Callable, c.Container]):\n        assert mro(X, abcs=abcs) == expected, ('assertEqual', mro(X, abcs=abcs), expected)\n    many_abcs = [c.Mapping, c.Sized, c.Callable, c.Container, c.Iterable]\n    assert mro(X, abcs=many_abcs) == expected, ('assertEqual', mro(X, abcs=many_abcs), expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_false_meta" {
    (ok, detail) = p2_libtest_run_snippet("import functools\n\ndef _t():\n\n    class MetaA(type):\n\n        def __len__(self):\n            return 0\n\n    class A(metaclass=MetaA):\n        pass\n\n    class AA(A):\n        pass\n\n    @functools.singledispatch\n    def fun(a):\n        return 'base A'\n\n    @fun.register(A)\n    def _(a):\n        return 'fun A'\n    aa = AA()\n    assert fun(aa) == 'fun A', ('assertEqual', fun(aa), 'fun A')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_cache_invalidation" {
    (ok, detail) = p2_libtest_run_snippet("import collections\nimport collections.abc\nfrom test import support\nimport weakref\nimport functools\n\ndef capture(*args, **kw):\n    \"\"\"capture all positional and keyword arguments\"\"\"\n    return (args, kw)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    from collections import UserDict\n    import weakref\n\n    class TracingDict(UserDict):\n\n        def __init__(self, *args, **kwargs):\n            super(TracingDict, self).__init__(*args, **kwargs)\n            self.set_ops = []\n            self.get_ops = []\n\n        def __getitem__(self, key):\n            result = self.data[key]\n            self.get_ops.append(key)\n            return result\n\n        def __setitem__(self, key, value):\n            self.set_ops.append(key)\n            self.data[key] = value\n\n        def clear(self):\n            self.data.clear()\n    td = TracingDict()\n    with support.swap_attr(weakref, 'WeakKeyDictionary', lambda: td):\n        c = collections.abc\n\n        @functools.singledispatch\n        def g(arg):\n            return 'base'\n        d = {}\n        l = []\n        assert len(td) == 0, ('assertEqual', len(td), 0)\n        assert g(d) == 'base', ('assertEqual', g(d), 'base')\n        assert len(td) == 1, ('assertEqual', len(td), 1)\n        assert td.get_ops == [], ('assertEqual', td.get_ops, [])\n        assert td.set_ops == [dict], ('assertEqual', td.set_ops, [dict])\n        assert td.data[dict] == g.registry[object], ('assertEqual', td.data[dict], g.registry[object])\n        assert g(l) == 'base', ('assertEqual', g(l), 'base')\n        assert len(td) == 2, ('assertEqual', len(td), 2)\n        assert td.get_ops == [], ('assertEqual', td.get_ops, [])\n        assert td.set_ops == [dict, list], ('assertEqual', td.set_ops, [dict, list])\n        assert td.data[dict] == g.registry[object], ('assertEqual', td.data[dict], g.registry[object])\n        assert td.data[list] == g.registry[object], ('assertEqual', td.data[list], g.registry[object])\n        assert td.data[dict] == td.data[list], ('assertEqual', td.data[dict], td.data[list])\n        assert g(l) == 'base', ('assertEqual', g(l), 'base')\n        assert g(d) == 'base', ('assertEqual', g(d), 'base')\n        assert td.get_ops == [list, dict], ('assertEqual', td.get_ops, [list, dict])\n        assert td.set_ops == [dict, list], ('assertEqual', td.set_ops, [dict, list])\n        g.register(list, lambda arg: 'list')\n        assert td.get_ops == [list, dict], ('assertEqual', td.get_ops, [list, dict])\n        assert len(td) == 0, ('assertEqual', len(td), 0)\n        assert g(d) == 'base', ('assertEqual', g(d), 'base')\n        assert len(td) == 1, ('assertEqual', len(td), 1)\n        assert td.get_ops == [list, dict], ('assertEqual', td.get_ops, [list, dict])\n        assert td.set_ops == [dict, list, dict], ('assertEqual', td.set_ops, [dict, list, dict])\n        assert td.data[dict] == functools._find_impl(dict, g.registry), ('assertEqual', td.data[dict], functools._find_impl(dict, g.registry))\n        assert g(l) == 'list', ('assertEqual', g(l), 'list')\n        assert len(td) == 2, ('assertEqual', len(td), 2)\n        assert td.get_ops == [list, dict], ('assertEqual', td.get_ops, [list, dict])\n        assert td.set_ops == [dict, list, dict, list], ('assertEqual', td.set_ops, [dict, list, dict, list])\n        assert td.data[list] == functools._find_impl(list, g.registry), ('assertEqual', td.data[list], functools._find_impl(list, g.registry))\n\n        class X:\n            pass\n        c.MutableMapping.register(X)\n        assert g(d) == 'base', ('assertEqual', g(d), 'base')\n        assert g(l) == 'list', ('assertEqual', g(l), 'list')\n        assert td.get_ops == [list, dict, dict, list], ('assertEqual', td.get_ops, [list, dict, dict, list])\n        assert td.set_ops == [dict, list, dict, list], ('assertEqual', td.set_ops, [dict, list, dict, list])\n        g.register(c.Sized, lambda arg: 'sized')\n        assert len(td) == 0, ('assertEqual', len(td), 0)\n        assert g(d) == 'sized', ('assertEqual', g(d), 'sized')\n        assert len(td) == 1, ('assertEqual', len(td), 1)\n        assert td.get_ops == [list, dict, dict, list], ('assertEqual', td.get_ops, [list, dict, dict, list])\n        assert td.set_ops == [dict, list, dict, list, dict], ('assertEqual', td.set_ops, [dict, list, dict, list, dict])\n        assert g(l) == 'list', ('assertEqual', g(l), 'list')\n        assert len(td) == 2, ('assertEqual', len(td), 2)\n        assert td.get_ops == [list, dict, dict, list], ('assertEqual', td.get_ops, [list, dict, dict, list])\n        assert td.set_ops == [dict, list, dict, list, dict, list], ('assertEqual', td.set_ops, [dict, list, dict, list, dict, list])\n        assert g(l) == 'list', ('assertEqual', g(l), 'list')\n        assert g(d) == 'sized', ('assertEqual', g(d), 'sized')\n        assert td.get_ops == [list, dict, dict, list, list, dict], ('assertEqual', td.get_ops, [list, dict, dict, list, list, dict])\n        assert td.set_ops == [dict, list, dict, list, dict, list], ('assertEqual', td.set_ops, [dict, list, dict, list, dict, list])\n        g.dispatch(list)\n        g.dispatch(dict)\n        assert td.get_ops == [list, dict, dict, list, list, dict, list, dict], ('assertEqual', td.get_ops, [list, dict, dict, list, list, dict, list, dict])\n        assert td.set_ops == [dict, list, dict, list, dict, list], ('assertEqual', td.set_ops, [dict, list, dict, list, dict, list])\n        c.MutableSet.register(X)\n        assert len(td) == 2, ('assertEqual', len(td), 2)\n        assert g(l) == 'list', ('assertEqual', g(l), 'list')\n        assert len(td) == 1, ('assertEqual', len(td), 1)\n        g.register(c.MutableMapping, lambda arg: 'mutablemapping')\n        assert len(td) == 0, ('assertEqual', len(td), 0)\n        assert g(d) == 'mutablemapping', ('assertEqual', g(d), 'mutablemapping')\n        assert len(td) == 1, ('assertEqual', len(td), 1)\n        assert g(l) == 'list', ('assertEqual', g(l), 'list')\n        assert len(td) == 2, ('assertEqual', len(td), 2)\n        g.register(dict, lambda arg: 'dict')\n        assert g(d) == 'dict', ('assertEqual', g(d), 'dict')\n        assert g(l) == 'list', ('assertEqual', g(l), 'list')\n        g._clear_cache()\n        assert len(td) == 0, ('assertEqual', len(td), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_annotations" {
    (ok, detail) = p2_libtest_run_snippet("import collections\nimport collections.abc\nimport functools\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    @functools.singledispatch\n    def i(arg):\n        return 'base'\n\n    @i.register\n    def _(arg: collections.abc.Mapping):\n        return 'mapping'\n\n    @i.register\n    def _(arg: 'collections.abc.Sequence'):\n        return 'sequence'\n    assert i(None) == 'base', ('assertEqual', i(None), 'base')\n    assert i({'a': 1}) == 'mapping', ('assertEqual', i({'a': 1}), 'mapping')\n    assert i([1, 2, 3]) == 'sequence', ('assertEqual', i([1, 2, 3]), 'sequence')\n    assert i((1, 2, 3)) == 'sequence', ('assertEqual', i((1, 2, 3)), 'sequence')\n    assert i('str') == 'sequence', ('assertEqual', i('str'), 'sequence')\n\n    @i.register(str)\n    class _:\n\n        def __init__(self, arg):\n            self.arg = arg\n\n        def __eq__(self, other):\n            return self.arg == other\n    assert i('str') == 'str', ('assertEqual', i('str'), 'str')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_method_register" {
    (ok, detail) = p2_libtest_run_snippet("import functools\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class A:\n\n        @functools.singledispatchmethod\n        def t(self, arg):\n            self.arg = 'base'\n\n        @t.register(int)\n        def _(self, arg):\n            self.arg = 'int'\n\n        @t.register(str)\n        def _(self, arg):\n            self.arg = 'str'\n    a = A()\n    a.t(0)\n    assert a.arg == 'int', ('assertEqual', a.arg, 'int')\n    aa = A()\n    assert not hasattr(aa, 'arg'), ('assertNotHasAttr', aa, 'arg')\n    a.t('')\n    assert a.arg == 'str', ('assertEqual', a.arg, 'str')\n    aa = A()\n    assert not hasattr(aa, 'arg'), ('assertNotHasAttr', aa, 'arg')\n    a.t(0.0)\n    assert a.arg == 'base', ('assertEqual', a.arg, 'base')\n    aa = A()\n    assert not hasattr(aa, 'arg'), ('assertNotHasAttr', aa, 'arg')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_staticmethod_register" {
    (ok, detail) = p2_libtest_run_snippet("import functools\n\ndef _t():\n\n    class A:\n\n        @functools.singledispatchmethod\n        @staticmethod\n        def t(arg):\n            return arg\n\n        @t.register(int)\n        @staticmethod\n        def _(arg):\n            return isinstance(arg, int)\n\n        @t.register(str)\n        @staticmethod\n        def _(arg):\n            return isinstance(arg, str)\n    a = A()\n    assert A.t(0), ('assertTrue', A.t(0))\n    assert A.t(''), ('assertTrue', A.t(''))\n    assert A.t(0.0) == 0.0, ('assertEqual', A.t(0.0), 0.0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_slotted_class" {
    (ok, detail) = p2_libtest_run_snippet("import functools\n\ndef _t():\n\n    class Slot:\n        __slots__ = ('a', 'b')\n\n        @functools.singledispatchmethod\n        def go(self, item, arg):\n            pass\n\n        @go.register\n        def _(self, item: int, arg):\n            return item + arg\n    s = Slot()\n    assert s.go(1, 1) == 2, ('assertEqual', s.go(1, 1), 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

