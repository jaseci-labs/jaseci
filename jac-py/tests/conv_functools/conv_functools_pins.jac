test "TestSingleDispatch.test_register_genericalias_annotation" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport typing\nimport functools\n\ndef _t():\n\n    @functools.singledispatch\n    def f(arg):\n        return 'default'\n    try:\n\n        @f.register\n        def _(arg: list[int]):\n            return 'types.GenericAlias'\n    except TypeError as _exc:\n        assert _re.search(\"Invalid annotation for 'arg'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        @f.register\n        def _(arg: typing.List[float]):\n            return 'typing.GenericAlias'\n    except TypeError as _exc:\n        assert _re.search(\"Invalid annotation for 'arg'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        @f.register\n        def _(arg: list[int] | str):\n            return 'types.UnionType(types.GenericAlias)'\n    except TypeError as _exc:\n        assert _re.search(\"Invalid annotation for 'arg'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n\n        @f.register\n        def _(arg: typing.List[float] | bytes):\n            return 'typing.Union[typing.GenericAlias]'\n    except TypeError as _exc:\n        assert _re.search(\"Invalid annotation for 'arg'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert f([1]) == 'default', ('assertEqual', f([1]), 'default')\n    assert f([1.0]) == 'default', ('assertEqual', f([1.0]), 'default')\n    assert f('') == 'default', ('assertEqual', f(''), 'default')\n    assert f(b'') == 'default', ('assertEqual', f(b''), 'default')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_method_equal_instances" {
    (ok, detail) = p2_libtest_run_snippet("import functools\n\ndef _t():\n\n    class A:\n\n        def __eq__(self, other):\n            return True\n\n        def __hash__(self):\n            return 1\n\n        @functools.singledispatchmethod\n        def t(self, arg):\n            return self\n    a = A()\n    b = A()\n    assert a.t(1) is a, ('assertIs', a.t(1), a)\n    assert b.t(2) is b, ('assertIs', b.t(2), b)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

