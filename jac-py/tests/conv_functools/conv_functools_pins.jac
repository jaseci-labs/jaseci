test "TestCachedProperty.test_subclass_with___set__" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    'Caching still works for a subclass defining __set__.'\n\n    class readonly_cached_property(py_functools.cached_property):\n\n        def __set__(self, obj, value):\n            raise AttributeError('read only property')\n\n    class Test:\n\n        def __init__(self, prop):\n            self._prop = prop\n\n        @readonly_cached_property\n        def prop(self):\n            return self._prop\n    t = Test(1)\n    assert t.prop == 1, ('assertEqual', t.prop, 1)\n    t._prop = 999\n    assert t.prop == 1, ('assertEqual', t.prop, 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
