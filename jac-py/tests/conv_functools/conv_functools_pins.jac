test "TestLRUPy.test_kwargs_order" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\n@py_functools.lru_cache()\ndef py_cached_func(x, y):\n    return 3 * x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cached_func = (py_cached_func,)\n    _SelfNS.cached_func = (py_cached_func,)\n    self.module = py_functools\n    _SelfNS.module = py_functools\n\n    @self.module.lru_cache(maxsize=10)\n    def f(**kwargs):\n        return list(kwargs.items())\n    assert f(a=1, b=2) == [('a', 1), ('b', 2)], ('assertEqual', f(a=1, b=2), [('a', 1), ('b', 2)])\n    assert f(b=2, a=1) == [('b', 2), ('a', 1)], ('assertEqual', f(b=2, a=1), [('b', 2), ('a', 1)])\n    assert f.cache_info() == self.module._CacheInfo(hits=0, misses=2, maxsize=10, currsize=2), ('assertEqual', f.cache_info(), self.module._CacheInfo(hits=0, misses=2, maxsize=10, currsize=2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
