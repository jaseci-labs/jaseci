test "TestSingleDispatch.test_union" {
    (ok, detail) = p2_libtest_run_snippet("import typing\nimport functools\n\ndef _t():\n\n    @functools.singledispatch\n    def f(arg):\n        return 'default'\n\n    @f.register\n    def _(arg: typing.Union[str, bytes]):\n        return 'typing.Union'\n\n    @f.register\n    def _(arg: int | float):\n        return 'types.UnionType'\n    assert f([]) == 'default', ('assertEqual', f([]), 'default')\n    assert f('') == 'typing.Union', ('assertEqual', f(''), 'typing.Union')\n    assert f(b'') == 'typing.Union', ('assertEqual', f(b''), 'typing.Union')\n    assert f(1) == 'types.UnionType', ('assertEqual', f(1), 'types.UnionType')\n    assert f(1.0) == 'types.UnionType', ('assertEqual', f(1.0), 'types.UnionType')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

