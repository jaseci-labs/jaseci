test "TestLRUPy.test_lru_with_types" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\n@py_functools.lru_cache()\ndef py_cached_func(x, y):\n    return 3 * x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cached_func = (py_cached_func,)\n    _SelfNS.cached_func = (py_cached_func,)\n    self.module = py_functools\n    _SelfNS.module = py_functools\n    for maxsize in (None, 128):\n\n        @self.module.lru_cache(maxsize=maxsize, typed=True)\n        def square(x):\n            return x * x\n        assert square(3) == 9, ('assertEqual', square(3), 9)\n        assert type(square(3)) == type(9), ('assertEqual', type(square(3)), type(9))\n        assert square(3.0) == 9.0, ('assertEqual', square(3.0), 9.0)\n        assert type(square(3.0)) == type(9.0), ('assertEqual', type(square(3.0)), type(9.0))\n        assert square(x=3) == 9, ('assertEqual', square(x=3), 9)\n        assert type(square(x=3)) == type(9), ('assertEqual', type(square(x=3)), type(9))\n        assert square(x=3.0) == 9.0, ('assertEqual', square(x=3.0), 9.0)\n        assert type(square(x=3.0)) == type(9.0), ('assertEqual', type(square(x=3.0)), type(9.0))\n        assert square.cache_info().hits == 4, ('assertEqual', square.cache_info().hits, 4)\n        assert square.cache_info().misses == 4, ('assertEqual', square.cache_info().misses, 4)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
