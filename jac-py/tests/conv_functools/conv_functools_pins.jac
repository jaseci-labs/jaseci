test "TestSingleDispatch.test_mro" {
    (ok, detail) = p2_libtest_run_snippet("import functools\n\ndef _t():\n\n    @functools.singledispatch\n    def g(obj):\n        return 'base'\n\n    class A:\n        pass\n\n    class C(A):\n        pass\n\n    class B(A):\n        pass\n\n    class D(C, B):\n        pass\n\n    def g_A(a):\n        return 'A'\n\n    def g_B(b):\n        return 'B'\n    g.register(A, g_A)\n    g.register(B, g_B)\n    assert g(A()) == 'A', ('assertEqual', g(A()), 'A')\n    assert g(B()) == 'B', ('assertEqual', g(B()), 'B')\n    assert g(C()) == 'A', ('assertEqual', g(C()), 'A')\n    assert g(D()) == 'B', ('assertEqual', g(D()), 'B')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

