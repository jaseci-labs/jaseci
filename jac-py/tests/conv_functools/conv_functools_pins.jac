test "TestSingleDispatch.test_method_no_reference_loops" {
    (ok, detail) = p2_libtest_run_snippet("from test import support\nimport weakref\nimport functools\n\ndef _t():\n\n    class A:\n\n        @functools.singledispatchmethod\n        def t(self, arg):\n            return weakref.ref(self)\n    a = A()\n    r = a.t(1)\n    assert r() is not None, ('assertIsNotNone', r())\n    del a\n    if not support.check_impl_detail(cpython=True):\n        support.gc_collect()\n    assert r() is None, ('assertIsNone', r())\n    a = A()\n    t = a.t\n    del a\n    support.gc_collect()\n    r = t(1)\n    assert r() is not None, ('assertIsNotNone', r())\n    del t\n    if not support.check_impl_detail(cpython=True):\n        support.gc_collect()\n    assert r() is None, ('assertIsNone', r())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_signatures" {
    (ok, detail) = p2_libtest_run_snippet("from inspect import Signature\nimport functools\n\ndef _t():\n\n    @functools.singledispatch\n    def func(item, arg: int) -> str:\n        return str(item)\n\n    @func.register\n    def _(item: int, arg: bytes) -> str:\n        return str(item)\n    assert str(Signature.from_callable(func)) == '(item, arg: int) -> str', ('assertEqual', str(Signature.from_callable(func)), '(item, arg: int) -> str')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSingleDispatch.test_method_signatures" {
    (ok, detail) = p2_libtest_run_snippet("from inspect import Signature\nimport functools\n\ndef _t():\n\n    class A:\n\n        @functools.singledispatchmethod\n        def func(self, item, arg: int) -> str:\n            return str(item)\n\n        @func.register\n        def _(self, item: int, arg: bytes) -> str:\n            return str(item)\n\n        @functools.singledispatchmethod\n        @classmethod\n        def cls_func(cls, item, arg: int) -> str:\n            return str(arg)\n\n        @func.register\n        @classmethod\n        def _(cls, item: int, arg: bytes) -> str:\n            return str(item)\n\n        @functools.singledispatchmethod\n        @staticmethod\n        def static_func(item, arg: int) -> str:\n            return str(arg)\n\n        @func.register\n        @staticmethod\n        def _(item: int, arg: bytes) -> str:\n            return str(item)\n    assert str(Signature.from_callable(A.func)) == '(self, item, arg: int) -> str', ('assertEqual', str(Signature.from_callable(A.func)), '(self, item, arg: int) -> str')\n    assert str(Signature.from_callable(A().func)) == '(self, item, arg: int) -> str', ('assertEqual', str(Signature.from_callable(A().func)), '(self, item, arg: int) -> str')\n    assert str(Signature.from_callable(A.cls_func)) == '(cls, item, arg: int) -> str', ('assertEqual', str(Signature.from_callable(A.cls_func)), '(cls, item, arg: int) -> str')\n    assert str(Signature.from_callable(A.static_func)) == '(item, arg: int) -> str', ('assertEqual', str(Signature.from_callable(A.static_func)), '(item, arg: int) -> str')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCachedProperty.test_cached" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\nclass CachedCostItem:\n    _cost = 1\n\n    def __init__(self):\n        self.lock = py_functools.RLock()\n\n    @py_functools.cached_property\n    def cost(self):\n        \"\"\"The cost of the item.\"\"\"\n        with self.lock:\n            self._cost += 1\n        return self._cost\n\ndef _t():\n    item = CachedCostItem()\n    assert item.cost == 2, ('assertEqual', item.cost, 2)\n    assert item.cost == 2, ('assertEqual', item.cost, 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCachedProperty.test_cached_attribute_name_differs_from_func_name" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\nclass OptionallyCachedCostItem:\n    _cost = 1\n\n    def get_cost(self):\n        \"\"\"The cost of the item.\"\"\"\n        self._cost += 1\n        return self._cost\n    cached_cost = py_functools.cached_property(get_cost)\n\ndef _t():\n    item = OptionallyCachedCostItem()\n    assert item.get_cost() == 2, ('assertEqual', item.get_cost(), 2)\n    assert item.cached_cost == 3, ('assertEqual', item.cached_cost, 3)\n    assert item.get_cost() == 4, ('assertEqual', item.get_cost(), 4)\n    assert item.cached_cost == 3, ('assertEqual', item.cached_cost, 3)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCachedProperty.test_object_with_slots" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\nclass CachedCostItemWithSlots:\n    __slots__ = '_cost'\n\n    def __init__(self):\n        self._cost = 1\n\n    @py_functools.cached_property\n    def cost(self):\n        raise RuntimeError('never called, slots not supported')\n\ndef _t():\n    item = CachedCostItemWithSlots()\n    try:\n        item.cost\n    except TypeError as _exc:\n        assert _re.search(\"No '__dict__' attribute on 'CachedCostItemWithSlots' instance to cache 'cost' property.\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
