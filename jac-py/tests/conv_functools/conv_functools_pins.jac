test "TestLRUPy.test_lru_hash_only_once" {
    (ok, detail) = p2_libtest_run_snippet("import unittest\nimport unittest.mock\nfrom test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\n@py_functools.lru_cache()\ndef py_cached_func(x, y):\n    return 3 * x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cached_func = (py_cached_func,)\n    _SelfNS.cached_func = (py_cached_func,)\n    self.module = py_functools\n    _SelfNS.module = py_functools\n\n    @self.module.lru_cache(maxsize=1)\n    def f(x, y):\n        return x * 3 + y\n    mock_int = unittest.mock.Mock()\n    mock_int.__mul__ = unittest.mock.Mock(return_value=15)\n    mock_int.__hash__ = unittest.mock.Mock(return_value=999)\n    assert f(mock_int, 1) == 16, ('assertEqual', f(mock_int, 1), 16)\n    assert mock_int.__hash__.call_count == 1, ('assertEqual', mock_int.__hash__.call_count, 1)\n    assert f.cache_info() == (0, 1, 1, 1), ('assertEqual', f.cache_info(), (0, 1, 1, 1))\n    assert f(mock_int, 1) == 16, ('assertEqual', f(mock_int, 1), 16)\n    assert mock_int.__hash__.call_count == 2, ('assertEqual', mock_int.__hash__.call_count, 2)\n    assert f.cache_info() == (1, 1, 1, 1), ('assertEqual', f.cache_info(), (1, 1, 1, 1))\n    assert f(6, 2) == 20, ('assertEqual', f(6, 2), 20)\n    assert mock_int.__hash__.call_count == 2, ('assertEqual', mock_int.__hash__.call_count, 2)\n    assert f.cache_info() == (1, 2, 1, 1), ('assertEqual', f.cache_info(), (1, 2, 1, 1))\n    assert f(mock_int, 1) == 16, ('assertEqual', f(mock_int, 1), 16)\n    assert mock_int.__hash__.call_count == 3, ('assertEqual', mock_int.__hash__.call_count, 3)\n    assert f.cache_info() == (1, 3, 1, 1), ('assertEqual', f.cache_info(), (1, 3, 1, 1))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

