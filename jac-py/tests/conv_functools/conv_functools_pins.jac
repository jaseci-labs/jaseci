test "TestPartialCSubclass.test_repr_safety_against_reentrant_mutation" {
    (ok, detail) = p2_libtest_run_snippet("import sys\nimport gc\nimport contextlib\nfrom test.support import import_helper\nimport functools\nc_functools = import_helper.import_fresh_module('functools', fresh=['_functools'])\n\n@contextlib.contextmanager\ndef replaced_module(name, replacement):\n    original_module = sys.modules[name]\n    sys.modules[name] = replacement\n    try:\n        yield\n    finally:\n        sys.modules[name] = original_module\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.module = c_functools\n    _SelfNS.module = c_functools\n    self.partial = c_functools.partial\n    _SelfNS.partial = c_functools.partial\n    g_partial = None\n\n    class Function:\n\n        def __init__(self, name):\n            self.name = name\n\n        def __call__(self):\n            return None\n\n        def __repr__(self):\n            return f'Function({self.name})'\n\n    class EvilObject:\n\n        def __init__(self):\n            self.triggered = False\n\n        def __repr__(self):\n            if not self.triggered and g_partial is not None:\n                self.triggered = True\n                new_args_tuple = (None,)\n                new_keywords_dict = {'keyword': None}\n                new_tuple_state = (Function('new_function'), new_args_tuple, new_keywords_dict, None)\n                g_partial.__setstate__(new_tuple_state)\n                gc.collect()\n            return f'EvilObject'\n    trigger = EvilObject()\n    func = Function('old_function')\n    g_partial = functools.partial(func, None, trigger=trigger)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), None, trigger=EvilObject)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), None, trigger=EvilObject)')\n    trigger.triggered = False\n    g_partial = functools.partial(func, trigger, arg=None)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), EvilObject, arg=None)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), EvilObject, arg=None)')\n    trigger.triggered = False\n    g_partial = functools.partial(func, trigger, None)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), EvilObject, None)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), EvilObject, None)')\n    trigger.triggered = False\n    g_partial = functools.partial(func, trigger=trigger, arg=None)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), trigger=EvilObject, arg=None)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), trigger=EvilObject, arg=None)')\n    trigger.triggered = False\n    g_partial = functools.partial(func, trigger, None, None, None, None, arg=None)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), EvilObject, None, None, None, None, arg=None)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), EvilObject, None, None, None, None, arg=None)')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

