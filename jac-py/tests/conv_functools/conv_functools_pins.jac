test "TestLRUPy.test_lru_cache_typed_is_not_recursive" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\n@py_functools.lru_cache()\ndef py_cached_func(x, y):\n    return 3 * x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cached_func = (py_cached_func,)\n    _SelfNS.cached_func = (py_cached_func,)\n    self.module = py_functools\n    _SelfNS.module = py_functools\n    cached = self.module.lru_cache(typed=True)(repr)\n    assert cached(1) == '1', ('assertEqual', cached(1), '1')\n    assert cached(True) == 'True', ('assertEqual', cached(True), 'True')\n    assert cached(1.0) == '1.0', ('assertEqual', cached(1.0), '1.0')\n    assert cached(0) == '0', ('assertEqual', cached(0), '0')\n    assert cached(False) == 'False', ('assertEqual', cached(False), 'False')\n    assert cached(0.0) == '0.0', ('assertEqual', cached(0.0), '0.0')\n    assert cached((1,)) == '(1,)', ('assertEqual', cached((1,)), '(1,)')\n    assert cached((True,)) == '(1,)', ('assertEqual', cached((True,)), '(1,)')\n    assert cached((1.0,)) == '(1,)', ('assertEqual', cached((1.0,)), '(1,)')\n    assert cached((0,)) == '(0,)', ('assertEqual', cached((0,)), '(0,)')\n    assert cached((False,)) == '(0,)', ('assertEqual', cached((False,)), '(0,)')\n    assert cached((0.0,)) == '(0,)', ('assertEqual', cached((0.0,)), '(0,)')\n\n    class T(tuple):\n        pass\n    assert cached(T((1,))) == '(1,)', ('assertEqual', cached(T((1,))), '(1,)')\n    assert cached(T((True,))) == '(1,)', ('assertEqual', cached(T((True,))), '(1,)')\n    assert cached(T((1.0,))) == '(1,)', ('assertEqual', cached(T((1.0,))), '(1,)')\n    assert cached(T((0,))) == '(0,)', ('assertEqual', cached(T((0,))), '(0,)')\n    assert cached(T((False,))) == '(0,)', ('assertEqual', cached(T((False,))), '(0,)')\n    assert cached(T((0.0,))) == '(0,)', ('assertEqual', cached(T((0.0,))), '(0,)')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestLRUPy.test_lru_with_keyword_args" {
