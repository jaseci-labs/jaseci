test "TestLRUPy.test_lru_cache_weakrefable" {
    (ok, detail) = p2_libtest_run_snippet("import weakref\nimport gc\nfrom test.support import import_helper\npy_functools = import_helper.import_fresh_module('functools', blocked=['_functools'])\n\n@py_functools.lru_cache()\ndef py_cached_func(x, y):\n    return 3 * x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.cached_func = (py_cached_func,)\n    _SelfNS.cached_func = (py_cached_func,)\n    self.module = py_functools\n    _SelfNS.module = py_functools\n\n    @self.module.lru_cache\n    def test_function(x):\n        return x\n\n    class A:\n\n        @self.module.lru_cache\n        def test_method(self, x):\n            return (self, x)\n\n        @staticmethod\n        @self.module.lru_cache\n        def test_staticmethod(x):\n            return (self, x)\n    refs = [weakref.ref(test_function), weakref.ref(A.test_method), weakref.ref(A.test_staticmethod)]\n    for ref in refs:\n        assert ref() is not None, ('assertIsNotNone', ref())\n    del A\n    del test_function\n    gc.collect()\n    for ref in refs:\n        assert ref() is None, ('assertIsNone', ref())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

