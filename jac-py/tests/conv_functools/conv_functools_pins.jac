assertEqual', repr(g_partial), 'functools.partial(Function(old_function), EvilObject, arg=None)')\n    trigger.triggered = False\n    g_partial = functools.partial(func, trigger, None)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), EvilObject, None)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), EvilObject, None)')\n    trigger.triggered = False\n    g_partial = functools.partial(func, trigger=trigger, arg=None)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), trigger=EvilObject, arg=None)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), trigger=EvilObject, arg=None)')\n    trigger.triggered = False\n    g_partial = functools.partial(func, trigger, None, None, None, None, arg=None)\n    assert repr(g_partial) == 'functools.partial(Function(old_function), EvilObject, None, None, None, None, arg=None)', ('assertEqual', repr(g_partial), 'functools.partial(Function(old_function), EvilObject, None, None, None, None, arg=None)')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
