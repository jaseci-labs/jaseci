test "ColorsysTest.test_hsv_roundtrip" {
    (ok, detail) = p2_libtest_run_snippet("import colorsys\n\ndef frange(start, stop, step):\n    while start <= stop:\n        yield start\n        start += step\n\ndef assertTripleEqual(tr1, tr2):\n    assert len(tr1) == 3, ('assertEqual', len(tr1), 3)\n    assert len(tr2) == 3, ('assertEqual', len(tr2), 3)\n    assert round(tr1[0] - tr2[0], 7) == 0, ('assertAlmostEqual', tr1[0], tr2[0])\n    assert round(tr1[1] - tr2[1], 7) == 0, ('assertAlmostEqual', tr1[1], tr2[1])\n    assert round(tr1[2] - tr2[2], 7) == 0, ('assertAlmostEqual', tr1[2], tr2[2])\n\ndef _t():\n    for r in frange(0.0, 1.0, 0.2):\n        for g in frange(0.0, 1.0, 0.2):\n            for b in frange(0.0, 1.0, 0.2):\n                rgb = (r, g, b)\n                assertTripleEqual(rgb, colorsys.hsv_to_rgb(*colorsys.rgb_to_hsv(*rgb)))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

