test "NamedExpressionScopeTest.test_named_expression_scope_08" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    def spam(a):\n        return a\n\n    def eggs(b):\n        return b * 2\n    res = [spam((a := eggs((b := h)))) for h in range(2)]\n    assert res == [0, 2], ('assertEqual', res, [0, 2])\n    assert a == 2, ('assertEqual', a, 2)\n    assert b == 1, ('assertEqual', b, 1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

