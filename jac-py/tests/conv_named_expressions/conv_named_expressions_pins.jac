    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n    cases = [('Top level', '{i for i in (i := range(5))}'), ('Inside tuple', '{i for i in (2, 3, i := range(5))}'), ('Inside list', '{i for i in {2, 3, i := range(5)}}'), ('Different name', '{i for i in (j := range(5))}'), ('Lambda expression', '{i for i in (lambda:(j := range(5)))()}'), ('Inner loop', '{i for i in range(5) for j in (i := range(5))}'), ('Nested comprehension', '{i for i in {j for j in (k := range(5))}}'), ('Nested comprehension condition', '{i for i in {j for j in range(5) if (j := True)}}'), ('Nested comprehension body', '{i for i in {(j := True) for j in range(5)}}')]\n    msg = 'assignment expression cannot be used in a comprehension iterable expression'\n    for case, code in cases:\n        try:\n            exec(code, {})\n        except SyntaxError as _exc:\n            assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            exec(code, {}, {})\n        except SyntaxError as _exc:\n            assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            exec(f'lambda: {code}', {})\n        except SyntaxError as _exc:\n            assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NamedExpressionInvalidTest.test_named_expression_invalid_rebinding_dict_comprehension_iteration_variable" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n    cases = [('Key reuse', 'i', '{(i := 0): 1 for i in range(5)}'), ('Value reuse', 'i', '{1: (i := 0) for i in range(5)}'), ('Both reuse', 'i', '{(i := 0): (i := 0) for i in range(5)}'), ('Nested reuse', 'j', '{{(j := 0): 1 for i in range(5)} for j in range(5)}'), ('Reuse inner loop target', 'j', '{(j := 0): 1 for i in range(5) for j in range(5)}'), ('Unpacking key reuse', 'i', '{(i := 0): 1 for i, j in {(0, 1)}}'), ('Unpacking value reuse', 'i', '{1: (i := 0) for i, j in {(0, 1)}}'), ('Reuse in loop condition', 'i', '{i+1: 1 for i in range(5) if (i := 0)}'), ('Unreachable reuse', 'i', '{(False or (i:=0)): 1 for i in range(5)}'), ('Unreachable nested reuse', 'i', '{i: j for i in range(5) for j in range(5) if True or (i:=10)}'), ('Complex expression: a', 'a', '{(a := 1): 1 for a, (*b, c[d+e::f(g)], h.i) in j}'), ('Complex expression: b', 'b', '{(b := 1): 1 for a, (*b, c[d+e::f(g)], h.i) in j}')]\n    for case, target, code in cases:\n        msg = f\"assignment expression cannot rebind comprehension iteration variable '{target}'\"\n        try:\n            exec(code, {})\n        except SyntaxError as _exc:\n            assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            exec(code, {}, {})\n        except SyntaxError as _exc:\n            assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        try:\n            exec(f'lambda: {code}', {})\n        except SyntaxError as _exc:\n            assert _re.search(msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

