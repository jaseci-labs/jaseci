test "NamedExpressionScopeTest.test_named_expression_scope_24" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    a = 10\n\n    def spam():\n        nonlocal a\n        (a := 20)\n    spam()\n    assert a == 20, ('assertEqual', a, 20)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NamedExpressionScopeTest.test_named_expression_scope_25" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    ns = {}\n    code = 'a = 10\\ndef spam():\\n    global a\\n    (a := 20)\\nspam()'\n    exec(code, ns, {})\n    assert ns['a'] == 20, ('assertEqual', ns['a'], 20)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NamedExpressionScopeTest.test_named_expression_variable_reuse_in_comprehensions" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    rebinding = '[x := i for i in range(3) if (x := i) or not x]'\n    filter_ref = '[x := i for i in range(3) if x or not x]'\n    body_ref = '[x for i in range(3) if (x := i) or not x]'\n    nested_ref = '[j for i in range(3) if x or not x for j in range(3) if (x := i)][:-3]'\n    cases = [('Rebind global', f'x = 1; result = {rebinding}'), ('Rebind nonlocal', f'result, x = (lambda x=1: ({rebinding}, x))()'), ('Filter global', f'x = 1; result = {filter_ref}'), ('Filter nonlocal', f'result, x = (lambda x=1: ({filter_ref}, x))()'), ('Body global', f'x = 1; result = {body_ref}'), ('Body nonlocal', f'result, x = (lambda x=1: ({body_ref}, x))()'), ('Nested global', f'x = 1; result = {nested_ref}'), ('Nested nonlocal', f'result, x = (lambda x=1: ({nested_ref}, x))()')]\n    for case, code in cases:\n        ns = {}\n        exec(code, ns)\n        assert ns['x'] == 2, ('assertEqual', ns['x'], 2)\n        assert ns['result'] == [0, 1, 2], ('assertEqual', ns['result'], [0, 1, 2])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NamedExpressionScopeTest.test_named_expression_global_scope" {
    (ok, detail) = p2_libtest_run_snippet("GLOBAL_VAR = None\n\ndef _t():\n    sentinel = object()\n    global GLOBAL_VAR\n\n    def f():\n        global GLOBAL_VAR\n        [(GLOBAL_VAR := sentinel) for _ in range(1)]\n        assert GLOBAL_VAR == sentinel, ('assertEqual', GLOBAL_VAR, sentinel)\n    try:\n        f()\n        assert GLOBAL_VAR == sentinel, ('assertEqual', GLOBAL_VAR, sentinel)\n    finally:\n        GLOBAL_VAR = None\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

