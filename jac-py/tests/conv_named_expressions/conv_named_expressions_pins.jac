    (ok, detail) = p2_libtest_run_snippet("GLOBAL_VAR = None\n\ndef _t():\n    sentinel = object()\n\n    def f():\n        GLOBAL_VAR = None\n        [(GLOBAL_VAR := sentinel) for _ in range(1)]\n        assert GLOBAL_VAR == sentinel, ('assertEqual', GLOBAL_VAR, sentinel)\n    f()\n    assert GLOBAL_VAR == None, ('assertEqual', GLOBAL_VAR, None)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NamedExpressionScopeTest.test_named_expression_nonlocal_scope" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    sentinel = object()\n\n    def f():\n        nonlocal_var = None\n\n        def g():\n            nonlocal nonlocal_var\n            [(nonlocal_var := sentinel) for _ in range(1)]\n        g()\n        assert nonlocal_var == sentinel, ('assertEqual', nonlocal_var, sentinel)\n    f()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NamedExpressionScopeTest.test_named_expression_nonlocal_scope_no_nonlocal_keyword" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    sentinel = object()\n\n    def f():\n        nonlocal_var = None\n\n        def g():\n            [(nonlocal_var := sentinel) for _ in range(1)]\n        g()\n        assert nonlocal_var == None, ('assertEqual', nonlocal_var, None)\n    f()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "NamedExpressionScopeTest.test_named_expression_scope_in_genexp" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    a = 1\n    b = [1, 2, 3, 4]\n    genexp = ((c := (i + a)) for i in b)\n    assert 'c' not in locals(), ('assertNotIn', 'c', locals())\n    for idx, elem in enumerate(genexp):\n        assert elem == b[idx] + a, ('assertEqual', elem, b[idx] + a)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
