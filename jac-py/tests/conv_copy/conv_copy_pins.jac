test "TestReplace.test_replace_method" {
    (ok, detail) = p2_libtest_run_snippet("import copy\nfrom operator import le, lt, ge, gt, eq, ne, attrgetter\n\ndef global_foo(x, y):\n    return x + y\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class A:\n\n        def __new__(cls, x, y=0):\n            self = object.__new__(cls)\n            self.x = x\n            self.y = y\n            return self\n\n        def __init__(self, *args, **kwargs):\n            self.z = self.x + self.y\n\n        def __replace__(self, **changes):\n            x = changes.get('x', self.x)\n            y = changes.get('y', self.y)\n            return type(self)(x, y)\n    attrs = attrgetter('x', 'y', 'z')\n    a = A(11, 22)\n    assert attrs(copy.replace(a)) == (11, 22, 33), ('assertEqual', attrs(copy.replace(a)), (11, 22, 33))\n    assert attrs(copy.replace(a, x=1)) == (1, 22, 23), ('assertEqual', attrs(copy.replace(a, x=1)), (1, 22, 23))\n    assert attrs(copy.replace(a, y=2)) == (11, 2, 13), ('assertEqual', attrs(copy.replace(a, y=2)), (11, 2, 13))\n    assert attrs(copy.replace(a, x=1, y=2)) == (1, 2, 3), ('assertEqual', attrs(copy.replace(a, x=1, y=2)), (1, 2, 3))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestReplace.test_namedtuple" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport copy\n\ndef _t():\n    from collections import namedtuple\n    from typing import NamedTuple\n    PointFromCall = namedtuple('Point', 'x y', defaults=(0,))\n\n    class PointFromInheritance(PointFromCall):\n        pass\n\n    class PointFromClass(NamedTuple):\n        x: int\n        y: int = 0\n    for Point in (PointFromCall, PointFromInheritance, PointFromClass):\n        p = Point(11, 22)\n        assert isinstance(p, Point), ('assertIsInstance', p, Point)\n        assert copy.replace(p) == (11, 22), ('assertEqual', copy.replace(p), (11, 22))\n        assert isinstance(copy.replace(p), Point), ('assertIsInstance', copy.replace(p), Point)\n        assert copy.replace(p, x=1) == (1, 22), ('assertEqual', copy.replace(p, x=1), (1, 22))\n        assert copy.replace(p, y=2) == (11, 2), ('assertEqual', copy.replace(p, y=2), (11, 2))\n        assert copy.replace(p, x=1, y=2) == (1, 2), ('assertEqual', copy.replace(p, x=1, y=2), (1, 2))\n        try:\n            copy.replace(p, x=1, error=2)\n        except TypeError as _exc:\n            assert _re.search('unexpected field name', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestReplace.test_dataclass" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport copy\nfrom operator import le, lt, ge, gt, eq, ne, attrgetter\n\ndef _t():\n    from dataclasses import dataclass\n\n    @dataclass\n    class C:\n        x: int\n        y: int = 0\n    attrs = attrgetter('x', 'y')\n    c = C(11, 22)\n    assert attrs(copy.replace(c)) == (11, 22), ('assertEqual', attrs(copy.replace(c)), (11, 22))\n    assert attrs(copy.replace(c, x=1)) == (1, 22), ('assertEqual', attrs(copy.replace(c, x=1)), (1, 22))\n    assert attrs(copy.replace(c, y=2)) == (11, 2), ('assertEqual', attrs(copy.replace(c, y=2)), (11, 2))\n    assert attrs(copy.replace(c, x=1, y=2)) == (1, 2), ('assertEqual', attrs(copy.replace(c, x=1, y=2)), (1, 2))\n    try:\n        copy.replace(c, x=1, error=2)\n    except TypeError as _exc:\n        assert _re.search('unexpected keyword argument', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
