test "TestCopy.test_copy_list_subclass" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef global_foo(x, y):\n    return x + y\n\ndef _t():\n\n    class C(list):\n        pass\n    x = C([[1, 2], 3])\n    x.foo = [4, 5]\n    y = copy.copy(x)\n    assert list(x) == list(y), ('assertEqual', list(x), list(y))\n    assert x.foo == y.foo, ('assertEqual', x.foo, y.foo)\n    assert x[0] is y[0], ('assertIs', x[0], y[0])\n    assert x.foo is y.foo, ('assertIs', x.foo, y.foo)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopy.test_deepcopy_list_subclass" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef global_foo(x, y):\n    return x + y\n\ndef _t():\n\n    class C(list):\n        pass\n    x = C([[1, 2], 3])\n    x.foo = [4, 5]\n    y = copy.deepcopy(x)\n    assert list(x) == list(y), ('assertEqual', list(x), list(y))\n    assert x.foo == y.foo, ('assertEqual', x.foo, y.foo)\n    assert x[0] is not y[0], ('assertIsNot', x[0], y[0])\n    assert x.foo is not y.foo, ('assertIsNot', x.foo, y.foo)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopy.test_copy_tuple_subclass" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef global_foo(x, y):\n    return x + y\n\ndef _t():\n\n    class C(tuple):\n        pass\n    x = C([1, 2, 3])\n    assert tuple(x) == (1, 2, 3), ('assertEqual', tuple(x), (1, 2, 3))\n    y = copy.copy(x)\n    assert tuple(y) == (1, 2, 3), ('assertEqual', tuple(y), (1, 2, 3))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopy.test_deepcopy_tuple_subclass" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef global_foo(x, y):\n    return x + y\n\ndef _t():\n\n    class C(tuple):\n        pass\n    x = C([[1, 2], 3])\n    assert tuple(x) == ([1, 2], 3), ('assertEqual', tuple(x), ([1, 2], 3))\n    y = copy.deepcopy(x)\n    assert tuple(y) == ([1, 2], 3), ('assertEqual', tuple(y), ([1, 2], 3))\n    assert x is not y, ('assertIsNot', x, y)\n    assert x[0] is not y[0], ('assertIsNot', x[0], y[0])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopy.test_getstate_exc" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef _t():\n\n    class EvilState(object):\n\n        def __getstate__(self):\n            raise ValueError(\"ain't got no stickin' state\")\n    try:\n        copy.copy(*(EvilState(),))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopy.test_copy_function" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef global_foo(x, y):\n    return x + y\n\ndef _t():\n    assert copy.copy(global_foo) == global_foo, ('assertEqual', copy.copy(global_foo), global_foo)\n\n    def foo(x, y):\n        return x + y\n    assert copy.copy(foo) == foo, ('assertEqual', copy.copy(foo), foo)\n    bar = lambda: None\n    assert copy.copy(bar) == bar, ('assertEqual', copy.copy(bar), bar)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopy.test_deepcopy_function" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef global_foo(x, y):\n    return x + y\n\ndef _t():\n    assert copy.deepcopy(global_foo) == global_foo, ('assertEqual', copy.deepcopy(global_foo), global_foo)\n\n    def foo(x, y):\n        return x + y\n    assert copy.deepcopy(foo) == foo, ('assertEqual', copy.deepcopy(foo), foo)\n    bar = lambda: None\n    assert copy.deepcopy(bar) == bar, ('assertEqual', copy.deepcopy(bar), bar)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestCopy.test_deepcopy_bound_method" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef _t():\n\n    class Foo(object):\n\n        def m(self):\n            pass\n    f = Foo()\n    f.b = f.m\n    g = copy.deepcopy(f)\n    assert g.m == g.b, ('assertEqual', g.m, g.b)\n    assert g.b.__self__ is g, ('assertIs', g.b.__self__, g)\n    g.b()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestReplace.test_unsupported" {
    (ok, detail) = p2_libtest_run_snippet("import copy\n\ndef _t():\n    try:\n        copy.replace(*(1,))\n    except TypeError:\n        pass\n    try:\n        copy.replace(*([],))\n    except TypeError:\n        pass\n    try:\n        copy.replace(*({},))\n    except TypeError:\n        pass\n\n    def f():\n        pass\n    try:\n        copy.replace(*(f,))\n    except TypeError:\n        pass\n\n    class A:\n        pass\n    try:\n        copy.replace(*(A,))\n    except TypeError:\n        pass\n    try:\n        copy.replace(*(A(),))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestReplace.test_dataclass" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport copy\nfrom operator import le, lt, ge, gt, eq, ne, attrgetter\n\ndef _t():\n    from dataclasses import dataclass\n\n    @dataclass\n    class C:\n        x: int\n        y: int = 0\n    attrs = attrgetter('x', 'y')\n    c = C(11, 22)\n    assert attrs(copy.replace(c)) == (11, 22), ('assertEqual', attrs(copy.replace(c)), (11, 22))\n    assert attrs(copy.replace(c, x=1)) == (1, 22), ('assertEqual', attrs(copy.replace(c, x=1)), (1, 22))\n    assert attrs(copy.replace(c, y=2)) == (11, 2), ('assertEqual', attrs(copy.replace(c, y=2)), (11, 2))\n    assert attrs(copy.replace(c, x=1, y=2)) == (1, 2), ('assertEqual', attrs(copy.replace(c, x=1, y=2)), (1, 2))\n    try:\n        copy.replace(c, x=1, error=2)\n    except TypeError as _exc:\n        assert _re.search('unexpected keyword argument', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
