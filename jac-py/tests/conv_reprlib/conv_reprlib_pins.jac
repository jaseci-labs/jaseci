    (ok, detail) = p2_libtest_run_snippet("from reprlib import Repr\n\ndef nestedTuple(nesting):\n    t = ()\n    for i in range(nesting):\n        t = (t,)\n    return t\n\ndef _t():\n\n    class TypeWithSpaces:\n        pass\n    t = TypeWithSpaces()\n    type(t).__name__ = 'type with spaces'\n    assert type(t).__name__ == 'type with spaces', ('assertEqual', type(t).__name__, 'type with spaces')\n\n    class MyRepr(Repr):\n\n        def repr_type_with_spaces(self, obj, level):\n            return 'Type With Spaces'\n    aRepr = MyRepr()\n    assert aRepr.repr(t) == 'Type With Spaces', ('assertEqual', aRepr.repr(t), 'Type With Spaces')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
