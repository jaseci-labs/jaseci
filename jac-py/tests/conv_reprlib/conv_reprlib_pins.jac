test "ReprTests.test_numbers" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport sys\nfrom reprlib import repr as r\n\ndef _t():\n    for x in [123, 1.0 / 3]:\n        assert r(x) == repr(x), ('assertEqual', r(x), repr(x))\n    max_digits = sys.get_int_max_str_digits()\n    for k in [100, max_digits - 1]:\n        n = 10 ** k\n        expected = repr(n)[:18] + '...' + repr(n)[-19:]\n        assert r(n) == expected, ('assertEqual', r(n), expected)\n\n    def re_msg(n, d):\n        return f'<{n.__class__.__name__} instance with roughly {d} digits \\\\(limit at {max_digits}\\\\) at 0x[a-f0-9]+>'\n    k = max_digits\n    n = 10 ** k\n    try:\n        repr(*(n,))\n    except ValueError:\n        pass\n    assert _re.search(re_msg(n, k + 1), r(n)), ('assertRegex', r(n), re_msg(n, k + 1))\n    for k in [max_digits + 1, 2 * max_digits]:\n        assert k > 100, ('assertGreater', k, 100)\n        n = 10 ** k\n        try:\n            repr(*(n,))\n        except ValueError:\n            pass\n        assert _re.search(re_msg(n, k + 1), r(n)), ('assertRegex', r(n), re_msg(n, k + 1))\n        n = 10 ** k - 1\n        try:\n            repr(*(n,))\n        except ValueError:\n            pass\n        assert _re.search(re_msg(n, k + 1), r(n)), ('assertRegex', r(n), re_msg(n, k + 1))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

