test "ReprTests.test_invalid_indent" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom reprlib import repr as r\nfrom reprlib import Repr\n\ndef _t():\n    test_object = [1, 'spam', {'eggs': True, 'ham': []}]\n    test_cases = [(-1, (ValueError, '[Nn]egative|[Pp]ositive')), (-4, (ValueError, '[Nn]egative|[Pp]ositive')), ((), (TypeError, None)), ([], (TypeError, None)), ((4,), (TypeError, None)), ([4], (TypeError, None)), (object(), (TypeError, None))]\n    for indent, (expected_error, expected_msg) in test_cases:\n        r = Repr()\n        r.indent = indent\n        expected_msg = expected_msg or f'{type(indent)}'\n        try:\n            r.repr(test_object)\n        except expected_error as _exc:\n            assert _re.search(expected_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

