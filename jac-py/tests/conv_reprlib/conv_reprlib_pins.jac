test "TestRecursiveRepr.test_recursive_repr" {
    (ok, detail) = p2_libtest_run_snippet("from reprlib import recursive_repr\n\nclass MyContainer:\n    \"\"\"Helper class for TestRecursiveRepr\"\"\"\n\n    def __init__(self, values):\n        self.values = list(values)\n\n    def append(self, value):\n        self.values.append(value)\n\n    @recursive_repr()\n    def __repr__(self):\n        return '<' + ', '.join(map(str, self.values)) + '>'\n\nclass MyContainer2(MyContainer):\n\n    @recursive_repr('+++')\n    def __repr__(self):\n        return '<' + ', '.join(map(str, self.values)) + '>'\n\ndef _t():\n    m = MyContainer(list('abcde'))\n    m.append(m)\n    m.append('x')\n    m.append(m)\n    assert repr(m) == '<a, b, c, d, e, ..., x, ...>', ('assertEqual', repr(m), '<a, b, c, d, e, ..., x, ...>')\n    m = MyContainer2(list('abcde'))\n    m.append(m)\n    m.append('x')\n    m.append(m)\n    assert repr(m) == '<a, b, c, d, e, +++, x, +++>', ('assertEqual', repr(m), '<a, b, c, d, e, +++, x, +++>')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

