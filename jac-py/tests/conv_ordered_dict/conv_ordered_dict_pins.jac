test "PurePythonOrderedDictSubclassTests.test_setdefault" {
    (ok, detail) = p2_libtest_run_snippet("from random import randrange, shuffle\nfrom test.support import import_helper\npy_coll = import_helper.import_fresh_module('collections', blocked=['_collections'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.OrderedDict = py_coll.OrderedDict\n    self.module = py_coll\n    OrderedDict = self.OrderedDict\n    pairs = [('c', 1), ('b', 2), ('a', 3), ('d', 4), ('e', 5), ('f', 6)]\n    shuffle(pairs)\n    od = OrderedDict(pairs)\n    pair_order = list(od.items())\n    assert od.setdefault('a', 10) == 3, ('assertEqual', od.setdefault('a', 10), 3)\n    assert list(od.items()) == pair_order, ('assertEqual', list(od.items()), pair_order)\n    assert od.setdefault('x', 10) == 10, ('assertEqual', od.setdefault('x', 10), 10)\n    assert list(od.items())[-1] == ('x', 10), ('assertEqual', list(od.items())[-1], ('x', 10))\n    assert od.setdefault('g', default=9) == 9, ('assertEqual', od.setdefault('g', default=9), 9)\n\n    class Missing(OrderedDict):\n\n        def __missing__(self, key):\n            return 0\n    assert Missing().setdefault(5, 9) == 9, ('assertEqual', Missing().setdefault(5, 9), 9)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

