test "PurePythonOrderedDictSubclassTests.test_equality" {
    (ok, detail) = p2_libtest_run_snippet("from random import randrange, shuffle\nfrom test.support import import_helper\npy_coll = import_helper.import_fresh_module('collections', blocked=['_collections'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.OrderedDict = py_coll.OrderedDict\n    self.module = py_coll\n    OrderedDict = self.OrderedDict\n    pairs = [('c', 1), ('b', 2), ('a', 3), ('d', 4), ('e', 5), ('f', 6)]\n    shuffle(pairs)\n    od1 = OrderedDict(pairs)\n    od2 = OrderedDict(pairs)\n    assert od1 == od2, ('assertEqual', od1, od2)\n    pairs = pairs[2:] + pairs[:2]\n    od2 = OrderedDict(pairs)\n    assert od1 != od2, ('assertNotEqual', od1, od2)\n    assert od1 == dict(od2), ('assertEqual', od1, dict(od2))\n    assert dict(od2) == od1, ('assertEqual', dict(od2), od1)\n    assert od1 != OrderedDict(pairs[:-1]), ('assertNotEqual', od1, OrderedDict(pairs[:-1]))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

