test "PurePythonOrderedDictSubclassTests.test_move_to_end" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_coll = import_helper.import_fresh_module('collections', blocked=['_collections'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.OrderedDict = py_coll.OrderedDict\n    self.module = py_coll\n    OrderedDict = self.OrderedDict\n    od = OrderedDict.fromkeys('abcde')\n    assert list(od) == list('abcde'), ('assertEqual', list(od), list('abcde'))\n    od.move_to_end('c')\n    assert list(od) == list('abdec'), ('assertEqual', list(od), list('abdec'))\n    od.move_to_end('c', False)\n    assert list(od) == list('cabde'), ('assertEqual', list(od), list('cabde'))\n    od.move_to_end('c', False)\n    assert list(od) == list('cabde'), ('assertEqual', list(od), list('cabde'))\n    od.move_to_end('e')\n    assert list(od) == list('cabde'), ('assertEqual', list(od), list('cabde'))\n    od.move_to_end('b', last=False)\n    assert list(od) == list('bcade'), ('assertEqual', list(od), list('bcade'))\n    try:\n        od.move_to_end('x')\n    except KeyError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        od.move_to_end('x', False)\n    except KeyError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

