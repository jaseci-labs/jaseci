test "PurePythonOrderedDictSubclassTests.test_pop" {
    (ok, detail) = p2_libtest_run_snippet("from random import randrange, shuffle\nfrom test.support import import_helper\npy_coll = import_helper.import_fresh_module('collections', blocked=['_collections'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.OrderedDict = py_coll.OrderedDict\n    self.module = py_coll\n    OrderedDict = self.OrderedDict\n    pairs = [('c', 1), ('b', 2), ('a', 3), ('d', 4), ('e', 5), ('f', 6)]\n    shuffle(pairs)\n    od = OrderedDict(pairs)\n    shuffle(pairs)\n    while pairs:\n        k, v = pairs.pop()\n        assert od.pop(k) == v, ('assertEqual', od.pop(k), v)\n    try:\n        od.pop('xyz')\n    except KeyError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    assert len(od) == 0, ('assertEqual', len(od), 0)\n    assert od.pop(k, 12345) == 12345, ('assertEqual', od.pop(k, 12345), 12345)\n\n    class Missing(OrderedDict):\n\n        def __missing__(self, key):\n            return 0\n    m = Missing(a=1)\n    assert m.pop('b', 5) == 5, ('assertEqual', m.pop('b', 5), 5)\n    assert m.pop('a', 6) == 1, ('assertEqual', m.pop('a', 6), 1)\n    assert m.pop('a', 6) == 6, ('assertEqual', m.pop('a', 6), 6)\n    assert m.pop('a', default=6) == 6, ('assertEqual', m.pop('a', default=6), 6)\n    try:\n        m.pop('a')\n    except KeyError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

