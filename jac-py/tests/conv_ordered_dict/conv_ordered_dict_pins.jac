test "PurePythonOrderedDictSubclassTests.test_merge_operator" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import import_helper\npy_coll = import_helper.import_fresh_module('collections', blocked=['_collections'])\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.OrderedDict = py_coll.OrderedDict\n    self.module = py_coll\n    OrderedDict = self.OrderedDict\n    a = OrderedDict({0: 0, 1: 1, 2: 1})\n    b = OrderedDict({1: 1, 2: 2, 3: 3})\n    c = a.copy()\n    d = a.copy()\n    c |= b\n    d |= list(b.items())\n    expected = OrderedDict({0: 0, 1: 1, 2: 2, 3: 3})\n    assert a | dict(b) == expected, ('assertEqual', a | dict(b), expected)\n    assert a | b == expected, ('assertEqual', a | b, expected)\n    assert c == expected, ('assertEqual', c, expected)\n    assert d == expected, ('assertEqual', d, expected)\n    c = b.copy()\n    c |= a\n    expected = OrderedDict({1: 1, 2: 1, 3: 3, 0: 0})\n    assert dict(b) | a == expected, ('assertEqual', dict(b) | a, expected)\n    assert b | a == expected, ('assertEqual', b | a, expected)\n    assert c == expected, ('assertEqual', c, expected)\n    assert type(a | b) is OrderedDict, ('assertIs', type(a | b), OrderedDict)\n    assert type(dict(a) | b) is OrderedDict, ('assertIs', type(dict(a) | b), OrderedDict)\n    assert type(a | dict(b)) is OrderedDict, ('assertIs', type(a | dict(b)), OrderedDict)\n    expected = a.copy()\n    a |= ()\n    a |= ''\n    assert a == expected, ('assertEqual', a, expected)\n    try:\n        a | None\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        a | ()\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        a | 'BAD'\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        a | ''\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        a |= 'BAD'\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

