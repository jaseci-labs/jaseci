test "ArrayMemoryviewTest.test_boolean_format" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    m1a = memoryview(b'\\x00\\x02\\x00').cast('?')\n    assert m1a.tolist() == [False, True, False], ('assertEqual', m1a.tolist(), [False, True, False])\n    m1b = memoryview(b'\\x00\\x04\\x00').cast('?')\n    assert m1b.tolist() == [False, True, False], ('assertEqual', m1b.tolist(), [False, True, False])\n    assert m1a == m1b, ('assertEqual', m1a, m1b)\n    m2a = memoryview(b'\\x01\\x03\\x05').cast('?')\n    assert m2a.tolist() == [True, True, True], ('assertEqual', m2a.tolist(), [True, True, True])\n    m2b = memoryview(b'\\x02\\x04\\x06').cast('?')\n    assert m2b.tolist() == [True, True, True], ('assertEqual', m2b.tolist(), [True, True, True])\n    assert m2a == m2b, ('assertEqual', m2a, m2b)\n    allbytes = bytes(range(256))\n    allbytes = memoryview(allbytes).cast('?')\n    assert allbytes.tolist() == [False] + [True] * 255, ('assertEqual', allbytes.tolist(), [False] + [True] * 255)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "OtherTest.test_half_float" {
    (ok, detail) = p2_libtest_run_snippet("import struct\n\ndef _t():\n    half_data = struct.pack('eee', 0.0, -1.5, 1.5)\n    float_data = struct.pack('fff', 0.0, -1.5, 1.5)\n    half_view = memoryview(half_data).cast('e')\n    float_view = memoryview(float_data).cast('f')\n    assert half_view.nbytes * 2 == float_view.nbytes, ('assertEqual', half_view.nbytes * 2, float_view.nbytes)\n    assert half_view.tolist() == float_view.tolist(), ('assertListEqual', half_view.tolist(), float_view.tolist())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
