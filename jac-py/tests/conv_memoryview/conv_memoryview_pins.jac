test "AbstractMemoryTests.test_issue22668" {
    (ok, detail) = p2_libtest_run_snippet("import array\n\ndef _t():\n    a = array.array('H', [256, 256, 256, 256])\n    x = memoryview(a)\n    m = x.cast('B')\n    b = m.cast('H')\n    c = b[0:2]\n    d = memoryview(b)\n    del b\n    assert c[0] == 256, ('assertEqual', c[0], 256)\n    assert d[0] == 256, ('assertEqual', d[0], 256)\n    assert c.format == 'H', ('assertEqual', c.format, 'H')\n    assert d.format == 'H', ('assertEqual', d.format, 'H')\n    _ = m.cast('I')\n    assert c[0] == 256, ('assertEqual', c[0], 256)\n    assert d[0] == 256, ('assertEqual', d[0], 256)\n    assert c.format == 'H', ('assertEqual', c.format, 'H')\n    assert d.format == 'H', ('assertEqual', d.format, 'H')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "AbstractMemoryTests.test_hex_use_after_free" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    ba = bytearray(b'A' * 1024)\n    mv = memoryview(ba)\n\n    class S(bytes):\n\n        def __len__(self):\n            mv.release()\n            ba.clear()\n            return 1\n    try:\n        mv.hex(*(S(b':'),))\n    except BufferError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
