test "SliceTest.test_pickle" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nfrom pickle import loads, dumps\n\ndef evaluate_slice_index(arg):\n    \"\"\"\n    Helper function to convert a slice argument to an integer, and raise\n    TypeError with a suitable message on failure.\n\n    \"\"\"\n    if hasattr(arg, '__index__'):\n        return operator.index(arg)\n    else:\n        raise TypeError('slice indices must be integers or None or have an __index__ method')\n\ndef slice_indices(slice, length):\n    \"\"\"\n    Reference implementation for the slice.indices method.\n\n    \"\"\"\n    length = operator.index(length)\n    step = 1 if slice.step is None else evaluate_slice_index(slice.step)\n    if length < 0:\n        raise ValueError('length should not be negative')\n    if step == 0:\n        raise ValueError('slice step cannot be zero')\n    lower = -1 if step < 0 else 0\n    upper = length - 1 if step < 0 else length\n    if slice.start is None:\n        start = upper if step < 0 else lower\n    else:\n        start = evaluate_slice_index(slice.start)\n        start = max(start + length, lower) if start < 0 else min(start, upper)\n    if slice.stop is None:\n        stop = lower if step < 0 else upper\n    else:\n        stop = evaluate_slice_index(slice.stop)\n        stop = max(stop + length, lower) if stop < 0 else min(stop, upper)\n    return (start, stop, step)\n\ndef _t():\n    import pickle\n    s = slice(10, 20, 3)\n    for protocol in range(pickle.HIGHEST_PROTOCOL + 1):\n        t = loads(dumps(s, protocol))\n        assert s == t, ('assertEqual', s, t)\n        assert s.indices(15) == t.indices(15), ('assertEqual', s.indices(15), t.indices(15))\n        assert id(s) != id(t), ('assertNotEqual', id(s), id(t))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SliceTest.test_copy" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nimport copy\n\ndef evaluate_slice_index(arg):\n    \"\"\"\n    Helper function to convert a slice argument to an integer, and raise\n    TypeError with a suitable message on failure.\n\n    \"\"\"\n    if hasattr(arg, '__index__'):\n        return operator.index(arg)\n    else:\n        raise TypeError('slice indices must be integers or None or have an __index__ method')\n\ndef slice_indices(slice, length):\n    \"\"\"\n    Reference implementation for the slice.indices method.\n\n    \"\"\"\n    length = operator.index(length)\n    step = 1 if slice.step is None else evaluate_slice_index(slice.step)\n    if length < 0:\n        raise ValueError('length should not be negative')\n    if step == 0:\n        raise ValueError('slice step cannot be zero')\n    lower = -1 if step < 0 else 0\n    upper = length - 1 if step < 0 else length\n    if slice.start is None:\n        start = upper if step < 0 else lower\n    else:\n        start = evaluate_slice_index(slice.start)\n        start = max(start + length, lower) if start < 0 else min(start, upper)\n    if slice.stop is None:\n        stop = lower if step < 0 else upper\n    else:\n        stop = evaluate_slice_index(slice.stop)\n        stop = max(stop + length, lower) if stop < 0 else min(stop, upper)\n    return (start, stop, step)\n\ndef _t():\n    s = slice(1, 10)\n    c = copy.copy(s)\n    assert s is c, ('assertIs', s, c)\n    s = slice(1, 10, 2)\n    c = copy.copy(s)\n    assert s is c, ('assertIs', s, c)\n    s = slice([1, 2], [3, 4], [5, 6])\n    c = copy.copy(s)\n    assert s is c, ('assertIs', s, c)\n    assert s.start is c.start, ('assertIs', s.start, c.start)\n    assert s.stop is c.stop, ('assertIs', s.stop, c.stop)\n    assert s.step is c.step, ('assertIs', s.step, c.step)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SliceTest.test_deepcopy" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nimport copy\n\ndef evaluate_slice_index(arg):\n    \"\"\"\n    Helper function to convert a slice argument to an integer, and raise\n    TypeError with a suitable message on failure.\n\n    \"\"\"\n    if hasattr(arg, '__index__'):\n        return operator.index(arg)\n    else:\n        raise TypeError('slice indices must be integers or None or have an __index__ method')\n\ndef slice_indices(slice, length):\n    \"\"\"\n    Reference implementation for the slice.indices method.\n\n    \"\"\"\n    length = operator.index(length)\n    step = 1 if slice.step is None else evaluate_slice_index(slice.step)\n    if length < 0:\n        raise ValueError('length should not be negative')\n    if step == 0:\n        raise ValueError('slice step cannot be zero')\n    lower = -1 if step < 0 else 0\n    upper = length - 1 if step < 0 else length\n    if slice.start is None:\n        start = upper if step < 0 else lower\n    else:\n        start = evaluate_slice_index(slice.start)\n        start = max(start + length, lower) if start < 0 else min(start, upper)\n    if slice.stop is None:\n        stop = lower if step < 0 else upper\n    else:\n        stop = evaluate_slice_index(slice.stop)\n        stop = max(stop + length, lower) if stop < 0 else min(stop, upper)\n    return (start, stop, step)\n\ndef _t():\n    s = slice(1, 10)\n    c = copy.deepcopy(s)\n    assert s == c, ('assertEqual', s, c)\n    s = slice(1, 10, 2)\n    c = copy.deepcopy(s)\n    assert s == c, ('assertEqual', s, c)\n    s = slice([1, 2], [3, 4], [5, 6])\n    c = copy.deepcopy(s)\n    assert s is not c, ('assertIsNot', s, c)\n    assert s == c, ('assertEqual', s, c)\n    assert s.start is not c.start, ('assertIsNot', s.start, c.start)\n    assert s.stop is not c.stop, ('assertIsNot', s.stop, c.stop)\n    assert s.step is not c.step, ('assertIsNot', s.step, c.step)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SliceTest.test_cycle" {
    (ok, detail) = p2_libtest_run_snippet("import operator\nimport weakref\nfrom test import support\n\ndef evaluate_slice_index(arg):\n    \"\"\"\n    Helper function to convert a slice argument to an integer, and raise\n    TypeError with a suitable message on failure.\n\n    \"\"\"\n    if hasattr(arg, '__index__'):\n        return operator.index(arg)\n    else:\n        raise TypeError('slice indices must be integers or None or have an __index__ method')\n\ndef slice_indices(slice, length):\n    \"\"\"\n    Reference implementation for the slice.indices method.\n\n    \"\"\"\n    length = operator.index(length)\n    step = 1 if slice.step is None else evaluate_slice_index(slice.step)\n    if length < 0:\n        raise ValueError('length should not be negative')\n    if step == 0:\n        raise ValueError('slice step cannot be zero')\n    lower = -1 if step < 0 else 0\n    upper = length - 1 if step < 0 else length\n    if slice.start is None:\n        start = upper if step < 0 else lower\n    else:\n        start = evaluate_slice_index(slice.start)\n        start = max(start + length, lower) if start < 0 else min(start, upper)\n    if slice.stop is None:\n        stop = lower if step < 0 else upper\n    else:\n        stop = evaluate_slice_index(slice.stop)\n        stop = max(stop + length, lower) if stop < 0 else min(stop, upper)\n    return (start, stop, step)\n\ndef _t():\n\n    class myobj:\n        pass\n    o = myobj()\n    o.s = slice(o)\n    w = weakref.ref(o)\n    o = None\n    support.gc_collect()\n    assert w() is None, ('assertIsNone', w())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
