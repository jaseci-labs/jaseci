test "FormatTest.test_negative_zero" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    assert f'{-0.0:.1f}' == '-0.0', ('assertEqual', f'{-0.0:.1f}', '-0.0')\n    assert f'{-0.01:.1f}' == '-0.0', ('assertEqual', f'{-0.01:.1f}', '-0.0')\n    assert f'{-0:.1f}' == '0.0', ('assertEqual', f'{-0:.1f}', '0.0')\n    assert f'{0.0:z.1f}' == '0.0', ('assertEqual', f'{0.0:z.1f}', '0.0')\n    assert f'{0.0:z6.1f}' == '   0.0', ('assertEqual', f'{0.0:z6.1f}', '   0.0')\n    assert f'{-1.0:z6.1f}' == '  -1.0', ('assertEqual', f'{-1.0:z6.1f}', '  -1.0')\n    assert f'{-0.0:z.1f}' == '0.0', ('assertEqual', f'{-0.0:z.1f}', '0.0')\n    assert f'{0.01:z.1f}' == '0.0', ('assertEqual', f'{0.01:z.1f}', '0.0')\n    assert f'{-0:z.1f}' == '0.0', ('assertEqual', f'{-0:z.1f}', '0.0')\n    assert f'{-0.01:z.1f}' == '0.0', ('assertEqual', f'{-0.01:z.1f}', '0.0')\n    assert f'{0.0:z.2f}' == '0.00', ('assertEqual', f'{0.0:z.2f}', '0.00')\n    assert f'{-0.0:z.2f}' == '0.00', ('assertEqual', f'{-0.0:z.2f}', '0.00')\n    assert f'{0.001:z.2f}' == '0.00', ('assertEqual', f'{0.001:z.2f}', '0.00')\n    assert f'{-0.001:z.2f}' == '0.00', ('assertEqual', f'{-0.001:z.2f}', '0.00')\n    assert f'{0.0:z.1e}' == '0.0e+00', ('assertEqual', f'{0.0:z.1e}', '0.0e+00')\n    assert f'{-0.0:z.1e}' == '0.0e+00', ('assertEqual', f'{-0.0:z.1e}', '0.0e+00')\n    assert f'{0.0:z.1E}' == '0.0E+00', ('assertEqual', f'{0.0:z.1E}', '0.0E+00')\n    assert f'{-0.0:z.1E}' == '0.0E+00', ('assertEqual', f'{-0.0:z.1E}', '0.0E+00')\n    assert f'{-0.001:z.2e}' == '-1.00e-03', ('assertEqual', f'{-0.001:z.2e}', '-1.00e-03')\n    assert f'{-0.001:z.2g}' == '-0.001', ('assertEqual', f'{-0.001:z.2g}', '-0.001')\n    assert f'{-0.001:z.2%}' == '-0.10%', ('assertEqual', f'{-0.001:z.2%}', '-0.10%')\n    assert f'{-1e-06:z.1f}' == '0.0', ('assertEqual', f'{-1e-06:z.1f}', '0.0')\n    assert f'{-0.0:z.1f}' == '0.0', ('assertEqual', f'{-0.0:z.1f}', '0.0')\n    assert f'{-0.0:z.1f}' == '0.0', ('assertEqual', f'{-0.0:z.1f}', '0.0')\n    assert f'{-1e-06:z.2f}' == '0.00', ('assertEqual', f'{-1e-06:z.2f}', '0.00')\n    assert f'{-0.0:z.2f}' == '0.00', ('assertEqual', f'{-0.0:z.2f}', '0.00')\n    assert f'{-0.0:z.2f}' == '0.00', ('assertEqual', f'{-0.0:z.2f}', '0.00')\n    assert f'{0.09:z.1f}' == '0.1', ('assertEqual', f'{0.09:z.1f}', '0.1')\n    assert f'{-0.09:z.1f}' == '-0.1', ('assertEqual', f'{-0.09:z.1f}', '-0.1')\n    assert f'{-0.0: z.0f}' == ' 0', ('assertEqual', f'{-0.0: z.0f}', ' 0')\n    assert f'{-0.0:+z.0f}' == '+0', ('assertEqual', f'{-0.0:+z.0f}', '+0')\n    assert f'{-0.0:-z.0f}' == '0', ('assertEqual', f'{-0.0:-z.0f}', '0')\n    assert f'{-1.0: z.0f}' == '-1', ('assertEqual', f'{-1.0: z.0f}', '-1')\n    assert f'{-1.0:+z.0f}' == '-1', ('assertEqual', f'{-1.0:+z.0f}', '-1')\n    assert f'{-1.0:-z.0f}' == '-1', ('assertEqual', f'{-1.0:-z.0f}', '-1')\n    assert f'{0j:z.1f}' == '0.0+0.0j', ('assertEqual', f'{0j:z.1f}', '0.0+0.0j')\n    assert f'{-0j:z.1f}' == '0.0+0.0j', ('assertEqual', f'{-0j:z.1f}', '0.0+0.0j')\n    assert f'{0.01j:z.1f}' == '0.0+0.0j', ('assertEqual', f'{0.01j:z.1f}', '0.0+0.0j')\n    assert f'{-0.01j:z.1f}' == '0.0+0.0j', ('assertEqual', f'{-0.01j:z.1f}', '0.0+0.0j')\n    assert f'{-0.0:z>6.1f}' == 'zz-0.0', ('assertEqual', f'{-0.0:z>6.1f}', 'zz-0.0')\n    assert f'{-0.0:z>z6.1f}' == 'zzz0.0', ('assertEqual', f'{-0.0:z>z6.1f}', 'zzz0.0')\n    assert f'{-0.0:x>z6.1f}' == 'xxx0.0', ('assertEqual', f'{-0.0:x>z6.1f}', 'xxx0.0')\n    assert f'{-0.0:\ud83d\udda4>z6.1f}' == '\ud83d\udda4\ud83d\udda4\ud83d\udda40.0', ('assertEqual', f'{-0.0:\ud83d\udda4>z6.1f}', '\ud83d\udda4\ud83d\udda4\ud83d\udda40.0')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "FormatTest.test_specifier_z_error" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport re\n\ndef _t():\n    error_msg = re.compile(\"Invalid format specifier '.*z.*'\")\n    try:\n        f'{0:z+f}'\n    except ValueError as _exc:\n        assert _re.search(error_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        f'{0:fz}'\n    except ValueError as _exc:\n        assert _re.search(error_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    error_msg = re.escape('Negative zero coercion (z) not allowed')\n    try:\n        f'{0:zd}'\n    except ValueError as _exc:\n        assert _re.search(error_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        f\"{'x':zs}\"\n    except ValueError as _exc:\n        assert _re.search(error_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    error_msg = re.escape(\"unsupported format character 'z'\")\n    try:\n        '%z.1f' % 0\n    except ValueError as _exc:\n        assert _re.search(error_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        b'%z.1f' % 0\n    except ValueError as _exc:\n        assert _re.search(error_msg, str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
