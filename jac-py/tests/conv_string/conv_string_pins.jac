test "ModuleTest.test_override_get_value" {
    (ok, detail) = p2_libtest_run_snippet("import string\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class NamespaceFormatter(string.Formatter):\n\n        def __init__(self, namespace={}):\n            string.Formatter.__init__(self)\n            self.namespace = namespace\n\n        def get_value(self, key, args, kwds):\n            if isinstance(key, str):\n                try:\n                    return kwds[key]\n                except KeyError:\n                    return self.namespace[key]\n            else:\n                string.Formatter.get_value(key, args, kwds)\n    fmt = NamespaceFormatter({'greeting': 'hello'})\n    assert fmt.format('{greeting}, world!') == 'hello, world!', ('assertEqual', fmt.format('{greeting}, world!'), 'hello, world!')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
