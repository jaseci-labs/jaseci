}

test "TestTemplate.test_braced_override_safe" {
    (ok, detail) = p2_libtest_run_snippet("from string import Template\n\ndef _t():\n\n    class MyTemplate(Template):\n        pattern = '\\n            \\\\$(?:\\n              (?P<escaped>$)                     |\\n              (?P<named>[_a-z][_a-z0-9]*)        |\\n              @@(?P<braced>[_a-z][_a-z0-9]*)@@   |\\n              (?P<invalid>)                      |\\n           )\\n           '\n    tmpl = 'PyCon in $@@location@@'\n    t = MyTemplate(tmpl)\n    assert t.safe_substitute() == tmpl, ('assertEqual', t.safe_substitute(), tmpl)\n    val = t.safe_substitute({'location': 'Cleveland'})\n    assert val == 'PyCon in Cleveland', ('assertEqual', val, 'PyCon in Cleveland')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestTemplate.test_unicode_values" {
    (ok, detail) = p2_libtest_run_snippet("from string import Template\n\ndef _t():\n    s = Template('$who likes $what')\n    d = dict(who='t\u00ffm', what='f\u00fe\\x0ced')\n    assert s.substitute(d) == 't\u00ffm likes f\u00fe\\x0ced', ('assertEqual', s.substitute(d), 't\u00ffm likes f\u00fe\\x0ced')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
