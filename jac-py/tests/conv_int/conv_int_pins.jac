test "IntTestCases.test_underscores" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.numbers import VALID_UNDERSCORE_LITERALS, INVALID_UNDERSCORE_LITERALS\n\ndef _t():\n    for lit in VALID_UNDERSCORE_LITERALS:\n        if any((ch in lit for ch in '.eEjJ')):\n            continue\n        assert int(lit, 0) == eval(lit), ('assertEqual', int(lit, 0), eval(lit))\n        assert int(lit, 0) == int(lit.replace('_', ''), 0), ('assertEqual', int(lit, 0), int(lit.replace('_', ''), 0))\n    for lit in INVALID_UNDERSCORE_LITERALS:\n        if any((ch in lit for ch in '.eEjJ')):\n            continue\n        try:\n            int(*(lit, 0))\n        except ValueError:\n            pass\n    assert int('1_00', 3) == 9, ('assertEqual', int('1_00', 3), 9)\n    assert int('0_100') == 100, ('assertEqual', int('0_100'), 100)\n    assert int(b'1_00') == 100, ('assertEqual', int(b'1_00'), 100)\n    try:\n        int(*('_100',))\n    except ValueError:\n        pass\n    try:\n        int(*('+_100',))\n    except ValueError:\n        pass\n    try:\n        int(*('1__00',))\n    except ValueError:\n        pass\n    try:\n        int(*('100_',))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

