test "IntTestCases.test_intconversion" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class ClassicMissingMethods:\n        pass\n    try:\n        int(*(ClassicMissingMethods(),))\n    except TypeError:\n        pass\n\n    class MissingMethods(object):\n        pass\n    try:\n        int(*(MissingMethods(),))\n    except TypeError:\n        pass\n\n    class Foo0:\n\n        def __int__(self):\n            return 42\n    assert int(Foo0()) == 42, ('assertEqual', int(Foo0()), 42)\n\n    class Classic:\n        pass\n    for base in (object, Classic):\n\n        class IntOverridesTrunc(base):\n\n            def __int__(self):\n                return 42\n\n            def __trunc__(self):\n                return -12\n        assert int(IntOverridesTrunc()) == 42, ('assertEqual', int(IntOverridesTrunc()), 42)\n\n        class JustTrunc(base):\n\n            def __trunc__(self):\n                return 42\n        try:\n            int(JustTrunc())\n        except TypeError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IntTestCases.test_int_subclass_with_index" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class MyIndex(int):\n\n        def __index__(self):\n            return 42\n\n    class BadIndex(int):\n\n        def __index__(self):\n            return 42.0\n    my_int = MyIndex(7)\n    assert my_int == 7, ('assertEqual', my_int, 7)\n    assert int(my_int) == 7, ('assertEqual', int(my_int), 7)\n    assert int(BadIndex()) == 0, ('assertEqual', int(BadIndex()), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IntTestCases.test_int_subclass_with_int" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class MyInt(int):\n\n        def __int__(self):\n            return 42\n\n    class BadInt(int):\n\n        def __int__(self):\n            return 42.0\n    my_int = MyInt(7)\n    assert my_int == 7, ('assertEqual', my_int, 7)\n    assert int(my_int) == 42, ('assertEqual', int(my_int), 42)\n    my_int = BadInt(7)\n    assert my_int == 7, ('assertEqual', my_int, 7)\n    try:\n        int(*(my_int,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

