test "IntTestCases.test_keyword_args" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n    assert int('100', base=2) == 4, ('assertEqual', int('100', base=2), 4)\n    try:\n        int(x=1.2)\n    except TypeError as _exc:\n        assert _re.search('keyword argument', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        int(x='100', base=2)\n    except TypeError as _exc:\n        assert _re.search('keyword argument', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        int(base=10)\n    except TypeError:\n        pass\n    try:\n        int(base=0)\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "IntTestCases.test_int_base_limits" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    \"\"\"Testing the supported limits of the int() base parameter.\"\"\"\n    assert int('0', 5) == 0, ('assertEqual', int('0', 5), 0)\n    try:\n        int('0', 1)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        int('0', 37)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        int('0', -909)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        int('0', base=0 - 2 ** 234)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        int('0', base=2 ** 234)\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    for base in range(2, 37):\n        assert int('0', base=base) == 0, ('assertEqual', int('0', base=base), 0)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

