}

test "TestContext.test_3611" {
    (ok, detail) = p2_libtest_run_snippet("from test import support\n\ndef get_tb():\n    try:\n        raise OSError()\n    except OSError as e:\n        return e.__traceback__\n\ndef _t():\n    import gc\n\n    class C:\n\n        def __del__(self):\n            try:\n                1 / 0\n            except ZeroDivisionError:\n                raise\n\n    def f():\n        x = C()\n        try:\n            try:\n                f.x\n            except AttributeError:\n                del x\n                gc.collect()\n                raise TypeError\n        except Exception as e:\n            assert e.__context__ != None, ('assertNotEqual', e.__context__, None)\n            assert isinstance(e.__context__, AttributeError), ('assertIsInstance', e.__context__, AttributeError)\n    with support.catch_unraisable_exception() as cm:\n        f()\n        assert ZeroDivisionError == cm.unraisable.exc_type, ('assertEqual', ZeroDivisionError, cm.unraisable.exc_type)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestRemovedFunctionality.test_tuples" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    try:\n        raise (IndexError, KeyError)\n    except TypeError:\n        pass\n    else:\n        raise AssertionError('No exception raised')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

