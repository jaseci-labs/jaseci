test "TestTracebackType.test_attrs" {
    (ok, detail) = p2_libtest_run_snippet("import sys\nimport types\n\ndef get_tb():\n    try:\n        raise OSError()\n    except OSError as e:\n        return e.__traceback__\n\ndef raiser():\n    raise ValueError\n\ndef _t():\n    try:\n        raiser()\n    except Exception as exc:\n        tb = exc.__traceback__\n    assert isinstance(tb.tb_next, types.TracebackType), ('assertIsInstance', tb.tb_next, types.TracebackType)\n    assert tb.tb_frame is sys._getframe(), ('assertIs', tb.tb_frame, sys._getframe())\n    assert isinstance(tb.tb_lasti, int), ('assertIsInstance', tb.tb_lasti, int)\n    assert isinstance(tb.tb_lineno, int), ('assertIsInstance', tb.tb_lineno, int)\n    assert tb.tb_next.tb_next is None, ('assertIs', tb.tb_next.tb_next, None)\n    try:\n        del tb.tb_next\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        tb.tb_next = 'asdf'\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        tb.tb_next = tb\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        tb.tb_next.tb_next = tb\n    except ValueError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    tb.tb_next = None\n    assert tb.tb_next is None, ('assertIs', tb.tb_next, None)\n    new_tb = get_tb()\n    tb.tb_next = new_tb\n    assert tb.tb_next is new_tb, ('assertIs', tb.tb_next, new_tb)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestTracebackType.test_constructor" {
    (ok, detail) = p2_libtest_run_snippet("import sys\nimport types\n\ndef get_tb():\n    try:\n        raise OSError()\n    except OSError as e:\n        return e.__traceback__\n\ndef _t():\n    other_tb = get_tb()\n    frame = sys._getframe()\n    tb = types.TracebackType(other_tb, frame, 1, 2)\n    assert tb.tb_next == other_tb, ('assertEqual', tb.tb_next, other_tb)\n    assert tb.tb_frame == frame, ('assertEqual', tb.tb_frame, frame)\n    assert tb.tb_lasti == 1, ('assertEqual', tb.tb_lasti, 1)\n    assert tb.tb_lineno == 2, ('assertEqual', tb.tb_lineno, 2)\n    tb = types.TracebackType(None, frame, 1, 2)\n    assert tb.tb_next == None, ('assertEqual', tb.tb_next, None)\n    try:\n        types.TracebackType('no', frame, 1, 2)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        types.TracebackType(other_tb, 'no', 1, 2)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        types.TracebackType(other_tb, frame, 'no', 2)\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        types.TracebackType(other_tb, frame, 1, 'nuh-uh')\n    except TypeError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

