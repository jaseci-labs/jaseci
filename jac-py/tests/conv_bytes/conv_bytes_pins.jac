test "BytearrayPEP3137Test.test_returns_new_copy" {
    (ok, detail) = p2_libtest_run_snippet("def marshal(x):\n    return bytearray(x)\n\ndef _t():\n    val = marshal(b'1234')\n    for methname in ('zfill', 'rjust', 'ljust', 'center'):\n        method = getattr(val, methname)\n        newval = method(3)\n        assert val == newval, ('assertEqual', val, newval)\n        assert val is not newval, ('assertIsNot', val, newval)\n    for expr in ('val.split()[0]', 'val.rsplit()[0]', 'val.partition(b\".\")[0]', 'val.rpartition(b\".\")[2]', 'val.splitlines()[0]', 'val.replace(b\"\", b\"\")'):\n        newval = eval(expr)\n        assert val == newval, ('assertEqual', val, newval)\n        assert val is not newval, ('assertIsNot', val, newval)\n    sep = marshal(b'')\n    newval = sep.join([val])\n    assert val == newval, ('assertEqual', val, newval)\n    assert val is not newval, ('assertIsNot', val, newval)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArraySubclassTest.test_fromhex" {
    (ok, detail) = p2_libtest_run_snippet("class ByteArraySubclass(bytearray):\n\n    class Nested(bytearray):\n        pass\n\n    class \u016c\u00f1\u0131\u00e7\u00f6\u0111\u00eb(bytearray):\n        pass\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.basetype = bytearray\n    self.type2test = ByteArraySubclass\n    b = self.type2test.fromhex('1a2B30')\n    assert b == b'\\x1a+0', ('assertEqual', b, b'\\x1a+0')\n    assert type(b) is self.type2test, ('assertIs', type(b), self.type2test)\n\n    class B1(self.basetype):\n\n        def __new__(cls, value):\n            me = self.basetype.__new__(cls, value)\n            me.foo = 'bar'\n            return me\n    b = B1.fromhex('1a2B30')\n    assert b == b'\\x1a+0', ('assertEqual', b, b'\\x1a+0')\n    assert type(b) is B1, ('assertIs', type(b), B1)\n    assert b.foo == 'bar', ('assertEqual', b.foo, 'bar')\n\n    class B2(self.basetype):\n\n        def __init__(me, *args, **kwargs):\n            if self.basetype is not bytes:\n                self.basetype.__init__(me, *args, **kwargs)\n            me.foo = 'bar'\n    b = B2.fromhex('1a2B30')\n    assert b == b'\\x1a+0', ('assertEqual', b, b'\\x1a+0')\n    assert type(b) is B2, ('assertIs', type(b), B2)\n    assert b.foo == 'bar', ('assertEqual', b.foo, 'bar')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

