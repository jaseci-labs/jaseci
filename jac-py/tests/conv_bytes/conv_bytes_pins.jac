test "ByteArrayTest.test_partition_bytearray_doesnt_share_nullstring" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    a, b, c = bytearray(b'x').partition(b'y')\n    assert b == b'', ('assertEqual', b, b'')\n    assert c == b'', ('assertEqual', c, b'')\n    assert b is not c, ('assertIsNot', b, c)\n    b += b'!'\n    assert c == b'', ('assertEqual', c, b'')\n    a, b, c = bytearray(b'x').partition(b'y')\n    assert b == b'', ('assertEqual', b, b'')\n    assert c == b'', ('assertEqual', c, b'')\n    b, c, a = bytearray(b'x').rpartition(b'y')\n    assert b == b'', ('assertEqual', b, b'')\n    assert c == b'', ('assertEqual', c, b'')\n    assert b is not c, ('assertIsNot', b, c)\n    b += b'!'\n    assert c == b'', ('assertEqual', c, b'')\n    c, b, a = bytearray(b'x').rpartition(b'y')\n    assert b == b'', ('assertEqual', b, b'')\n    assert c == b'', ('assertEqual', c, b'')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArrayTest.test_resize_forbidden" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    b = bytearray(10)\n    v = memoryview(b)\n\n    def manual_resize(n):\n        b[1:-1] = range(n + 1, 2 * n - 1)\n    b.resize(10)\n    orig = b[:]\n    try:\n        b.resize(*(11,))\n    except BufferError:\n        pass\n    try:\n        manual_resize(*(11,))\n    except BufferError:\n        pass\n    assert b == orig, ('assertEqual', b, orig)\n    try:\n        b.resize(*(9,))\n    except BufferError:\n        pass\n    assert b == orig, ('assertEqual', b, orig)\n    try:\n        b.resize(*(0,))\n    except BufferError:\n        pass\n    assert b == orig, ('assertEqual', b, orig)\n    try:\n        b.pop(*(0,))\n    except BufferError:\n        pass\n    assert b == orig, ('assertEqual', b, orig)\n    try:\n        b.remove(*(b[1],))\n    except BufferError:\n        pass\n    assert b == orig, ('assertEqual', b, orig)\n\n    def delitem():\n        del b[1]\n    try:\n        delitem()\n    except BufferError:\n        pass\n    assert b == orig, ('assertEqual', b, orig)\n\n    def delslice():\n        b[1:-1:2] = b''\n    try:\n        delslice()\n    except BufferError:\n        pass\n    assert b == orig, ('assertEqual', b, orig)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArrayTest.test_iterator_pickling2" {
    (ok, detail) = p2_libtest_run_snippet("import pickle\n\ndef _t():\n    orig = bytearray(b'abc')\n    data = list(b'qwerty')\n    for proto in range(pickle.HIGHEST_PROTOCOL + 1):\n        itorig = iter(orig)\n        d = pickle.dumps((itorig, orig), proto)\n        it, b = pickle.loads(d)\n        b[:] = data\n        assert type(it) == type(itorig), ('assertEqual', type(it), type(itorig))\n        assert list(it) == data, ('assertEqual', list(it), data)\n        next(itorig)\n        d = pickle.dumps((itorig, orig), proto)\n        it, b = pickle.loads(d)\n        b[:] = data\n        assert type(it) == type(itorig), ('assertEqual', type(it), type(itorig))\n        assert list(it) == data[1:], ('assertEqual', list(it), data[1:])\n        for i in range(1, len(orig)):\n            next(itorig)\n        d = pickle.dumps((itorig, orig), proto)\n        it, b = pickle.loads(d)\n        b[:] = data\n        assert type(it) == type(itorig), ('assertEqual', type(it), type(itorig))\n        assert list(it) == data[len(orig):], ('assertEqual', list(it), data[len(orig):])\n        try:\n            next(*(itorig,))\n        except StopIteration:\n            pass\n        d = pickle.dumps((itorig, orig), proto)\n        it, b = pickle.loads(d)\n        b[:] = data\n        assert list(it) == [], ('assertEqual', list(it), [])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

