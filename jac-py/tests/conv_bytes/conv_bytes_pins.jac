test "ByteArrayTest.test_resize" {
    (ok, detail) = p2_libtest_run_snippet("import sys\n\nclass ByteArraySubclass(bytearray):\n\n    class Nested(bytearray):\n        pass\n\n    class \u016c\u00f1\u0131\u00e7\u00f6\u0111\u00eb(bytearray):\n        pass\n\ndef _t():\n    ba = bytearray(b'abcdef')\n    assert ba.resize(3) is None, ('assertIsNone', ba.resize(3))\n    assert ba == bytearray(b'abc'), ('assertEqual', ba, bytearray(b'abc'))\n    assert ba.resize(10) is None, ('assertIsNone', ba.resize(10))\n    assert len(ba) == 10, ('assertEqual', len(ba), 10)\n    assert ba == bytearray(b'abc\\x00\\x00\\x00\\x00\\x00\\x00\\x00'), ('assertEqual', ba, bytearray(b'abc\\x00\\x00\\x00\\x00\\x00\\x00\\x00'))\n    ba[3:10] = b'defghij'\n    assert ba == bytearray(b'abcdefghij'), ('assertEqual', ba, bytearray(b'abcdefghij'))\n    assert ba.resize(2 ** 20) is None, ('assertIsNone', ba.resize(2 ** 20))\n    assert len(ba) == 2 ** 20, ('assertEqual', len(ba), 2 ** 20)\n    assert ba == bytearray(b'abcdefghij' + b'\\x00' * (2 ** 20 - 10)), ('assertEqual', ba, bytearray(b'abcdefghij' + b'\\x00' * (2 ** 20 - 10)))\n    assert ba.resize(0) is None, ('assertIsNone', ba.resize(0))\n    assert ba == bytearray(), ('assertEqual', ba, bytearray())\n    assert ba.resize(10) is None, ('assertIsNone', ba.resize(10))\n    assert ba == bytearray(b'\\x00' * 10), ('assertEqual', ba, bytearray(b'\\x00' * 10))\n    ba = ByteArraySubclass(b'abcdef')\n    assert ba.resize(3) is None, ('assertIsNone', ba.resize(3))\n    assert ba == bytearray(b'abc'), ('assertEqual', ba, bytearray(b'abc'))\n    try:\n        bytearray().resize()\n    except TypeError:\n        pass\n    try:\n        bytearray().resize(*((10, 10),))\n    except TypeError:\n        pass\n    try:\n        bytearray().resize(*(-1,))\n    except ValueError:\n        pass\n    try:\n        bytearray().resize(*(-200,))\n    except ValueError:\n        pass\n    try:\n        bytearray().resize(*(sys.maxsize,))\n    except MemoryError:\n        pass\n    try:\n        bytearray(1000).resize(*(sys.maxsize,))\n    except MemoryError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArrayTest.test_setslice" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    b = bytearray(range(10))\n    assert list(b) == list(range(10)), ('assertEqual', list(b), list(range(10)))\n    b[0:5] = bytearray([1, 1, 1, 1, 1])\n    assert b == bytearray([1, 1, 1, 1, 1, 5, 6, 7, 8, 9]), ('assertEqual', b, bytearray([1, 1, 1, 1, 1, 5, 6, 7, 8, 9]))\n    del b[0:-5]\n    assert b == bytearray([5, 6, 7, 8, 9]), ('assertEqual', b, bytearray([5, 6, 7, 8, 9]))\n    b[0:0] = bytearray([0, 1, 2, 3, 4])\n    assert b == bytearray(range(10)), ('assertEqual', b, bytearray(range(10)))\n    b[-7:-3] = bytearray([100, 101])\n    assert b == bytearray([0, 1, 2, 100, 101, 7, 8, 9]), ('assertEqual', b, bytearray([0, 1, 2, 100, 101, 7, 8, 9]))\n    b[3:5] = [3, 4, 5, 6]\n    assert b == bytearray(range(10)), ('assertEqual', b, bytearray(range(10)))\n    b[3:0] = [42, 42, 42]\n    assert b == bytearray([0, 1, 2, 42, 42, 42, 3, 4, 5, 6, 7, 8, 9]), ('assertEqual', b, bytearray([0, 1, 2, 42, 42, 42, 3, 4, 5, 6, 7, 8, 9]))\n    b[3:] = b'foo'\n    assert b == bytearray([0, 1, 2, 102, 111, 111]), ('assertEqual', b, bytearray([0, 1, 2, 102, 111, 111]))\n    b[:3] = memoryview(b'foo')\n    assert b == bytearray([102, 111, 111, 102, 111, 111]), ('assertEqual', b, bytearray([102, 111, 111, 102, 111, 111]))\n    b[3:4] = []\n    assert b == bytearray([102, 111, 111, 111, 111]), ('assertEqual', b, bytearray([102, 111, 111, 111, 111]))\n    for elem in [5, -5, 0, int(1e+21), 'str', 2.3, ['a', 'b'], [b'a', b'b'], [[]]]:\n        try:\n            b[3:4] = elem\n        except TypeError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n    for elem in [[254, 255, 256], [-256, 9000]]:\n        try:\n            b[3:4] = elem\n        except ValueError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

