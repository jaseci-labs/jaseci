test "ByteArrayTest.test_bytearray_api" {
    (ok, detail) = p2_libtest_run_snippet("import os\nimport tempfile\n\ndef _t():\n    short_sample = b'Hello world\\n'\n    sample = short_sample + b'\\x00' * (20 - len(short_sample))\n    tfn = tempfile.mktemp()\n    try:\n        with open(tfn, 'wb') as f:\n            f.write(short_sample)\n        with open(tfn, 'rb') as f:\n            b = bytearray(20)\n            n = f.readinto(b)\n        assert n == len(short_sample), ('assertEqual', n, len(short_sample))\n        assert list(b) == list(sample), ('assertEqual', list(b), list(sample))\n        with open(tfn, 'wb') as f:\n            f.write(b)\n        with open(tfn, 'rb') as f:\n            assert f.read() == sample, ('assertEqual', f.read(), sample)\n    finally:\n        try:\n            os.remove(tfn)\n        except OSError:\n            pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

