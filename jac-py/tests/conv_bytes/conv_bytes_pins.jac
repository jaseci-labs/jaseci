test "ByteArrayTest.test_extend_empty_buffer_overflow" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class EvilIter:\n\n        def __iter__(self):\n            return self\n\n        def __next__(self):\n            return next(source)\n\n        def __length_hint__(self):\n            return 0\n    source = iter(b'42')\n    ba = bytearray()\n    ba.extend(EvilIter())\n    try:\n        float(*(bytearray(),))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArrayTest.test_hex_use_after_free" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    ba = bytearray(b'\\xaa')\n\n    class S(bytes):\n\n        def __len__(self):\n            ba.clear()\n            return 1\n    try:\n        ba.hex(*(S(b':'),))\n    except BufferError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "AssortedBytesTest.test_format" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport re\n\ndef _t():\n    for b in (b'abc', bytearray(b'abc')):\n        assert format(b) == str(b), ('assertEqual', format(b), str(b))\n        assert format(b, '') == str(b), ('assertEqual', format(b, ''), str(b))\n        try:\n            format(b, 's')\n        except TypeError as _exc:\n            assert _re.search('\\\\b%s\\\\b' % re.escape(type(b).__name__), str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "AssortedBytesTest.test_compare_bytes_to_bytearray" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    assert (b'abc' == bytes(b'abc')) == True, ('assertEqual', (b'abc' == bytes(b'abc')), True)\n    assert (b'ab' != bytes(b'abc')) == True, ('assertEqual', (b'ab' != bytes(b'abc')), True)\n    assert (b'ab' <= bytes(b'abc')) == True, ('assertEqual', (b'ab' <= bytes(b'abc')), True)\n    assert (b'ab' < bytes(b'abc')) == True, ('assertEqual', (b'ab' < bytes(b'abc')), True)\n    assert (b'abc' >= bytes(b'ab')) == True, ('assertEqual', (b'abc' >= bytes(b'ab')), True)\n    assert (b'abc' > bytes(b'ab')) == True, ('assertEqual', (b'abc' > bytes(b'ab')), True)\n    assert (b'abc' != bytes(b'abc')) == False, ('assertEqual', (b'abc' != bytes(b'abc')), False)\n    assert (b'ab' == bytes(b'abc')) == False, ('assertEqual', (b'ab' == bytes(b'abc')), False)\n    assert (b'ab' > bytes(b'abc')) == False, ('assertEqual', (b'ab' > bytes(b'abc')), False)\n    assert (b'ab' >= bytes(b'abc')) == False, ('assertEqual', (b'ab' >= bytes(b'abc')), False)\n    assert (b'abc' < bytes(b'ab')) == False, ('assertEqual', (b'abc' < bytes(b'ab')), False)\n    assert (b'abc' <= bytes(b'ab')) == False, ('assertEqual', (b'abc' <= bytes(b'ab')), False)\n    assert (bytes(b'abc') == b'abc') == True, ('assertEqual', (bytes(b'abc') == b'abc'), True)\n    assert (bytes(b'ab') != b'abc') == True, ('assertEqual', (bytes(b'ab') != b'abc'), True)\n    assert (bytes(b'ab') <= b'abc') == True, ('assertEqual', (bytes(b'ab') <= b'abc'), True)\n    assert (bytes(b'ab') < b'abc') == True, ('assertEqual', (bytes(b'ab') < b'abc'), True)\n    assert (bytes(b'abc') >= b'ab') == True, ('assertEqual', (bytes(b'abc') >= b'ab'), True)\n    assert (bytes(b'abc') > b'ab') == True, ('assertEqual', (bytes(b'abc') > b'ab'), True)\n    assert (bytes(b'abc') != b'abc') == False, ('assertEqual', (bytes(b'abc') != b'abc'), False)\n    assert (bytes(b'ab') == b'abc') == False, ('assertEqual', (bytes(b'ab') == b'abc'), False)\n    assert (bytes(b'ab') > b'abc') == False, ('assertEqual', (bytes(b'ab') > b'abc'), False)\n    assert (bytes(b'ab') >= b'abc') == False, ('assertEqual', (bytes(b'ab') >= b'abc'), False)\n    assert (bytes(b'abc') < b'ab') == False, ('assertEqual', (bytes(b'abc') < b'ab'), False)\n    assert (bytes(b'abc') <= b'ab') == False, ('assertEqual', (bytes(b'abc') <= b'ab'), False)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

