test "ByteArrayTest.test_alloc" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    b = bytearray()\n    alloc = b.__alloc__()\n    assert alloc >= 0, ('assertGreaterEqual', alloc, 0)\n    seq = [alloc]\n    for i in range(100):\n        b += b'x'\n        alloc = b.__alloc__()\n        assert alloc > len(b), ('assertGreater', alloc, len(b))\n        if alloc not in seq:\n            seq.append(alloc)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArrayTest.test_init_alloc" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    b = bytearray()\n\n    def g():\n        for i in range(1, 100):\n            yield i\n            a = list(b)\n            assert a == list(range(1, len(a) + 1)), ('assertEqual', a, list(range(1, len(a) + 1)))\n            assert len(b) == len(a), ('assertEqual', len(b), len(a))\n            assert len(b) <= i, ('assertLessEqual', len(b), i)\n            alloc = b.__alloc__()\n            assert alloc > len(b), ('assertGreater', alloc, len(b))\n    b.__init__(g())\n    assert list(b) == list(range(1, 100)), ('assertEqual', list(b), list(range(1, 100)))\n    assert len(b) == 99, ('assertEqual', len(b), 99)\n    alloc = b.__alloc__()\n    assert alloc > len(b), ('assertGreater', alloc, len(b))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArrayTest.test_extend" {
    (ok, detail) = p2_libtest_run_snippet("class Indexable:\n\n    def __init__(self, value=0):\n        self.value = value\n\n    def __index__(self):\n        return self.value\n\ndef _t():\n    orig = b'hello'\n    a = bytearray(orig)\n    a.extend(a)\n    assert a == orig + orig, ('assertEqual', a, orig + orig)\n    assert a[5:] == orig, ('assertEqual', a[5:], orig)\n    a = bytearray(b'')\n    a.extend(map(int, orig * 25))\n    a.extend((int(x) for x in orig * 25))\n    assert a == orig * 50, ('assertEqual', a, orig * 50)\n    assert a[-5:] == orig, ('assertEqual', a[-5:], orig)\n    a = bytearray(b'')\n    a.extend(iter(map(int, orig * 50)))\n    assert a == orig * 50, ('assertEqual', a, orig * 50)\n    assert a[-5:] == orig, ('assertEqual', a[-5:], orig)\n    a = bytearray(b'')\n    a.extend(list(map(int, orig * 50)))\n    assert a == orig * 50, ('assertEqual', a, orig * 50)\n    assert a[-5:] == orig, ('assertEqual', a[-5:], orig)\n    a = bytearray(b'')\n    try:\n        a.extend(*([0, 1, 2, 256],))\n    except ValueError:\n        pass\n    try:\n        a.extend(*([0, 1, 2, -1],))\n    except ValueError:\n        pass\n    assert len(a) == 0, ('assertEqual', len(a), 0)\n    a = bytearray(b'')\n    a.extend([Indexable(ord('a'))])\n    assert a == b'a', ('assertEqual', a, b'a')\n    a = bytearray(b'abc')\n    try:\n        a.extend(*('def',))\n    except TypeError:\n        pass\n    try:\n        a.extend(*(1.0,))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArrayTest.test_remove" {
    (ok, detail) = p2_libtest_run_snippet("class Indexable:\n\n    def __init__(self, value=0):\n        self.value = value\n\n    def __index__(self):\n        return self.value\n\ndef _t():\n    b = bytearray(b'hello')\n    b.remove(ord('l'))\n    assert b == b'helo', ('assertEqual', b, b'helo')\n    b.remove(ord('l'))\n    assert b == b'heo', ('assertEqual', b, b'heo')\n    try:\n        (lambda: b.remove(ord('l')))()\n    except ValueError:\n        pass\n    try:\n        (lambda: b.remove(400))()\n    except ValueError:\n        pass\n    try:\n        (lambda: b.remove('e'))()\n    except TypeError:\n        pass\n    b.remove(ord('o'))\n    b.remove(ord('h'))\n    assert b == b'e', ('assertEqual', b, b'e')\n    try:\n        (lambda: b.remove(b'e'))()\n    except TypeError:\n        pass\n    b.remove(Indexable(ord('e')))\n    assert b == b'', ('assertEqual', b, b'')\n    c = bytearray([126, 127, 128, 129])\n    c.remove(127)\n    assert c == bytes([126, 128, 129]), ('assertEqual', c, bytes([126, 128, 129]))\n    c.remove(129)\n    assert c == bytes([126, 128]), ('assertEqual', c, bytes([126, 128]))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

