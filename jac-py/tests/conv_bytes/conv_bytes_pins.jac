    assert detail == "ok" , "GOT<" + detail + ">";
}

test "BytesTest.test_repeat_id_preserving" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    a = b'123abc1@'\n    b = b'456zyx-+'\n    assert id(a) == id(a), ('assertEqual', id(a), id(a))\n    assert id(a) != id(b), ('assertNotEqual', id(a), id(b))\n    assert id(a) != id(a * -4), ('assertNotEqual', id(a), id(a * -4))\n    assert id(a) != id(a * 0), ('assertNotEqual', id(a), id(a * 0))\n    assert id(a) == id(a * 1), ('assertEqual', id(a), id(a * 1))\n    assert id(a) == id(1 * a), ('assertEqual', id(a), id(1 * a))\n    assert id(a) != id(a * 2), ('assertNotEqual', id(a), id(a * 2))\n\n    class SubBytes(bytes):\n        pass\n    s = SubBytes(b'qwerty()')\n    assert id(s) == id(s), ('assertEqual', id(s), id(s))\n    assert id(s) != id(s * -4), ('assertNotEqual', id(s), id(s * -4))\n    assert id(s) != id(s * 0), ('assertNotEqual', id(s), id(s * 0))\n    assert id(s) != id(s * 1), ('assertNotEqual', id(s), id(s * 1))\n    assert id(s) != id(1 * s), ('assertNotEqual', id(s), id(1 * s))\n    assert id(s) != id(s * 2), ('assertNotEqual', id(s), id(s * 2))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

