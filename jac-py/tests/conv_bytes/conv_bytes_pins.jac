test "ByteArrayTest.test_extended_set_del_slice" {
    (ok, detail) = p2_libtest_run_snippet("import sys\n\ndef _t():\n    indices = (0, None, 1, 3, 19, 300, 1 << 333, sys.maxsize, -1, -2, -31, -300)\n    for start in indices:\n        for stop in indices:\n            for step in indices[1:]:\n                L = list(range(255))\n                b = bytearray(L)\n                data = L[start:stop:step]\n                data.reverse()\n                L[start:stop:step] = data\n                b[start:stop:step] = data\n                assert b == bytearray(L), ('assertEqual', b, bytearray(L))\n                del L[start:stop:step]\n                del b[start:stop:step]\n                assert b == bytearray(L), ('assertEqual', b, bytearray(L))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

