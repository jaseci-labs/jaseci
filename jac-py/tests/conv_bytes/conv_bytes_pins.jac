    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ByteArraySubclassTest.test_init_override" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class subclass(bytearray):\n\n        def __init__(me, newarg=1, *args, **kwargs):\n            bytearray.__init__(me, *args, **kwargs)\n    x = subclass(4, b'abcd')\n    x = subclass(4, source=b'abcd')\n    assert x == b'abcd', ('assertEqual', x, b'abcd')\n    x = subclass(newarg=4, source=b'abcd')\n    assert x == b'abcd', ('assertEqual', x, b'abcd')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
