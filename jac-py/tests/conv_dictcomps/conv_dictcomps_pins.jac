    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "DictComprehensionTest.test_evaluation_order" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    expected = {'H': 'W', 'e': 'o', 'l': 'l', 'o': 'd'}\n    expected_calls = [('key', 'H'), ('value', 'W'), ('key', 'e'), ('value', 'o'), ('key', 'l'), ('value', 'r'), ('key', 'l'), ('value', 'l'), ('key', 'o'), ('value', 'd')]\n    actual_calls = []\n\n    def add_call(pos, value):\n        actual_calls.append((pos, value))\n        return value\n    actual = {add_call('key', k): add_call('value', v) for k, v in zip('Hello', 'World')}\n    assert actual == expected, ('assertEqual', actual, expected)\n    assert actual_calls == expected_calls, ('assertEqual', actual_calls, expected_calls)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "DictComprehensionTest.test_assignment_idiom_in_comprehensions" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    expected = {1: 1, 2: 4, 3: 9, 4: 16}\n    actual = {j: j * j for i in range(4) for j in [i + 1]}\n    assert actual == expected, ('assertEqual', actual, expected)\n    expected = {3: 2, 5: 6, 7: 12, 9: 20}\n    actual = {j + k: j * k for i in range(4) for j in [i + 1] for k in [j + 1]}\n    assert actual == expected, ('assertEqual', actual, expected)\n    expected = {3: 2, 5: 6, 7: 12, 9: 20}\n    actual = {j + k: j * k for i in range(4) for j, k in [(i + 1, i + 2)]}\n    assert actual == expected, ('assertEqual', actual, expected)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

