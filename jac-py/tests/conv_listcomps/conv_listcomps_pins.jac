test "ListComprehensionTest.test_class_scope_free_var_with_class_cell" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class C:\n\n        def method(self):\n            super()\n            return __class__\n        items = [lambda: i for i in range(5)]\n        y = [x() for x in items]\n    assert C.y == [4, 4, 4, 4, 4], ('assertEqual', C.y, [4, 4, 4, 4, 4])\n    assert C().method() is C, ('assertIs', C().method(), C)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
