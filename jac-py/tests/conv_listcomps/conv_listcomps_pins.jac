test "ListComprehensionTest.test_in_class_scope_with_global" {
    (ok, detail) = p2_libtest_run_snippet("import textwrap\n\ndef _check_in_scopes(code, outputs=None, ns=None, scopes=None, raises=(), exec_func=exec):\n    code = textwrap.dedent(code)\n    scopes = scopes or ['module', 'class', 'function']\n    for scope in scopes:\n        if scope == 'class':\n            newcode = textwrap.dedent('\\n                        class _C:\\n                            {code}\\n                    ').format(code=textwrap.indent(code, '    '))\n\n            def get_output(moddict, name):\n                return getattr(moddict['_C'], name)\n        elif scope == 'function':\n            newcode = textwrap.dedent('\\n                        def _f():\\n                            {code}\\n                            return locals()\\n                        _out = _f()\\n                    ').format(code=textwrap.indent(code, '    '))\n\n            def get_output(moddict, name):\n                return moddict['_out'][name]\n        else:\n            newcode = code\n\n            def get_output(moddict, name):\n                return moddict[name]\n        newns = ns.copy() if ns else {}\n        try:\n            exec_func(newcode, newns)\n        except raises as e:\n            assert type(e) is raises, ('assertIs', type(e), raises)\n        else:\n            for k, v in (outputs or {}).items():\n                assert get_output(newns, k) == v, ('assertEqual', get_output(newns, k), v)\n\ndef _t():\n    code = \"\\n            y = 1\\n            class C:\\n                global y\\n                y = 2\\n                # Ensure the listcomp uses the global, not the value in the\\n                # class namespace\\n                locals()['y'] = 3\\n                vals = [(x, y) for x in range(2)]\\n            vals = C.vals\\n        \"\n    outputs = {'vals': [(0, 2), (1, 2)]}\n    _check_in_scopes(code, outputs, scopes=['module', 'class'])\n    outputs = {'vals': [(0, 1), (1, 1)]}\n    _check_in_scopes(code, outputs, scopes=['function'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

