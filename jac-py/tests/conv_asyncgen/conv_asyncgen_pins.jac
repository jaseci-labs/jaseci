test "AsyncGenAsyncioTest.test_async_gen_aiter" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nasyncio = import_module('asyncio')\n\nclass AwaitException(Exception):\n    pass\n\ndef run_until_complete(coro):\n    exc = False\n    while True:\n        try:\n            if exc:\n                exc = False\n                fut = coro.throw(AwaitException)\n            else:\n                fut = coro.send(None)\n        except StopIteration as ex:\n            return ex.args[0]\n        if fut == ('throw',):\n            exc = True\n\ndef to_list(gen):\n\n    async def iterate():\n        res = []\n        async for i in gen:\n            res.append(i)\n        return res\n    return run_until_complete(iterate())\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.loop = asyncio.new_event_loop()\n    asyncio.set_event_loop(None)\n\n    async def gen():\n        yield 1\n        yield 2\n    g = gen()\n\n    async def consume():\n        return [i async for i in aiter(g)]\n    res = self.loop.run_until_complete(consume())\n    assert res == [1, 2], ('assertEqual', res, [1, 2])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "AsyncGenAsyncioTest.test_async_gen_aiter_class" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nasyncio = import_module('asyncio')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.loop = asyncio.new_event_loop()\n    asyncio.set_event_loop(None)\n    results = []\n\n    class Gen:\n\n        async def __aiter__(self):\n            yield 1\n            yield 2\n    g = Gen()\n\n    async def consume():\n        ait = aiter(g)\n        while True:\n            try:\n                results.append(await anext(ait))\n            except StopAsyncIteration:\n                break\n    self.loop.run_until_complete(consume())\n    assert results == [1, 2], ('assertEqual', results, [1, 2])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
