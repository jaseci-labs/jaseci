test "AsyncGenAsyncioTest.test_anext_bad_await" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport types\nfrom test.support.import_helper import import_module\nasyncio = import_module('asyncio')\n\n@types.coroutine\ndef awaitable(*, throw=False):\n    if throw:\n        yield ('throw',)\n    else:\n        yield ('result',)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.loop = asyncio.new_event_loop()\n    asyncio.set_event_loop(None)\n\n    async def bad_awaitable():\n\n        class BadAwaitable:\n\n            def __await__(self):\n                return 42\n\n        class MyAsyncIter:\n\n            def __aiter__(self):\n                return self\n\n            def __anext__(self):\n                return BadAwaitable()\n        regex = '__await__.*iterator'\n        awaitable = anext(MyAsyncIter(), 'default')\n        try:\n            await awaitable\n        except TypeError as _exc:\n            assert _re.search(regex, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        awaitable = anext(MyAsyncIter())\n        try:\n            await awaitable\n        except TypeError as _exc:\n            assert _re.search(regex, str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        return 'completed'\n    result = self.loop.run_until_complete(bad_awaitable())\n    assert result == 'completed', ('assertEqual', result, 'completed')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "AsyncGenAsyncioTest.test_anext_await_raises" {
    (ok, detail) = p2_libtest_run_snippet("import types\nfrom test.support.import_helper import import_module\nasyncio = import_module('asyncio')\n\n@types.coroutine\ndef awaitable(*, throw=False):\n    if throw:\n        yield ('throw',)\n    else:\n        yield ('result',)\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.loop = asyncio.new_event_loop()\n    asyncio.set_event_loop(None)\n\n    class RaisingAwaitable:\n\n        def __await__(self):\n            raise ZeroDivisionError()\n            yield\n\n    class WithRaisingAwaitableAnext:\n\n        def __aiter__(self):\n            return self\n\n        def __anext__(self):\n            return RaisingAwaitable()\n\n    async def do_test():\n        awaitable = anext(WithRaisingAwaitableAnext())\n        try:\n            await awaitable\n        except ZeroDivisionError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        awaitable = anext(WithRaisingAwaitableAnext(), 'default')\n        try:\n            await awaitable\n        except ZeroDivisionError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        return 'completed'\n    result = self.loop.run_until_complete(do_test())\n    assert result == 'completed', ('assertEqual', result, 'completed')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

