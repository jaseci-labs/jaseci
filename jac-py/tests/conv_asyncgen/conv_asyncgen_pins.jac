test "AsyncGenAsyncioTest.test_asyncgen_nonstarted_hooks_are_cancellable" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nfrom test.support import gc_collect, requires_working_socket\nasyncio = import_module('asyncio')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.loop = asyncio.new_event_loop()\n    asyncio.set_event_loop(None)\n    messages = []\n\n    def exception_handler(loop, context):\n        messages.append(context)\n\n    async def async_iterate():\n        yield 1\n        yield 2\n\n    async def main():\n        loop = asyncio.get_running_loop()\n        loop.set_exception_handler(exception_handler)\n        async for i in async_iterate():\n            break\n    asyncio.run(main())\n    assert [] == messages, ('assertEqual', [], messages)\n    gc_collect()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "AsyncGenAsyncioTest.test_async_gen_await_same_anext_coro_twice" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nfrom test.support.import_helper import import_module\nasyncio = import_module('asyncio')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.loop = asyncio.new_event_loop()\n    asyncio.set_event_loop(None)\n\n    async def async_iterate():\n        yield 1\n        yield 2\n\n    async def run():\n        it = async_iterate()\n        nxt = it.__anext__()\n        await nxt\n        try:\n            await nxt\n        except RuntimeError as _exc:\n            assert _re.search('cannot reuse already awaited __anext__\\\\(\\\\)/asend\\\\(\\\\)', str(_exc)), 'assertRaisesRegex: message mismatch'\n        else:\n            raise AssertionError('assertRaises: did not raise')\n        await it.aclose()\n    self.loop.run_until_complete(run())\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

