test "TestUnawaitedWarnings.test_aclose_throw" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import gc_collect, requires_working_socket\n\nclass AwaitException(Exception):\n    pass\n\ndef run_until_complete(coro):\n    exc = False\n    while True:\n        try:\n            if exc:\n                exc = False\n                fut = coro.throw(AwaitException)\n            else:\n                fut = coro.send(None)\n        except StopIteration as ex:\n            return ex.args[0]\n        if fut == ('throw',):\n            exc = True\n\ndef to_list(gen):\n\n    async def iterate():\n        res = []\n        async for i in gen:\n            res.append(i)\n        return res\n    return run_until_complete(iterate())\n\ndef _t():\n\n    async def gen():\n        return\n        yield\n\n    class MyException(Exception):\n        pass\n    g = gen()\n    try:\n        g.aclose().throw(MyException)\n    except MyException as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    del g\n    gc_collect()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestUnawaitedWarnings.test_asend_send_already_running" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport types\nfrom test.support import gc_collect, requires_working_socket\n\nclass AwaitException(Exception):\n    pass\n\ndef run_until_complete(coro):\n    exc = False\n    while True:\n        try:\n            if exc:\n                exc = False\n                fut = coro.throw(AwaitException)\n            else:\n                fut = coro.send(None)\n        except StopIteration as ex:\n            return ex.args[0]\n        if fut == ('throw',):\n            exc = True\n\ndef to_list(gen):\n\n    async def iterate():\n        res = []\n        async for i in gen:\n            res.append(i)\n        return res\n    return run_until_complete(iterate())\n\ndef _t():\n\n    @types.coroutine\n    def _async_yield(v):\n        return (yield v)\n\n    async def agenfn():\n        while True:\n            await _async_yield(1)\n        return\n        yield\n    agen = agenfn()\n    gen = agen.asend(None)\n    gen.send(None)\n    gen2 = agen.asend(None)\n    try:\n        gen2.send(None)\n    except RuntimeError as _exc:\n        assert _re.search('anext\\\\(\\\\): asynchronous generator is already running', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    del gen2\n    gc_collect()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

