test "AsyncGenAsyncioTest.test_async_gen_asyncio_shutdown_01" {
    (ok, detail) = p2_libtest_run_snippet("from test.support.import_helper import import_module\nasyncio = import_module('asyncio')\n\ndef _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n    self.loop = asyncio.new_event_loop()\n    asyncio.set_event_loop(None)\n    finalized = 0\n\n    async def waiter(timeout):\n        nonlocal finalized\n        try:\n            await asyncio.sleep(timeout)\n            yield 1\n        finally:\n            await asyncio.sleep(0)\n            finalized += 1\n\n    async def wait():\n        async for _ in waiter(1):\n            pass\n    t1 = self.loop.create_task(wait())\n    t2 = self.loop.create_task(wait())\n    self.loop.run_until_complete(asyncio.sleep(0.1))\n    t1.cancel()\n    t2.cancel()\n    try:\n        self.loop.run_until_complete(t1)\n    except asyncio.CancelledError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        self.loop.run_until_complete(t2)\n    except asyncio.CancelledError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    self.loop.run_until_complete(self.loop.shutdown_asyncgens())\n    assert finalized == 2, ('assertEqual', finalized, 2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

