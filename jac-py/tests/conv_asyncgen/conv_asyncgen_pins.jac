test "AsyncGenTest.test_async_gen_api_01" {
    (ok, detail) = p2_libtest_run_snippet("import inspect\nimport types\n\nclass AwaitException(Exception):\n    pass\n\ndef run_until_complete(coro):\n    exc = False\n    while True:\n        try:\n            if exc:\n                exc = False\n                fut = coro.throw(AwaitException)\n            else:\n                fut = coro.send(None)\n        except StopIteration as ex:\n            return ex.args[0]\n        if fut == ('throw',):\n            exc = True\n\ndef to_list(gen):\n\n    async def iterate():\n        res = []\n        async for i in gen:\n            res.append(i)\n        return res\n    return run_until_complete(iterate())\n\ndef _t():\n\n    async def gen():\n        yield 123\n    g = gen()\n    assert g.__name__ == 'gen', ('assertEqual', g.__name__, 'gen')\n    g.__name__ = '123'\n    assert g.__name__ == '123', ('assertEqual', g.__name__, '123')\n    assert '.gen' in g.__qualname__, ('assertIn', '.gen', g.__qualname__)\n    g.__qualname__ = '123'\n    assert g.__qualname__ == '123', ('assertEqual', g.__qualname__, '123')\n    assert g.ag_await is None, ('assertIsNone', g.ag_await)\n    assert isinstance(g.ag_frame, types.FrameType), ('assertIsInstance', g.ag_frame, types.FrameType)\n    assert not g.ag_running, ('assertFalse', g.ag_running)\n    assert isinstance(g.ag_code, types.CodeType), ('assertIsInstance', g.ag_code, types.CodeType)\n    aclose = g.aclose()\n    assert inspect.isawaitable(aclose), ('assertTrue', inspect.isawaitable(aclose))\n    aclose.close()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "AsyncGenTest.test_async_gen_asend_close_runtime_error" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\nimport types\n\nclass AwaitException(Exception):\n    pass\n\ndef run_until_complete(coro):\n    exc = False\n    while True:\n        try:\n            if exc:\n                exc = False\n                fut = coro.throw(AwaitException)\n            else:\n                fut = coro.send(None)\n        except StopIteration as ex:\n            return ex.args[0]\n        if fut == ('throw',):\n            exc = True\n\ndef to_list(gen):\n\n    async def iterate():\n        res = []\n        async for i in gen:\n            res.append(i)\n        return res\n    return run_until_complete(iterate())\n\ndef _t():\n    import types\n\n    @types.coroutine\n    def _async_yield(v):\n        return (yield v)\n\n    async def agenfn():\n        try:\n            await _async_yield(None)\n        except GeneratorExit:\n            await _async_yield(None)\n        return\n        yield\n    agen = agenfn()\n    gen = agen.asend(None)\n    gen.send(None)\n    try:\n        gen.close()\n    except RuntimeError as _exc:\n        assert _re.search('coroutine ignored GeneratorExit', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
