test "InlineCommentStrippingTestCase.test_stripping" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\n\ndef _t():\n    cfg = configparser.ConfigParser(inline_comment_prefixes=(';', '#', '//'))\n    cfg.read_string('\\n        [section]\\n        k1 = v1;still v1\\n        k2 = v2 ;a comment\\n        k3 = v3 ; also a comment\\n        k4 = v4;still v4 ;a comment\\n        k5 = v5;still v5 ; also a comment\\n        k6 = v6;still v6; and still v6 ;a comment\\n        k7 = v7;still v7; and still v7 ; also a comment\\n\\n        [multiprefix]\\n        k1 = v1;still v1 #a comment ; yeah, pretty much\\n        k2 = v2 // this already is a comment ; continued\\n        k3 = v3;#//still v3# and still v3 ; a comment\\n        ')\n    s = cfg['section']\n    assert s['k1'] == 'v1;still v1', ('assertEqual', s['k1'], 'v1;still v1')\n    assert s['k2'] == 'v2', ('assertEqual', s['k2'], 'v2')\n    assert s['k3'] == 'v3', ('assertEqual', s['k3'], 'v3')\n    assert s['k4'] == 'v4;still v4', ('assertEqual', s['k4'], 'v4;still v4')\n    assert s['k5'] == 'v5;still v5', ('assertEqual', s['k5'], 'v5;still v5')\n    assert s['k6'] == 'v6;still v6; and still v6', ('assertEqual', s['k6'], 'v6;still v6; and still v6')\n    assert s['k7'] == 'v7;still v7; and still v7', ('assertEqual', s['k7'], 'v7;still v7; and still v7')\n    s = cfg['multiprefix']\n    assert s['k1'] == 'v1;still v1', ('assertEqual', s['k1'], 'v1;still v1')\n    assert s['k2'] == 'v2', ('assertEqual', s['k2'], 'v2')\n    assert s['k3'] == 'v3;#//still v3# and still v3', ('assertEqual', s['k3'], 'v3;#//still v3# and still v3')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SectionlessTestCase.test_no_first_section" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\nimport io\n\ndef fromstring(string):\n    cfg = configparser.ConfigParser(allow_unnamed_section=True)\n    cfg.read_string(string)\n    return cfg\n\ndef _t():\n    cfg1 = fromstring('\\n        a = 1\\n        b = 2\\n        [sect1]\\n        c = 3\\n        ')\n    assert set([configparser.UNNAMED_SECTION, 'sect1']) == set(cfg1.sections()), ('assertEqual', set([configparser.UNNAMED_SECTION, 'sect1']), set(cfg1.sections()))\n    assert '1' == cfg1[configparser.UNNAMED_SECTION]['a'], ('assertEqual', '1', cfg1[configparser.UNNAMED_SECTION]['a'])\n    assert '2' == cfg1[configparser.UNNAMED_SECTION]['b'], ('assertEqual', '2', cfg1[configparser.UNNAMED_SECTION]['b'])\n    assert '3' == cfg1['sect1']['c'], ('assertEqual', '3', cfg1['sect1']['c'])\n    output = io.StringIO()\n    cfg1.write(output)\n    cfg2 = fromstring(output.getvalue())\n    assert '1' == cfg2[configparser.UNNAMED_SECTION]['a'], ('assertEqual', '1', cfg2[configparser.UNNAMED_SECTION]['a'])\n    assert '2' == cfg2[configparser.UNNAMED_SECTION]['b'], ('assertEqual', '2', cfg2[configparser.UNNAMED_SECTION]['b'])\n    assert '3' == cfg2['sect1']['c'], ('assertEqual', '3', cfg2['sect1']['c'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

