test "SectionlessTestCase.test_empty_unnamed_section" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\nimport io\n\ndef _t():\n    cfg = configparser.ConfigParser(allow_unnamed_section=True)\n    cfg.add_section(configparser.UNNAMED_SECTION)\n    cfg.add_section('section')\n    output = io.StringIO()\n    cfg.write(output)\n    assert output.getvalue() == '[section]\\n\\n', ('assertEqual', output.getvalue(), '[section]\\n\\n')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SectionlessTestCase.test_add_section" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\nimport io\n\ndef _t():\n    cfg = configparser.ConfigParser(allow_unnamed_section=True)\n    cfg.add_section(configparser.UNNAMED_SECTION)\n    cfg.set(configparser.UNNAMED_SECTION, 'a', '1')\n    assert '1' == cfg[configparser.UNNAMED_SECTION]['a'], ('assertEqual', '1', cfg[configparser.UNNAMED_SECTION]['a'])\n    output = io.StringIO()\n    cfg.write(output)\n    assert output.getvalue() == 'a = 1\\n\\n', ('assertEqual', output.getvalue(), 'a = 1\\n\\n')\n    cfg = configparser.ConfigParser(allow_unnamed_section=True)\n    cfg[configparser.UNNAMED_SECTION] = {'a': '1'}\n    assert '1' == cfg[configparser.UNNAMED_SECTION]['a'], ('assertEqual', '1', cfg[configparser.UNNAMED_SECTION]['a'])\n    output = io.StringIO()\n    cfg.write(output)\n    assert output.getvalue() == 'a = 1\\n\\n', ('assertEqual', output.getvalue(), 'a = 1\\n\\n')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "SectionlessTestCase.test_disabled_error" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\n\ndef _t():\n    try:\n        configparser.ConfigParser().read_string('a = 1')\n    except configparser.MissingSectionHeaderError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        configparser.ConfigParser().add_section(configparser.UNNAMED_SECTION)\n    except configparser.UnnamedSectionDisabledError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        configparser.ConfigParser()[configparser.UNNAMED_SECTION] = {'a': '1'}\n    except configparser.UnnamedSectionDisabledError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

