test "ReDoSTestCase.test_option_regex_does_not_backtrack" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\n\ndef _t():\n    parser = configparser.RawConfigParser()\n    content = '[section]\\n' + 'x' + ' ' * 40000 + 'y' + '\\n'\n    try:\n        parser.read_string(content)\n    except configparser.ParsingError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "ReDoSTestCase.test_option_regex_no_value_does_not_backtrack" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\n\ndef _t():\n    parser = configparser.RawConfigParser(allow_no_value=True)\n    content = '[section]\\n' + 'x' + ' ' * 40000 + 'y' + '\\n'\n    parser.read_string(content)\n    assert parser.has_option('section', 'x' + ' ' * 40000 + 'y'), ('assertTrue', parser.has_option('section', 'x' + ' ' * 40000 + 'y'))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}
