test "InvalidInputTestCase.test_delimiter_in_key" {
    (ok, detail) = p2_libtest_run_snippet("import configparser\nimport io\n\ndef _t():\n    cfg = configparser.ConfigParser(delimiters='=')\n    cfg.add_section('section1')\n    cfg.set('section1', 'a=b', 'c')\n    output = io.StringIO()\n    try:\n        cfg.write(output)\n    except configparser.InvalidWriteError as _exc:\n        pass\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    output.close()\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

