test "GeneralFloatCases.test_floatasratio" {
    (ok, detail) = p2_libtest_run_snippet("import fractions\nimport random\n\ndef _t():\n    for f, ratio in [(0.875, (7, 8)), (-0.875, (-7, 8)), (0.0, (0, 1)), (11.5, (23, 2))]:\n        assert f.as_integer_ratio() == ratio, ('assertEqual', f.as_integer_ratio(), ratio)\n    for i in range(10000):\n        f = random.random()\n        f *= 10 ** random.randint(-100, 100)\n        n, d = f.as_integer_ratio()\n        assert float(n).__truediv__(d) == f, ('assertEqual', float(n).__truediv__(d), f)\n    R = fractions.Fraction\n    assert R(0, 1) == R(*float(0.0).as_integer_ratio()), ('assertEqual', R(0, 1), R(*float(0.0).as_integer_ratio()))\n    assert R(5, 2) == R(*float(2.5).as_integer_ratio()), ('assertEqual', R(5, 2), R(*float(2.5).as_integer_ratio()))\n    assert R(1, 2) == R(*float(0.5).as_integer_ratio()), ('assertEqual', R(1, 2), R(*float(0.5).as_integer_ratio()))\n    assert R(4728779608739021, 2251799813685248) == R(*float(2.1).as_integer_ratio()), ('assertEqual', R(4728779608739021, 2251799813685248), R(*float(2.1).as_integer_ratio()))\n    assert R(-4728779608739021, 2251799813685248) == R(*float(-2.1).as_integer_ratio()), ('assertEqual', R(-4728779608739021, 2251799813685248), R(*float(-2.1).as_integer_ratio()))\n    assert R(-2100, 1) == R(*float(-2100.0).as_integer_ratio()), ('assertEqual', R(-2100, 1), R(*float(-2100.0).as_integer_ratio()))\n    try:\n        float('inf').as_integer_ratio()\n    except OverflowError:\n        pass\n    try:\n        float('-inf').as_integer_ratio()\n    except OverflowError:\n        pass\n    try:\n        float('nan').as_integer_ratio()\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

