test "FormatTestCase.test_format" {
    (ok, detail) = p2_libtest_run_snippet("INF = float('inf')\nNAN = float('nan')\n\ndef _t():\n    assert format(0.0, 'f') == '0.000000', ('assertEqual', format(0.0, 'f'), '0.000000')\n    assert format(0.0, '') == '0.0', ('assertEqual', format(0.0, ''), '0.0')\n    assert format(0.01, '') == '0.01', ('assertEqual', format(0.01, ''), '0.01')\n    assert format(0.01, 'g') == '0.01', ('assertEqual', format(0.01, 'g'), '0.01')\n    x = 100 / 7.0\n    assert format(x, '') == str(x), ('assertEqual', format(x, ''), str(x))\n    assert format(x, '-') == str(x), ('assertEqual', format(x, '-'), str(x))\n    assert format(x, '>') == str(x), ('assertEqual', format(x, '>'), str(x))\n    assert format(x, '2') == str(x), ('assertEqual', format(x, '2'), str(x))\n    assert format(1.0, 'f') == '1.000000', ('assertEqual', format(1.0, 'f'), '1.000000')\n    assert format(-1.0, 'f') == '-1.000000', ('assertEqual', format(-1.0, 'f'), '-1.000000')\n    assert format(1.0, ' f') == ' 1.000000', ('assertEqual', format(1.0, ' f'), ' 1.000000')\n    assert format(-1.0, ' f') == '-1.000000', ('assertEqual', format(-1.0, ' f'), '-1.000000')\n    assert format(1.0, '+f') == '+1.000000', ('assertEqual', format(1.0, '+f'), '+1.000000')\n    assert format(-1.0, '+f') == '-1.000000', ('assertEqual', format(-1.0, '+f'), '-1.000000')\n    assert format(-1.0, '%') == '-100.000000%', ('assertEqual', format(-1.0, '%'), '-100.000000%')\n    try:\n        format(*(3.0, 's'))\n    except ValueError:\n        pass\n    for format_spec in 'sbcdoxX':\n        try:\n            format(*(0.0, format_spec))\n        except ValueError:\n            pass\n        try:\n            format(*(1.0, format_spec))\n        except ValueError:\n            pass\n        try:\n            format(*(-1.0, format_spec))\n        except ValueError:\n            pass\n        try:\n            format(*(1e+100, format_spec))\n        except ValueError:\n            pass\n        try:\n            format(*(-1e+100, format_spec))\n        except ValueError:\n            pass\n        try:\n            format(*(1e-100, format_spec))\n        except ValueError:\n            pass\n        try:\n            format(*(-1e-100, format_spec))\n        except ValueError:\n            pass\n    assert format(NAN, 'f') == 'nan', ('assertEqual', format(NAN, 'f'), 'nan')\n    assert format(NAN, 'F') == 'NAN', ('assertEqual', format(NAN, 'F'), 'NAN')\n    assert format(INF, 'f') == 'inf', ('assertEqual', format(INF, 'f'), 'inf')\n    assert format(INF, 'F') == 'INF', ('assertEqual', format(INF, 'F'), 'INF')\n    x = 123456.123456\n    assert format(x, '_f') == '123_456.123456', ('assertEqual', format(x, '_f'), '123_456.123456')\n    assert format(x, ',f') == '123,456.123456', ('assertEqual', format(x, ',f'), '123,456.123456')\n    assert format(x, '._f') == '123456.123_456', ('assertEqual', format(x, '._f'), '123456.123_456')\n    assert format(x, '.,f') == '123456.123,456', ('assertEqual', format(x, '.,f'), '123456.123,456')\n    assert format(x, '_._f') == '123_456.123_456', ('assertEqual', format(x, '_._f'), '123_456.123_456')\n    assert format(x, ',.,f') == '123,456.123,456', ('assertEqual', format(x, ',.,f'), '123,456.123,456')\n    assert format(x, '.10_f') == '123456.123_456_000_0', ('assertEqual', format(x, '.10_f'), '123456.123_456_000_0')\n    assert format(x, '.10,f') == '123456.123,456,000,0', ('assertEqual', format(x, '.10,f'), '123456.123,456,000,0')\n    assert format(x, '>21._f') == '       123456.123_456', ('assertEqual', format(x, '>21._f'), '       123456.123_456')\n    assert format(x, '<21._f') == '123456.123_456       ', ('assertEqual', format(x, '<21._f'), '123456.123_456       ')\n    assert format(x, '+.11_e') == '+1.234_561_234_56e+05', ('assertEqual', format(x, '+.11_e'), '+1.234_561_234_56e+05')\n    assert format(x, '+.11,e') == '+1.234,561,234,56e+05', ('assertEqual', format(x, '+.11,e'), '+1.234,561,234,56e+05')\n    assert format(x, '021_._f') == '0_000_123_456.123_456', ('assertEqual', format(x, '021_._f'), '0_000_123_456.123_456')\n    assert format(x, '020_._f') == '0_000_123_456.123_456', ('assertEqual', format(x, '020_._f'), '0_000_123_456.123_456')\n    assert format(x, '+021_._f') == '+0_000_123_456.123_456', ('assertEqual', format(x, '+021_._f'), '+0_000_123_456.123_456')\n    assert format(x, '21_._f') == '      123_456.123_456', ('assertEqual', format(x, '21_._f'), '      123_456.123_456')\n    assert format(x, '>021_._f') == '000000123_456.123_456', ('assertEqual', format(x, '>021_._f'), '000000123_456.123_456')\n    assert format(x, '<021_._f') == '123_456.123_456000000', ('assertEqual', format(x, '<021_._f'), '123_456.123_456000000')\n    assert format(x, '023_.10_f') == '0_123_456.123_456_000_0', ('assertEqual', format(x, '023_.10_f'), '0_123_456.123_456_000_0')\n    assert format(x, '022_.10_f') == '0_123_456.123_456_000_0', ('assertEqual', format(x, '022_.10_f'), '0_123_456.123_456_000_0')\n    assert format(x, '+023_.10_f') == '+0_123_456.123_456_000_0', ('assertEqual', format(x, '+023_.10_f'), '+0_123_456.123_456_000_0')\n    assert format(x, '023_.9_f') == '000_123_456.123_456_000', ('assertEqual', format(x, '023_.9_f'), '000_123_456.123_456_000')\n    assert format(x, '021_._e') == '0_000_001.234_561e+05', ('assertEqual', format(x, '021_._e'), '0_000_001.234_561e+05')\n    assert format(x, '020_._e') == '0_000_001.234_561e+05', ('assertEqual', format(x, '020_._e'), '0_000_001.234_561e+05')\n    assert format(x, '+021_._e') == '+0_000_001.234_561e+05', ('assertEqual', format(x, '+021_._e'), '+0_000_001.234_561e+05')\n    assert format(x, '023_.10_e') == '0_001.234_561_234_6e+05', ('assertEqual', format(x, '023_.10_e'), '0_001.234_561_234_6e+05')\n    assert format(x, '022_.10_e') == '0_001.234_561_234_6e+05', ('assertEqual', format(x, '022_.10_e'), '0_001.234_561_234_6e+05')\n    assert format(x, '023_.9_e') == '000_001.234_561_235e+05', ('assertEqual', format(x, '023_.9_e'), '000_001.234_561_235e+05')\n    try:\n        format(*(x, '._6f'))\n    except ValueError:\n        pass\n    try:\n        format(*(x, '.,_f'))\n    except ValueError:\n        pass\n    try:\n        format(*(x, '.6,_f'))\n    except ValueError:\n        pass\n    try:\n        format(*(x, '.6_,f'))\n    except ValueError:\n        pass\n    try:\n        format(*(x, '.6_n'))\n    except ValueError:\n        pass\n    try:\n        format(*(x, '.6,n'))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

