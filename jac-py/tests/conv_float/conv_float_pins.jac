test "FormatTestCase.test_issue35560" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    assert format(123.0, '00') == '123.0', ('assertEqual', format(123.0, '00'), '123.0')\n    assert format(123.34, '00f') == '123.340000', ('assertEqual', format(123.34, '00f'), '123.340000')\n    assert format(123.34, '00e') == '1.233400e+02', ('assertEqual', format(123.34, '00e'), '1.233400e+02')\n    assert format(123.34, '00g') == '123.34', ('assertEqual', format(123.34, '00g'), '123.34')\n    assert format(123.34, '00.10f') == '123.3400000000', ('assertEqual', format(123.34, '00.10f'), '123.3400000000')\n    assert format(123.34, '00.10e') == '1.2334000000e+02', ('assertEqual', format(123.34, '00.10e'), '1.2334000000e+02')\n    assert format(123.34, '00.10g') == '123.34', ('assertEqual', format(123.34, '00.10g'), '123.34')\n    assert format(123.34, '01f') == '123.340000', ('assertEqual', format(123.34, '01f'), '123.340000')\n    assert format(-123.0, '00') == '-123.0', ('assertEqual', format(-123.0, '00'), '-123.0')\n    assert format(-123.34, '00f') == '-123.340000', ('assertEqual', format(-123.34, '00f'), '-123.340000')\n    assert format(-123.34, '00e') == '-1.233400e+02', ('assertEqual', format(-123.34, '00e'), '-1.233400e+02')\n    assert format(-123.34, '00g') == '-123.34', ('assertEqual', format(-123.34, '00g'), '-123.34')\n    assert format(-123.34, '00.10f') == '-123.3400000000', ('assertEqual', format(-123.34, '00.10f'), '-123.3400000000')\n    assert format(-123.34, '00.10f') == '-123.3400000000', ('assertEqual', format(-123.34, '00.10f'), '-123.3400000000')\n    assert format(-123.34, '00.10e') == '-1.2334000000e+02', ('assertEqual', format(-123.34, '00.10e'), '-1.2334000000e+02')\n    assert format(-123.34, '00.10g') == '-123.34', ('assertEqual', format(-123.34, '00.10g'), '-123.34')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "InfNanTest.test_inf_from_str" {
    (ok, detail) = p2_libtest_run_snippet("from math import isinf, isnan, copysign, ldexp\n\ndef _t():\n    assert isinf(float('inf')), ('assertTrue', isinf(float('inf')))\n    assert isinf(float('+inf')), ('assertTrue', isinf(float('+inf')))\n    assert isinf(float('-inf')), ('assertTrue', isinf(float('-inf')))\n    assert isinf(float('infinity')), ('assertTrue', isinf(float('infinity')))\n    assert isinf(float('+infinity')), ('assertTrue', isinf(float('+infinity')))\n    assert isinf(float('-infinity')), ('assertTrue', isinf(float('-infinity')))\n    assert repr(float('inf')) == 'inf', ('assertEqual', repr(float('inf')), 'inf')\n    assert repr(float('+inf')) == 'inf', ('assertEqual', repr(float('+inf')), 'inf')\n    assert repr(float('-inf')) == '-inf', ('assertEqual', repr(float('-inf')), '-inf')\n    assert repr(float('infinity')) == 'inf', ('assertEqual', repr(float('infinity')), 'inf')\n    assert repr(float('+infinity')) == 'inf', ('assertEqual', repr(float('+infinity')), 'inf')\n    assert repr(float('-infinity')) == '-inf', ('assertEqual', repr(float('-infinity')), '-inf')\n    assert repr(float('INF')) == 'inf', ('assertEqual', repr(float('INF')), 'inf')\n    assert repr(float('+Inf')) == 'inf', ('assertEqual', repr(float('+Inf')), 'inf')\n    assert repr(float('-iNF')) == '-inf', ('assertEqual', repr(float('-iNF')), '-inf')\n    assert repr(float('Infinity')) == 'inf', ('assertEqual', repr(float('Infinity')), 'inf')\n    assert repr(float('+iNfInItY')) == 'inf', ('assertEqual', repr(float('+iNfInItY')), 'inf')\n    assert repr(float('-INFINITY')) == '-inf', ('assertEqual', repr(float('-INFINITY')), '-inf')\n    assert str(float('inf')) == 'inf', ('assertEqual', str(float('inf')), 'inf')\n    assert str(float('+inf')) == 'inf', ('assertEqual', str(float('+inf')), 'inf')\n    assert str(float('-inf')) == '-inf', ('assertEqual', str(float('-inf')), '-inf')\n    assert str(float('infinity')) == 'inf', ('assertEqual', str(float('infinity')), 'inf')\n    assert str(float('+infinity')) == 'inf', ('assertEqual', str(float('+infinity')), 'inf')\n    assert str(float('-infinity')) == '-inf', ('assertEqual', str(float('-infinity')), '-inf')\n    try:\n        float(*('info',))\n    except ValueError:\n        pass\n    try:\n        float(*('+info',))\n    except ValueError:\n        pass\n    try:\n        float(*('-info',))\n    except ValueError:\n        pass\n    try:\n        float(*('in',))\n    except ValueError:\n        pass\n    try:\n        float(*('+in',))\n    except ValueError:\n        pass\n    try:\n        float(*('-in',))\n    except ValueError:\n        pass\n    try:\n        float(*('infinit',))\n    except ValueError:\n        pass\n    try:\n        float(*('+Infin',))\n    except ValueError:\n        pass\n    try:\n        float(*('-INFI',))\n    except ValueError:\n        pass\n    try:\n        float(*('infinitys',))\n    except ValueError:\n        pass\n    try:\n        float(*('++Inf',))\n    except ValueError:\n        pass\n    try:\n        float(*('-+inf',))\n    except ValueError:\n        pass\n    try:\n        float(*('+-infinity',))\n    except ValueError:\n        pass\n    try:\n        float(*('--Infinity',))\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

