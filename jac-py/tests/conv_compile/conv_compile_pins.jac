t position[2] == column, ('assertEqual', position[2], column)\n                assert position[3] == end_column, ('assertEqual', position[3], end_column)\n                return\n    raise AssertionError(f'Opcode {opcode} not found in code')\n\ndef _t():\n    snippet = textwrap.dedent('            f(\\n                1, 2, 3, 4\\n            )\\n            ')\n    compiled_code, _ = check_positions_against_ast(snippet)\n    assertOpcodeSourcePositionIs(compiled_code, 'CALL', line=1, end_line=3, column=0, end_column=1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSourcePositions.test_multiline_boolean_expression" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\nimport ast\nimport _ast\nimport textwrap\nfrom test.support.bytecode_helper import instructions_with_positions\n\ndef check_positions_against_ast(snippet):\n    code = compile(snippet, 'test_compile.py', 'exec')\n    ast_tree = compile(snippet, 'test_compile.py', 'exec', _ast.PyCF_ONLY_AST)\n    assert type(ast_tree) == _ast.Module, ('assertTrue', type(ast_tree) == _ast.Module)\n    lines, end_lines, columns, end_columns = (set(), set(), set(), set())\n\n    class SourceOffsetVisitor(ast.NodeVisitor):\n\n        def generic_visit(self, node):\n            super().generic_visit(node)\n            if not isinstance(node, (ast.expr, ast.stmt, ast.pattern)):\n                return\n            lines.add(node.lineno)\n            end_lines.add(node.end_lineno)\n            columns.add(node.col_offset)\n            end_columns.add(node.end_col_offset)\n    SourceOffsetVisitor().visit(ast_tree)\n    for line, end_line, col, end_col in code.co_positions():\n        if line == 0:\n            continue\n        if line is not None:\n            assert line in lines, ('assertIn', line, lines)\n        if end_line is not None:\n            assert end_line in end_lines, ('assertIn', end_line, end_lines)\n        if col is not None:\n            assert col in columns, ('assertIn', col, columns)\n        if end_col is not None:\n            assert end_col in end_columns, ('assertIn', end_col, end_columns)\n    return (code, ast_tree)\n\ndef assertOpcodeSourcePositionIs(code, opcode, line, end_line, column, end_column, occurrence=1):\n    for instr, position in instructions_with_positions(dis.Bytecode(code), code.co_positions()):\n        if instr.opname == opcode:\n            occurrence -= 1\n            if not occurrence:\n                assert position[0] == line, ('assertEqual', position[0], line)\n                assert position[1] == end_line, ('assertEqual', position[1], end_line)\n                assert position[2] == column, ('assertEqual', position[2], column)\n                assert position[3] == end_column, ('assertEqual', position[3], end_column)\n                return\n    raise AssertionError(f'Opcode {opcode} not found in code')\n\ndef _t():\n    snippet = textwrap.dedent('            if (a or\\n                (b and not c) or\\n                not (\\n                    d > 0)):\\n                x = 42\\n            ')\n    compiled_code, _ = check_positions_against_ast(snippet)\n    assertOpcodeSourcePositionIs(compiled_code, 'POP_JUMP_IF_TRUE', line=1, end_line=1, column=4, end_column=5, occurrence=1)\n    assertOpcodeSourcePositionIs(compiled_code, 'POP_JUMP_IF_FALSE', line=2, end_line=2, column=5, end_column=6, occurrence=1)\n    assertOpcodeSourcePositionIs(compiled_code, 'POP_JUMP_IF_FALSE', line=2, end_line=2, column=15, end_column=16, occurrence=2)\n    assertOpcodeSourcePositionIs(compiled_code, 'COMPARE_OP', line=4, end_line=4, column=8, end_column=13, occurrence=1)\n    assertOpcodeSourcePositionIs(compiled_code, 'POP_JUMP_IF_TRUE', line=4, end_line=4, column=8, end_column=13, occurrence=2)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSourcePositions.test_multiline_generator_expression" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\nimport ast\nimport _ast\nimport types\nimport textwrap\nfrom test.support.bytecode_helper import instructions_with_positions\n\ndef check_positions_against_ast(snippet):\n    code = compile(snippet, 'test_compile.py', 'exec')\n    ast_tree = compile(snippet, 'test_compile.py', 'exec', _ast.PyCF_ONLY_AST)\n    assert type(ast_tree) == _ast.Module, ('assertTrue', type(ast_tree) == _ast.Module)\n    lines, end_lines, columns, end_columns = (set(), set(), set(), set())\n\n    class SourceOffsetVisitor(ast.NodeVisitor):\n\n        def generic_visit(self, node):\n            super().generic_visit(node)\n            if not isinstance(node, (ast.expr, ast.stmt, ast.pattern)):\n                return\n            lines.add(node.lineno)\n            end_lines.add(node.end_lineno)\n            columns.add(node.col_offset)\n            end_columns.add(node.end_col_offset)\n    SourceOffsetVisitor().visit(ast_tree)\n    for line, end_line, col, end_col in code.co_positions():\n        if line == 0:\n            continue\n        if line is not None:\n            assert line in lines, ('assertIn', line, lines)\n        if end_line is not None:\n            assert end_line in end_lines, ('assertIn', end_line, end_lines)\n        if col is not None:\n            assert col in columns, ('assertIn', col, columns)\n        if end_col is not None:\n            assert end_col in end_columns, ('assertIn', end_col, end_columns)\n    return (code, ast_tree)\n\ndef assertOpcodeSourcePositionIs(code, opcode, line, end_line, column, end_column, occurrence=1):\n    for instr, position in instructions_with_positions(dis.Bytecode(code), code.co_positions()):\n        if instr.opname == opcode:\n            occurrence -= 1\n            if not occurrence:\n                assert position[0] == line, ('assertEqual', position[0], line)\n                assert position[1] == end_line, ('assertEqual', position[1], end_line)\n                assert position[2] == column, ('assertEqual', position[2], column)\n                assert position[3] == end_column, ('assertEqual', position[3], end_column)\n                return\n    raise AssertionError(f'Opcode {opcode} not found in code')\n\ndef _t():\n    snippet = textwrap.dedent('            ((x,\\n                2*x)\\n                for x\\n                in [1,2,3] if (x > 0\\n                               and x < 100\\n                               and x != 50))\\n            ')\n    compiled_code, _ = check_positions_against_ast(snippet)\n    compiled_code = compiled_code.co_consts[0]\n    assert isinstance(compiled_code, types.CodeType), ('assertIsInstance', compiled_code, types.CodeType)\n    assertOpcodeSourcePositionIs(compiled_code, 'YIELD_VALUE', line=1, end_line=2, column=1, end_column=8, occurrence=1)\n    assertOpcodeSourcePositionIs(compiled_code, 'JUMP_BACKWARD', line=1, end_line=2, column=1, end_column=8, occurrence=1)\n    assertOpcodeSourcePositionIs(compiled_code, 'RETURN_VALUE', line=4, end_line=4, column=7, end_column=14, occurrence=1)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

