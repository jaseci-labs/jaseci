test "TestSpecifics.test_compile_warning_in_finally" {
    (ok, detail) = p2_libtest_run_snippet("import textwrap\nimport warnings\n\ndef _t():\n    source = textwrap.dedent('\\n            try:\\n                pass\\n            finally:\\n                1 is 1  # line 5\\n                try:\\n                    pass\\n                finally: # nested\\n                    1 is 1  # line 9\\n        ')\n    with warnings.catch_warnings(record=True) as caught:\n        warnings.simplefilter('always')\n        compile(source, '<stdin>', 'exec')\n    assert sorted((wm.lineno for wm in caught)) == [5, 9], ('assertEqual', sorted((wm.lineno for wm in caught)), [5, 9])\n    for wm in caught:\n        assert wm.category == SyntaxWarning, ('assertEqual', wm.category, SyntaxWarning)\n        assert '\"is\" with \\'int\\' literal' in str(wm.message), ('assertIn', '\"is\" with \\'int\\' literal', str(wm.message))\n    source = textwrap.dedent('\\n            try:\\n                pass\\n            except *Exception:\\n                pass\\n            finally:\\n                1 is 1  # line 7\\n                try:\\n                    pass\\n                except *Exception:\\n                    pass\\n                finally: # nested\\n                    1 is 1  # line 13\\n        ')\n    with warnings.catch_warnings(record=True) as caught:\n        warnings.simplefilter('always')\n        compile(source, '<stdin>', 'exec')\n    assert sorted((wm.lineno for wm in caught)) == [7, 13], ('assertEqual', sorted((wm.lineno for wm in caught)), [7, 13])\n    for wm in caught:\n        assert wm.category == SyntaxWarning, ('assertEqual', wm.category, SyntaxWarning)\n        assert '\"is\" with \\'int\\' literal' in str(wm.message), ('assertIn', '\"is\" with \\'int\\' literal', str(wm.message))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

