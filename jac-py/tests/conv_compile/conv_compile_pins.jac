test "TestStackSizeStability.test_if" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport io\nimport warnings\n\ndef check_stack_size(snippet, async_=False):\n\n    def compile_snippet(i):\n        ns = {}\n        script = 'def func():\\n' + i * snippet\n        if async_:\n            script = 'async ' + script\n        with warnings.catch_warnings():\n            warnings.simplefilter('ignore', SyntaxWarning)\n            code = compile(script, '<script>', 'exec')\n        exec(code, ns, ns)\n        return ns['func'].__code__\n    sizes = [compile_snippet(i).co_stacksize for i in range(2, 5)]\n    if len(set(sizes)) != 1:\n        import dis, io\n        out = io.StringIO()\n        dis.dis(compile_snippet(1), file=out)\n        raise AssertionError('stack sizes diverge with # of consecutive snippets: %s\\n%s\\n%s' % (sizes, snippet, out.getvalue()))\n\ndef _t():\n    snippet = '\\n            if x:\\n                a\\n            '\n    check_stack_size(snippet)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestStackSizeStability.test_if_else" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport io\nimport warnings\n\ndef check_stack_size(snippet, async_=False):\n\n    def compile_snippet(i):\n        ns = {}\n        script = 'def func():\\n' + i * snippet\n        if async_:\n            script = 'async ' + script\n        with warnings.catch_warnings():\n            warnings.simplefilter('ignore', SyntaxWarning)\n            code = compile(script, '<script>', 'exec')\n        exec(code, ns, ns)\n        return ns['func'].__code__\n    sizes = [compile_snippet(i).co_stacksize for i in range(2, 5)]\n    if len(set(sizes)) != 1:\n        import dis, io\n        out = io.StringIO()\n        dis.dis(compile_snippet(1), file=out)\n        raise AssertionError('stack sizes diverge with # of consecutive snippets: %s\\n%s\\n%s' % (sizes, snippet, out.getvalue()))\n\ndef _t():\n    snippet = '\\n            if x:\\n                a\\n            elif y:\\n                b\\n            else:\\n                c\\n            '\n    check_stack_size(snippet)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestStackSizeStability.test_try_except_bare" {
