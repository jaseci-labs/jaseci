test "TestSpecifics.test_mangling" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class A:\n\n        def f():\n            __mangled = 1\n            __not_mangled__ = 2\n            import __mangled_mod\n            import __package__.module\n    assert '_A__mangled' in A.f.__code__.co_varnames, ('assertIn', '_A__mangled', A.f.__code__.co_varnames)\n    assert '__not_mangled__' in A.f.__code__.co_varnames, ('assertIn', '__not_mangled__', A.f.__code__.co_varnames)\n    assert '_A__mangled_mod' in A.f.__code__.co_varnames, ('assertIn', '_A__mangled_mod', A.f.__code__.co_varnames)\n    assert '__package__' in A.f.__code__.co_varnames, ('assertIn', '__package__', A.f.__code__.co_varnames)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

