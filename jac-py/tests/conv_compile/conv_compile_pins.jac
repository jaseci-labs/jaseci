test "TestSourcePositions.test_very_long_line_end_offset" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\nimport ast\nimport _ast\nfrom test.support.bytecode_helper import instructions_with_positions\n\ndef check_positions_against_ast(snippet):\n    code = compile(snippet, 'test_compile.py', 'exec')\n    ast_tree = compile(snippet, 'test_compile.py', 'exec', _ast.PyCF_ONLY_AST)\n    assert type(ast_tree) == _ast.Module, ('assertTrue', type(ast_tree) == _ast.Module)\n    lines, end_lines, columns, end_columns = (set(), set(), set(), set())\n\n    class SourceOffsetVisitor(ast.NodeVisitor):\n\n        def generic_visit(self, node):\n            super().generic_visit(node)\n            if not isinstance(node, (ast.expr, ast.stmt, ast.pattern)):\n                return\n            lines.add(node.lineno)\n            end_lines.add(node.end_lineno)\n            columns.add(node.col_offset)\n            end_columns.add(node.end_col_offset)\n    SourceOffsetVisitor().visit(ast_tree)\n    for line, end_line, col, end_col in code.co_positions():\n        if line == 0:\n            continue\n        if line is not None:\n            assert line in lines, ('assertIn', line, lines)\n        if end_line is not None:\n            assert end_line in end_lines, ('assertIn', end_line, end_lines)\n        if col is not None:\n            assert col in columns, ('assertIn', col, columns)\n        if end_col is not None:\n            assert end_col in end_columns, ('assertIn', end_col, end_columns)\n    return (code, ast_tree)\n\ndef assertOpcodeSourcePositionIs(code, opcode, line, end_line, column, end_column, occurrence=1):\n    for instr, position in instructions_with_positions(dis.Bytecode(code), code.co_positions()):\n        if instr.opname == opcode:\n            occurrence -= 1\n            if not occurrence:\n                assert position[0] == line, ('assertEqual', position[0], line)\n                assert position[1] == end_line, ('assertEqual', position[1], end_line)\n                assert position[2] == column, ('assertEqual', position[2], column)\n                assert position[3] == end_column, ('assertEqual', position[3], end_column)\n                return\n    raise AssertionError(f'Opcode {opcode} not found in code')\n\ndef _t():\n    long_string = 'a' * 1000\n    snippet = f\"g('{long_string}')\"\n    compiled_code, _ = check_positions_against_ast(snippet)\n    assertOpcodeSourcePositionIs(compiled_code, 'CALL', line=1, end_line=1, column=0, end_column=1005)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSourcePositions.test_complex_single_line_expression" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\nimport ast\nimport _ast\nfrom test.support.bytecode_helper import instructions_with_positions\n\ndef check_positions_against_ast(snippet):\n    code = compile(snippet, 'test_compile.py', 'exec')\n    ast_tree = compile(snippet, 'test_compile.py', 'exec', _ast.PyCF_ONLY_AST)\n    assert type(ast_tree) == _ast.Module, ('assertTrue', type(ast_tree) == _ast.Module)\n    lines, end_lines, columns, end_columns = (set(), set(), set(), set())\n\n    class SourceOffsetVisitor(ast.NodeVisitor):\n\n        def generic_visit(self, node):\n            super().generic_visit(node)\n            if not isinstance(node, (ast.expr, ast.stmt, ast.pattern)):\n                return\n            lines.add(node.lineno)\n            end_lines.add(node.end_lineno)\n            columns.add(node.col_offset)\n            end_columns.add(node.end_col_offset)\n    SourceOffsetVisitor().visit(ast_tree)\n    for line, end_line, col, end_col in code.co_positions():\n        if line == 0:\n            continue\n        if line is not None:\n            assert line in lines, ('assertIn', line, lines)\n        if end_line is not None:\n            assert end_line in end_lines, ('assertIn', end_line, end_lines)\n        if col is not None:\n            assert col in columns, ('assertIn', col, columns)\n        if end_col is not None:\n            assert end_col in end_columns, ('assertIn', end_col, end_columns)\n    return (code, ast_tree)\n\ndef assertOpcodeSourcePositionIs(code, opcode, line, end_line, column, end_column, occurrence=1):\n    for instr, position in instructions_with_positions(dis.Bytecode(code), code.co_positions()):\n        if instr.opname == opcode:\n            occurrence -= 1\n            if not occurrence:\n                assert position[0] == line, ('assertEqual', position[0], line)\n                assert position[1] == end_line, ('assertEqual', position[1], end_line)\n                assert position[2] == column, ('assertEqual', position[2], column)\n                assert position[3] == end_column, ('assertEqual', position[3], end_column)\n                return\n    raise AssertionError(f'Opcode {opcode} not found in code')\n\ndef _t():\n    snippet = \"a - b @ (c * x['key'] + 23)\"\n    compiled_code, _ = check_positions_against_ast(snippet)\n    assertOpcodeSourcePositionIs(compiled_code, 'BINARY_OP', line=1, end_line=1, column=13, end_column=21)\n    assertOpcodeSourcePositionIs(compiled_code, 'BINARY_OP', line=1, end_line=1, column=9, end_column=21, occurrence=2)\n    assertOpcodeSourcePositionIs(compiled_code, 'BINARY_OP', line=1, end_line=1, column=9, end_column=26, occurrence=3)\n    assertOpcodeSourcePositionIs(compiled_code, 'BINARY_OP', line=1, end_line=1, column=4, end_column=27, occurrence=4)\n    assertOpcodeSourcePositionIs(compiled_code, 'BINARY_OP', line=1, end_line=1, column=0, end_column=27, occurrence=5)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSourcePositions.test_multiline_assert_rewritten_as_method_call" {
    (ok, detail) = p2_libtest_run_snippet("import ast\n\ndef _t():\n    tree = ast.parse('assert (\\n42\\n)')\n    old_node = tree.body[0]\n    new_node = ast.Expr(ast.Call(ast.Attribute(ast.Name('spam', ast.Load()), 'eggs', ast.Load()), [], []))\n    ast.copy_location(new_node, old_node)\n    ast.fix_missing_locations(new_node)\n    tree.body[0] = new_node\n    compile(tree, '<test>', 'exec')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSourcePositions.test_push_null_load_global_positions" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\nimport textwrap\nimport warnings\nfrom test.support.bytecode_helper import instructions_with_positions\n\ndef assertOpcodeSourcePositionIs(code, opcode, line, end_line, column, end_column, occurrence=1):\n    for instr, position in instructions_with_positions(dis.Bytecode(code), code.co_positions()):\n        if instr.opname == opcode:\n            occurrence -= 1\n            if not occurrence:\n                assert position[0] == line, ('assertEqual', position[0], line)\n                assert position[1] == end_line, ('assertEqual', position[1], end_line)\n                assert position[2] == column, ('assertEqual', position[2], column)\n                assert position[3] == end_column, ('assertEqual', position[3], end_column)\n                return\n    raise AssertionError(f'Opcode {opcode} not found in code')\n\ndef _t():\n    source_template = '\\n        import abc, dis\\n        import ast as art\\n\\n        abc = None\\n        dix = dis\\n        ast = art\\n\\n        def f():\\n        {}\\n        '\n    for body in ['    abc.a()', '    art.a()', '    ast.a()', '    dis.a()', '    dix.a()', '    abc[...]()', '    art()()', '   (ast or ...)()', '   [dis]()', '   (dix + ...)()']:\n        namespace = {}\n        source = textwrap.dedent(source_template.format(body))\n        with warnings.catch_warnings():\n            warnings.simplefilter('ignore', SyntaxWarning)\n            exec(source, namespace)\n        code = namespace['f'].__code__\n        assertOpcodeSourcePositionIs(code, 'LOAD_GLOBAL', line=10, end_line=10, column=4, end_column=7)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

