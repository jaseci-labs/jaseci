test "TestSpecifics.test_consts_in_conditionals" {
    (ok, detail) = p2_libtest_run_snippet("import dis\n\ndef _t():\n\n    def and_true(x):\n        return True and x\n\n    def and_false(x):\n        return False and x\n\n    def or_true(x):\n        return True or x\n\n    def or_false(x):\n        return False or x\n    funcs = [and_true, and_false, or_true, or_false]\n    for func in funcs:\n        opcodes = list(dis.get_instructions(func))\n        assert len(opcodes) <= 3, ('assertLessEqual', len(opcodes), 3)\n        assert 'LOAD_' in opcodes[-2].opname, ('assertIn', 'LOAD_', opcodes[-2].opname)\n        assert 'RETURN_VALUE' == opcodes[-1].opname, ('assertEqual', 'RETURN_VALUE', opcodes[-1].opname)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecifics.test_imported_load_method" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\nimport textwrap\n\ndef _t():\n    sources = ['            import os\\n            def foo():\\n                return os.uname()\\n            ', '            import os as operating_system\\n            def foo():\\n                return operating_system.uname()\\n            ', '            from os import path\\n            def foo(x):\\n                return path.join(x)\\n            ', '            from os import path as os_path\\n            def foo(x):\\n                return os_path.join(x)\\n            ']\n    for source in sources:\n        namespace = {}\n        exec(textwrap.dedent(source), namespace)\n        func = namespace['foo']\n        opcodes = list(dis.get_instructions(func))\n        instructions = [opcode.opname for opcode in opcodes]\n        assert 'LOAD_METHOD' not in instructions, ('assertNotIn', 'LOAD_METHOD', instructions)\n        assert 'LOAD_ATTR' in instructions, ('assertIn', 'LOAD_ATTR', instructions)\n        assert 'CALL' in instructions, ('assertIn', 'CALL', instructions)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecifics.test_folding_type_param" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\n\ndef _t():\n    get_code_fn_cls = lambda x: x.co_consts[0].co_consts[2]\n    get_code_type_alias = lambda x: x.co_consts[0].co_consts[3]\n    snippets = [('def foo[T = 40 + 5](): pass', get_code_fn_cls), ('def foo[**P = 40 + 5](): pass', get_code_fn_cls), ('def foo[*Ts = 40 + 5](): pass', get_code_fn_cls), ('class foo[T = 40 + 5]: pass', get_code_fn_cls), ('class foo[**P = 40 + 5]: pass', get_code_fn_cls), ('class foo[*Ts = 40 + 5]: pass', get_code_fn_cls), ('type foo[T = 40 + 5] = 1', get_code_type_alias), ('type foo[**P = 40 + 5] = 1', get_code_type_alias), ('type foo[*Ts = 40 + 5] = 1', get_code_type_alias)]\n    for snippet, get_code in snippets:\n        c = compile(snippet, '<dummy>', 'exec')\n        code = get_code(c)\n        opcodes = list(dis.get_instructions(code))\n        instructions = [opcode.opname for opcode in opcodes]\n        args = [opcode.oparg for opcode in opcodes]\n        assert 40 not in args, ('assertNotIn', 40, args)\n        assert 5 not in args, ('assertNotIn', 5, args)\n        assert 'LOAD_SMALL_INT' in instructions, ('assertIn', 'LOAD_SMALL_INT', instructions)\n        assert 45 in args, ('assertIn', 45, args)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
