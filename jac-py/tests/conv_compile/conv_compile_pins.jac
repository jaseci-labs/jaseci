test "TestSpecifics.test_compile_filename" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    for filename in ('file.py', b'file.py'):\n        code = compile('pass', filename, 'exec')\n        assert code.co_filename == 'file.py', ('assertEqual', code.co_filename, 'file.py')\n    for filename in (bytearray(b'file.py'), memoryview(b'file.py')):\n        try:\n            compile('pass', filename, 'exec')\n        except TypeError as _exc:\n            pass\n        else:\n            raise AssertionError('assertRaises: did not raise')\n    try:\n        compile(*('pass', list(b'file.py'), 'exec'))\n    except TypeError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecifics.test_compile_filename_refleak" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    mortal_str = 'this is a mortal string'\n    try:\n        compile(*(b'', mortal_str), mode=1234)\n    except TypeError:\n        pass\n    try:\n        compile(*(b'', mortal_str, 'exec'), optimize=1 << 1000)\n    except OverflowError:\n        pass\n\n    class EvilBool:\n\n        def __bool__(self):\n            raise ValueError\n    try:\n        compile(*(b'', mortal_str, 'exec'), dont_inherit=EvilBool())\n    except ValueError:\n        pass\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

