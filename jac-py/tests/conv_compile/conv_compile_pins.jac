test "TestSpecifics.test_literals_with_leading_zeroes" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    for arg in ['077787', '0xj', '0x.', '0e', '090000000000000', '080000000000000', '000000000000009', '000000000000008', '0b42', '0BADCAFE', '0o123456789', '0b1.1', '0o4.2', '0b101j', '0o153j', '0b100e1', '0o777e1', '0777', '000777', '000000000000007']:\n        try:\n            eval(*(arg,))\n        except SyntaxError:\n            pass\n    assert eval('0xff') == 255, ('assertEqual', eval('0xff'), 255)\n    assert eval('0777.') == 777, ('assertEqual', eval('0777.'), 777)\n    assert eval('0777.0') == 777, ('assertEqual', eval('0777.0'), 777)\n    assert eval('000000000000000000000000000000000000000000000000000777e0') == 777, ('assertEqual', eval('000000000000000000000000000000000000000000000000000777e0'), 777)\n    assert eval('0777e1') == 7770, ('assertEqual', eval('0777e1'), 7770)\n    assert eval('0e0') == 0, ('assertEqual', eval('0e0'), 0)\n    assert eval('0000e-012') == 0, ('assertEqual', eval('0000e-012'), 0)\n    assert eval('09.5') == 9.5, ('assertEqual', eval('09.5'), 9.5)\n    assert eval('0777j') == 777j, ('assertEqual', eval('0777j'), 777j)\n    assert eval('000') == 0, ('assertEqual', eval('000'), 0)\n    assert eval('00j') == 0j, ('assertEqual', eval('00j'), 0j)\n    assert eval('00.0') == 0, ('assertEqual', eval('00.0'), 0)\n    assert eval('0e3') == 0, ('assertEqual', eval('0e3'), 0)\n    assert eval('090000000000000.') == 90000000000000.0, ('assertEqual', eval('090000000000000.'), 90000000000000.0)\n    assert eval('090000000000000.0000000000000000000000') == 90000000000000.0, ('assertEqual', eval('090000000000000.0000000000000000000000'), 90000000000000.0)\n    assert eval('090000000000000e0') == 90000000000000.0, ('assertEqual', eval('090000000000000e0'), 90000000000000.0)\n    assert eval('090000000000000e-0') == 90000000000000.0, ('assertEqual', eval('090000000000000e-0'), 90000000000000.0)\n    assert eval('090000000000000j') == 90000000000000j, ('assertEqual', eval('090000000000000j'), 90000000000000j)\n    assert eval('000000000000008.') == 8.0, ('assertEqual', eval('000000000000008.'), 8.0)\n    assert eval('000000000000009.') == 9.0, ('assertEqual', eval('000000000000009.'), 9.0)\n    assert eval('0b101010') == 42, ('assertEqual', eval('0b101010'), 42)\n    assert eval('-0b000000000010') == -2, ('assertEqual', eval('-0b000000000010'), -2)\n    assert eval('0o777') == 511, ('assertEqual', eval('0o777'), 511)\n    assert eval('-0o0000010') == -8, ('assertEqual', eval('-0o0000010'), -8)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecifics.test_unary_minus" {
    (ok, detail) = p2_libtest_run_snippet("import sys\n\ndef _t():\n    if sys.maxsize == 2147483647:\n        all_one_bits = '0xffffffff'\n        assert eval(all_one_bits) == 4294967295, ('assertEqual', eval(all_one_bits), 4294967295)\n        assert eval('-' + all_one_bits) == -4294967295, ('assertEqual', eval('-' + all_one_bits), -4294967295)\n    elif sys.maxsize == 9223372036854775807:\n        all_one_bits = '0xffffffffffffffff'\n        assert eval(all_one_bits) == 18446744073709551615, ('assertEqual', eval(all_one_bits), 18446744073709551615)\n        assert eval('-' + all_one_bits) == -18446744073709551615, ('assertEqual', eval('-' + all_one_bits), -18446744073709551615)\n    else:\n        raise AssertionError('How many bits *does* this machine have???')\n    assert isinstance(eval('%s' % (-sys.maxsize - 1)), int), ('assertIsInstance', eval('%s' % (-sys.maxsize - 1)), int)\n    assert isinstance(eval('%s' % (-sys.maxsize - 2)), int), ('assertIsInstance', eval('%s' % (-sys.maxsize - 2)), int)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

