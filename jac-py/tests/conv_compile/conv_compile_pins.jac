test "TestSpecifics.test_null_terminated" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n    try:\n        compile('123\\x00', '<dummy>', 'eval')\n    except SyntaxError as _exc:\n        assert _re.search('cannot contain null', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        compile(memoryview(b'123\\x00'), '<dummy>', 'eval')\n    except SyntaxError as _exc:\n        assert _re.search('cannot contain null', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    code = compile(memoryview(b'123\\x00')[1:-1], '<dummy>', 'eval')\n    assert eval(code) == 23, ('assertEqual', eval(code), 23)\n    code = compile(memoryview(b'1234')[1:-1], '<dummy>', 'eval')\n    assert eval(code) == 23, ('assertEqual', eval(code), 23)\n    code = compile(memoryview(b'$23$')[1:-1], '<dummy>', 'eval')\n    assert eval(code) == 23, ('assertEqual', eval(code), 23)\n    assert eval(memoryview(b'1234')[1:-1]) == 23, ('assertEqual', eval(memoryview(b'1234')[1:-1]), 23)\n    namespace = dict()\n    exec(memoryview(b'ax = 123')[1:-1], namespace)\n    assert namespace['x'] == 12, ('assertEqual', namespace['x'], 12)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecifics.test_dont_merge_constants" {
    (ok, detail) = p2_libtest_run_snippet("def check_constant(func, expected):\n    for const in func.__code__.co_consts:\n        if repr(const) == repr(expected):\n            break\n    else:\n        raise AssertionError('unable to find constant %r in %r' % (expected, func.__code__.co_consts))\n\ndef _t():\n\n    def check_different_constants(const1, const2):\n        ns = {}\n        exec('f1, f2 = lambda: %r, lambda: %r' % (const1, const2), ns)\n        f1 = ns['f1']\n        f2 = ns['f2']\n        assert f1.__code__ is not f2.__code__, ('assertIsNot', f1.__code__, f2.__code__)\n        assert f1.__code__ != f2.__code__, ('assertNotEqual', f1.__code__, f2.__code__)\n        check_constant(f1, const1)\n        check_constant(f2, const2)\n        assert repr(f1()) == repr(const1), ('assertEqual', repr(f1()), repr(const1))\n        assert repr(f2()) == repr(const2), ('assertEqual', repr(f2()), repr(const2))\n    check_different_constants(+0.0, -0.0)\n    check_different_constants((0,), (0.0,))\n    check_different_constants('a', b'a')\n    check_different_constants(('a',), (b'a',))\n    f1, f2 = (lambda: +0j, lambda: -0j)\n    assert f1.__code__ is not f2.__code__, ('assertIsNot', f1.__code__, f2.__code__)\n    check_constant(f1, +0j)\n    check_constant(f2, -0j)\n    assert repr(f1()) == repr(+0j), ('assertEqual', repr(f1()), repr(+0j))\n    assert repr(f2()) == repr(-0j), ('assertEqual', repr(f2()), repr(-0j))\n    f1, f2 = (lambda x: x in {0}, lambda x: x in {0.0})\n    assert f1.__code__ is not f2.__code__, ('assertIsNot', f1.__code__, f2.__code__)\n    check_constant(f1, frozenset({0}))\n    check_constant(f2, frozenset({0.0}))\n    assert f1(0), ('assertTrue', f1(0))\n    assert f2(0.0), ('assertTrue', f2(0.0))\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

