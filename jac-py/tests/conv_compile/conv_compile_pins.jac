test "TestSourcePositions.test_load_super_attr" {
    (ok, detail) = p2_libtest_run_snippet("import dis\nimport opcode\nimport types\nfrom test.support.bytecode_helper import instructions_with_positions\n\ndef assertOpcodeSourcePositionIs(code, opcode, line, end_line, column, end_column, occurrence=1):\n    for instr, position in instructions_with_positions(dis.Bytecode(code), code.co_positions()):\n        if instr.opname == opcode:\n            occurrence -= 1\n            if not occurrence:\n                assert position[0] == line, ('assertEqual', position[0], line)\n                assert position[1] == end_line, ('assertEqual', position[1], end_line)\n                assert position[2] == column, ('assertEqual', position[2], column)\n                assert position[3] == end_column, ('assertEqual', position[3], end_column)\n                return\n    raise AssertionError(f'Opcode {opcode} not found in code')\n\ndef _t():\n    source = 'class C:\\n  def __init__(self):\\n    super().__init__()'\n    for const in compile(source, '<test>', 'exec').co_consts[0].co_consts:\n        if isinstance(const, types.CodeType):\n            code = const\n            break\n    assertOpcodeSourcePositionIs(code, 'LOAD_GLOBAL', line=3, end_line=3, column=4, end_column=9)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSourcePositions.test_lambda_return_position" {
    (ok, detail) = p2_libtest_run_snippet("from test.support import script_helper, requires_debug_ranges, run_code, requires_specialization\n\ndef _t():\n    snippets = ['f = lambda: x', 'f = lambda: 42', 'f = lambda: 1 + 2', 'f = lambda: a + b']\n    for snippet in snippets:\n        lamb = run_code(snippet)['f']\n        positions = lamb.__code__.co_positions()\n        for i, pos in enumerate(positions):\n            start_line, end_line, start_col, end_col = pos\n            if i == 0 and start_col == end_col == 0:\n                continue\n            assert start_line == 1, ('assertEqual', start_line, 1)\n            assert end_line == 1, ('assertEqual', end_line, 1)\n            code_start = snippet.find(':') + 2\n            code_end = len(snippet)\n            assert start_col >= code_start, ('assertGreaterEqual', start_col, code_start)\n            assert end_col <= code_end, ('assertLessEqual', end_col, code_end)\n            assert end_col >= start_col, ('assertGreaterEqual', end_col, start_col)\n            assert end_col <= code_end, ('assertLessEqual', end_col, code_end)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestStaticAttributes.test_nested_function" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class C:\n\n        def f(self):\n            self.x = 1\n            self.y = 2\n            self.x = 3\n\n        def g(self, obj):\n            self.y = 4\n            self.z = 5\n\n            def h(self, a):\n                self.u = 6\n                self.v = 7\n            obj.self = 8\n    assert sorted(C.__static_attributes__) == ['u', 'v', 'x', 'y', 'z'], ('assertEqual', sorted(C.__static_attributes__), ['u', 'v', 'x', 'y', 'z'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestStaticAttributes.test_nested_class" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class C:\n\n        def f(self):\n            self.x = 42\n            self.y = 42\n\n        class D:\n\n            def g(self):\n                self.y = 42\n                self.z = 42\n    assert sorted(C.__static_attributes__) == ['x', 'y'], ('assertEqual', sorted(C.__static_attributes__), ['x', 'y'])\n    assert sorted(C.D.__static_attributes__) == ['y', 'z'], ('assertEqual', sorted(C.D.__static_attributes__), ['y', 'z'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
