}

test "TestStaticAttributes.test_subclass" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class C:\n\n        def f(self):\n            self.x = 42\n            self.y = 42\n\n    class D(C):\n\n        def g(self):\n            self.y = 42\n            self.z = 42\n    assert sorted(C.__static_attributes__) == ['x', 'y'], ('assertEqual', sorted(C.__static_attributes__), ['x', 'y'])\n    assert sorted(D.__static_attributes__) == ['y', 'z'], ('assertEqual', sorted(D.__static_attributes__), ['y', 'z'])\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
