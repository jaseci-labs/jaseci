test "TestSpecifics.test_encoding" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n    code = b'# -*- coding: badencoding -*-\\npass\\n'\n    try:\n        compile(*(code, 'tmp', 'exec'))\n    except SyntaxError:\n        pass\n    code = '# -*- coding: badencoding -*-\\n\"\u00c2\u00a4\"\\n'\n    compile(code, 'tmp', 'exec')\n    assert eval(code) == '\u00c2\u00a4', ('assertEqual', eval(code), '\u00c2\u00a4')\n    code = '\"\u00c2\u00a4\"\\n'\n    assert eval(code) == '\u00c2\u00a4', ('assertEqual', eval(code), '\u00c2\u00a4')\n    code = b'\"\\xc2\\xa4\"\\n'\n    assert eval(code) == '\u00a4', ('assertEqual', eval(code), '\u00a4')\n    code = b'# -*- coding: latin1 -*-\\n\"\\xc2\\xa4\"\\n'\n    assert eval(code) == '\u00c2\u00a4', ('assertEqual', eval(code), '\u00c2\u00a4')\n    code = b'# -*- coding: utf-8 -*-\\n\"\\xc2\\xa4\"\\n'\n    assert eval(code) == '\u00a4', ('assertEqual', eval(code), '\u00a4')\n    code = b'# -*- coding: iso8859-15 -*-\\n\"\\xc2\\xa4\"\\n'\n    assert eval(code) == '\u00c2\u20ac', ('assertEqual', eval(code), '\u00c2\u20ac')\n    code = '\"\"\"\\\\\\n# -*- coding: iso8859-15 -*-\\n\u00c2\u00a4\"\"\"\\n'\n    assert eval(code) == '# -*- coding: iso8859-15 -*-\\n\u00c2\u00a4', ('assertEqual', eval(code), '# -*- coding: iso8859-15 -*-\\n\u00c2\u00a4')\n    code = b'\"\"\"\\\\\\n# -*- coding: iso8859-15 -*-\\n\\xc2\\xa4\"\"\"\\n'\n    assert eval(code) == '# -*- coding: iso8859-15 -*-\\n\u00a4', ('assertEqual', eval(code), '# -*- coding: iso8859-15 -*-\\n\u00a4')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecifics.test_subscripts" {
    (ok, detail) = p2_libtest_run_snippet("def _t():\n\n    class _SelfNS:\n        pass\n    self = _SelfNS()\n\n    class str_map(object):\n\n        def __init__(self):\n            self.data = {}\n\n        def __getitem__(self, key):\n            return self.data[str(key)]\n\n        def __setitem__(self, key, value):\n            self.data[str(key)] = value\n\n        def __delitem__(self, key):\n            del self.data[str(key)]\n\n        def __contains__(self, key):\n            return str(key) in self.data\n    d = str_map()\n    d[1] = 1\n    assert d[1] == 1, ('assertEqual', d[1], 1)\n    d[1] += 1\n    assert d[1] == 2, ('assertEqual', d[1], 2)\n    del d[1]\n    assert 1 not in d, ('assertNotIn', 1, d)\n    d[1, 1] = 1\n    assert d[1, 1] == 1, ('assertEqual', d[1, 1], 1)\n    d[1, 1] += 1\n    assert d[1, 1] == 2, ('assertEqual', d[1, 1], 2)\n    del d[1, 1]\n    assert (1, 1) not in d, ('assertNotIn', (1, 1), d)\n    d[1:2] = 1\n    assert d[1:2] == 1, ('assertEqual', d[1:2], 1)\n    d[1:2] += 1\n    assert d[1:2] == 2, ('assertEqual', d[1:2], 2)\n    del d[1:2]\n    assert slice(1, 2) not in d, ('assertNotIn', slice(1, 2), d)\n    d[1:2, 1:2] = 1\n    assert d[1:2, 1:2] == 1, ('assertEqual', d[1:2, 1:2], 1)\n    d[1:2, 1:2] += 1\n    assert d[1:2, 1:2] == 2, ('assertEqual', d[1:2, 1:2], 2)\n    del d[1:2, 1:2]\n    assert (slice(1, 2), slice(1, 2)) not in d, ('assertNotIn', (slice(1, 2), slice(1, 2)), d)\n    d[1:2:3] = 1\n    assert d[1:2:3] == 1, ('assertEqual', d[1:2:3], 1)\n    d[1:2:3] += 1\n    assert d[1:2:3] == 2, ('assertEqual', d[1:2:3], 2)\n    del d[1:2:3]\n    assert slice(1, 2, 3) not in d, ('assertNotIn', slice(1, 2, 3), d)\n    d[1:2:3, 1:2:3] = 1\n    assert d[1:2:3, 1:2:3] == 1, ('assertEqual', d[1:2:3, 1:2:3], 1)\n    d[1:2:3, 1:2:3] += 1\n    assert d[1:2:3, 1:2:3] == 2, ('assertEqual', d[1:2:3, 1:2:3], 2)\n    del d[1:2:3, 1:2:3]\n    assert (slice(1, 2, 3), slice(1, 2, 3)) not in d, ('assertNotIn', (slice(1, 2, 3), slice(1, 2, 3)), d)\n    d[...] = 1\n    assert d[...] == 1, ('assertEqual', d[...], 1)\n    d[...] += 1\n    assert d[...] == 2, ('assertEqual', d[...], 2)\n    del d[...]\n    assert Ellipsis not in d, ('assertNotIn', Ellipsis, d)\n    d[..., ...] = 1\n    assert d[..., ...] == 1, ('assertEqual', d[..., ...], 1)\n    d[..., ...] += 1\n    assert d[..., ...] == 2, ('assertEqual', d[..., ...], 2)\n    del d[..., ...]\n    assert (Ellipsis, Ellipsis) not in d, ('assertNotIn', (Ellipsis, Ellipsis), d)\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

