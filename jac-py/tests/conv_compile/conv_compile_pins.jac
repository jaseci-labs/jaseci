    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

test "TestSpecifics.test_compile_redundant_jumps_and_nops_after_moving_cold_blocks" {
    (ok, detail) = p2_libtest_run_snippet("import ast\nimport textwrap\n\ndef _t():\n    code = textwrap.dedent(\"\\n            try:\\n                pass\\n            except:\\n                pass\\n            else:\\n                match name_2:\\n                    case b'':\\n                        pass\\n            finally:\\n                something\\n            \")\n    tree = ast.parse(code)\n    for node in ast.walk(tree):\n        if hasattr(node, 'lineno'):\n            del node.lineno\n            del node.end_lineno\n            del node.col_offset\n            del node.end_col_offset\n    compile(ast.fix_missing_locations(tree), '<file>', 'exec')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
    assert ok , "RUN<" + detail + ">";
    assert detail == "ok" , "GOT<" + detail + ">";
}

