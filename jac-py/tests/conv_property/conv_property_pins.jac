test "PropertyTests.test_property_name" {
    (ok, detail) = p2_libtest_run_snippet("import re as _re\n\ndef _t():\n\n    def getter(self):\n        return 42\n\n    def setter(self, value):\n        pass\n\n    class A:\n\n        @property\n        def foo(self):\n            return 1\n\n        @foo.setter\n        def oof(self, value):\n            pass\n        bar = property(getter)\n        baz = property(None, setter)\n    assert A.foo.__name__ == 'foo', ('assertEqual', A.foo.__name__, 'foo')\n    assert A.oof.__name__ == 'oof', ('assertEqual', A.oof.__name__, 'oof')\n    assert A.bar.__name__ == 'bar', ('assertEqual', A.bar.__name__, 'bar')\n    assert A.baz.__name__ == 'baz', ('assertEqual', A.baz.__name__, 'baz')\n    A.quux = property(getter)\n    assert A.quux.__name__ == 'getter', ('assertEqual', A.quux.__name__, 'getter')\n    A.quux.__name__ = 'myquux'\n    assert A.quux.__name__ == 'myquux', ('assertEqual', A.quux.__name__, 'myquux')\n    assert A.bar.__name__ == 'bar', ('assertEqual', A.bar.__name__, 'bar')\n    A.quux.__name__ = None\n    assert A.quux.__name__ is None, ('assertIsNone', A.quux.__name__)\n    try:\n        property(None, setter).__name__\n    except AttributeError as _exc:\n        assert _re.search(\"'property' object has no attribute '__name__'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    try:\n        property(1).__name__\n    except AttributeError as _exc:\n        assert _re.search(\"'property' object has no attribute '__name__'\", str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n\n    class Err:\n\n        def __getattr__(self, attr):\n            raise RuntimeError('fail')\n    p = property(Err())\n    try:\n        p.__name__\n    except RuntimeError as _exc:\n        assert _re.search('fail', str(_exc)), 'assertRaisesRegex: message mismatch'\n    else:\n        raise AssertionError('assertRaises: did not raise')\n    p.__name__ = 'not_fail'\n    assert p.__name__ == 'not_fail', ('assertEqual', p.__name__, 'not_fail')\ntry:\n    _t()\nexcept BaseException as _e:\n    print('ORACLE_EXC ' + type(_e).__name__ + ' ' + repr(str(_e)))\nelse:\n    print('ok')\n");
