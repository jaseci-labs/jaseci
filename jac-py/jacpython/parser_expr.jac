                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_call_from_optional_args(a, b, start_lineno, start_col_offset, end_lineno, end_col_offset);
                return res;
            }
        }
    }
    peg_reset(p, mark);
    atom = rule_atom(p);
    if atom is not None {
        res = atom;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

def rule_shift_expr(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_shift_expr);
    if hit.hit {
        return hit.result as expr | None;
    }
    mark = peg_mark(p);
    res: expr | None = None;
    resmark = mark;
    while True {
        peg_update_memo(p, mark, RULE_shift_expr, res);
        peg_reset(p, mark);
        raw = rule_shift_expr_raw(p);
        if peg_has_error(p) {
            return None;
        }
        if raw is None or peg_mark(p) <= resmark {
            break;
        }
        resmark = peg_mark(p);
        res = raw;
    }
    return peg_left_rec_finish(p, resmark, res) as expr;
}

def rule_shift_expr_raw(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    a = rule_shift_expr(p);
    if a is not None {
        lit = peg_expect_token(p, 33);
        if lit is not None {
            b = rule_sum(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, LShift(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_shift_expr(p);
    if a is not None {
        lit = peg_expect_token(p, 34);
        if lit is not None {
            b = rule_sum(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, RShift(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    sum = rule_sum(p);
    if sum is not None {
        res = sum;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

def rule_starred_expression(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    if peg_fill_token(p) {
        t0 = p.tokens[p.mark];
        start_lineno = t0.lineno;
        start_col_offset = t0.col_offset;
    }
    lit = peg_expect_token(p, 16);
    if lit is not None {
        a = rule_expression(p);
        if a is not None {
            end_tok = p.tokens[p.mark - 1];
            end_lineno = end_tok.end_lineno;
            end_col_offset = end_tok.end_col_offset;
            res = pa_ast_starred(a, start_lineno, start_col_offset, end_lineno, end_col_offset );
            return res;
        }
    }
    peg_reset(p, mark);
    return None;
}

def rule_sum(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_sum);
    if hit.hit {
        return hit.result as expr | None;
    }
    mark = peg_mark(p);
    res: expr | None = None;
    resmark = mark;
    while True {
        peg_update_memo(p, mark, RULE_sum, res);
        peg_reset(p, mark);
        raw = rule_sum_raw(p);
        if peg_has_error(p) {
            return None;
        }
        if raw is None or peg_mark(p) <= resmark {
            break;
        }
        resmark = peg_mark(p);
        res = raw;
    }
    return peg_left_rec_finish(p, resmark, res) as expr;
}

def rule_sum_raw(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    a = rule_sum(p);
    if a is not None {
        lit = peg_expect_token(p, 14);
        if lit is not None {
            b = rule_term(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, Add(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_sum(p);
    if a is not None {
        lit = peg_expect_token(p, 15);
        if lit is not None {
            b = rule_term(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, Sub(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    term = rule_term(p);
    if term is not None {
        res = term;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

def rule_term(p: peg_parser) -> expr | None {
    hit = peg_check_memo(p, RULE_term);
    if hit.hit {
        return hit.result as expr | None;
    }
    mark = peg_mark(p);
    res: expr | None = None;
    resmark = mark;
    while True {
        peg_update_memo(p, mark, RULE_term, res);
        peg_reset(p, mark);
        raw = rule_term_raw(p);
        if peg_has_error(p) {
            return None;
        }
        if raw is None or peg_mark(p) <= resmark {
            break;
        }
        resmark = peg_mark(p);
        res = raw;
    }
    return peg_left_rec_finish(p, resmark, res) as expr;
}

def rule_term_raw(p: peg_parser) -> expr | None {
    mark = peg_mark(p);
    start_lineno = 1;
    start_col_offset = 0;
    end_lineno = 1;
    end_col_offset = 0;
    a = rule_term(p);
    if a is not None {
        lit = peg_expect_token(p, 16);
        if lit is not None {
            b = rule_factor(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, Mult(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_term(p);
    if a is not None {
        lit = peg_expect_token(p, 17);
        if lit is not None {
            b = rule_factor(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, Div(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_term(p);
    if a is not None {
        lit = peg_expect_token(p, 47);
        if lit is not None {
            b = rule_factor(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, FloorDiv(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_term(p);
    if a is not None {
        lit = peg_expect_token(p, 24);
        if lit is not None {
            b = rule_factor(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = pa_ast_binop(a, Mod(), b, start_lineno, start_col_offset, end_lineno, end_col_offset );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    a = rule_term(p);
    if a is not None {
        lit = peg_expect_token(p, 49);
        if lit is not None {
            b = rule_factor(p);
            if b is not None {
                end_tok = p.tokens[p.mark - 1];
                end_lineno = end_tok.end_lineno;
                end_col_offset = end_tok.end_col_offset;
                res = CHECK_VERSION ( expr_ty , 5 , "The '@' operator is" , pa_ast_binop(a, MatMult(), b, start_lineno, start_col_offset, end_lineno, end_col_offset ) );
                return res;
            }
        }
    }
    peg_reset(p, mark);
    factor = rule_factor(p);
    if factor is not None {
        res = factor;
        return res;
    }
    peg_reset(p, mark);
    return None;
}

def _build_keyword_lists() -> list[list[peg_keyword_entry]] {
    lists: list[list[peg_keyword_entry]] = [];
    i = 0;
    while i <= 5 {
        lists.append([]);
        i = i + 1;
    }
    lists[2].append(peg_keyword_entry(spelling="or", tok_type=505));
    lists[2].append(peg_keyword_entry(spelling="if", tok_type=506));
    lists[2].append(peg_keyword_entry(spelling="in", tok_type=514));
    lists[2].append(peg_keyword_entry(spelling="is", tok_type=511));
    lists[3].append(peg_keyword_entry(spelling="and", tok_type=504));
    lists[3].append(peg_keyword_entry(spelling="not", tok_type=513));
    lists[4].append(peg_keyword_entry(spelling="True", tok_type=500));
    lists[4].append(peg_keyword_entry(spelling="None", tok_type=502));
    lists[4].append(peg_keyword_entry(spelling="else", tok_type=507));
    lists[5].append(peg_keyword_entry(spelling="False", tok_type=501));
    lists[5].append(peg_keyword_entry(spelling="await", tok_type=503));
    return lists;
}
glob SOFT_KEYWORDS: list[str] = [];

def parse_eval_module(p: peg_parser) -> mod | None {
    res = rule_eval(p);
    if res is None {
        return None;
    }
    if peg_expect_token(p, ENDMARKER) is None {
        return None;
    }
    return res;
}

def parse_eval_source(source: str, filename: str) -> mod | None {
    p = peg_parser_from_source(source, filename, True);
    peg_set_keywords(p, _build_keyword_lists());
    peg_set_soft_keywords(p, SOFT_KEYWORDS);
    return parse_eval_module(p);
}

def parse_eval_expr(source: str, filename: str) -> expr | None {
    mod = parse_eval_source(source, filename);
    if mod is None {
        return None;
    }
    if isinstance(mod, Expression) {
        return (mod as Expression).body;
    }
    return None;
}
