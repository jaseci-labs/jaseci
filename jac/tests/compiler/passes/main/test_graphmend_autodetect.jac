"""GraphMend automatic activation (the auto/on/off tri-state).

Under `auto`, GraphMend engages for exactly the modules torch.compile could
touch, detected syntactically at compile time: any import statement binding
`torch` or a `torch.*` submodule, in jac import syntax and in py-origin
Import nodes alike. Relative imports such as `.torch` name a sibling module,
not PyTorch, so they must not trigger. A torch-free module compiled under
auto must be byte-identical to a graphmend-off compile, and a torch-importing
module under auto must match explicit-on output exactly. The bool spellings
(True/False) stay valid; "on"/"off" normalize to them. Detection needs no
installed torch. Temp files are generated at test time because the repository
takes no new .py files, and a `torch.jac` sibling must not sit in the shared
fixtures directory where it would shadow the real torch for other suites."""
import os;
import tempfile;
import from tests.support {
    GRAPHMEND_FIXTURES as FIXTURES,
    graphmend_compile_opts as _compile_opts
}
import from jaclang.jac0core.compile_options { CompileOptions }

"""Compile a file under the given graphmend setting and return the unparsed
Python source, the generated bytecode, and the post-compile resolved value of
CompileOptions.graphmend (auto resolves to a bool during compilation)."""
def _compile(path: str, gm: any) -> tuple[str, any, any] {
    opts = CompileOptions(graphmend=gm, type_check=False);
    (src, bc) = _compile_opts(path, opts);
    return (src, bc, opts.graphmend);
}

def _fixture(name: str, gm: any) -> tuple[str, any, any] {
    return _compile(os.path.join(FIXTURES, name), gm);
}

test "auto transforms a torch-importing module identically to explicit on" {
    (src_auto, _bc, resolved) = _fixture("val_guard_all.jac", "auto");
    (src_on, _bc2, _r2) = _fixture("val_guard_all.jac", True);
    assert resolved is True;
    assert src_auto == src_on;
    assert "torch._assert_async(" in src_auto;
    assert "raise ValueError" not in src_auto;
}

test "auto also engages through an import-from of the torch module" {
    (src_auto, _bc, resolved) = _fixture("val_guard_tensor_import.jac", "auto");
    (src_on, _bc2, _r2) = _fixture("val_guard_tensor_import.jac", True);
    assert resolved is True;
    assert src_auto == src_on;
    assert "torch._assert_async(" in src_auto;
}

test "auto leaves a torch-free module byte-identical to off" {
    (src_auto, bc_auto, resolved) = _fixture("no_torch_plain.jac", "auto");
    (src_off, bc_off, _r) = _fixture("no_torch_plain.jac", False);
    assert resolved is False;
    assert src_auto == src_off;
    assert bc_auto == bc_off;
}

test "explicit off leaves a torch-importing module untransformed" {
    (src_off, _bc, resolved) = _fixture("val_guard_all.jac", False);
    assert resolved is False;
    assert "torch._assert_async(" not in src_off;
    assert "raise ValueError" in src_off;
}

test "a relative .torch jac import does not engage auto" {
    with tempfile.TemporaryDirectory() as tmp {
        with open(os.path.join(tmp, "torch.jac"), "w") as fh {
            fh.write("def relu(x: any) -> any {\n    return x;\n}\n");
        }
        target = os.path.join(tmp, "rel_torch.jac");
        with open(target, "w") as fh {
            fh.write(
                "import from .torch { relu }\n\n"
                    + "def f(x: any) -> any {\n"
                    + "    if x > 0 {\n        return relu(x);\n    }\n"
                    + "    return x;\n}\n"
            );
        }
        (src_auto, bc_auto, resolved) = _compile(target, "auto");
        (src_off, bc_off, _r) = _compile(target, False);
        assert resolved is False;
        assert src_auto == src_off;
        assert bc_auto == bc_off;
    }
}

glob PY_TORCH_SRC = '''
import torch


class MyModel(torch.nn.Module):
    def forward(self, x):
        x = torch.relu(x)
        if x.sum() > 0:
            return x * 2.0
        else:
            return x * 3.0


model = MyModel()
compiled = torch.compile(model)
''',
     PY_RELATIVE_SRC = '''
from .torch import relu


def f(x):
    if x > 0:
        return relu(x)
    return x
''';

"""Write generated .py source to a temp file and compile it under the given
graphmend setting."""
def _py_compile(py_src: str, name: str, gm: any) -> tuple[str, any, any] {
    with tempfile.TemporaryDirectory() as tmp {
        path = os.path.join(tmp, name);
        with open(path, "w") as fh {
            fh.write(py_src);
        }
        return _compile(path, gm);
    }
}

test "py: auto engages on an import torch module like explicit on" {
    (src_auto, _bc, resolved) = _py_compile(PY_TORCH_SRC, "auto_model.py", "auto");
    (src_on, _bc2, _r2) = _py_compile(PY_TORCH_SRC, "auto_model.py", True);
    assert resolved is True;
    assert src_auto == src_on;
    assert "torch.where(" in src_auto;
    assert "if x.sum() > 0" not in src_auto;
}

test "py: a relative .torch import stays off under auto" {
    with tempfile.TemporaryDirectory() as tmp {
        path = os.path.join(tmp, "rel_plain.py");
        with open(path, "w") as fh {
            fh.write(PY_RELATIVE_SRC);
        }
        (src_auto, bc_auto, resolved) = _compile(path, "auto");
        (src_off, bc_off, _r) = _compile(path, False);
        assert resolved is False;
        assert src_auto == src_off;
        assert bc_auto == bc_off;
    }
}

test "compile options accept the on off and auto spellings" {
    assert CompileOptions(graphmend="on").graphmend is True;
    assert CompileOptions(graphmend="off").graphmend is False;
    assert CompileOptions(graphmend="auto").graphmend == "auto";
    assert CompileOptions(graphmend=True).graphmend is True;
    assert CompileOptions(graphmend=False).graphmend is False;
}

test "the configured mode resolver normalizes every jac.toml spelling" {
    import jaclang.cli.commands.execution as execution;
    import from jaclang.project.config { JacConfig }
    import jaclang.project.config as config_mod;
    old_config = config_mod._config;
    try {
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = \"auto\"\n");
        assert execution._configured_graphmend() == "auto";
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = true\n");
        assert execution._configured_graphmend() is True;
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = false\n");
        assert execution._configured_graphmend() is False;
        config_mod._config = JacConfig.from_toml_str("[run]\nmain = true\n");
        assert execution._configured_graphmend() == "auto";
    } finally {
        config_mod._config = old_config;
    }
}

test "the run section of jac.toml carries the auto spelling" {
    import from jaclang.project.config { JacConfig }
    cfg = JacConfig.from_toml_str("[run]\ngraphmend = \"auto\"\n");
    assert cfg.run.graphmend == "auto";
    cfg_bool = JacConfig.from_toml_str("[run]\ngraphmend = true\n");
    assert cfg_bool.run.graphmend is True;
}

test "the cli mapper carries the configured mode to the program" {
    import from jaclang.jac0core.runtime { JacRuntime as Jac }
    import jaclang.cli.commands.execution as execution;
    import from jaclang.project.config { JacConfig }
    import jaclang.project.config as config_mod;
    prog = Jac.get_program();
    prev_enabled = prog.graphmend_enabled;
    prev_scope = prog.graphmend_scope;
    prev_disable = prog.graphmend_disable;
    old_config = config_mod._config;
    try {
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = \"auto\"\n");
        execution._apply_graphmend("", "");
        assert Jac.get_program().graphmend_enabled == "auto";
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = \"on\"\n");
        execution._apply_graphmend("", "");
        assert Jac.get_program().graphmend_enabled is True;
        config_mod._config = JacConfig.from_toml_str("[run]\ngraphmend = \"off\"\n");
        execution._apply_graphmend("", "");
        assert Jac.get_program().graphmend_enabled is False;
    } finally {
        config_mod._config = old_config;
        cur = Jac.get_program();
        cur.graphmend_enabled = prev_enabled;
        cur.graphmend_scope = prev_scope;
        cur.graphmend_disable = prev_disable;
    }
}
