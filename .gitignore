# Docs "Build Anything" track pages live under jac/jaclang/cli/docs/build/ --
# the bare `build` rule above would otherwise ignore them. Keep this content
# tracked.
!jac/jaclang/cli/docs/build/
!jac/jaclang/cli/docs/build/**

# Zig 0.16 project-local package cache (fetched, hash-pinned deps)
zig-pkg/

# Seal-time generated materializer root (see jaclang/dist/gen_native_materialize.jac)
jac/jaclang/compiler/native_materialize.jac

# Pi subagent session artifacts
.pi-subagents/

# Throwaway debug/repro drivers under jac-py/jacpython (underscore-prefixed
# scratch files; lifted C-module ports like _statmodule.jac do NOT match these
# prefixed patterns and stay trackable).
jac-py/jacpython/_tmp_*.jac
jac-py/jacpython/_repro*.jac
jac-py/jacpython/_smoke_*.jac
jac-py/jacpython/_fuzz_*.jac
jac-py/jacpython/_t[0-9]*.jac
jac-py/jacpython/zz_*tmp*.jac
